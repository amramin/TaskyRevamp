@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<SharedResources> Loc


    <div class="card empty-page">
        <div class="card-body">
            <span class="vector">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EmptyPageVector"></SVGCrud>
            </span>
            <div class="content">
                <h5 class="headline-5">@MessageTitle</h5>
                <p class="small-medium-text">@MessageSubtitle</p>
            </div>
            <div class="action-btn-list">
                <button class="btn btn-lg btn-primary" @onclick="OnButtonClick">
                    <span class="icon">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                    </span>
                    @ButtonText
                </button>
            </div>
        </div>
    </div>


@code {
    [Parameter] public string? MessageTitle { get; set; }
    [Parameter] public string? MessageSubtitle { get; set; }
    [Parameter] public string? ButtonText { get; set; }
    [Parameter] public EventCallback OnButtonClick { get; set; }
}
