@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums
@inject PopupService PopupService
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Loc;

@if (isVisible)
{
 
    @if (_popupType == PopupType.New && _parameters is NewPopupParams newParams)
    {
      
        <!-- Overlay -->
    <div class="offcanvas-backdrop fade show" @onclick="PopupService.Hide"></div>

    <!-- Actual Offcanvas -->
    <div class="offcanvas offcanvas-end show  h-100"
         tabindex="-1" style="visibility: visible;" @onclick:stopPropagation>
        <div class="offcanvas-header">
                <button type="button" class="btn close" @onclick="PopupService.Hide">
                    <span class="icon">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CloseArrow"></SVGCrud>
                    </span>
                </button>
                <h5 class="offcanvas-title">@newParams.HeaderText</h5>
            </div>

       
            @newParams.ChildContent
       
    </div>
    }
    else
    {
     
        <div class="modal-backdrop fade show" @onclick="PopupService.Hide"></div>

        <div class="modal fade show d-block" tabindex="-1"
             @onclick="PopupService.Hide">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>

                @if (_popupType == PopupType.Confirmation && _parameters is ConfirmationPopupParams confirmParams)
                {
                    var buttonClass = confirmParams.Type == ConfirmationType.Danger ? "btn-danger" : "btn-primary";
                    <div class="modal-content confirmation-popup">
                        <div class="">
                            <div class="modal-body">
                                <span class="confirm-icon">
                                    @if (confirmParams.Type == ConfirmationType.Danger)
                                    {
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.InfoCircleDanger"></SVGCrud>
                                    }
                                    else if (confirmParams.Type == ConfirmationType.Primary)
                                    {
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.RecycleVectore"></SVGCrud>
                                    }
                                    else
                                    {
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Info"></SVGCrud>

                                    }
                                </span>
                                @if (confirmParams.Type == ConfirmationType.Danger)
                                {
                                    @* <h6 class="modal-title headline-6">Sure to Delete ?</h6> *@
                                }
                                else if (confirmParams.Type == ConfirmationType.Primary)
                                {
                                    <h6 class="modal-title headline-6"> Move to trash ?</h6>
                                }
                                <p class="small-medium-text">@confirmParams.Message</p>
                                <div class="action d-grid w-100">
                                    <button class="btn btn-lg @(buttonClass)" @onclick="() => Confirm(true, confirmParams.OnConfirm)">
                                        @confirmParams.ButtonText
                                    </button>
                                    <button class="btn btn-lg" @onclick="() => Confirm(false, confirmParams.OnConfirm)">@Loc["Cancel"]</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_popupType == PopupType.Info && _parameters is InfoPopupParams infoParams)
                {
                    var buttonClass = infoParams.Type == ConfirmationType.Danger ? "btn-danger" : "btn-primary";
                    <div class="modal-content confirmation-popup">
                        <div class="">
                            <div class="modal-body">
                                <span class="confirm-icon">
                                    @if (infoParams.Type == ConfirmationType.Danger)
                                    {
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.InfoCircleDanger"></SVGCrud>
                                    }
                                    else
                                    {
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Info"></SVGCrud>
                                    }
                                </span>
                                @if (infoParams.Type == ConfirmationType.Danger)
                                {
                                    @* <h6 class="modal-title headline-6">Sure to Delete ?</h6> *@
                                }
                                else
                                {
@*                                     <h6 class="modal-title headline-6"> Move to trash ?</h6>
 *@                                }
                                <p class="small-medium-text">@infoParams.Message</p>
                                <p class="small-medium-text">@infoParams.Info</p>
                                <div class="action d-grid w-100">
                                        <button class="btn btn-lg @(buttonClass)" @onclick="() => Confirm(false, infoParams.OnConfirm)">@Loc["Close"]</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else if (_popupType == PopupType.InValid && _parameters is InvalidPopupParams invalidParams)
                {
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Invalid</h5>
                            <button type="button" class="btn-close" @onclick="PopupService.Hide"></button>
                        </div>
                        <div class="modal-body">
                            <p>@invalidParams.Message</p>
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-primary" @onclick="PopupService.Hide">OK</button>
                        </div>
                    </div>
                }
                else if (_popupType == PopupType.Standard && _parameters is StandardPopupParams stdParams)
                {
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">@stdParams.HeaderText</h5>
                            <button type="button" class="btn-close" @onclick="PopupService.Hide"></button>
                        </div>
                        <div class="modal-body">
                            @stdParams.ChildContent
                        </div>
                        <div class="modal-footer">
                            <button class="btn btn-secondary" @onclick="PopupService.Hide">Close</button>
                        </div>
                    </div>
                }

            </div>
        </div>
    }
}



@code {
    private PopupType _popupType;
    private object? _parameters;
    private bool isVisible;

    protected override void OnInitialized()
    {
        PopupService.OnShow += ShowPopup;
        PopupService.OnHide += HidePopup;
    }

    private void ShowPopup(PopupType type, object parameters)
    {
        _popupType = type;
        _parameters = parameters;
        isVisible = true;
        InvokeAsync(StateHasChanged);
    }

    private void HidePopup()
    {
        _popupType = default;
        _parameters = null;
        isVisible = false;
        InvokeAsync(StateHasChanged);
    }

    private async Task Confirm(bool value, EventCallback<bool> callback)
    {
        if (callback.HasDelegate)
        {
            await callback.InvokeAsync(value);
        }
        // PopupService.Hide();
    }
}
