@if (isVisible)
{
    <div class="popup-overlay">
        <div class="popup">
            <h3>@title</h3>
            <p>@message</p>
            <div class="buttons">
                <button @onclick="Confirm">OK</button>
                <button @onclick="Cancel">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool isVisible;
    private string? title;
    private string? message;
    private Func<Task>? confirmAction;

    [Inject] private PopupService PopupService { get; set; } = default!;

    protected override void OnInitialized()
    {
        PopupService.OnShow += (t, m, onConfirm) =>
            InvokeAsync(() =>
            {
                title = t;
                message = m;
                confirmAction = onConfirm;
                isVisible = true;
                StateHasChanged();
            });

        PopupService.OnHide += () =>
            InvokeAsync(() =>
            {
                isVisible = false;
                StateHasChanged();
            });
    }

    private async Task Confirm()
    {
        if (confirmAction != null)
            await confirmAction();
        isVisible = false;
    }

    private void Cancel() => isVisible = false;
}
