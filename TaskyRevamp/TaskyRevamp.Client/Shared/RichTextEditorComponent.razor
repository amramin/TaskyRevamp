@using Syncfusion.Blazor
@using Syncfusion.Blazor.RichTextEditor
@inject IStringLocalizer<SharedResources> Loc
@using System.Globalization
@using TaskyRevamp.Dto.Account

@if (!IsLoaded)
{
    <div class="form-control"
         style="min-height:120px; cursor:text;"
         @onclick="LoadEditor">
        @((MarkupString)(!string.IsNullOrWhiteSpace(InternalContent)
            ? InternalContent
            : $"<span class='text-muted'><i>{HintMessage ?? ButtonText}</i></span>"))
</div>
}
else
{
        <SfRichTextEditor @ref="rte"
                          ID="@EditorId"
                          SaveInterval="0"
                          Value="@InternalContent"
                          ValueChanged="OnValueChange"
                          EnablePersistence="false"
                          EnableRtl="EnableRtl"
                          ShowCharCount="true"
                          MaxLength="3000"
                          CssClass="@(EnableRtl ? "arabic-rte" : "")">
            <RichTextEditorToolbarSettings Items="@Tools" />
            <RichTextEditorPasteCleanupSettings Prompt="false" PlainText="false" KeepFormat="true" DeniedTags="@DeniedTags" />
            <RichTextEditorQuickToolbarSettings Link="@Link" />
        </SfRichTextEditor>       

}
<style>
    .arabic-rte .e-rte-content { text-align: right; }
</style>

@code {
    [Parameter] public string EditorId { get; set; }
    [Parameter] public string Content { set; get; }
    [Parameter] public EventCallback<string> ContentChanged { get; set; }
    [Parameter] public bool EnableRtl { get; set; } = CultureInfo.CurrentCulture.Name == "ar-EG" ? true : false;
    [Parameter] public string ButtonText { get; set; } = "Add text...";
    [Parameter] public string HintMessage { get; set; }
    [Parameter] public List<UserDto> Assignees { get; set; } = new();
    private bool IsLoaded;
    private bool IsLoading;
    private SfRichTextEditor rte;
    private string[] DeniedTags = { "p", "div" };
    private string currentText = "";
    private List<ToolbarItemModel> Tools = new()
{
        new ToolbarItemModel() { Command = ToolbarCommand.OrderedList },
        new ToolbarItemModel() { Command = ToolbarCommand.UnorderedList },
        new ToolbarItemModel() { Command = ToolbarCommand.Underline },
        new ToolbarItemModel() { Command = ToolbarCommand.Italic },
        new ToolbarItemModel() { Command = ToolbarCommand.Bold },
        //new ToolbarItemModel() { Command = ToolbarCommand.BackgroundColor },
        //new ToolbarItemModel() { Command = ToolbarCommand.FontColor },
        new ToolbarItemModel() { Command = ToolbarCommand.StrikeThrough },
       // new ToolbarItemModel() { Command = ToolbarCommand.Image },
        new ToolbarItemModel() { Command = ToolbarCommand.CreateLink },
        new ToolbarItemModel() { Command = ToolbarCommand.Alignments },
        // new ToolbarItemModel() { Command = ToolbarCommand.FontSize },
        // new ToolbarItemModel() { Command = ToolbarCommand.FontName },
        // new ToolbarItemModel() { Command = ToolbarCommand.Indent },
        // new ToolbarItemModel() { Command = ToolbarCommand.Outdent },
        // new ToolbarItemModel() { Command = ToolbarCommand.Separator },
        // new ToolbarItemModel() { Command = ToolbarCommand.Formats },
        // new ToolbarItemModel() { Command = ToolbarCommand.SourceCode },
        // new ToolbarItemModel() { Command = ToolbarCommand.Separator },
        // new ToolbarItemModel() { Command = ToolbarCommand.SubScript},
        // new ToolbarItemModel() { Command = ToolbarCommand.SuperScript},
        // new ToolbarItemModel() { Command = ToolbarCommand.Undo },
        // new ToolbarItemModel() { Command = ToolbarCommand.Redo },

    };
    private List<LinkToolbarItemModel> Link = new List<LinkToolbarItemModel>()
    {
        new LinkToolbarItemModel() { Command = LinkToolbarCommand.Open },
        new LinkToolbarItemModel() { Command = LinkToolbarCommand.Edit },
        new LinkToolbarItemModel() { Command = LinkToolbarCommand.UnLink }
    };

    public async Task<string> GetValueAsync() => IsLoaded ? await rte.GetXhtmlAsync() : InternalContent;
    private string InternalContent
    {
        get => Content;
        set
        {
            if (Content != value)
            {
                Content = value;
                ContentChanged.InvokeAsync(value);
            }
        }
    }
    protected override void OnParametersSet()
    {
        if (!IsLoaded && !string.IsNullOrWhiteSpace(Content))
        {
            IsLoaded = true;
        }
    }
    async Task LoadEditor()
    {
        IsLoading = true;
        await InvokeAsync(StateHasChanged);
        await Task.Yield();
        IsLoaded = true;
        IsLoading = false;
        await InvokeAsync(StateHasChanged);
    }
    public string GetContent() => Content;
    private async Task OnValueChange(string args)
    {
        if (Content != args)
        {
            Content = args;
            await ContentChanged.InvokeAsync(args);
        }
        await InvokeAsync(StateHasChanged);
    }
    public async Task ResetAsync()
    {
        Content = string.Empty;
        await ContentChanged.InvokeAsync(Content);
        IsLoaded = false;
        await InvokeAsync(StateHasChanged);
    }
}