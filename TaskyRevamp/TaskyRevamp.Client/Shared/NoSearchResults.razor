@using Microsoft.AspNetCore.Components
@inject IStringLocalizer<SharedResources> Loc


<div class="card empty-page">
    <div class="card-body">
        <span class="vector">
            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.NoSearchReasult"></SVGCrud>
        </span>
        <div class="content mt-3">
            <h5 class="headline-5">@Loc[MessageTitle]</h5>
            <p class="small-medium-text">@Loc[MessageSubtitle]</p>
        </div>
        @if (ShowResetButton)
        {
            <div class="action-btn-list mt-3">
                <button class="btn btn-outline-primary" @onclick="OnResetClick">
                    <span class="icon">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Repeat"></SVGCrud>
                    </span>
                    @Loc[ButtonText]
                </button>
            </div>
        }
    </div>
</div>


@code {
    [Parameter] public string? MessageTitle { get; set; } = "NoResultsFound";
    [Parameter] public string? MessageSubtitle { get; set; } = "TryAjustingYourSearch";
    [Parameter] public bool ShowResetButton { get; set; } = true;
    [Parameter] public string? ButtonText { get; set; } = "ClearSearch";
    [Parameter] public EventCallback OnResetClick { get; set; }
}