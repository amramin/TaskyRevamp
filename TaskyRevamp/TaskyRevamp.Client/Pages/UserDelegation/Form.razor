@using Blazored.LocalStorage
@using Stingray.Components.MultiSelectComponent
@using Stingray.Components.MultiSelectComponent.Dtos
@using TaskyRevamp.Client.Consumer
@inject UserConsumer _userConsumer
@inject SendEmailConsumer _sendmailConsumer

@inject UserDelegationConsumer _userDelegationConsumer
@inject ILocalStorageService LocalStorageService
@inject Microsoft.Extensions.Configuration.IConfiguration _configuration;
@inject NavigationManager uriHelper

@using System.Globalization
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.Email
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.GeneralDto
@using TaskyRevamp.Dto.UserDelegation

@inject IStringLocalizer<SharedResources> Loc
<EditForm Model="@userDelegation" IsStarted="@IsStarted" IsAdmine="@IsAdmine" OnInvalidSubmit="onivald" OnValidSubmit="Callback" FormName="Testmmfff">
    <DataAnnotationsValidator />

    <div class="offcanvas-body">
        <div class="mb-3">

            <label class="form-label" for="body">
                @Loc["FromUser"]
                <span class="text-danger"> *</span>
            </label>
            <SearchableSingleDropdown IsDisabled="!IsAdmine||IsStarted" TInput=DdlDto TOutput=Guid
                                      TextSelector="x=> x.Name"
                                      OutputSelector="x => x.Id"
                                      
                                      SearchDataConsumer="DataProvider"
                                      LoadSelectedDataConsumer="SelectedDataProvider"
                                      @bind-SelectedOption=@userDelegation.FromUserId
                                      PlaceHolder="@($"--{Loc["FromUser"]}--")" />
     
                                  
                                  
                                  </div>
        <ValidationMessage class="small text-danger" For="@(() => userDelegation.FromUserId)" />
        @if (IsFromUser)
        {
            <label class="small text-danger"> @Loc["Required"]</label>

        }
        <div class="mb-3">

            <label class="form-label" for="body">
                @Loc["ToUser"]
                <span class="text-danger"> *</span>
            </label>

            <SearchableSingleDropdown TInput=DdlDto IsDisabled="IsStarted" TOutput=Guid TextSelector="x=> x.Name"
                                      OutputSelector="x=> x.Id"
                                      SearchDataConsumer="DataProvider"
                                      LoadSelectedDataConsumer="SelectedDataProvider"
                                      @bind-SelectedOption=@userDelegation.ToUserId
                                      PlaceHolder="@($"--{Loc["ToUser"]}--")" />
        </div>
        <ValidationMessage class="small text-danger" For="@(() => userDelegation.ToUser)" />
        @if (IsToUser)
        {
            <label class="small text-danger"> @Loc["Required"]</label>

        }
        <div class="mb-3">
            <label class="form-label" for="fromDate">@Loc["FromDate"]
                <span class="text-danger"> *</span>
            </label>

            <div class="date-group">
                <InputDate class="form-control" disabled="@IsStarted" id="fromDate" @bind-Value="userDelegation.FromDate" />
            </div>
            <ValidationMessage class="small text-danger" For="@(() => userDelegation.FromDate)" />
        </div>
        <div class="mb-3">
            <label class="form-label" for="toDate">@Loc["ToDate"]<span class="text-danger"> *</span></label>
            <div class="date-group">
                <InputDate class="form-control" id="toDate" @bind-Value="userDelegation.ToDate" />
            </div>
            <ValidationMessage class="small text-danger" For="@(() => userDelegation.ToDate)" />
       
            </div>

            
        <div class="mb-3">

            <label class="form-label" for="body">
                @Loc["DelegationOptions"]
                <span class="text-danger"> *</span>
            </label>
            <SearchableSingleDropdownOffline 
                TInput=DelegationOptions 
                TOutput="DelegationOptions"
                Datasource=all
                TextSelector=@(x=>x.GetDescription())
                OutputSelector="x=> x"
                MinCharacterCount="1"
                @bind-SelectedOption=userDelegation.DelegationOption
                PlaceHolder="@($"--{Loc["DelegationOption"]}--")" />


           


        </div>
        @if (userDelegation.DelegationOption == DelegationOptions.UserTasks)
{
            <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">

            <div class="text-content">
                <div class="text-content">
                    <p class="small-medium-text hint"> @Loc["Onlythetasksthattheuser"]</p>
                </div>
            </div>
            </div>

        }
        @if (userDelegation.DelegationOption == DelegationOptions.Privilegesandusertasks)
{
            <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">

            <div class="text-content">
                <div class="text-content">
                    <p class="small-medium-text hint"> @Loc["Alluserprivileges"]</p>
                </div>
            </div>
            </div>

        }
        <ValidationMessage class="small text-danger" For="@(() => userDelegation.DelegationOption)" />
        @if (IsDelegated)
        {
            <label class="small text-danger"> @Loc["Required"]</label>

        }
            

    </div>


    <div class="offcanvas-footer">
        <div class="row g-3">
            <div class="col-6">
                <div class="d-grid">

                    <button class="btn btn-lg btn-light" type="button" data-bs-dismiss="offcanvas">@Loc["Cancel"]</button>

                </div>
            </div>
            <div class="col-6">
                <div class="d-grid">
                    <button class="btn btn-lg btn-primary" type="button" onclick="@Save">@Loc["Save"]</button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {



    [Parameter] public UserDelegationDto userDelegation { get; set; }
    [Parameter] public EventCallback OnValidSubmit { get; set; }
    [Parameter] public string ButtonText { get; set; }
    [Parameter]
    public bool IsAdmine { set; get; }
    [Parameter]
    public bool IsStarted { set; get; }
    List<UserDto> Fromusers = new List<UserDto>();
    List<UserDto> Tousers = new List<UserDto>();
    bool IsDelegated;
    bool IsFromUser;
    bool IsToUser;
    private string applicationURL;
    List<DelegationOptions> all = EnumExtensions.GetOrderedValues<DelegationOptions>();

    private async Task Save()
    {
        IsFromUser = false;
        IsToUser = false;

      
        if (userDelegation.ToUserId == Guid.Empty || userDelegation.FromUserId == Guid.Empty || userDelegation.DelegationOption==null)

        {
            if (userDelegation.ToUserId == Guid.Empty)
                IsToUser = true;
            if (userDelegation.FromUserId == Guid.Empty)
                IsFromUser = true;
            if (userDelegation.DelegationOption == null)
                IsDelegated = true;
            return;

        }
        if (!IsAdmine)
        {
            var current = await LocalStorageService.GetItemAsStringAsync("Id");
            userDelegation.FromUserId = Guid.Parse(current);
        }
        await SendMail();
        await OnValidSubmit.InvokeAsync();

    }
    private async Task Cancel()
    {
        userDelegation = new UserDelegationDto();
        uriHelper.NavigateTo("UserDelegations/", true);

        StateHasChanged();
    }
    protected override async Task OnInitializedAsync()
    {
        await GetUsersList();
        applicationURL = _configuration["ApplicationURL"];
    }
    public async Task GetUsersList()
    {
        var users = await _userConsumer.GetUsers();
        Fromusers = users.Data;
        Tousers = users.Data;
    }

    private async Task<SearchableDropDownDto<DdlDto>> DataProvider(string searchValue, int pageSize, int offset)
    {
        var ret = await _userConsumer.GetUsersBySearchValue(searchValue, pageSize, offset);
        if (ret.Success)
        {
            return ret.Data;
        }
        throw new Exception(ret.ErrorMessage);
    }

    private async Task<DdlDto> SelectedDataProvider(Guid id)
    {
        var ret = await _userConsumer.GetSelectedUserDdlById(id);
        if (ret.Success)
        {
            return ret.Data;
        }
        throw new Exception(ret.ErrorMessage);
    }


    

    private async Task onivald(EditContext obj)
    {
        var xx = userDelegation.ToUserId;
    }
    private async Task Callback(EditContext obj)
    {
        await OnValidSubmit.InvokeAsync();

    }
    SendEmailDto sendEamilDto = new SendEmailDto();
    string fromUserMail;
    string toUserMail;

    public async Task SendMail()
    {

        toUserMail = Fromusers.Where(K => K.Id == userDelegation.FromUserId).First().DisplayedName;
        fromUserMail = Fromusers.Where(K => K.Id == userDelegation.ToUserId).First().DisplayedName;
        var sentmail = Fromusers.Where(K => K.Id == userDelegation.ToUserId).First().Email;
        var frmdate = userDelegation.FromDate.ToString("dd MMMM yyyy", CultureInfo.InvariantCulture);
        var todat = userDelegation.ToDate.ToString("dd MMMM yyyy", CultureInfo.InvariantCulture);
        sendEamilDto.EmailSubject = "تفويض مهام";
        sendEamilDto.EmailToId = sentmail;
        sendEamilDto.EmailToName = sentmail;
        string html = $@"
                <!DOCTYPE html>
                <html lang=""en"">
                <head>
                <meta charset=""utf-8"" />
                <meta name=""viewport"" content=""width=device-width, initial-scale=1"" />
                <title>Delegate</title>
                </head>
                <body style=""font-family: 'Almarai', sans-serif; margin: 0; padding: 0"">
                <div
                style=""width: 100%; max-width: 800px; margin: 0 auto; padding: 1.5rem 2rem; box-sizing: border-box;""
                >
                <!-- Header Section -->
                <table
                width=""100%""
                cellspacing=""0""
                cellpadding=""0""
                style=""width: 100%; border-spacing: 0""
                >
                <tr>
                <td style=""width: 50%; text-align: start"">
                <img src=""{applicationURL}images/MOH-Logo.png"" alt=""MOH LOGO"" style=""height: 64px"" />
                </td>
                <td style=""width: 50%; text-align: end"">
                <img src=""{applicationURL}images/samim-logo.png"" alt=""Samim LOGO"" style=""height: 64px"" />
                </td>
                </tr>
                </table>

                <!-- Main Content Section -->
                <div
                style=""border-top: 6px solid #449f95; border-bottom: 6px solid #449f95; padding: 2rem 0;""
                >
                <!-- English Article -->
                <div style=""width: 100%; margin-bottom: 2rem"">
                <p>Dear <strong>{fromUserMail}</strong></p>
                <p>
                You have been authorized to carry out the tasks of
                <strong>{toUserMail}</strong>
                </p>
                <p>From <strong>{frmdate}</strong> To <strong>{todat}</strong></p>
                <p>We trust in your ability to complete the tasks efficiently.</p>
                <p>
                <span>For any inquiries, please contact us via email at:</span>
                <br /><br />
                <span style=""color: blue; text-decoration: underline;"">Sameem-Team@moh.gov.sa</span>
                </p>
                <h5>Best Regards,</h5>
                <p>Deputyship of e-Health and Digital Transformation</p>
                </div>

                <!-- Arabic Article -->
                <div
                style=""width: 100%; border-top: 1px solid #cecece; direction: rtl; text-align: start;""
                >
                <p>عزيزي/عزيزتي <strong>{fromUserMail}</strong></p>
                <p>تم تفويضك بمهام الزميل/ة <strong>{toUserMail}</strong></p>
                <p>من <strong>{frmdate}</strong> حتى <strong>{todat}</strong></p>
                <p>نثق بقدرتك على إتمام المهام بكفاءة</p>
                <p>
                <span>لأي استفسار، تواصل معنا عبر البريد الإلكتروني:</span>
                <br /><br />
                <span style=""color: blue; text-decoration: underline;"">Sameem-Team@moh.gov.sa</span>
                </p>
                <h5>مع التحية،</h5>
                <p>وكالة الوزارة للصحة الإلكترونية والتحول الرقمي</p>
                </div>
                </div>
                </div>
                </body>
                </html>";

        sendEamilDto.EmailBody = html.ToString();
        await _sendmailConsumer.SendEmail(sendEamilDto);


    }


}