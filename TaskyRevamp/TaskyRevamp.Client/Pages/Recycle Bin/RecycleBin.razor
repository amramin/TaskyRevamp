@page "/recycle-bin"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.Task.Components
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.Enums.SearchFields
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.TaskDto
@inject IStringLocalizer<SharedResources> Loc
@inject TaskConsumer _taskConsumer
@inject RecycleBinSettingConsumer _recycleBinSettingConsumer
@inject ToastService ToastService
@inject PopupService PopupService
@inject NavigationManager navigationManager

@if (allDeletedTasks != null && allDeletedTasks.Any())
{
    @if (retentionDays.HasValue)
    {
        <div class="alert alert-warning mt-4 mb-2 ms-3 me-3">
            @Loc["RecycleBinRetentionMessage", retentionDays.Value]
        </div>
    }
    @if (selectedTasks.Any())
    {
        <div class="d-flex align-items-center justify-content-between border rounded px-3 py-2 mb-2 ms-3 me-3 bg-light">
            <div class="d-flex align-items-center gap-3">
                <input type="checkbox" class="form-check-input" title="@Loc["SelectAll"]" checked="@selectAll" @onchange="ToggleSelectAll" />
                <span class="fw-semibold"> @selectedTasks.Count @Loc["Selected"] </span>
            </div>
            <button class="btn btn-danger btn-sm" @onclick="ConfirmBulkDelete">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud> @Loc["RemoveSelectedItems"]
                </span>
            </button>
        </div>
    }
    <div class="page-body">
        <div class="table-responsive sticky-header-custom">
            <SortableTable TItem="CreateTaskDto" Columns="@Columns.Where(p => p.IsVisible).OrderBy(k => k.Order).ToList()" Items="@allDeletedTasks"
                           SortColumn="@currentSortColumn" SortAscending="@sortAscending" OnSortRequested="HandleSort">
                <RowTemplate>
                    @foreach (var task in allDeletedTasks)
                    {
                        <tr class="@(selectedTasks.Contains(task.Id) ? "table-active" : "")">
                            <td>
                                <input type="checkbox" class="form-check-input" title="@Loc["Select"]" disabled="@(!CanDelete(task))"
                                       checked="@selectedTasks.Contains(task.Id)" @onchange="(e => ToggleTask(task.Id, (bool)e.Value!))" />
                            </td>
                            <td> <span style="cursor:pointer; color:black" @onclick="() => ViewTaskDetails(task.Id)">@task.Title</span> </td>
                            <td>@task.DeletedByName</td>
                            <td>@task.DeletionDate?.ToLocalTime().ToString(Loc["LocalizeDate"])</td>
                            <td>@task.StartDate?.ToLocalTime().ToString(Loc["LocalizeDate"])</td>
                            <td>@task.EndDate?.ToLocalTime().ToString(Loc["LocalizeDate"])</td>
                            <td>@task.PriorityName</td>
                            <td>
                                <div class="dropdown actions">
                                    <button class="btn btn-action-24" type="button" data-bs-toggle="dropdown"
                                            aria-expanded="false">
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EllipseVertical"></SVGCrud>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <button class="dropdown-item" @onclick="@(() => ShowRestorePopup(task.Id))">
                                                <span class="icon">
                                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Repeat"></SVGCrud>
                                                </span>
                                                @Loc["Restore"]
                                            </button>
                                        </li>
                                        <li>
                                            <button class="dropdown-item text-danger" @onclick="@(() => ConfirmDelete(task.Id))">
                                                <span class="icon">
                                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                                                </span>
                                                @Loc["Delete"]
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </RowTemplate>
            </SortableTable>
        </div>
        <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                    PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
    </div>
}
else
{
    <NoDataAvailable MessageTitle="@Loc["Empty Recycle Bin"]"></NoDataAvailable>
}
<RestoreTaskPopup Show="@showRestorePopup" ShowChanged="@(v => showRestorePopup = v)" TaskId="@restoreTaskId" OnRestored="GetDeletedTasks" />

@code {
    private List<SortableColumn> Columns = new();
    private List<CreateTaskDto> allDeletedTasks = new List<CreateTaskDto>();
    private RecycleBinSettingDto RecycleBinSetting = new RecycleBinSettingDto();
    private string currentSortColumn = "";
    private bool? sortAscending = true;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private Search? searchComponent;
    private string? lastSearchTerm = null;
    private long? retentionDays;
    private bool showRestorePopup;
    private Guid restoreTaskId;
    private HashSet<Guid> selectedTasks = new();
    private bool selectAll = false;
    public List<SearchFieldDeletedTask> searchFields = new List<SearchFieldDeletedTask>() {
            SearchFieldDeletedTask.Title,
            SearchFieldDeletedTask.StartDate,
            SearchFieldDeletedTask.EndDate,
            SearchFieldDeletedTask.DeletionDate,
            SearchFieldDeletedTask.DeletedBy,
            SearchFieldDeletedTask.Priority
    };

    protected override async Task OnInitializedAsync()
    {
        Columns = new List<SortableColumn>
        {
            new SortableColumn { DisplayName = "", Field = "Select", IsVisible = true, IsSortable = false, Order = -1 },
            new SortableColumn { DisplayName = Loc["Title"], Field = "Title", IsVisible = true, Order = 0 },
            new SortableColumn { DisplayName = Loc["StartDate"], Field = "Start Date", IsVisible = true, Order = 3 },
            new SortableColumn { DisplayName = Loc["EndDate"], Field = "End Date", IsVisible = true, Order = 4 },
            new SortableColumn { DisplayName = Loc["DeletionDate"], Field = "Deletion Date", IsVisible = true, Order = 2 },
            new SortableColumn { DisplayName = Loc["DeletedBy"], Field = "Deleted By", IsVisible = true, Order = 1 },
            new SortableColumn { DisplayName = Loc["Priority2"], Field = "Priority", IsVisible = true, Order = 5 },
            new SortableColumn { DisplayName = Loc["Action"], Field = "Action", IsVisible = true, IsSortable = false, Order = 6 }
        };
        await GetDeletedTasks();
        var res = await _recycleBinSettingConsumer.GetRecycleBinSetting();
        if (res.Success && res.Data != null)
        {
            RecycleBinSetting = res.Data;
        }
        retentionDays = GetRetentionDays();
    }
    private void ViewTaskDetails(Guid id) => navigationManager.NavigateTo($"/task/details/{id}/details");
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await GetDeletedTasks();
    }
    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await GetDeletedTasks();
    }
    private async Task GetDeletedTasks()
    {
        var res = await _taskConsumer.GetDeletedTasks(currentPage, pageSize, currentSortColumn, sortAscending!.Value, searchFields);
        if (res.Success && res.Data != null && res.Data.Items != null)
        {
            allDeletedTasks = res.Data.Items.ToList();
            totalPages = res.Data.TotalPages;
            totalCount = res.Data.TotalCount;
        }
        StateHasChanged();
    }
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;
        if (sortAscending == null)
        {
            currentSortColumn = "";
            sortAscending = true;
        }
        await GetDeletedTasks();
    }
    private long? GetRetentionDays()
    {
        if (RecycleBinSetting == null)
            return null;

        if (RecycleBinSetting.PeriodType == PeriodType.Never)
            return null;

        if (RecycleBinSetting.PeriodType == PeriodType.Custom)
            return RecycleBinSetting.CustomDays;

        return (long)RecycleBinSetting.PeriodType;
    }
    private async Task ConfirmDelete(Guid taskId)
    {
        PopupService.ShowConfirmation(@Loc["TaskSure"], @Loc["Confirm"],
                async (confirmed) =>
                {
                    if (confirmed)
                        await DeleteTask(taskId);
                }, ConfirmationType.Danger);
    }
    private async Task DeleteTask(Guid taskId)
    {
        var res = await _taskConsumer.DeleteTask(taskId);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["Deletedsuccessfully"], "success");
            await GetDeletedTasks();
        }
    }
    private void ShowRestorePopup(Guid taskId)
    {
        restoreTaskId = taskId;
        showRestorePopup = true;
    }
    private void ToggleTask(Guid taskId, bool isChecked)
    {
        if (isChecked)
            selectedTasks.Add(taskId);
        else
            selectedTasks.Remove(taskId);
        selectAll = selectedTasks.Count == allDeletedTasks.Count(t => CanDelete(t));
    }
    private void ToggleSelectAll(ChangeEventArgs e)
    {
        selectAll = (bool)e.Value!;
        selectedTasks.Clear();
        if (selectAll)
        {
            foreach (var task in allDeletedTasks)
            {
                if (CanDelete(task))
                    selectedTasks.Add(task.Id);
            }
        }
    }
    private async Task ConfirmBulkDelete()
    {
        PopupService.ShowConfirmation(selectedTasks.Count() > 1 ? Loc["TasksSure"] : Loc["TaskSure"], Loc["Confirm"],
            async (confirmed) =>
            {
                if (confirmed)
                    await BulkDelete();
            },
            ConfirmationType.Danger);
    }
    private async Task BulkDelete()
    {
        var res = await _taskConsumer.DeleteTasks(selectedTasks.ToList());
        if (res.Success && res.Data)
        {
            selectedTasks.Clear();
            selectAll = false;
            await ToastService.ShowToastAsync(Loc["DeletedSuccessfully"], "success");
            await GetDeletedTasks();
        }
    }
    private bool CanDelete(CreateTaskDto task)
    {
        return true;
    }
}

