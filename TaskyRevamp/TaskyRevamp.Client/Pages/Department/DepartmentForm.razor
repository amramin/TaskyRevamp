@using Stingray.Components.MultiSelectComponent
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.SystemConfiguration
@inject DepartmentConsumer _departmentConsumer

@inject IStringLocalizer<SharedResources> Loc

<EditForm EditContext="@editContext" OnSubmit="@OnSubmitHandler">
    <DataAnnotationsValidator />
    <div class="offcanvas-body">
        <div class="mb-3">
            <label class="form-label">
                @Loc["EnglishName"]
                <span class="text-danger"> *</span>

            </label>
            <InputText class="form-control" @bind-Value="department.NameEnglish" placeholder="@Loc["NameEnglish"]" />
            <ValidationMessage class="small text-danger" For="@(() => department.NameEnglish)"></ValidationMessage>
        </div>

        <div class="mb-3">
            <label class="form-label">
                @Loc["ArabicName"]
                <span class="text-danger"> *</span>

            </label>
            <InputText class="form-control" @bind-Value="department.NameArabic" placeholder="@Loc["NameArabic"]" />
            <ValidationMessage class="small text-danger" For="@(() => department.NameArabic)"></ValidationMessage>
        </div>

        @if (allDepartments != null && allDepartments.Count() > 0 && !isFrist)
        {
            <label class="form-label">@Loc["SelectParent"]
                <span class="text-danger"> *</span>
            </label>
            <div class="filter-single">
                <SearchableSingleDropdownOffline TInput=DepartmentDto TOutput=Guid TextSelector="(DepartmentDto x) => x.Name"
                    OutputSelector="x => x.Id" Datasource="allDepartments" MinCharacterCount="1"
                    @bind-SelectedOption="@department.ParentdepartmentId" PlaceHolder="@($"{Loc["Select"]}")" />

                @if (ParentdepartmentRequired)
                {
                    <div>
                        <label class="small text-danger"> @Loc["Required"]</label>
                    </div>
                }
            </div>

        }

    </div>
    <div class="offcanvas-footer">
        <div class="row g-2">
            <div class="col-6">
                <div class="d-grid">
                    <button type="button" class="btn btn-lg btn-light" @onclick="OnCancelClick">@Loc["Cancel"]</button>
                </div>
            </div>
            <div class="col-6">
                <div class="d-grid">
                    <button type="submit" class="btn btn-lg btn-primary">@SubmitButtonText</button>
                </div>
            </div>
        </div>

    </div>

</EditForm>


@code {

    [Parameter] public DepartmentDto department { get; set; } = new DepartmentDto();
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string SubmitButtonText { get; set; }
    public List<DepartmentDto> allDepartments = new List<DepartmentDto>();
    private EditContext editContext;
    private ValidationMessageStore messageStore;

    public async Task savedep(Guid id, Guid parnt)
    {
        department.ParentdepartmentId = id;
        await InvokeAsync(StateHasChanged);
    }
    bool isFrist;
    protected override async Task OnParametersSetAsync()

    {
        if (editContext == null || editContext.Model != department)
        {
            editContext = new EditContext(department);
            messageStore = new ValidationMessageStore(editContext);
        }
        var departs = await _departmentConsumer.GetDepartmentsForDDL();
        allDepartments = departs.Data.ToList();
        if (department.Id != Guid.Empty && department.ParentdepartmentId == Guid.Empty)
        {
            isFrist = true;
        }
        StateHasChanged();
    }

    bool ParentdepartmentRequired;
    private async Task OnSubmitHandler(EditContext context)
    {
        ParentdepartmentRequired = false;
        ClearValidationMessages();
        if (!editContext.Validate())
            return; // client-side validation failed → stop

        if (allDepartments.Count() > 0 && department.ParentdepartmentId == Guid.Empty && !isFrist)
        {
            ParentdepartmentRequired = true;
            return;
        }
        if (allDepartments.Count() == 0)
        {
            department.ParentdepartmentId = Guid.Empty;
        }
        await OnValidSubmit.InvokeAsync(context);
    }

    private async Task OnCancelClick()
    {
        await OnCancel.InvokeAsync();
    }

    public void AddErrorsToEditContext(IReadOnlyDictionary<string, List<string>> errors)
    {
        messageStore.Clear();
        foreach (var error in errors)
        {
            var property = typeof(DepartmentDto).GetProperty(error.Key);
            if (property != null)
            {
                var fieldIdentifier = new FieldIdentifier(department, property.Name);

                foreach (var errorMessage in error.Value)
                {
                    messageStore.Add(fieldIdentifier, errorMessage);
                }
            }
        }
        editContext.NotifyValidationStateChanged();
        InvokeAsync(StateHasChanged);
    }

    public void ClearValidationMessages()
    {
        messageStore.Clear();
        editContext.NotifyValidationStateChanged();
    }
}