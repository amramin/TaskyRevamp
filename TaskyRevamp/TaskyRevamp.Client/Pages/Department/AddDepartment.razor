@page "/Add-Department/{ParentId:guid?}"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject DepartmentConsumer _departmentConsumer
@inject ToastService ToastService


       <DepartmentForm
           @ref="form"
           OnCancel="Cancel" 
           OnValidSubmit="@Save"
           Department="_newDepartment" 
           SubmitButtonText= "@Loc["Save"]" />


@code {
    [Parameter] public Guid? ParentId { set; get; } = new Guid(); 
    [Parameter] public EventCallback OnSaved { get; set; }
    private DepartmentDto _newDepartment = new DepartmentDto();
    public List<DepartmentDto> departmentDtos = new List<DepartmentDto>();
    [Parameter] public EventCallback<DepartmentDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private DepartmentForm form;

    protected async override Task OnInitializedAsync()
    {

        var res = await _departmentConsumer.GetDepartmentsForDDL();
        if (ParentId != null || ParentId != Guid.Empty)
        {
            _newDepartment.ParentdepartmentId = ParentId.Value;
        }
    }

    private async Task Save(EditContext editContext)
    {

        var res = await _departmentConsumer.AddDepartment(_newDepartment);
        if (res.Success)
        {
            await OnValidSubmit.InvokeAsync(_newDepartment);
            await ToastService.ShowToastAsync(Loc["Addedsuccessfully"], "success");
            await OnSaved.InvokeAsync();
        }
        else
        {
            if (res.Errors != null && res.Errors.Count > 0)
                form.AddErrorsToEditContext(res.Errors);
        }
    }
    private async Task Cancel()
    {
        navigationManager.NavigateTo("/Departments");
    }
}
