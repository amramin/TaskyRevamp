@page "/Update-Department/{Id:guid}"

@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.SystemConfiguration
@using Newtonsoft.Json.Linq;
@using Newtonsoft.Json;
@inject ILocalStorageService LocalStorageService
@inject PopupService PopupService


@inject IStringLocalizer<SharedResources> Loc
@inject DepartmentConsumer _DepartmentConsumer
@inject ToastService ToastService
@inject NavigationManager navigationManager


<DepartmentForm @ref="form"
                Department="@department"
                OnValidSubmit="@Save"
                SubmitButtonText="@Loc["Update"]"
                OnCancel="@Cancel" />


@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback<DepartmentDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private DepartmentDto department = new DepartmentDto();
    private DepartmentForm form;

    protected override async Task OnInitializedAsync()
    {

        var res = await _DepartmentConsumer.GetDepartmentById(Id);
        // if(res.Success && res != null && res.Data != null)
        // {
        department = res.Data;
        //}
        StateHasChanged();
    }

    private async Task Save(EditContext editContext)
    {
        var current = await LocalStorageService.GetItemAsStringAsync("Id");
        department.UpdatedBy = Guid.Parse(current);
        var res = await _DepartmentConsumer.UpdateDepartment(department);
        if (res.Errors != null && res.Errors.Count > 0){
            form.AddErrorsToEditContext(res.Errors);
            return;
        }
        else
        {
            await OnValidSubmit.InvokeAsync(department);
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
            await OnSaved.InvokeAsync();
            PopupService.Hide();
        }
    }


    private async Task Cancel()
    {
        //await OnCancel.InvokeAsync();
        PopupService.Hide();
    }
}
