@using TaskyRevamp.Dto.Department
@inject IStringLocalizer<SharedResources> Loc
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.Department.Components
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Enums.SearchFields
@using TaskyRevamp.Dto.SystemConfiguration
@inject DepartmentConsumer _departmentConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService

<div class="table-responsive sticky-header-custom">

    <SortableTable TItem="DepartmentDto"
                   Columns="@tableColumns"
                   Items="@Departments"
                   SortColumn="@currentSortColumn"
                   SortAscending="@sortAscending"
                   OnSortRequested="HandleSort">

        <RowTemplate>


            @foreach (var p in Departments)
            {
                <tr>
                    <td>@p.NameEnglish</td>
                    <td>@p.NameArabic</td>
                    <td>@p.ParentdepartmentName</td>
                    <td>@p.CreatedByName</td>
                    <td>@p.CreateDate?.ToString("yyyy-MM-dd")</td>
                    <td>@p.UpdatedByName</td>
                    <td>@p.UpdateDate?.ToString("yyyy-MM-dd")</td>

                    <td class="sticky-end-action">
                        <div class="dropdown actions">
                            <button class="btn btn-action-24" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EllipseVertical"></SVGCrud>
                            </button>
                            <ul class="dropdown-menu">

                                <li>
                                    <button class="dropdown-item" @onclick="@(() => OnShowUsers.InvokeAsync(p.Id))">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Users"></SVGCrud>
                                        </span>
                                        @Loc["ViewUsers"]
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="@(() => OnAdd.InvokeAsync(p.Id))">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.AddColumn"></SVGCrud>
                                        </span>
                                        @Loc["AddDepartment"]
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item" @onclick="@(() => OnEdit.InvokeAsync(p.Id))">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                        </span>
                                        @Loc["Edit"]
                                    </button>
                                </li>
                                <li>
                                    <button class="dropdown-item text-danger" @onclick="@(() => OnDelete.InvokeAsync(p.Id))">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                                        </span>
                                        @Loc["Delete"]
                                    </button>
                                </li>
                            </ul>

                        </div>
                    </td>
                </tr>
            }



        </RowTemplate>
    </SortableTable>


</div>

<Pagination CurrentPage="@CurrentPage"
            TotalPages="@TotalPages"
            TotalCount="@TotalCount"
            PageSize="@PageSize"
            PageChanged="PageChanged"
            PageSizeChangedCallback="PageSizeChanged" />

@code {
    [Parameter] public List<DepartmentDto> Departments { get; set; } = new();
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnShowUsers { get; set; }
    [Parameter] public EventCallback<Guid> OnAdd { get; set; }
    [Parameter] public EventCallback<Guid> OnAddDepartment { get; set; }

    [Parameter] public int CurrentPage { get; set; }
    [Parameter] public int TotalPages { get; set; }
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int PageSize { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public EventCallback<int> PageSizeChanged { get; set; }

    private string currentSortColumn = "CreateDate";
    private bool? sortAscending = true;
    private List<SortableColumn> tableColumns = new();
    private void HandleDepartmentSelection(Guid departmentId) 
    {
        OnAddDepartment.InvokeAsync(departmentId);
    }
    private async Task DeleteConfirmed(Guid departmentId)
    {
        var result = await _departmentConsumer.DeleteDepartment(departmentId);
        if (result.Success)
        {
            var toRemove = Departments.FirstOrDefault(d => d.Id == departmentId);
            if (toRemove != null)
            {
                Departments.Remove(toRemove);
            }

            await ToastService.ShowToastAsync(Loc["Deletedsuccessfully"], "success");

        }
        else
        {
            await ToastService.ShowToastAsync(Loc["DeleteFailed"], "danger");
        }

        StateHasChanged();
    }
    private void OnDeleteDepartment(Guid departmentId)
    {
        PopupService.ShowConfirmation(
            @Loc["SureDeleteDepartment"],
            "Yes, Delete",
            async (confirmed) =>
            {
                if (confirmed)
                    await DeleteConfirmed(departmentId);
            },
            ConfirmationType.Danger
        );
    }
    private void EditDepartment(Guid id)
    {
        PopupService.ShowNew(@<DepartmentForm Id="id" OnValidSubmit="OnInitializedAsync"></DepartmentForm>, headerText: @Loc["EditDepartment"]);
    }
    private void ShowUser(Guid id) => navigationManager.NavigateTo($"/UsersDepartment/{id}");


    protected override async Task OnInitializedAsync()
    {
        tableColumns = new()
        {
            new() { Field = "NameEnglish", DisplayName = Loc["NameEnglish"] },
            new() { Field = "NameArabic", DisplayName = Loc["NameArabic"] },
            new() { Field = "DepartmentParent", DisplayName = Loc["ParentdepartmentName"] },
            new() { Field = "CreatedBy", DisplayName = Loc["CreatedBy"] },

            new() { Field = "CreateDate", DisplayName = Loc["CreationDate"] },
            new() { Field = "UpdatedBy", DisplayName = Loc["UpdatedBy"] },

            new() { Field = "UpdateDate", DisplayName = Loc["UpdateDate"] },
            new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
        };
        StateHasChanged();
    }

    public List<SearchFieldDepartment> searchFields = new List<SearchFieldDepartment>() {
    SearchFieldDepartment.NameEnglish,
    SearchFieldDepartment.NameArabic,
    SearchFieldDepartment.CreatedBy,
    SearchFieldDepartment.UpdatedBy,
    SearchFieldDepartment.CreateDate,
    SearchFieldDepartment.UpdateDate,
    SearchFieldDepartment.ParentNameAR,
    SearchFieldDepartment.ParentNameEN
    };

    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;


        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = "CreateDate"; // or whatever your default column is
            sortAscending = true;
        }

    }
}
