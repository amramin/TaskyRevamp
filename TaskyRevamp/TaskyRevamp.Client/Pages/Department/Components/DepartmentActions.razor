@using TaskyRevamp.Dto.Department 
@using TaskyRevamp.Client.Services
@inject IStringLocalizer<SharedResources> Loc
@inject PopupService PopupService

<div class="dropdown actions">
    <button class="btn btn-action-24" type="button" data-bs-toggle="dropdown" aria-expanded="false">
        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EllipseVertical"></SVGCrud>
    </button>

    <ul class="dropdown-menu">
        <li>
            <button class="dropdown-item" @onclick="@(() => OnAdd.InvokeAsync(Department.Id))">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.AddColumn"></SVGCrud>
                </span>
                @Loc["AddDepartment"]
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="@(() => Edit.InvokeAsync(Department.Id))">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                </span>
                @Loc["Edit"]
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="@(() => ShowUsers.InvokeAsync(Department.Id))">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Users"></SVGCrud>
                </span>
                @Loc["ViewUsers"]
            </button>
        </li>
        <li>
            <button class="dropdown-item" @onclick="@(() => LinkUser(Department.Id))">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.User"></SVGCrud>
                </span>
                @Loc["linkUsers"]
            </button>
        </li>
        <li>
            @if (Department.Level > 1 && Department.ParentdepartmentId != Guid.Empty)
            {
                <button class="dropdown-item text-danger" @onclick="@(() => Delete.InvokeAsync(Department.Id))">
                    <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                </span>
                @Loc["Delete"]
            </button>
            }
        </li>
    </ul>
</div>

@code {
    [Parameter] public DepartmentDto Department { get; set; }
    [Parameter] public EventCallback<Guid> ShowUsers { get; set; }
    [Parameter] public EventCallback<Guid> Edit { get; set; }
    [Parameter] public EventCallback<Guid> Delete { get; set; }
    [Parameter] public EventCallback<Guid> OnAdd { get; set; }


    private void LinkUser(Guid departmentId)
    {
        PopupService.ShowNew(@<LinkUserDepartment Id="departmentId" OnSaved="ReloadAfterSave"></LinkUserDepartment>,Loc["LinkUser"]);
    }

    private async Task ReloadAfterSave()
    {
        PopupService.Hide();
        StateHasChanged();
    }
}
