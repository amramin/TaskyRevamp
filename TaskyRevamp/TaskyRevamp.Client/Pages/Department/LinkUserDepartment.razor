@page "/LinkDepartmentUser/{Id:guid}"

@using Stingray.Components.MultiSelectComponent
@using System.Globalization
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.Department
@inject UserConsumer  _userConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService

<div class="offcanvas-body">
    <div class="mb-3">
        <label class="form-label">
            @Loc["users"]
            <span class="text-danger">*</span>
        </label>
        <SearchableMultiDropdownOffline TInput=UserDto TOutput="Guid" Datasource=availableUsers
                    TextSelector=@(x=>x.DisplayedName) OutputSelector="x=> x.Id" @bind-SelectedOptions=UsrIds SearchInputPlaceHolder="@Loc["Search"]" PlaceHolder="@($"{Loc["Select"]}")"
                                        NoMatchPlaceHolder="@Loc["NoResultsFound"]" SelectAllPlaceHolder="@Loc["SelectAll"]" MinCharacterCount="1" />
        @if (ShowValidationError)
        {
            <div class="text-danger mt-1">
                @Loc["Required"]
            </div>
        }
    </div>
</div>
<div class="offcanvas-footer">
    <div class="row g-2">
        <div class="col-6">
            <div class="d-grid">
                <button type="button" class="btn btn-lg btn-light" @onclick="OnCancelClick">@Loc["Cancel"]</button>
            </div>
        </div>
        <div class="col-6">
            <div class="d-grid">
                <button type="button" @onclick="SaveClick" class="btn btn-lg btn-primary">@Loc["Save"]</button>
            </div>
        </div>
    </div>

</div>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    public List<UserDto> availableUsers { get; set; } = new();
    private AssignedUserDto _assignedUserDto = new AssignedUserDto();
    public AssignedUserDto assignedUserDto
    {
        get => _assignedUserDto;
        set
        {
            _assignedUserDto = value;
            ShowValidationError = false;
        }
    }
    private List<Guid> UsrIds
    {
        get => assignedUserDto.UsrIds;
        set
        {
            assignedUserDto.UsrIds = value;
            ShowValidationError = false;
        }
    }
    private bool ShowValidationError;
    protected async override Task OnInitializedAsync()
    {
        assignedUserDto.DepartmentId = Id;
        var res = await _userConsumer.GetAllUNassignedUsers();
        availableUsers = res.Data!.ToList();
        StateHasChanged();
    }
    private async Task SaveClick()
    {
        if(assignedUserDto.UsrIds == null || !assignedUserDto.UsrIds.Any())
        {
            ShowValidationError = true;
            return;
        }
        ShowValidationError = false;
        var res = await _userConsumer.CreateAssignedUser(assignedUserDto);
        if(res.Success)
        {
            await OnSaved.InvokeAsync();
            await ToastService.ShowToastAsync(Loc["Added successfully"], "success");
        }
    }
    private void OnCancelClick()
    {
        PopupService.Hide();
        assignedUserDto.UsrIds = new List<Guid>();
    }

}
