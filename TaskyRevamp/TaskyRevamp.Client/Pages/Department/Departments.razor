    private bool IsRowEmpty(ExcelWorksheet worksheet, int row)
    {
        for (int col = 1; col <= worksheet.Dimension.Columns; col++)
        {
            if (!string.IsNullOrWhiteSpace(worksheet.Cells[row, col].Text))
            {
                return false; // Row has at least one non-empty cell
            }
        }
        return true; // Row is completely empty
    }

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadDepartmentsAsync();
    }
    protected override async Task OnInitializedAsync()
    {

        tableColumns = new()
{
new() { Field = "DisplayedName", DisplayName = Loc["Name"] },
new() { Field = "Level", DisplayName = Loc["Level"] },
new() { Field = "DepartmentParent", DisplayName = Loc["DepartmentParent"] },
new() { Field = "CreateDate", DisplayName = Loc["CreationDate"] },
new() { Field = "CreatedBy", DisplayName = Loc["CreatedBy"] },
new() { Field = "UpdateDate", DisplayName = Loc["UpdateDate"] },
new() { Field = "UpdatedBy", DisplayName = Loc["UpdatedBy"] },
new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
};

        await LoadDepartmentsAsync();
        intialDepartmentDtos = departmentDtos;

        StateHasChanged();
    }
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadDepartmentsAsync();
    }
    private void Add()
    {
        PopupService.ShowNew(@<AddDepartment OnSaved="ReloadAfterSave"></AddDepartment>,Loc["AddDepartment"]);

    }
    private async Task ReloadAfterSave()
    {
        //currentPage = page;
        PopupService.Hide();
        await LoadDepartmentsAsync();
        StateHasChanged();
    }
    private async Task ClearSearch()
    {
        currentPage = 1;
        searchComponent.SearchTerm = "";

        await searchComponent?.SearchSubmit.InvokeAsync("");
        await LoadDepartmentsAsync(isSearch: false, null);

    }
    private void Edit(Guid id)
    {
        PopupService.ShowNew(@<UpdateDepartment Id="id" OnSaved="ReloadAfterSave"></UpdateDepartment>, headerText:
        @Loc["EditDepartment"]);

    }
    private void ShowUser(Guid id)
    {
        navigationManager.NavigateTo($"/UsersDepartment/{id}");

    }
    private void AddLinkUser(Guid Id)
    {
        PopupService.ShowNew(@<LinkUserDepartment Id="Id" OnSaved="ReloadAfterSave"></LinkUserDepartment>,Loc["Addusers"]);
        StateHasChanged();
    }
    private void AddDept(Guid id)
    {
        PopupService.ShowNew(@<AddDepartment ParentId="id" OnSaved="ReloadAfterSave"></AddDepartment>,Loc["AddDepartment"]);

    }
    private async Task ChangeView(DepartmentViewType view)
    {
        currentView = view;
        currentPage = 1;
        // if Tree or Hierarchy → fetch all departments at once
        if (currentView == DepartmentViewType.Tree || currentView == DepartmentViewType.Hierarchy)
        {
            currentPage = 1;
            pageSize = 10000;
        }
        else
        {
            pageSize = 10; // normal pagination for Grid
        }

        await LoadDepartmentsAsync(isSearch: !string.IsNullOrEmpty(searchdata), searchdata);
    }
    private async Task OnDeleteDepartment(Guid departmentId)
    {
        var res = await _departmentConsumer.CheckDeparmentHasUsers(departmentId);
        if (res.Success && res.Data)
        {
            await ToastService.ShowToastAsync(Loc["DepartmentHasUsersCannotDelete"], "error");
            return;
        }
        PopupService.ShowConfirmation(@Loc["SureDeleteDepartment"], @Loc["Confirm"],
        async (confirmed) =>
        {
            if (confirmed)
                await DeleteConfirmed(departmentId);
        }, ConfirmationType.Danger);
    }
    private async Task DeleteConfirmed(Guid departmentId)
    {
        var result = await _departmentConsumer.DeleteDepartment(departmentId);
        if (result.Success)
        {
            var toRemove = departmentDtos.FirstOrDefault(d => d.Id == departmentId);
            if (toRemove != null)
            {
                departmentDtos.Remove(toRemove);
                if (departmentDtos.Count() <= 0)
                {
                    currentPage -= 1;
                   await LoadDepartmentsAsync();
                }
            }

            await ToastService.ShowToastAsync(Loc["Deletedsuccessfully"], "success");
            await LoadDepartmentsAsync();
        }
        else
        {
            await ToastService.ShowToastAsync(Loc["DeleteFailed"], "danger");
        }
        StateHasChanged();
    }
    public List<SearchFieldDepartment> searchFields = new List<SearchFieldDepartment>() {
SearchFieldDepartment.NameEnglish,
SearchFieldDepartment.NameArabic,
SearchFieldDepartment.CreatedBy,
SearchFieldDepartment.UpdatedBy,
SearchFieldDepartment.CreateDate,
SearchFieldDepartment.UpdateDate,
SearchFieldDepartment.ParentNameAR,
SearchFieldDepartment.ParentNameEN,
SearchFieldDepartment.Level
};
    private void HandleAddDepartment(string parentId)
    {
        navigationManager.NavigateTo($"/Add-Department?parentId={parentId}");
    }
    public async Task Search(string searchTerm)
    {
        searchdata = searchTerm;
        currentPage = 1;
        await LoadDepartmentsAsync(true, searchTerm);
    }
    private async Task LoadDepartmentsAsync(bool isSearch = false, string searchTerm = null)
    {
        // Determine page size dynamically
        var effectivePageSize = (currentView == DepartmentViewType.Tree || currentView == DepartmentViewType.Hierarchy)
        ? 10000
                : pageSize;
        if (isSearchMode && !isSearch)
        {
            isSearch = true;
            searchTerm = lastSearchTerm;
        }
        var encodedTerm = searchTerm != null ? Uri.EscapeDataString(searchTerm) : null;
        var resp = await _departmentConsumer.GetDepartments(
        currentPage,
        effectivePageSize,
        currentSortColumn,
        sortAscending.Value,
        isSearch ? searchFields : null,
        isSearch ? encodedTerm : null
                );

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;

        // Paginated or full list (depends on view)
        departmentDtos = data.Items;
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;

        // Build hierarchy tree using same data
        allDepartments = data.Items.ToList();
        var dict = allDepartments.ToDictionary(x => x.Id);

        foreach (var dept in allDepartments)
            dept.Children = new List<DepartmentDto>();

        foreach (var dept in allDepartments)
        {
            if (dept.ParentdepartmentId != Guid.Empty && dict.ContainsKey(dept.ParentdepartmentId))
                dict[dept.ParentdepartmentId].Children.Add(dept);
        }

        rootDepartments = allDepartments
        .Where(d => d.ParentdepartmentId == Guid.Empty ||
        !allDepartments.Any(x => x.Id == d.ParentdepartmentId))
        .ToList();

        RootDepartments = rootDepartments; // alias for hierarchy view
    }
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;
        // Third click → reset to default sorting
        if (sortAscending == null)
        {
            currentSortColumn = "";
            sortAscending = true;
        }
        await LoadDepartmentsAsync();
        StateHasChanged();
    }
    private enum DepartmentViewType
    {
        Grid,
        Tree,
        Hierarchy
    }
}