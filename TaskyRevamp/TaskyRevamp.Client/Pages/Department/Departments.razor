    }
    private void Cancel(MouseEventArgs args)
    {
        departmentDtos = OriginalDeptes!.Select(p => new DepartmentDto
        {
            Id = p.Id,
            NameEnglish = p.NameEnglish,
            NameArabic = p.NameArabic,
            
        }).ToList();
        isOrdered = false;
        StateHasChanged();
    }
    private List<DepartmentDto> CopyPriorites()
    {
        return departmentDtos.Select(p => new DepartmentDto
        {
            Id = p.Id,
            NameEnglish = p.NameEnglish,
            NameArabic = p.NameArabic,
           
        }).ToList();
    }
