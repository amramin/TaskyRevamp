    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        List<DepartmentDto> DepartmentsList = new List<DepartmentDto>();
        fileInput = e.File;
        if (fileInput != null)
        {
            var (bytes, name, type) = await _fileManagementService.ReadFileAsync(fileInput);
            if (bytes == null)
            {
                return;
            }
            var rows = _fileManagementService.ReadExcelRows(bytes);
            Console.WriteLine($"Total Rows: {rows.Count}");
            if (rows.Count <= 1)
            {
                await ToastService.ShowToastAsync(Loc["ValidationError"], "error");
                return;
            }
            for (int i = 1; i < rows.Count; i++)
            {
                Console.WriteLine($"Processing Row {i + 1}");
                var isValid = await Validate(rows[i]);
                if (!isValid)
                {
                    await ToastService.ShowToastAsync(Loc["ValidationError"], "error");
                    return;
                }
                if (Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar")
                {
                    DepartmentsList.Add(new DepartmentDto
                        {
                            Level = int.Parse(rows[i][0].Trim()),
                            NameEnglish = rows[i][1].Trim(),
                            NameArabic = rows[i][2].Trim(),
                            ParentdepartmentArabic = rows[i][3].Trim(),
                        ParentdepartmentId = allDepartments.Where(k => k.NameArabic == rows[i][3].Trim()).First().Id,

                        });
                }

                else
                {
                    DepartmentsList.Add(new DepartmentDto
                        {
                            Level = int.Parse(rows[i][0].Trim()),
                            NameEnglish = rows[i][1].Trim(),
                            NameArabic = rows[i][2].Trim(),
                            ParentdepartmentEnglish = rows[i][3].Trim(),
                        ParentdepartmentId = allDepartments.Where(k => k.NameEnglish == rows[i][3].Trim()).First().Id,

                        });
                }
                await _departmentConsumer.CreateDeprtmentsBulk(DepartmentsList);

                 await LoadDepartmentsAsync(); 
            }
        }
    }
    private async Task<bool> Validate(string[] row)
    {
        
        var level = row[0].Trim().ToLower();
        var departmentNameEN = row[1].Trim().ToLower();
        var departmentNameAR = row[2].Trim().ToLower();
        var parentName = row[3].Trim().ToLower();
        if (string.IsNullOrEmpty(parentName) && allDepartments.Count() > 0)
        {
            await ToastService.ShowToastAsync(Loc["Somerequiredvaluesaremissing"], "danger");

            return false;
        }

        if (string.IsNullOrEmpty(level) ||
            string.IsNullOrEmpty(departmentNameEN) ||
            string.IsNullOrEmpty(departmentNameAR))
        {
            await ToastService.ShowToastAsync(Loc["SomeInvalidRowsSkipped"], "danger");

            return false;
        }
        if (Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar")

        {

            if (string.IsNullOrEmpty(parentName) || allDepartments.Where(k => k.NameArabic == parentName).Count() == 0)
            {
                await ToastService.ShowToastAsync(Loc["Somerequiredvaluesaremissing"], "danger");

                return false;
            }
        }
        else
        {
            if (string.IsNullOrEmpty(parentName) || allDepartments.Where(k => k.NameEnglish == parentName).Count() == 0)
            {
                await ToastService.ShowToastAsync(Loc["Somerequiredvaluesaremissing"], "danger");

                return false;
            }
        }
        
        
        

        return true;
    }
