@page "/Departments"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.Department.Components
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Enums.SearchFields
@using TaskyRevamp.Dto.SystemConfiguration
@inject DepartmentConsumer _departmentConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService



<div class="page-header">
    <h1 class="page-headline">@Loc["Departments"]</h1>
    <div class="action-btn-list">
        <Search @ref="searchComponent" SearchSubmit="Search" CssClass="form-control"></Search>
        <button
            class="btn btn-action-40 @(currentView == DepartmentViewType.Hierarchy ? "btn-outline-primary" : "btn-outline-light")"
            data-bs-toggle="tooltip" data-bs-placement="top" title="@Loc["Hierarchy"]"
            @onclick="@(() => ChangeView(DepartmentViewType.Hierarchy))">

            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.DataFlow"></SVGCrud>
            </span>
        </button>

        <button
            class="btn btn-action-40 @(currentView == DepartmentViewType.Tree ? "btn-outline-primary" : "btn-outline-light")"
            data-bs-toggle="tooltip" data-bs-placement="top" title="@Loc["Tree"]"
            @onclick="@(() => ChangeView(DepartmentViewType.Tree))">

            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.SubTasks"></SVGCrud>
            </span>
        </button>
        <button
            class="btn btn-action-40   @(currentView == DepartmentViewType.Grid ? "btn-outline-primary" : "btn-outline-light")"
            data-bs-toggle="tooltip" data-bs-placement="top" title="@Loc["Grid"]"
            @onclick="@(() => ChangeView(DepartmentViewType.Grid))">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.List"></SVGCrud>
            </span>

        </button>


        <button class="btn btn-primary" @onclick="Add">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
            </span>
            @Loc["AddDepartment"]
        </button>
    </div>
</div>
@if (departmentDtos != null && departmentDtos.Any())
{
    <div class="page-body">
        @switch (currentView)
        {
            case DepartmentViewType.Grid:
                <DepartmentGrid Departments="departmentDtos" OnEdit="Edit" OnDelete="OnDeleteDepartment" OnShowUsers="ShowUser"
                    OnAdd="AddDept" OnAddDepartment="AddDept" CurrentPage="currentPage" SortChanged="HandleSort"
                    SortColumn="@currentSortColumn" SortAscending="@sortAscending" PageChanged="ChangePage"
                    PageSizeChanged="ChangePageSize" PageSize="pageSize" TotalPages="totalPages" TotalCount="totalCount" />
                break;

            case DepartmentViewType.Tree:
                <div class="card setting-card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-10 ">
                                <DepartmentTree IsRoot="true" Departments="rootDepartments" OnEdit="Edit"
                                    OnDelete="OnDeleteDepartment" OnAddDepartment="AddDept" OnShowUsers="ShowUser"
                                    OnAdd="AddDept" />
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case DepartmentViewType.Hierarchy:
                <div class="card setting-card card-hierarchy">
                    <div class="card-body">
                        <DepartmentHierarchy Departments="RootDepartments" OnEdit="Edit" OnDelete="OnDeleteDepartment"
                            OnAddDepartment="AddDept" OnShowUsers="ShowUser" OnAdd="AddDept" />
                    </div>
                </div>
                break;
        }
    </div>
}
else if (intialDepartmentDtos != null && intialDepartmentDtos.Any())
{
    <NoSearchResults OnResetClick="ClearSearch"></NoSearchResults>

}
else
{
    <NoDataAvailable MessageTitle="@Loc["Nodepartmentavailable"]" MessageSubtitle="@Loc["AddADepartmentToGetStarted"]"
        ButtonText="@Loc["AddDepartment"]" OnButtonClick="Add" />
}


@code {
    private List<DepartmentDto> departmentDtos = new();
    private List<DepartmentDto> intialDepartmentDtos = new();
    private List<DepartmentDto> rootDepartments = new();
    private DepartmentDto? selectedDepartment;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "";
    private bool? sortAscending = true;
    private DepartmentViewType currentView = DepartmentViewType.Grid;
    private List<SortableColumn> tableColumns = new();
    string searchdata { set; get; }
    private string? lastSearchTerm = null;
    private bool isSearchMode = false;
    private List<DepartmentDto> RootDepartments = new();
    List<DepartmentDto> allDepartments = new List<DepartmentDto>();
    [Parameter] public bool IsRoot { get; set; } = false;
    private Search? searchComponent;

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadDepartmentsAsync();
    }
    protected override async Task OnInitializedAsync()
    {

        tableColumns = new()
{
new() { Field = "DisplayedName", DisplayName = Loc["Name"] },
new() { Field = "Level", DisplayName = Loc["Level"] },
new() { Field = "DepartmentParent", DisplayName = Loc["DepartmentParent"] },
new() { Field = "CreateDate", DisplayName = Loc["CreationDate"] },
new() { Field = "CreatedBy", DisplayName = Loc["CreatedBy"] },
new() { Field = "UpdateDate", DisplayName = Loc["UpdateDate"] },
new() { Field = "UpdatedBy", DisplayName = Loc["UpdatedBy"] },
new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
};

        await LoadDepartmentsAsync();
        intialDepartmentDtos = departmentDtos;

        StateHasChanged();
    }
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadDepartmentsAsync();
    }
    private void Add()
    {
        PopupService.ShowNew(@<AddDepartment OnSaved="ReloadAfterSave"></AddDepartment>,Loc["AddDepartment"]);

    }
    private async Task ReloadAfterSave()
    {
        //currentPage = page;
        PopupService.Hide();
        await LoadDepartmentsAsync();
        StateHasChanged();
    }
    private async Task ClearSearch()
    {
        currentPage = 1;
        searchComponent.SearchTerm = "";

        await searchComponent?.SearchSubmit.InvokeAsync("");
        await LoadDepartmentsAsync(isSearch: false, null);

    }
    private void Edit(Guid id)
    {
        PopupService.ShowNew(@<UpdateDepartment Id="id" OnSaved="ReloadAfterSave"></UpdateDepartment>, headerText:
        @Loc["EditDepartment"]);

    }
    private void ShowUser(Guid id)
    {
        navigationManager.NavigateTo($"/UsersDepartment/{id}");

    }
    private void AddDept(Guid id)
    {
        PopupService.ShowNew(@<AddDepartment ParentId="id" OnSaved="ReloadAfterSave"></AddDepartment>,Loc["AddDepartment"]);

    }
    private async Task ChangeView(DepartmentViewType view)
    {
        currentView = view;

        // if Tree or Hierarchy → fetch all departments at once
        if (currentView == DepartmentViewType.Tree || currentView == DepartmentViewType.Hierarchy)
        {
            currentPage = 1;
            pageSize = 10000;
        }
        else
        {
            pageSize = 10; // normal pagination for Grid
        }

        await LoadDepartmentsAsync(isSearch: !string.IsNullOrEmpty(searchdata), searchdata);
    }
    private async Task OnDeleteDepartment(Guid departmentId)
    {
        var res = await _departmentConsumer.CheckDeparmentHasUsers(departmentId);
        if (res.Success && res.Data)
        {
            await ToastService.ShowToastAsync(Loc["DepartmentHasUsersCannotDelete"], "error");
            return;
        }
        PopupService.ShowConfirmation(@Loc["SureDeleteDepartment"], @Loc["Confirm"],
        async (confirmed) =>
        {
            if (confirmed)
                await DeleteConfirmed(departmentId);
        }, ConfirmationType.Danger);
    }
    private async Task DeleteConfirmed(Guid departmentId)
    {
        var result = await _departmentConsumer.DeleteDepartment(departmentId);
        if (result.Success)
        {
            var toRemove = departmentDtos.FirstOrDefault(d => d.Id == departmentId);
            if (toRemove != null)
            {
                departmentDtos.Remove(toRemove);
                if (departmentDtos.Count() <= 0)
                {
                    currentPage -= 1;
                   await LoadDepartmentsAsync();
                }
            }

            await ToastService.ShowToastAsync(Loc["Deletedsuccessfully"], "success");
            await LoadDepartmentsAsync();
        }
        else
        {
            await ToastService.ShowToastAsync(Loc["DeleteFailed"], "danger");
        }
        StateHasChanged();
    }
    public List<SearchFieldDepartment> searchFields = new List<SearchFieldDepartment>() {
SearchFieldDepartment.NameEnglish,
SearchFieldDepartment.NameArabic,
SearchFieldDepartment.CreatedBy,
SearchFieldDepartment.UpdatedBy,
SearchFieldDepartment.CreateDate,
SearchFieldDepartment.UpdateDate,
SearchFieldDepartment.ParentNameAR,
SearchFieldDepartment.ParentNameEN,
SearchFieldDepartment.Level
};
    private void HandleAddDepartment(string parentId)
    {
        navigationManager.NavigateTo($"/Add-Department?parentId={parentId}");
    }
    public async Task Search(string searchTerm)
    {
        searchdata = searchTerm;
        currentPage = 1;
        await LoadDepartmentsAsync(true, searchTerm);
    }
    private async Task LoadDepartmentsAsync(bool isSearch = false, string searchTerm = null)
    {
        // Determine page size dynamically
        var effectivePageSize = (currentView == DepartmentViewType.Tree || currentView == DepartmentViewType.Hierarchy)
        ? 10000
                : pageSize;
        if (isSearchMode && !isSearch)
        {
            isSearch = true;
            searchTerm = lastSearchTerm;
        }
        var encodedTerm = searchTerm != null ? Uri.EscapeDataString(searchTerm) : null;
        var resp = await _departmentConsumer.GetDepartments(
        currentPage,
        effectivePageSize,
        currentSortColumn,
        sortAscending.Value,
        isSearch ? searchFields : null,
        isSearch ? encodedTerm : null
                );

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;

        // Paginated or full list (depends on view)
        departmentDtos = data.Items;
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;

        // Build hierarchy tree using same data
        allDepartments = data.Items.ToList();
        var dict = allDepartments.ToDictionary(x => x.Id);

        foreach (var dept in allDepartments)
            dept.Children = new List<DepartmentDto>();

        foreach (var dept in allDepartments)
        {
            if (dept.ParentdepartmentId != Guid.Empty && dict.ContainsKey(dept.ParentdepartmentId))
                dict[dept.ParentdepartmentId].Children.Add(dept);
        }

        rootDepartments = allDepartments
        .Where(d => d.ParentdepartmentId == Guid.Empty ||
        !allDepartments.Any(x => x.Id == d.ParentdepartmentId))
        .ToList();

        RootDepartments = rootDepartments; // alias for hierarchy view
    }
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;
        // Third click → reset to default sorting
        if (sortAscending == null)
        {
            currentSortColumn = "";
            sortAscending = true;
        }
        await LoadDepartmentsAsync();
        StateHasChanged();
    }
    private enum DepartmentViewType
    {
        Grid,
        Tree,
        Hierarchy
    }
}