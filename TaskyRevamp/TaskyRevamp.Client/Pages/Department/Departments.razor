@page "/Departments"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.Department.Components
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Enums.SearchFields
@using TaskyRevamp.Dto.SystemConfiguration
@inject DepartmentConsumer _departmentConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService



<div class="page-header">
    <h1 class="page-headline">@Loc["Departments"]</h1>
    <div class="action-btn-list">
        <Search SearchSubmit="Search" CssClass="form-control"></Search>
        <button
            class="btn btn-action-40 @(currentView == DepartmentViewType.Hierarchy ? "btn-outline-primary" : "btn-outline-light")"
            data-bs-toggle="tooltip" data-bs-placement="top" title="@Loc["Hierarchy"]"
            @onclick="@(() => ChangeView(DepartmentViewType.Hierarchy))">

            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.DataFlow"></SVGCrud>
            </span>
        </button>

        <button
            class="btn btn-action-40 @(currentView == DepartmentViewType.Tree ? "btn-outline-primary" : "btn-outline-light")"
            data-bs-toggle="tooltip" data-bs-placement="top" title="@Loc["Tree"]"
            @onclick="@(() => ChangeView(DepartmentViewType.Tree))">

            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.SubTasks"></SVGCrud>
            </span>
        </button>
        <button
            class="btn btn-action-40   @(currentView == DepartmentViewType.Grid ? "btn-outline-primary" : "btn-outline-light")"
            data-bs-toggle="tooltip" data-bs-placement="top" title="@Loc["Grid"]"
            @onclick="@(() => ChangeView(DepartmentViewType.Grid))">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.List"></SVGCrud>
            </span>

        </button>


        <button class="btn btn-primary" @onclick="Add">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
            </span>
            @Loc["AddDepartment"]
        </button>
    </div>
</div>

@if (departmentDtos == null || departmentDtos.Count == 0)
{
    <h6 class="mb-3">@Loc["Nodepartmentavailable"]</h6>
}
else
{
    <div class="page-body">
        @switch (currentView)
        {
            case DepartmentViewType.Grid:
                <DepartmentGrid Departments="departmentDtos" OnEdit="Edit" OnDelete="OnDeleteDepartment" OnShowUsers="ShowUser" />
                break;

            case DepartmentViewType.Tree:
                <div class="card flex-grow-1">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-10 ">
                                <DepartmentTree Departments="rootDepartments" OnEdit="Edit" OnDelete="OnDeleteDepartment"
                                    OnShowUsers="ShowUser" OnAddDepartment="HandleAddDepartment" />
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case DepartmentViewType.Hierarchy:
                <DepartmentHierarchy Departments="RootDepartments" OnEdit="Edit" OnDelete="OnDeleteDepartment"
                    OnShowUsers="ShowUser" />
                break;
        }
    </div>


}

@code {
    private List<DepartmentDto> departmentDtos = new();
    private List<DepartmentDto> rootDepartments = new();
    private DepartmentDto? selectedDepartment;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "CreateDate";
    private bool? sortAscending = true;
    private DepartmentViewType currentView = DepartmentViewType.Grid;
    private List<SortableColumn> tableColumns = new();
    List<SourceDtoWithName> sources = new();
    List<SourceDtoWithName> initialSources = new();
    private List<DepartmentDto> RootDepartments => departmentDtos
    .Where(d => d.ParentdepartmentId == Guid.Empty)
    .ToList();
    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadSources();
    }
    protected override async Task OnInitializedAsync()
    {
        tableColumns = new()
{
new() { Field = "NameEnglish", DisplayName = Loc["NameEnglish"] },
new() { Field = "NameArabic", DisplayName = Loc["NameArabic"] },
new() { Field = "DepartmentParent", DisplayName = Loc["ParentdepartmentName"] },

new() { Field = "CreateDate", DisplayName = Loc["CreationDate"] },
new() { Field = "CreatedBy", DisplayName = Loc["CreatedBy"] },
new() { Field = "UpdateDate", DisplayName = Loc["UpdateDate"] },
new() { Field = "UpdatedBy", DisplayName = Loc["UpdatedBy"] },
new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
};

        await LoadSources();
        initialSources = sources;



        BuildHierarchy();
    }
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadSources();
    }
    private void Add()
    {

        // navigationManager.NavigateTo("/Add-Department");
        PopupService.ShowNew(@<AddDepartment OnValidSubmit="OnInitializedAsync"></AddDepartment>, headerText:
        @Loc["AddDepartment"]);

    }
    private void Edit(Guid id)
    {
        PopupService.ShowNew(@<UpdateDepartment Id="id" OnValidSubmit="OnInitializedAsync"></UpdateDepartment>, headerText:
        @Loc["EditDepartment"]);

        // navigationManager.NavigateTo($"/Update-Department/{id}");
    }
    private void ShowUser(Guid id)
    {
        // navigationManager.NavigateTo($"/UsersDepartment/{id}");
        PopupService.ShowNew(@<UsersDepartment Id="id"></UsersDepartment>, headerText: @Loc["UsersDepartment"]);

    }

    private void ChangeView(DepartmentViewType view) => currentView = view;

    private void OnDeleteDepartment(Guid departmentId)
    {
        PopupService.ShowConfirmation(
        @Loc["SureDeleteDepartment"],
        "Yes, Delete",
        async (confirmed) =>
        {
            if (confirmed)
                await DeleteConfirmed(departmentId);
        },
        ConfirmationType.Danger
        );
    }
    public List<SearchFieldDepartment> searchFields = new List<SearchFieldDepartment>() {
SearchFieldDepartment.NameEnglish,
SearchFieldDepartment.NameArabic,
SearchFieldDepartment.CreatedBy,
SearchFieldDepartment.UpdatedBy,
SearchFieldDepartment.CreateDate,
SearchFieldDepartment.UpdateDate,
SearchFieldDepartment.ParentNameAR,
SearchFieldDepartment.ParentNameEN
};
    private async Task DeleteConfirmed(Guid departmentId)
    {
        var result = await _departmentConsumer.DeleteDepartment(departmentId);
        if (result.Success)
        {
            var toRemove = departmentDtos.FirstOrDefault(d => d.Id == departmentId);
            if (toRemove != null)
            {
                departmentDtos.Remove(toRemove);
            }

            await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            BuildHierarchy();
        }
        else
        {
            await ToastService.ShowToastAsync(Loc["DeleteFailed"], "danger");
        }

        StateHasChanged();
    }


    private void BuildHierarchy()
    {
        var dict = departmentDtos.ToDictionary(x => x.Id);
        foreach (var dept in departmentDtos)
            dept.Children = new List<DepartmentDto>();

        foreach (var dept in departmentDtos)
        {
            if (dept.ParentdepartmentId != Guid.Empty && dict.ContainsKey(dept.ParentdepartmentId))
                dict[dept.ParentdepartmentId].Children.Add(dept);
        }

        rootDepartments = departmentDtos
        .Where(d => d.ParentdepartmentId == Guid.Empty ||
        !departmentDtos.Any(x => x.Id == d.ParentdepartmentId))
        .ToList();
    }

    private void HandleAddDepartment(string parentId)
    {
        navigationManager.NavigateTo($"/Add-Department?parentId={parentId}");
    }
    public async Task Search(string searchTerm)
    {
        await LoadSources(true, searchTerm);
    }
    private async Task LoadSources(bool isSearch = false, string searchTerm = null)
    {
        var resp = await _departmentConsumer.GetDepartments(currentPage, pageSize, currentSortColumn, sortAscending.Value,
        isSearch ?
        searchFields : null, isSearch ? searchTerm : null);
        departmentDtos = resp.Data.Items.OrderBy(k => k.CreateDate).ToList();

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }
    private enum DepartmentViewType
    {
        Grid,
        Tree,
        Hierarchy
    }
}