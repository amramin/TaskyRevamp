@page "/Departments"
@using OfficeOpenXml
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.Department.Components
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Enums.SearchFields
@using TaskyRevamp.Dto.SystemConfiguration
@inject DepartmentConsumer _departmentConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService
@inject FileManagementService _fileManagementService



<div class="page-header">
    <h1 class="page-headline">@Loc["Departments"]</h1>
    <div class="action-btn-list">
        <Search @ref="searchComponent" SearchSubmit="Search" CssClass="form-control"></Search>
        <button
            class="btn btn-action-40 @(currentView == DepartmentViewType.Hierarchy ? "btn-outline-primary" : "btn-outline-light")"
            data-bs-toggle="tooltip" data-bs-placement="top" title="@Loc["Hierarchy"]"
            @onclick="@(() => ChangeView(DepartmentViewType.Hierarchy))">

            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.DataFlow"></SVGCrud>
            </span>
        </button>

        <button
            class="btn btn-action-40 @(currentView == DepartmentViewType.Tree ? "btn-outline-primary" : "btn-outline-light")"
            data-bs-toggle="tooltip" data-bs-placement="top" title="@Loc["Tree"]"
            @onclick="@(() => ChangeView(DepartmentViewType.Tree))">

            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.SubTasks"></SVGCrud>
            </span>
        </button>
        <button
            class="btn btn-action-40   @(currentView == DepartmentViewType.Grid ? "btn-outline-primary" : "btn-outline-light")"
            data-bs-toggle="tooltip" data-bs-placement="top" title="@Loc["Grid"]"
            @onclick="@(() => ChangeView(DepartmentViewType.Grid))">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.List"></SVGCrud>
            </span>

        </button>


        <button class="btn btn-primary" @onclick="Add">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
            </span>
            @Loc["AddDepartment"]
        </button>
    </div>
</div>
 <div class="page-body">
      <div class="file-qustom button-end mb-2">
    <label for="DepartmentFileUpload">
        <span class="icon">
            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.FileUpload"></SVGCrud>
        </span>
        <div>
            <div class="d-flex gap-2 align-items-center">
                    <span class="text"> @Loc["UploadExcelFile"]</span>
                    <div class="more-info">
                            <span class="info-icon">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Info"></SVGCrud>
                            </span>
                            <div class="content">
                                <ul>
                                    <li>@Loc["DepartmentLevelMandatory"]</li>
                                    <li>@Loc["DepartmentNameMandatory"]</li>
                                    <li>@Loc["ParentDepartmentNameMandatory"]</li>
                                </ul>
                            </div>
                    </div>
            </div>
            <span class="file-type"> @Loc["Add the department's structure"]</span>
        </div>
    </label>
    <InputFile id="DepartmentFileUpload" OnChange="HandleFileSelected" accept=".xlsx" />
    <a class="btn btn-lg btn-light text-nowrap" href=@(Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName ==
                                                        "ar" ? "إضافة إدارات.xlsx" : "Add departements.xlsx") download="DepartmentsTemplate.xlsx">
        @Loc["DownloadExcelTemplate"]
    </a>
</div>
@if (departmentDtos != null && departmentDtos.Any())
{
   
      
        @switch (currentView)
        {
            case DepartmentViewType.Grid:
                <DepartmentGrid Departments="departmentDtos" OnEdit="Edit" OnDelete="OnDeleteDepartment" OnShowUsers="ShowUser" OnLinkUsers="AddLinkUser"
                    OnAdd="AddDept" OnAddDepartment="AddDept" CurrentPage="currentPage" SortChanged="HandleSort"
                    SortColumn="@currentSortColumn" SortAscending="@sortAscending" PageChanged="ChangePage"
                    PageSizeChanged="ChangePageSize" PageSize="pageSize" TotalPages="totalPages" TotalCount="totalCount" />
                break;

            case DepartmentViewType.Tree:
                <div class="card setting-card card-hierarchy">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-lg-10 ">
                                <DepartmentTree IsRoot="true" Departments="rootDepartments" OnEdit="Edit"
                                                OnDelete="OnDeleteDepartment" OnAddDepartment="AddDept" OnShowUsers="ShowUser" OnLinkUsers="AddLinkUser"
                                    OnAdd="AddDept" />
                            </div>
                        </div>
                    </div>
                </div>
                break;

            case DepartmentViewType.Hierarchy:
                <div class="card setting-card card-hierarchy">
                    <div class="card-body">
                        <DepartmentHierarchy Departments="RootDepartments" OnEdit="Edit" OnDelete="OnDeleteDepartment"
                                             OnAddDepartment="AddDept" OnShowUsers="ShowUser" OnLinkUsers="AddLinkUser" OnAdd="AddDept" />
                    </div>
                </div>
                break;
        }
  
}
else if (intialDepartmentDtos != null && intialDepartmentDtos.Any())
{
    <NoSearchResults OnResetClick="ClearSearch"></NoSearchResults>

}
else
{
    
    <NoDataAvailable MessageTitle="@Loc["Nodepartmentavailable"]" MessageSubtitle="@Loc["AddADepartmentToGetStarted"]"
        ButtonText="@Loc["AddDepartment"]" OnButtonClick="Add" />
}
  </div>

