@page "/task/details/{TaskId:guid}/{activeTab?}"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.Task.Components
@using TaskyRevamp.Dto.TaskDto
@inject NavigationManager navigationManager
@inject TaskConsumer _taskConsumer
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="task-detail-page">
    <TaskHeader Task="task" @key="task.Id" OnGoBack="GoBack" ShowViewedBy="@isCreator" />
    <TaskMeta Task="task" />

    <div class="row g-0">
        <div class="col-lg-8">
            <div class="tab-pills flex-grow-1">
                <TaskTabs @bind-ActiveTab="activeTab" Task="task" />
                <div class="page-body">
                    @if (activeTab == "attachment")
                    {
                        <TaskAttachments TaskId="TaskId" />
                    }
                    else if (activeTab == "dependency")
                    {
                        <TaskDependency Task="task" />
                    }
                    else if (activeTab == "details")
                    {
                        <TaskDescription @bind-ShowSection="showDescription" Task="task" />
                        <TaskDetails @bind-ShowSection="showDetails" Task="task" />
                        <TaskComments @bind-ShowSection="showComments" TaskId="TaskId" @ref="commentssection" />
                    }
                    else if (activeTab == "enddate")
                    {
                        <RequestNewEndDateTaskHistory OnRequestChanged="OnRequestChanged" @bind-ShowSection="showrequest" @ref="enddatesection" Task="task" />
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="page-body">
                <TaskSidebar Task="task" OnConfirmed="LoadTask" OnReopenTask="AfterReopen" OnRequestNewEndDate="AfterRequestNewDate" />
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public Guid TaskId { get; set; }
    [Parameter] [SupplyParameterFromQuery]public string? returnUrl { get; set; }
    [Parameter] public string? activeTab { get; set; } = "details";
    private CreateTaskDto task = new CreateTaskDto();
    private bool showDescription = true;
    private TaskComments commentssection;
    private RequestNewEndDateTaskHistory enddatesection;
    private bool showDetails = false;
    private bool showrequest = false;
    private bool showComments = true;
    private Guid currentUserId;
    private bool isCreator = false;
    private bool firstRenderCompleted = false;

    override protected async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && task.Id != Guid.Empty && enddatesection != null)
        {
            firstRenderCompleted = true;
            await enddatesection.LoadSources();
        }
    }
    override protected async Task OnInitializedAsync()
    {
        var userIdString = await LocalStorage.GetItemAsStringAsync("Id");
        if (!string.IsNullOrEmpty(userIdString))
        {
            userIdString = userIdString.Trim('"'); // Remove quotes if any
            if (Guid.TryParse(userIdString, out var userId))
            {
                currentUserId = userId;
            }
        }
        await LoadTask();
    }
    private async Task LoadTask()
    {
        var res = await _taskConsumer.GetTaskById(TaskId, currentUserId);
        if (res.Success && res.Data != null)
        {
            task = res.Data;
            isCreator = task.CreatedBy == currentUserId;
            StateHasChanged();
        }
    }
    public async Task OnRequestChanged()
    {
        await LoadTask();
    }
    private void GoBack()
    {
        if (!string.IsNullOrEmpty(returnUrl))
            navigationManager.NavigateTo(returnUrl);
        else
            navigationManager.NavigateTo("/MainTasks");
    }
    public async Task AfterReopen()
    {
        await LoadTask();
        await commentssection.LoadComments();
    }
    public async Task AfterRequestNewDate()
    {
        await LoadTask();
        await enddatesection.LoadSources();
        await commentssection.LoadComments();
    }

}