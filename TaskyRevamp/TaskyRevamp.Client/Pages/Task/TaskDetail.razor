@page "/task/details/{TaskId:guid}"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.Task.Components
@using TaskyRevamp.Dto.TaskDto
@inject NavigationManager navigationManager
@inject TaskConsumer _taskConsumer
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage

<div class="task-detail-page">
    <TaskHeader Task="task" @key="task.Id" OnGoBack="GoBack" ShowViewedBy="@isCreator" />
    <TaskMeta Task="task" />



    <div class="row g-0">
        <div class="col-lg-8">
            <div class="tab-pills flex-grow-1">
                <TaskTabs @bind-ActiveTab="activeTab" Task="task" />
                <div class="page-body">
                    @if(activeTab == "attachment")
            {
                <TaskAttachments TaskId="TaskId" />
            }
            else if(activeTab == "details")
            {
                <TaskDescription @bind-ShowSection="showDescription" Task="task" />
                <TaskDetails @bind-ShowSection="showDetails" Task="task" />
                <TaskComments @bind-ShowSection="showComments" TaskId="TaskId" @ref="commentssection"/>
            }
            else if (activeTab == "enddate")
            {
                <RequestNewEndDateTaskHistory @bind-ShowSection="showDetails" Task="task" />
            }
                </div>
            </div>
        </div>
             <div class="col-lg-4">
            <div class="page-body">
                <TaskSidebar Task="task" OnConfirmed="LoadTask" OnReopenTask="AfterReopen" />
            </div>
        </div>

   

</div></div>
@code {
    [Parameter] public Guid TaskId { get; set; }
    private string activeTab = "details";
    private CreateTaskDto task = new CreateTaskDto();
    private bool showDescription = true;
    private TaskComments commentssection;
    private bool showDetails = false;
    private bool showComments = true;
    private Guid currentUserId;
    private bool isCreator = false;

    override protected async Task OnInitializedAsync()
    {
        var userIdString = await LocalStorage.GetItemAsStringAsync("Id");
        if (!string.IsNullOrEmpty(userIdString))
        {
            userIdString = userIdString.Trim('"'); // Remove quotes if any
            if (Guid.TryParse(userIdString, out var userId))
            {
                currentUserId = userId;
            }
        }
        await LoadTask();
    }
    private async Task LoadTask()
    {
        var res = await _taskConsumer.GetTaskById(TaskId, currentUserId);
        if (res.Success && res.Data != null)
        {
            task = res.Data;
            isCreator = task.CreatedBy == currentUserId;
            StateHasChanged();
        }
    }
    private void GoBack()
    {
        navigationManager.NavigateTo("/MainTasks");
    }
    public async Task AfterReopen()
    {
        var res = await _taskConsumer.GetTaskById(TaskId, currentUserId);
        if (res.Success && res.Data != null)
        {
            task = res.Data;
            isCreator = task.CreatedBy == currentUserId;
            StateHasChanged();
        }
        await commentssection.LoadComments();
    }

}