    public async Task<List<SortableColumn>> GetColumns()
    {
        var key = IsCompletedTasks ? "CompletedTask_Columns" : "MainTask_Columns";
        var columns = await LocalStorageService.GetItemAsync<List<SortableColumn>>(key);
        return columns;
    }
    public async Task RefreshColumns()
    {
        await LoadColumns();
        StateHasChanged();
    }

    private async Task LoadColumns()
    {
        var olddata = await GetColumns();
        if (olddata != null && olddata.Count > 0)
        {
            Columns = olddata.OrderBy(c => c.Order).ToList();
        }
        else
        {
            var all = await GetDefaultColumns();
            Columns = all.ToList();
        }
    }
    private async Task<List<SortableColumn>> GetDefaultColumns()
    {
        List<SortableColumn> column = new List<SortableColumn>();
        column = new List<SortableColumn>()
        {
            new() { Field = "Title", DisplayName  = Loc["Title"], Order = 0, IsVisible = true },
            new() { Field = "Priority", DisplayName =  Loc["Priority2"], Order = 1, IsVisible = true },
            new() { Field = "Status", DisplayName =  Loc["TaskStatus"], Order = 2, IsVisible = true },
            new() { Field = "Actual progress", DisplayName = Loc["ActualProgress"], Order = 3, IsVisible = true },
