    private async Task OnConfirmDelete(bool confirmed)
    {
        if (confirmed && itemToDelete != null!)
        {
            var res = await _taskConsumer.DeleteTask(itemToDelete);
            if (res.Success)
            {
                allTaks.Remove(allTaks.FirstOrDefault(x => x.Id == itemToDelete)!);
                await GetTasks();
            }
        }
        isPopupVisible = false;
        StateHasChanged();
    }
    public void ShowConfirmation(Guid Id)
    {
        itemToDelete = Id;
        isPopupVisible = true;
        StateHasChanged();
    }
    public async Task UpdateTask(CreateTaskDto updatedTask)
    {
        var taskIndex = allTaks.FindIndex(t => t.Id == updatedTask.Id);
        if (taskIndex >= 0)
            allTaks[taskIndex] = updatedTask;
        await InvokeAsync(StateHasChanged);
    }
