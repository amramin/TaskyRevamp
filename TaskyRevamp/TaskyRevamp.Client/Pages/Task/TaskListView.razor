    };
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;
        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = ""; // or whatever your default column is
            sortAscending = true;
        }
        await GetTasks();
    }
    private void ViewTaskDetails(Guid id) => navigationManager.NavigateTo($"/task/details/{id}");
    public async Task GetTasks(bool isSearch = false, string searchTerm = null!)
    {
        var res = await _taskConsumer.GetTasks(currentPage, pageSize, currentSortColumn, sortAscending!.Value, isSearch ?
            searchFields : null!, isSearch ? searchTerm : null!, ViewType, ViewTypeId, IsCompleted);

        if (!(res?.Success ?? false) || res.Data is null)
            return;
        allTaks = res.Data!.Items.ToList();
        var data = res.Data;
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
        if (!collapseLoadedFromStorage)
        {
            IsCollapse = allTaks == null || !allTaks.Any();
        }
        StateHasChanged();
    }
    private async Task<int> GetRejectionPeriod()
    {
        var res = await _rejectionSettingConsumer.GetRejectionSetting();
        int RejectionPeriod = 0;
        if (res.Success)
        {
            var setting = res.Data;
            if (res.Data is not null)
            {
                if (res.Data.CustomDays != null)
                {
                    RejectionPeriod = (int)res.Data.CustomDays;
                }
                else
                {
                    RejectionPeriod = (int)res.Data.PeriodType;
                }
            }
        }
        return RejectionPeriod;
    }
    private bool DisplayRejectButton(CreateTaskDto taskDto)
    {
        if (RejectionPeriod == 0)
        {
            return false;
        }
        else
        {
            if ((DateOnly.FromDateTime(taskDto.CreateDate ?? DateTime.Now).AddDays(RejectionPeriod) < DateOnly.FromDateTime(DateTime.Now)) || !(taskDto.AssignedIds.Contains(CurrentUser)))
            {
                return false;
            }
            else
            {
                return true;
            }
        }
    }
    private async Task OnTaskProgressChanged(CreateTaskDto task, int value)
    {
        task.ActualProcess = value;
        await _taskConsumer.ChangeTaskProgress(task.Id, value);
        // var resMainTasks = await _taskConsumer.GetMainAndParentTasks();
        // if (resMainTasks.Success && resMainTasks.Data != null)
        //     MainAndParentTasks = resMainTasks.Data;
        StateHasChanged();
    }
    private async Task Collapse()
    {
        if (ViewType != (int)ViewTypes.OverAllView)
        {
            IsCollapse = !IsCollapse;
        }
        if (ViewTypeId is null)
            return;
        var key = IsCompleted ? $"collapse-{ViewTypeId}-c" : $"collapse-{ViewTypeId}";
        await LocalStorageService.SetItemAsStringAsync(key, IsCollapse.ToString());
    }
    private bool IsDelayed(CreateTaskDto task)
    {
        return task.TaskStatusName == "Delayed";
    }
    private async Task CollapseAll(bool collapse)
    {
        if (ViewType != (int)ViewTypes.OverAllView)
        {
            IsCollapse = collapse;
        }
        if (ViewTypeId is null)
            return;
        var key = IsCompleted ? $"collapse-{ViewTypeId}-c" : $"collapse-{ViewTypeId}";
        await LocalStorageService.SetItemAsStringAsync(key, IsCollapse.ToString());
    }
}