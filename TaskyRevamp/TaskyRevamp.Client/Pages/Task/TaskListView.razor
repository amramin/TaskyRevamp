        };
        var key = IsCompletedTasks ? "CompletedTask_Columns" : "MainTask_Columns";
        await LocalStorageService.SetItemAsync(key, column);
        var all = await LocalStorageService.GetItemAsync<List<SortableColumn>>(key);
        return all;
    }
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var isNewLogin = await LocalStorageService.GetItemAsync<bool>("IsNewLogin");
            if (!isNewLogin && ViewTypeId is not null)
            {
                var key = IsCompleted ? $"collapse-{ViewTypeId}-c" : $"collapse-{ViewTypeId}";
                var value = await LocalStorageService.GetItemAsStringAsync(key);
                if (bool.TryParse(value, out var result))
                {
                    IsCollapse = result;
                    collapseLoadedFromStorage = true;
                }
            }
            else
            {
                IsCollapse = false;
            }
            if (isNewLogin)
            {
                IsCollapse = false;
                var keys = await LocalStorageService.KeysAsync();
                foreach (var key in keys.Where(k => k.StartsWith("collapse-")))
                {
                    await LocalStorageService.RemoveItemAsync(key);
                }
                await LocalStorageService.RemoveItemAsync("IsNewLogin");
            }
            await LoadColumns();
            var statusres = await _statusSettingConsumer.GetStatusConfiguration();
            if (statusres.Success && statusres != null && statusres.Data != null)
            {
                Statuses = statusres.Data;
            }
            var olddata = await GetColumns();
            if (olddata != null && olddata.Count > 0)
            {
                Columns = olddata.OrderBy(c => c.Order).ToList();
            }
            else
            {
                var all = await GetDefaultColumns();
                Columns = all.ToList();
            }
            // var resMainTasks = await _taskConsumer.GetMainAndParentTasks();
            // if (resMainTasks.Success && resMainTasks.Data != null)
            // {
            //     MainAndParentTasks = resMainTasks.Data;
            // }
          
            var res = await _defaultColumnsSettingConsumer.GetDefaultColumnsSettings();
            if (res.Success)
            {
                var settings = res.Data;
                if (settings != null)
                    ColumnsList = settings;
            }
            // Filter and order by settings
            tableColumns = tableColumns.Where(c => ColumnsList.Any(s => s.IsActive && string.Equals(s.NameEnglish, c.Field, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(c => ColumnsList.First(s => string.Equals(s.NameEnglish, c.Field, StringComparison.OrdinalIgnoreCase)).Order ?? int.MaxValue).ToList();
            CurrentUser = Guid.Parse(await LocalStorageService.GetItemAsStringAsync("Id"));
            RejectionPeriod = await GetRejectionPeriod();
            await GetTasks();
        }
        finally
        {
            isLoading = false;
        }
    }
    protected override void OnParametersSet()
    {
        if (IsCollapseAll.HasValue)
        {
            CollapseAll((bool)IsCollapseAll.Value);
        }
