@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.Task.Components
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.Enums.SearchFields
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.TaskDto
@using Syncfusion.Blazor
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService
@inject TaskConsumer _taskConsumer
@inject NavigationManager navigationManager
@inject StatusSettingConsumer _statusSettingConsumer
@inject DefaultColumnsSettingConsumer _defaultColumnsSettingConsumer
@inject ILocalStorageService LocalStorageService
@inject RejectionSettingConsumer _rejectionSettingConsumer

@if (!isLoading)
{
    <div class="card table-card collaped-task-card">
        <div class="table-caption cursor-pointer @(IsCollapse ? "collapsed" : "")" @onclick="Collapse">
            @if (ViewType != (int)ViewTypes.OverAllView)
            {
                <span class="chevron-icon">
                    <SVGCrud SVGType="@(IsCollapse? SVGCrud.SVGTypeEnum.ChevronEnd : SVGCrud.SVGTypeEnum.ChevronDown)" />
                </span>
            }
            <span class="text"> @Title</span>
        </div>
        @if (allTaks != null && allTaks.Any())
        {
            <div style="display:@(IsCollapse ? "none" : "block")">
                <div class="mb-1">
                    <OverallBar Tasks="allTaks" Width="600"></OverallBar>
                </div>
                <div class="table-responsive task-table">
                    <SortableTable TItem="CreateTaskDto" Columns="@Columns.Where(p => p.IsVisible).OrderBy(k => k.Order).ToList()" Items="@allTaks"
                                   SortColumn="@currentSortColumn" SortAscending="@sortAscending" OnSortRequested="HandleSort">

                        <RowTemplate>
                            @foreach (var task in allTaks)
                            {
                                <tr>
                                    @foreach (var column in Columns.Where(p => p.IsVisible).OrderBy(k => k.Order).ToList())
                                    {
                                        <td class="@(column.Field == "Title" ? "d-flex gap-1" : "min-w-150")">
                                            @RenderColumnValue(task, column.Field)
                                        </td>
                                    }
                                    <td>
                                        <div class="dropdown actions">
                                            <button class="btn btn-action-24" type="button" data-bs-toggle="dropdown"
                                                    aria-expanded="false">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EllipseVertical"></SVGCrud>
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li>
                                                    <button class="dropdown-item" @onclick="@(() => ViewTaskDetails(task.Id))">
                                                        <span class="icon">
                                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.OpenEye"></SVGCrud>
                                                        </span>
                                                        @Loc["Taskdetails"]
                                                    </button>
                                                </li>
                                                <li>
                                                    <button class="dropdown-item" @onclick="@(() => OnEdit.InvokeAsync(task.Id))">
                                                        <span class="icon">
                                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                                        </span>
                                                        @Loc["EditTask"]
                                                    </button>
                                                </li>
                                                @if (task.ActualProcess == 100 && task.TaskStatus ==
                                                                                    Guid.Parse("6EE4574D-C439-45B4-223A-08DE3318A61C"))
                                                {
                                                    <li>
                                                        <button class="dropdown-item" @onclick="@(() => CompleteTask(task.Id))">
                                                            <span class="icon">
                                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.OpenEye"></SVGCrud>
                                                            </span>
                                                            @Loc["Complete"]
                                                        </button>
                                                    </li>
                                                }
                                                @if (task.ActualProcess == 100 && task.TaskStatus ==
                                                                                    Guid.Parse("6EE4574D-C439-45B4-223A-08DE3318A61C"))
                                                {
                                                    <li>
                                                        <button class="dropdown-item" @onclick="@(() => OnReopen.InvokeAsync(task.Id))">
                                                            <span class="icon">
                                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.OpenEye"></SVGCrud>
                                                            </span>
                                                            @Loc["ReOpen"]
                                                        </button>
                                                    </li>
                                                }
                                                @if (DisplayRejectButton(task))
                                                {
                                                    <li>
                                                        <button class="dropdown-item" @onclick="@(() => OnReject.InvokeAsync(task.Id))">
                                                            <span class="icon">
                                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Reject"></SVGCrud>
                                                            </span>
                                                            @Loc["Reject"]
                                                        </button>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </RowTemplate>
                    </SortableTable>
                </div>
                <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                            PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
            </div>
        }
        else
        {
            <div style="display:@(IsCollapse ? "none" : "block")">
                <NoDataAvailable MessageTitle="@Loc["NoTasks"]" MessageSubtitle="@Loc["AddTaskToStart"]"
                                 ButtonText="@Loc["AddTask"]" OnButtonClick="Add" />
            </div>
        }

    </div>
}


@code {
