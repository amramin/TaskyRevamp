    private Dictionary<string, bool> activeFields = new();

    public async Task<List<SortableColumn>> GetColumns()
    {
        var key = IsCompletedTasks ? "CompletedTask_Columns" : "MainTask_Columns";
        var columns = await LocalStorageService.GetItemAsync<List<SortableColumn>>(key);
        return columns;
    }
    public async Task RefreshColumns()
    {
        await LoadColumns();
        StateHasChanged();
    }
    private async Task LoadColumns()
    {
        var olddata = await GetColumns();
        if (olddata != null && olddata.Count > 0)
        {
            Columns = olddata.OrderBy(c => c.Order).ToList();
        }
        else
        {
            var all = await GetDefaultColumns();
            Columns = all.ToList();
        }
    }
    private async Task<List<SortableColumn>> GetDefaultColumns()
    {
        List<SortableColumn> column = new List<SortableColumn>();
        column = new List<SortableColumn>()
{
new() { Field = "Title", DisplayName = Loc["Title"], Order = 0, IsVisible = true },
new() { Field = "Priority", DisplayName = Loc["Priority2"], Order = 1, IsVisible = true },
new() { Field = "Status", DisplayName = Loc["TaskStatus"], Order = 2, IsVisible = true },
new() { Field = "Actual progress", DisplayName = Loc["ActualProgress"], Order = 3, IsVisible = true },
new() { Field = "Start Date", DisplayName = Loc["StartDate"], Order = 4, IsVisible = true },
new() { Field = "End Date", DisplayName = Loc["EndDate"], Order = 5, IsVisible = true },
new() { Field = "weight", DisplayName = Loc["weight"], Order = 6, IsVisible = true },
new() { Field = "Assigned To", DisplayName = Loc["AssignedTo"], Order = 7, IsVisible = true,IsSortable=false },
new() { Field = "Assigned To Department", DisplayName =Loc["AssignedToDepartment"], Order = 8, IsVisible =
true,IsSortable=false },
new() { Field = "Source", DisplayName =Loc["Source"], Order = 9, IsVisible = true },
new() { Field = "Dependency", DisplayName = Loc["Dependency"], Order = 10, IsVisible = true,IsSortable=false },
new() { Field = "Created By", DisplayName = Loc["CreatedBy"], Order = 11, IsVisible = true },
new() { Field = "Duration", DisplayName = Loc["Duration"], Order = 12, IsVisible = true,IsSortable=false },
new() { Field = "Created by department", DisplayName = Loc["CreatedByDepartment"], Order = 13, IsVisible = true },
new() { Field = "Planned Progress", DisplayName = Loc["PlannedProgress"], Order = 14, IsVisible = true,IsSortable=false
},
new() { Field = "Creation Date", DisplayName = Loc["CreationDate"], Order = 15, IsVisible = true },
new() { Field = "Type", DisplayName = Loc["Type"], Order = 16, IsVisible = true },
new() { Field = "Actual Weight", DisplayName = Loc["ActualWeight"], Order = 17, IsVisible = true,IsSortable=false },
new() { Field = "Planned Weight", DisplayName =Loc["PlannedWeight"], Order = 18, IsVisible = true,IsSortable=false },
};

        var key = IsCompletedTasks ? "CompletedTask_Columns" : "MainTask_Columns";
        if (await LocalStorageService.GetItemAsync<List<SortableColumn>>(key) is null)
        {
            foreach (var col in column)
            {
                col.IsVisible = ColumnsList.FirstOrDefault(s => string.Equals(s.NameEnglish, col.Field,
                StringComparison.OrdinalIgnoreCase))?.IsDisplay ?? col.IsVisible;
            }
        }
        await LocalStorageService.SetItemAsync(key, column);
        var all = await LocalStorageService.GetItemAsync<List<SortableColumn>>(key);
        return all;
    }
    private string GetColumnClass(string field)
    {
        return field switch
        {
            "Title" => "d-flex gap-1",
            "Dependency" => "dependency-cell",

            "Status" => "status-cell",
            _ => "min-w-150"
        };
    }
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        try
        {
            var res = await _defaultColumnsSettingConsumer.GetDefaultColumnsSettings(isload:false);
            if (res.Success)
            {
                var settings = res.Data;
                if (settings != null)
                    ColumnsList = settings;
            }
            var isNewLogin = await LocalStorageService.GetItemAsync<bool>("IsNewLogin");
            if (!isNewLogin && ViewTypeId is not null)
            {
                var key = IsCompleted ? $"collapse-{ViewTypeId}-c" : $"collapse-{ViewTypeId}";
                var value = await LocalStorageService.GetItemAsStringAsync(key);
                if (bool.TryParse(value, out var result))
                {
                    IsCollapse = result;
                    collapseLoadedFromStorage = true;
                }
            }
            else
            {
                IsCollapse = false;
            }
            if (isNewLogin)
            {
                IsCollapse = false;
                var keys = await LocalStorageService.KeysAsync();
                foreach (var key in keys.Where(k => k.StartsWith("collapse-")))
                {
                    await LocalStorageService.RemoveItemAsync(key);
                }
                await LocalStorageService.RemoveItemAsync("IsNewLogin");
            }
            await LoadColumns();
            var statusres = await _statusSettingConsumer.GetStatusConfiguration(isload: false);
            if (statusres.Success && statusres != null && statusres.Data != null)
            {
                Statuses = statusres.Data;
            }
            var olddata = await GetColumns();
            if (olddata != null && olddata.Count > 0)
            {
                Columns = olddata.OrderBy(c => c.Order).ToList();
            }
            else
            {
                var all = await GetDefaultColumns();
                Columns = all.ToList();
            }
            // var resMainTasks = await _taskConsumer.GetMainAndParentTasks();
            // if (resMainTasks.Success && resMainTasks.Data != null)
            // {
            // MainAndParentTasks = resMainTasks.Data;
            // }
            var prioritiesTask = _prioritySettingConsumer.GetPriorities(isload: false);
            var prioritiesRes = await prioritiesTask;
            if (prioritiesRes.Success && prioritiesRes.Data != null)
            {
                Priorities = prioritiesRes.Data.Where(k => k.IsDeleted != true).ToList().OrderBy(q => q.Order).ToList();
            }
            var addTasksSettingRes = await _addTaskSettingConsumer.GetAddTaskSettings(isload: false);
            if (addTasksSettingRes.Success && addTasksSettingRes.Data != null)
            {
                addTaskSettingDtos = addTasksSettingRes.Data;
                BuildActiveFieldsDictionary();
            }

            // Filter and order by settings
            tableColumns = tableColumns.Where(c => ColumnsList.Any(s => s.IsActive && string.Equals(s.NameEnglish, c.Field,
            StringComparison.OrdinalIgnoreCase)))
            .OrderBy(c => ColumnsList.First(s => string.Equals(s.NameEnglish, c.Field, StringComparison.OrdinalIgnoreCase)).Order ??
            int.MaxValue).ToList();
            CurrentUser = Guid.Parse(await LocalStorageService.GetItemAsStringAsync("Id"));
            RejectionPeriod = await GetRejectionPeriod();
            await GetTasks();
            InitialTasks = allTaks;


        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    protected override async Task OnParametersSetAsync()
    {
        if (IsFilter)
        {
            await GetTasks();
        }

        if (IsCollapseAll.HasValue)
        {
            await CollapseAll((bool)IsCollapseAll.Value);
        }
    }
    public async Task Search(string searchTerm)
    {
        currentPage = 1;
        await GetTasks(true, searchTerm);
    }
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await GetTasks();
    }
    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await GetTasks();
    }
    private async Task CompleteConfirmed(Guid id)
    {
        var result = await _taskConsumer.CompleteTask(id);
        if (result.Success && result.Data)
        {
            await GetTasks();
            await ToastService.ShowToastAsync(Loc["Completedsuccessfully"], "success");

        }
        else
            await ToastService.ShowToastAsync(Loc["CompleteFailed"], "danger");
        StateHasChanged();
