    private RenderFragment RenderColumnValue(CreateTaskDto task, string field) => builder =>
    {
        switch (field)
        {
            @* case "Title":
                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "class", "task-title");
                builder.AddAttribute(2, "title", task.Title ?? string.Empty);
                builder.AddContent(3, task.Title);
                builder.CloseElement();
                break; *@
            case "Title":
               
                    builder.OpenElement(-10, "span");
                    builder.AddAttribute(-9, "class", "task-delayed-icon");

                    builder.OpenComponent<SVGCrud>(-8);
                    builder.AddAttribute(-7, "SVGType", SVGCrud.SVGTypeEnum.ClockRewind);
                    builder.CloseComponent();

                    builder.CloseElement();
             

                builder.OpenElement(0, "span");
                builder.AddAttribute(1, "class", "task-title");
                builder.AddAttribute(2, "title", task.Title ?? string.Empty);
                builder.AddContent(3, task.Title);
                builder.CloseElement();
                if (task.Dependencies.Count() > 0)
                {
                    builder.OpenElement(4, "span");
                    builder.AddAttribute(5, "class", "task-depancy-number");

                    builder.OpenElement(6, "span");
                    builder.AddAttribute(7, "class", "icon");

                    builder.OpenComponent<SVGCrud>(8);
                    builder.AddAttribute(9, "SVGType", SVGCrud.SVGTypeEnum.Relation);
                    builder.CloseComponent();

                    builder.CloseElement();

                    builder.OpenElement(10, "span");
                    builder.AddAttribute(11, "class", "text");
                    builder.AddContent(12, $"{task.Dependencies.Count()}");
                    builder.CloseElement();
                    builder.CloseElement();
                }
                break;
            case "Priority":
                builder.AddContent(0, task.PriorityName);
                break;
            case "Status":
                builder.AddContent(0, (task.TaskStatusName)?.ToString());
                break;
            case "Actual progress":
                builder.AddContent(0, (RenderFragment)(b =>
                {
                    b.OpenComponent<OverallBar>(0);
                    b.AddAttribute(1, "ActualProgress", task.ActualProcess);
                    b.AddAttribute(2, "Width", 150);
                    b.AddAttribute(3, "OnProgressChanged", EventCallback.Factory.Create<int>(this, value => OnTaskProgressChanged(task, value)));
                    b.CloseComponent();
                }));
                break;
            case "Start Date":
                builder.AddContent(0, task.StartDate?.ToString(Loc["LocalizeDate"]));
                break;
            case "End Date":
                builder.AddContent(0, task.EndDate?.ToString(Loc["LocalizeDate"]));
                break;
            case "weight":
                builder.AddContent(0, task.weight);
                break;
            case "Assigned To":
                builder.AddContent(0, (RenderFragment)(b =>
                {
                    b.OpenComponent<Initials>(0);
                    b.AddAttribute(1, "Names", task.AssigneduserNames);
                    b.AddAttribute(2, "Size", 32);
                    b.AddAttribute(3, "Black", true);
                    b.CloseComponent();
                }));
                break;
            case "Assigned To Department":
                builder.AddContent(0, task.AssignedDepartmentName);
                break;
            case "Source":
                builder.AddContent(0, task.SourceName);
                break;
            case "Dependency":
                builder.AddContent(0, task.DependencyNames);
                break;
            case "Created by department":
                builder.AddContent(0, task.Createdbydepartment);
                break;
            case "Created By":
                builder.AddContent(0, (RenderFragment)(b =>
                {
                    b.OpenComponent<Initials>(0);
                    b.AddAttribute(1, "Names", task.CreatedByName);
                    b.AddAttribute(2, "Size", 32);
                    b.AddAttribute(3, "Black", true);
                    b.CloseComponent();
                }));
                break;
            case "Duration":
                builder.AddContent(0, task.Duration);
                break;
            case "Planned Progress":
                builder.AddContent(0, $"{task.PlannedProgress}%");
                break;
            case "Creation Date":
                builder.AddContent(0, task.CreateDate?.ToString(Loc["LocalizeDate"]));
                break;
            case "Type":
                builder.AddContent(0, task.TypeName);
                break;
            case "Actual Weight":
                builder.AddContent(0, $"{task.ActualWeight}%");
                break;
            case "Planned Weight":
                builder.AddContent(0, $"{task.Plannedweight}%");
                break;
            case "Action":
                builder.AddContent(0, "...");
                break;
