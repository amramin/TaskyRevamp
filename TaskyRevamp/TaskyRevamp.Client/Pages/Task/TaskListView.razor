    private async Task Collapse()
    {
        if (ViewType != (int)ViewTypes.OverAllView)
        {
            IsCollapse = !IsCollapse;
        }
        if (ViewTypeId is null)
            return;
        var key = IsCompleted ? $"collapse-{ViewTypeId}-c" : $"collapse-{ViewTypeId}";
        await LocalStorageService.SetItemAsStringAsync(key, IsCollapse.ToString());
    }
    private bool IsDelayed(CreateTaskDto task)
    {
        return task.TaskStatusName == "Delayed" || task.TaskStatusName == "متأخرة";
    }
    private bool IsCompletedTask(CreateTaskDto task)
    {
        return task.TaskStatusName == "Completed" || task.TaskStatusName == "مكتملة";
    }
    private async Task CollapseAll(bool collapse)
    {
        if (ViewType != (int)ViewTypes.OverAllView)
        {
            IsCollapse = collapse;
        }
        if (ViewTypeId is null)
            return;
        var key = IsCompleted ? $"collapse-{ViewTypeId}-c" : $"collapse-{ViewTypeId}";
        await LocalStorageService.SetItemAsStringAsync(key, IsCollapse.ToString());
    }
    private string GetRemainingDays(CreateTaskDto task)
    {
        var today = DateOnly.FromDateTime(DateTime.Now).DayNumber;
        var expiry =
        DateOnly.FromDateTime(task.AssigneesData?.FirstOrDefault(d => d.UserId == CurrentUser)?.AssigneeDate ?? DateTime.Now)
        .AddDays(RejectionPeriod).DayNumber;

        var res = expiry - today;
        if (res == 1)
        {
            return $"({res} {Loc["Day"]})";
        }
        else
        {
            return $"({res} {Loc["Days"]})";
        }
    }
