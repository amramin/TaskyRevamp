    private void BuildActiveFieldsDictionary()
    {
        activeFields = addTaskSettingDtos.DistinctBy(c => c.NameEnglish, StringComparer.OrdinalIgnoreCase)
        .ToDictionary(c => c.NameEnglish, c => c.IsActive, StringComparer.OrdinalIgnoreCase);
    }
    private bool IsFieldActive(string fieldName)
    {
        var isactiveField = activeFields.FirstOrDefault(s => s.Key == fieldName);
        return isactiveField.Value;
    }
    private RenderFragment RenderColumnValue(CreateTaskDto task, string field, bool IsCardView = false) => builder =>
    {
        switch (field)
        {
            case "Title":
                if (IsDelayed(task))
                {
                    builder.OpenElement(-10, "span");

                    builder.AddAttribute(-9, "class", "task-delayed-icon");

                    builder.OpenComponent<SVGCrud>(-8);
                    builder.AddAttribute(-7, "SVGType", SVGCrud.SVGTypeEnum.ClockRewind);
                    builder.CloseComponent();

                    builder.CloseElement();
                }

                builder.OpenElement(4, "span");

                builder.AddAttribute(5, "class", "task-title");


                builder.AddAttribute(6, "title", task.Title ?? string.Empty);
                builder.AddAttribute(7, "style", "cursor:pointer;");
                builder.AddAttribute(8, "onclick",
            EventCallback.Factory.Create(this, () => ViewTaskDetails(task.Id)));

                builder.AddContent(9, task.Title);
                builder.CloseElement();
                if (task.Dependencies!.Count() > 0)
                {
                    builder.OpenElement(10, "span");
                    builder.AddAttribute(11, "class", "task-depancy-number");

                    builder.OpenElement(12, "span");
                    builder.AddAttribute(13, "class", "icon");

                    builder.OpenComponent<SVGCrud>(14);
                    builder.AddAttribute(15, "SVGType", SVGCrud.SVGTypeEnum.Relation);
                    builder.CloseComponent();

                    builder.CloseElement();

                    builder.OpenElement(16, "span");
                    builder.AddAttribute(17, "class", "text");
                    builder.AddContent(18, $"{task.Dependencies.Count()}");
                    builder.CloseElement();

                    builder.CloseElement();
                }

                break;
            case "Priority":
                // // 1️⃣ Show current priority badge
                if (IsCompleted)
                {
                    builder.OpenElement(0, "div");
                    builder.AddAttribute(1, "style",
                $"background-color:{task.PriorityBackgroundColor};" +
                $"color:{task.PriorityColor};");
                    builder.AddAttribute(2, "class", "badge");
                    builder.AddContent(3, task.PriorityName);
                    builder.CloseElement();
                }
                else
                {

                    // 2️⃣ Get selected priority colors
                    selectedPriority = Priorities?
                .FirstOrDefault(p => p.Id == task.Priority);

                    var bgColor = selectedPriority?.BackgroundColor ?? "#ffffff";
                    var textColor = selectedPriority?.NameColor ?? "#000000";

                    // 3️⃣ Wrapper with fixed width
                    builder.OpenElement(4, "div");
                    builder.AddAttribute(5, "class", "priority-drop-down");
                    builder.AddAttribute(6, "style",
                $"width:130px;" + // 👈 fixed width here
                $"background-color:{bgColor};" +
                $"color:{textColor};"
                );

                    builder.OpenComponent<SearchableSingleDropdownOffline<PriorityDto, Guid>>(7);
                    builder.SetKey($"{task.Id}-priority");

                    builder.AddAttribute(8, "TextSelector",
                (Func<PriorityDto, string>)(x => x.Name));

                    builder.AddAttribute(9, "OutputSelector",
                (Func<PriorityDto, Guid>)(x => x.Id));

                    builder.AddAttribute(10, "Datasource", Priorities);

                    builder.AddAttribute(11, "SelectedOption", task.Priority);

                    builder.AddAttribute(12, "SelectedOptionChanged",
                EventCallback.Factory.Create<Guid>(this,
                value => OnPriorityChanged(task, value)));
                    builder.AddAttribute(13, "ItemTemplate",
                (RenderFragment<PriorityDto>)((context) => (itemBuilder) =>
                {
                    itemBuilder.OpenElement(0, "div");
                    itemBuilder.AddAttribute(1, "class", "");

                    itemBuilder.OpenElement(2, "span");
                    itemBuilder.AddAttribute(3, "class", "badge");
                    itemBuilder.AddAttribute(4, "style",
                $"background-color:{context.BackgroundColor};color:{context.NameColor};");

                    itemBuilder.AddContent(5, context.Name);

                    itemBuilder.CloseElement(); // span
                    itemBuilder.CloseElement(); // div
                }));
                    builder.CloseComponent();
                    builder.CloseElement();
                }
                break;
            case "Status":
                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "style",
            $"background-color:{task.TaskStatusBackgroundColor};" +
            $"color:{task.TaskStatusColor};");
                builder.AddAttribute(3, "class", "badge");
                builder.AddContent(0, (task.TaskStatusName)?.ToString());
                builder.CloseElement();
                break;
            case "Actual progress":
                builder.AddContent(0, (RenderFragment)(b =>
            {
                b.OpenComponent<OverallBar>(0);
                b.AddAttribute(1, "ActualProgress", task.ActualProcess);
                b.AddAttribute(2, "Width", 150);
                b.AddAttribute(3, "OnProgressChanged", EventCallback.Factory.Create<int>(this, value => ChangeProgressConfirmed(task,

            value)));
                b.CloseComponent();
            }));
                break;
            case "Start Date":
                builder.AddContent(0, task.StartDate?.ToString(Loc["LocalizeDate"]));
                break;
            case "End Date":
                builder.AddContent(0, task.EndDate?.ToString(Loc["LocalizeDate"]));
                break;
            case "weight":
                if (IsFieldActive("Weight"))
                    builder.AddContent(0, task.weight);
                else
                    builder.AddContent(0, 0);
                break;
            case "Assigned To":
                builder.AddContent(0, (RenderFragment)(b =>
            {
                b.OpenComponent<Initials>(0);
                b.AddAttribute(1, "Names", task.AssigneduserNames);
                b.AddAttribute(2, "Size", 32);
                b.AddAttribute(3, "Black", true);
                b.CloseComponent();
            }));
                break;
            case "Assigned To Department":

                builder.OpenElement(0, "div");
                builder.AddAttribute(1, "class", "department-cell");

                var departments = task.AssignedDepartmentName?
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim())
            .ToList() ?? new List<string>();

                if (departments.Any())
                {
                    var firstTwo = departments.Take(1).ToList();
                    var rest = departments.Skip(1).ToList();

                    int seq = 2;
                    int count = firstTwo.Count;

                    for (int i = 0; i < count; i++)
                    {
                        var dep = firstTwo[i];

                        builder.OpenElement(seq++, "span");
                        builder.AddAttribute(seq++, "class", "department-main");
                        builder.AddContent(seq++, dep);
                        builder.CloseElement();

                        if (i < count - 1)
                        {
                            builder.AddContent(seq++, ", ");
                        }
                    }

                    if (rest.Any())
                    {
                        builder.OpenElement(seq++, "div");
                        builder.AddAttribute(seq++, "class", "dropdown department-dropdown d-inline ms-1");

                        builder.OpenElement(seq++, "button");
                        builder.AddAttribute(seq++, "class", "btn btn-sm btn-light");
                        builder.AddAttribute(seq++, "type", "button");
                        builder.AddAttribute(seq++, "data-bs-toggle", "dropdown");
                        builder.AddContent(seq++, $"+{rest.Count}");
                        builder.CloseElement();

                        builder.OpenElement(seq++, "ul");
                        builder.AddAttribute(seq++, "class", "dropdown-menu");

                        foreach (var item in rest)
                        {
                            builder.OpenElement(seq++, "li");
                            builder.OpenElement(seq++, "span");
                            builder.AddAttribute(seq++, "class", "dropdown-item");
                            builder.AddContent(seq++, item);
                            builder.CloseElement();
                            builder.CloseElement();
                        }

                        builder.CloseElement(); // ul
                        builder.CloseElement(); // div
                    }
                }

                builder.CloseElement(); // department-cell

                break;
            case "Source":
                builder.AddContent(0, task.SourceName);
                break;
            case "Dependency":

                var dependencies = task.DependencyNames?
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .ToList() ?? new List<string>();

                if (dependencies.Any())
                {
                    var first = dependencies.First();
                    var rest = dependencies.Skip(1).ToList();

                    builder.OpenElement(0, "span");
                    builder.AddAttribute(1, "class", "dependency-main");
                    builder.AddContent(2, first);
                    builder.CloseElement();

                    if (rest.Any())
                    {
                        builder.OpenElement(3, "div");
                        builder.AddAttribute(4, "class", "dropdown dependency-dropdown d-inline ms-1");

                        builder.OpenElement(5, "button");
                        builder.AddAttribute(6, "class", "btn btn-sm btn-light");
                        builder.AddAttribute(7, "data-bs-toggle", "dropdown");
                        builder.AddContent(8, $"+{rest.Count}");
                        builder.CloseElement();

                        builder.OpenElement(9, "ul");
                        builder.AddAttribute(10, "class", "dropdown-menu");

                        int seq = 11;
                        foreach (var dep in rest)
                        {
                            builder.OpenElement(seq++, "li");
                            builder.AddAttribute(seq++, "class", "dropdown-item");
                            builder.AddContent(seq++, dep);
                            builder.CloseElement();
                        }

                        builder.CloseElement();
                        builder.CloseElement();
                    }
                }

                break;
            case "Created by department":
                builder.AddContent(0, task.Createdbydepartment);
                break;
            case "Created By":
                builder.AddContent(0, (RenderFragment)(b =>
            {
                b.OpenComponent<Initials>(0);
                b.AddAttribute(1, "Names", task.CreatedByName);
                b.AddAttribute(2, "Size", 32);
                b.AddAttribute(3, "Black", true);
                b.CloseComponent();
            }));
                break;
            case "Duration":
                builder.AddContent(0, task.Duration);
                break;
            case "Planned Progress":
                builder.AddContent(0, $"{task.PlannedProgress}%");
                break;
            case "Creation Date":
                builder.AddContent(0, task.CreateDate?.ToString(Loc["LocalizeDate"]));
                break;
            case "Type":
                builder.AddContent(0, task.TypeName);
                break;
            case "Actual Weight":
                if (IsFieldActive("Weight"))
                    builder.AddContent(0, $"{task.ActualWeight}%");
                else
                    builder.AddContent(0, $"{0}%");
                break;
            case "Planned Weight":
                if (IsFieldActive("Weight"))
                    builder.AddContent(0, $"{task.Plannedweight}%");
                else
                    builder.AddContent(0, $"{0}%");
                break;
            case "Action":
                builder.AddContent(0, "...");
                break;
        }
    };

    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;
        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = ""; // or whatever your default column is
            sortAscending = true;
        }
        await GetTasks();
    }
    private void ViewTaskDetails(Guid id) => navigationManager.NavigateTo($"/task/details/{id}/details");
    public async Task GetTasks(bool isSearch = false, string searchTerm = null!)
    {
        var res = await _taskConsumer.GetTasks(currentPage, pageSize, currentSortColumn, sortAscending!.Value, isSearch ?
        searchFields : null!, isSearch ? searchTerm : null!, ViewType, ViewTypeId, IsCompleted, TaskFilter);

        if (!(res?.Success ?? false) || res.Data is null)
            return;
        allTaks = res.Data!.Items.ToList();
        var data = res.Data;
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
        if (!collapseLoadedFromStorage)
        {
            if (ViewType != (int)ViewTypes.OverAllView)
            {
                IsCollapse = allTaks == null || !allTaks.Any();
            }
        }
        StateHasChanged();
        await Task.Yield(); 
        await JS.InvokeVoidAsync("initDropdowns");
    }
    private async Task<int> GetRejectionPeriod()
    {
        var res = await _rejectionSettingConsumer.GetRejectionSetting(isload: false);
        int RejectionPeriod = 0;
        if (res.Success)
        {
            var setting = res.Data;
            if (res.Data is not null)
            {
                if (res.Data.CustomDays != null)
                {
                    RejectionPeriod = (int)res.Data.CustomDays;
                }
                else
                {
                    RejectionPeriod = (int)res.Data.PeriodType;
                }
            }
        }
        return RejectionPeriod;
    }
    private void OnPriorityChanged(CreateTaskDto task, Guid value)
    {
        // task.Priority = value;

        // 2️⃣ Update display fields (important!)
        var selected = Priorities?.FirstOrDefault(p => p.Id == value);
        PopupService.ShowConfirmation(@Loc["SureChangePriority"], @Loc["Confirm"],
        async (confirmed) =>
        {
            if (confirmed)
            {
                if (selected != null)
                {
                    task.PriorityName = selected.Name;
                    task.PriorityBackgroundColor = selected.BackgroundColor;
                    task.PriorityColor = selected.NameColor;
                }
                await ChangePriorityConfirmed(task, value);
            }
        },
        ConfirmationType.Other
        );
    }
    private async Task ChangePriorityConfirmed(CreateTaskDto task, Guid value)
