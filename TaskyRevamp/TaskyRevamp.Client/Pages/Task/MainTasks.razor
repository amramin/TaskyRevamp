@page "/MainTasks"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums.SearchFields
@using TaskyRevamp.Dto.TaskDto
@inject ToastService ToastService
@inject PopupService PopupService
@inject TaskConsumer _taskConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
<div class="tab-pills flex-grow-1">
    <ul class="nav nav-pills" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active"
                    id="List-view"
                    data-bs-toggle="tab"
                    data-bs-target="#List-view-tab"
                    type="button"
                    role="tab"
                    aria-controls="List-view-tab"
                    aria-selected="true">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.List"></SVGCrud>
                </span>
                List view
            </button>

            <div class="table-responsive sticky-header-custom">

                <SortableTable TItem="CreateTaskDto"
                               Columns="@tableColumns"
                               Items="@allTaks"
                               SortColumn="@currentSortColumn"
                               SortAscending="@sortAscending"
                               OnSortRequested="HandleSort">

                    <RowTemplate>


                        @foreach (var p in allTaks)
                        {
                            <tr>
                                <td>@p.TitleEnglish</td>
                                <td>@p.TitleArabic</td>
                                <td>@p.Priority</td>
                                <td>@p.CreatedByName</td>
                                <td>@p.CreateDate?.ToString("yyyy-MM-dd")</td>
                                <td>@p.UpdatedBy</td>
                                <td>@p.UpdateDate?.ToString("yyyy-MM-dd")</td>

                                <td class="sticky-end-action">
                                    <div class="dropdown actions">
                                        <button class="btn btn-action-24" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EllipseVertical"></SVGCrud>
                                        </button>
                                        <ul class="dropdown-menu">

                                            <li>
                                                <button class="dropdown-item" @onclick="@(() => OnShowUsers.InvokeAsync(p.Id))">
                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Users"></SVGCrud>
                                                    </span>
                                                    @Loc["ShowUser"]
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item" @onclick="@(() => OnAdd.InvokeAsync(p.Id))">
                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.AddColumn"></SVGCrud>
                                                    </span>
                                                    @Loc["AddDepartment"]
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item" @onclick="@(() => OnEdit.InvokeAsync(p.Id))">
                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                                    </span>
                                                    @Loc["Edit"]
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item text-danger" @onclick="@(() => OnDelete.InvokeAsync(p.Id))">
                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                                                    </span>
                                                    @Loc["Delete"]
                                                </button>
                                            </li>
                                        </ul>

                                    </div>
                                </td>
                            </tr>
                        }



                    </RowTemplate>
                </SortableTable>


            </div>
            <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                        PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />

        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    data-bs-toggle="tab"
                    data-bs-target="#kanban-view-tab"
                    type="button"
                    role="tab"
                    aria-controls="profile"
                    aria-selected="false">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Kanban"></SVGCrud>

                </span>
                Kanban view
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link"
                    id="gannt-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#gannt-view-tab"
                    type="button"
                    role="tab"
                    aria-controls="gannt-tab"
                    aria-selected="false">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Gantt"></SVGCrud>

                </span>
                Gantt chart
            </button>
        </li>
    </ul>
    <div class="tab-content" id="myTabContent">
        <div class="tab-pane fade show active"
             id="List-view-tab"
             role="tabpanel"
             aria-labelledby="List-view-tab">
            <div class="page-header">
                <div class="title-block">
                    <h1 class="page-headline">Task list</h1>
                    <div class="view-scope-toggle"
                         role="group"
                         aria-label="Basic radio toggle button group">
                        <input type="radio"
                               class="btn-check"
                               name="taskRadio"
                               id="mineRadio-task"
                               autocomplete="off"
                               checked />
                        <label class="btn" for="mineRadio-task">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.User"></SVGCrud>
                            <span>Mine</span>
                        </label>

                        <input type="radio"
                               class="btn-check"
                               name="taskRadio"
                               id="teamRadio-task"
                               autocomplete="off" />
                        <label class="btn" for="teamRadio-task">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Users"></SVGCrud>

                            <span>Team</span>
                        </label>
                    </div>
                </div>

                <div class="action-btn-list">
                    <button class="btn btn-primary"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#survey-type-modal"
                            aria-controls="offcanvasWithBothOptions">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                        </span>
                        Add Task
                    </button>

                    <button type="button"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Filter"
                            class="btn btn-action-40 btn-outline-light-pimary">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Filter"></SVGCrud>

                    </button>
                    <button type="button"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="View column"
                            class="btn btn-action-40 btn-outline-light-pimary">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.AddColumn"></SVGCrud>

                    </button>
                    <button type="button"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Card View"
                            class="btn btn-action-40 btn-outline-light-pimary">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CardView"></SVGCrud>
                    </button>
                    <button type="button"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Export Excel"
                            class="btn btn-action-40 btn-outline-light-pimary">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Excel"></SVGCrud>
                    </button>
                </div>
            </div>
            <div class="page-body"></div>
        </div>
        <div class="tab-pane fade"
             id="kanban-view-tab"
             role="tabpanel"
             aria-labelledby="kanban-tab">
            <div class="page-header">
                <div class="title-block">
                    <h1 class="page-headline">Task list</h1>
                    <div class="view-scope-toggle"
                         role="group"
                         aria-label="Basic radio toggle button group">
                        <input type="radio"
                               class="btn-check"
                               name="btnradio"
                               id="mineRadio"
                               autocomplete="off"
                               checked />
                        <label class="btn" for="mineRadio">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.User"></SVGCrud>
                            <span>Mine</span>
                        </label>

                        <input type="radio"
                               class="btn-check"
                               name="btnradio"
                               id="teamRadio"
                               autocomplete="off" />
                        <label class="btn" for="teamRadio">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Users"></SVGCrud>

                            <span>Team</span>
                        </label>
                    </div>
                </div>

                <div class="action-btn-list">
                    <button class="btn btn-primary"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#survey-type-modal"
                            aria-controls="offcanvasWithBothOptions">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                        </span>
                        Add Task
                    </button>

                    <button type="button"
                            data-bs-toggle="tooltip"
                            data-bs-placement="top"
                            title="Filter"
                            class="btn btn-action-40 btn-outline-light-pimary">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Filter"></SVGCrud>
                    </button>
                </div>
            </div>
            <div class="page-body"></div>
        </div>
        <div class="tab-pane fade"
             id="gannt-view-tab"
             role="tabpanel"
             aria-labelledby="gannt-tab">
            <div class="page-body"></div>
        </div>


    </div>
</div>

@code {
    public bool IsAdmine;// = roleService.IsAllowed(int)Modules., (int)ModuleActions.EditReportPermission) ;//true;//
    [Parameter] public EventCallback<Guid> OnEdit { get; set; }
    [Parameter] public EventCallback<Guid> OnDelete { get; set; }
    [Parameter] public EventCallback<Guid> OnShowUsers { get; set; }
    [Parameter] public EventCallback<Guid> OnAdd { get; set; }
    CreateTaskDto taskdto = new CreateTaskDto();
    List<CreateTaskDto> allTaks = new List<CreateTaskDto>();
    private bool isPopupVisible = false;
    public bool IsShowEditDialog { get; set; } = false;
    public Guid UserDelegationId { set; get; }
    int total = 0;
    private Guid itemToDelete;
    public int CurrentPage { get; set; }
    public int PageSize { get; set; }
    public int TotalItemsCount { get; set; }
    private List<SortableColumn> tableColumns = new();
    private string currentSortColumn = "CreateDate";
    private bool? sortAscending = true;
    public Guid currentUserId { set; get; }
    public bool IsShowCreateDialog { get; set; } = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    protected override async Task OnInitializedAsync()
    {
        tableColumns = new()
        {
            new() { Field = "TitleEnglish", DisplayName = Loc["TitleEnglish"] },
            new() { Field = "TitleArabic", DisplayName = Loc["TitleArabic"] },
            new() { Field = "Level", DisplayName = Loc["Level"] },

          

            new() { Field = "CreatedBy", DisplayName = Loc["CreatedBy"] },

            new() { Field = "CreateDate", DisplayName = Loc["CreationDate"] },
            new() { Field = "UpdatedBy", DisplayName = Loc["UpdatedBy"] },

            new() { Field = "UpdateDate", DisplayName = Loc["UpdateDate"] },
            new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
        };

        await GetTasks();
        StateHasChanged();
    }
    public async Task ResetPage()
    {
        await GetTasks();
        IsShowCreateDialog = false;
        IsShowEditDialog = false;
        isPopupVisible = false;
        StateHasChanged();
    }
    public async Task Search(string searchTerm)
    {
        await GetTasks(true, searchTerm);
        // await LoadSources(true, searchTerm);
    }
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await GetTasks();
    }
    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await GetTasks();
    }
    private async Task DeleteConfirmed(Guid Id)
    {
        var result = await _taskConsumer.DeleteTask(Id);
        if (result.Success)
        {
            var toRemove = allTaks.FirstOrDefault(d => d.Id == Id);
            if (toRemove != null)
            {
                allTaks.Remove(toRemove);
            }

            await ToastService.ShowToastAsync(Loc["Deletedsuccessfully"], "success");
        }
        else
        {
            await ToastService.ShowToastAsync(Loc["DeleteFailed"], "danger");
        }

        StateHasChanged();
    }
    private Search? searchComponent;

    private async Task ClearSearch()
    {
        currentPage = 1;
        searchComponent.SearchTerm = "";

        await searchComponent?.SearchSubmit.InvokeAsync("");
        await GetTasks(isSearch: false, null);

    }
    private void OnDeleteDelegation(Guid delegationId)
    {
        PopupService.ShowConfirmation(
        @Loc["SureDeleteDelegation"],
        "Yes, Delete",
        async (confirmed) =>
        {
            if (confirmed)
                await DeleteConfirmed(delegationId);
        },
        ConfirmationType.Danger
        );
    }

    public async Task Add()
    {
        PopupService.ShowNew(@<Create IsAdmine="@IsAdmine" OnValidSubmit="OnInitializedAsync"></Create>,Loc["AddDelegation"]);

        // StateHasChanged();
    }

    public void ShowEditPopup(Guid id)
    {
        PopupService.ShowNew(@<Edit UserDelegationId="@id.ToString()" IsAdmine="@IsAdmine" OnValidSubmit="OnInitializedAsync"></Edit>, headerText:
        @Loc["EditDelegation"]);
    }
    private async Task OnConfirmDelete(bool confirmed)
    {
        if (confirmed && itemToDelete != null)
        {
            var res = await _taskConsumer.DeleteTask(itemToDelete);
            if (res.Success)
            {
                allTaks.Remove(allTaks.FirstOrDefault(x => x.Id == itemToDelete));
                await GetTasks();
            }
        }
        isPopupVisible = false;
        StateHasChanged();
    }
    public void ShowConfirmation(Guid Id)
    {
        itemToDelete = Id;
        isPopupVisible = true;
        StateHasChanged();
    }
    public async void OnPageChange(int selectedPage, int pageSize)
    {
        IsShowCreateDialog = false;
        IsShowEditDialog = false;
        CurrentPage = selectedPage;
        PageSize = pageSize;

        // await GetUsersList();
        await GetTasks();
        StateHasChanged();
    }
    private async Task Cancel()
    {
        taskdto = new CreateTaskDto();
        StateHasChanged();
    }
    public List<SearchFieldTask> searchFields = new List<SearchFieldTask>() {
    SearchFieldTask.TitleEnglish,
    SearchFieldTask.TitleArabic,
    SearchFieldTask.Level,
       
         SearchFieldTask.CreatedBy,
             SearchFieldTask.CreateDate,
    SearchFieldTask.UpdatedBy,
    SearchFieldTask.UpdateDate

    };

    private async Task Save()
    {
  
        await _taskConsumer.AddTask(taskdto);

        await GetTasks();
    }
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;


        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = "CreateDate"; // or whatever your default column is
            sortAscending = true;
        }
        await GetTasks();
    }



    private async Task GetTasks(bool isSearch = false, string searchTerm = null)
    {
       

        var res = await _taskConsumer.GetTasks(currentPage, pageSize, currentSortColumn, sortAscending.Value, isSearch ?
                 searchFields : null, isSearch ? searchTerm : null);
            allTaks = res.Data.Items.ToList();

            if (!(res?.Success ?? false) || res.Data is null)
                return;

            var data = res.Data;
            totalPages = data.TotalPages;
            totalCount = data.TotalCount;
        
        StateHasChanged();
    }


}
