    public static class SessionKeys
    {
        public const string ActiveTaskColumns = "ActiveTask_Columns";
        public const string CompletedTaskColumns = "CompletedTask_Columns";
    }
    private async Task<List<TaskColumnSetting>> GetDefaultColumns()
    {
        List<TaskColumnSetting> column = new List<TaskColumnSetting>();
        column= new List<TaskColumnSetting>()
    {
        new() { Id = "Title", DisplayName = "Task Title", Order = 0, IsVisible = true },
        new() { Id = "Status", DisplayName = "Status", Order = 1, IsVisible = true },
        new() { Id = "Priority", DisplayName = "Priority", Order = 2, IsVisible = true },
        new() { Id = "Source", DisplayName = "Source", Order = 3, IsVisible = true },
        new() { Id = "DueDate", DisplayName = "Due Date", Order = 4, IsVisible = true }
    };

        await LocalStorageService.SetItemAsync("AllColumn", column);
        var all = await LocalStorageService.GetItemAsync<List<TaskColumnSetting>>("AllColumn");
        return all;
    }

    private void MoveUp(TaskColumnSetting column)
    {
        var index = Columns.IndexOf(column);
        if (index <= 0) return;

        (Columns[index - 1], Columns[index]) =
            (Columns[index], Columns[index - 1]);

        UpdateOrder();
    }

    private void MoveDown(TaskColumnSetting column)
    {
        var index = Columns.IndexOf(column);
        if (index >= Columns.Count - 1) return;

        (Columns[index + 1], Columns[index]) =
            (Columns[index], Columns[index + 1]);

        UpdateOrder();
    }

    private void UpdateOrder()
    {
        for (int i = 0; i < Columns.Count; i++)
            Columns[i].Order = i;
    }


