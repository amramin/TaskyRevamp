    private bool IsFirst(TaskColumnSetting column)
    {
        return Columns
            .OrderBy(c => c.Order)
            .FirstOrDefault() == column;
    }
    private bool IsLast(TaskColumnSetting column)
    {
        return Columns
            .OrderBy(c => c.Order)
            .LastOrDefault() == column;
    }
    private void ToggleVisibility(TaskColumnSetting column, ChangeEventArgs e)
    {
        if (column == null)
            return;


        if (e.Value is bool isChecked)
        {
            column.IsVisible = isChecked;
        }
    }

