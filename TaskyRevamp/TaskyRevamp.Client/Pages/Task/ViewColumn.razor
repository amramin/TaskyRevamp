    private async Task SaveColumnsToSession(
    List<TaskColumnSetting> columns,
    bool isCompletedTasks = false)
    {
        if (columns == null || !columns.Any())
            return;

        // Ensure order is updated before saving
        for (int i = 0; i < columns.Count; i++)
            columns[i].Order = i;

        var sessionKey = isCompletedTasks
            ? SessionKeys.CompletedTaskColumns
            : SessionKeys.ActiveTaskColumns;

        await LocalStorageService.SetItemAsync(sessionKey, columns);
    }
    private void Cancel()
    {
        Columns = BackupColumns
            .Select(c => new TaskColumnSetting
            {
                Id = c.Id,
                DisplayName = c.DisplayName,
                Order = c.Order,
                IsVisible = c.IsVisible,

            })
            .ToList();
        PopupService.Hide();
    }

    protected async override Task OnInitializedAsync()
    {
