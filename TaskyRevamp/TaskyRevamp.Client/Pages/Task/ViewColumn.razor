@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.SystemConfiguration.TypeSetting
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.TaskViews
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject TypeSettingConsumer _typeSettingConsumer
@inject ILocalStorageService LocalStorageService
@inject DefaultColumnsSettingConsumer _defaultColumnsSettingConsumer

@inject PopupService PopupService
<div class="offcanvas-body ">
    <SortableList Items="@OrderedColumns" KeySelector="@(c => c.Field)"
        OnUpdate="EventCallback.Factory.Create<(int oldIndex, int newIndex)>(
                                                                                                        this,
                                                                                                        e => OnColumnDrop(e.oldIndex, e.newIndex))">
        <SortableItemTemplate Context="column">
            <div class="card card-order-control">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div class="flex-fill">
                        <span>@column.DisplayName</span>
                    </div>
                    <div class="toggle">
                        <div class="form-switch custom ">
                            @* <input type="checkbox" id="IsActive@(setting.Id)" class="form-check-input"
                                @bind="setting.IsActive" /> *@
                            <input type="checkbox" id="col-@column.Field" checked="@column.IsVisible"
                                disabled="@IsTitleColumn(column)" @onchange="e => ToggleVisibility(column, e)" />
                            <label for="col-@column.Field">
                                <span class="toggler-icon"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="btn-group-vertical">
                    <button class="btn" disabled="@IsFirst(column)" @onclick="() => MoveUp(column)">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowUp"></SVGCrud>
                        </span>
                    </button>

                    <button class="btn" disabled="@IsLast(column)" @onclick="() => MoveDown(column)">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowDown"></SVGCrud>
                        </span>
                    </button>
                </div>
            </div>
        </SortableItemTemplate>
    </SortableList>
</div>
<div class="offcanvas-footer">
    <div class="row g-2">
        <div class="col-6">
            <div class="d-grid">
                <button type="button" class="btn btn-lg btn-light" @onclick="Cancel">@Loc["Cancel"]</button>
            </div>
        </div>
        <div class="col-6">
            <div class="d-grid">
                <button @onclick="Save" class="btn btn-lg btn-primary">@Loc["Save"]</button>
            </div>
        </div>
    </div>

</div>




@code {
    [Parameter] public EventCallback<List<SortableColumn>> OnValidSubmit { get; set; }

    //private ProtectedSessionStorage SessionStorage { get; set; } = default!;
    private List<SortableColumn> Columns = new();
    private List<SortableColumn> BackupColumns = new();
    private List<DefaultColumnsSettingDto> ColumnsList = new();

    private bool IsTitleColumn(SortableColumn column)
    {
        return column.Field == "Title";
    }
    private void OnColumnDrop(int oldIndex, int newIndex)
    {
        var movedColumn = OrderedColumns[oldIndex];

        Columns.Remove(movedColumn);
        Columns.Insert(newIndex, movedColumn);

        // Update order so UI stays consistent
        for (int i = 0; i < Columns.Count; i++)
            Columns[i].Order = i;

        StateHasChanged();
    }

    private List<SortableColumn> OrderedColumns =>
    Columns
    .Where(c => c.IsVisible)
    .OrderBy(c => c.Order)
    .ToList();

    private bool IsFirst(SortableColumn column)
    {
        return Columns
        .OrderBy(c => c.Order)
        .FirstOrDefault() == column;
    }
    private bool IsLast(SortableColumn column)
    {
        return Columns
        .OrderBy(c => c.Order)
        .LastOrDefault() == column;
    }
    private void ToggleVisibility(SortableColumn column, ChangeEventArgs e)
    {
        if (column == null)
            return;


        if (e.Value is bool isChecked)
        {
            column.IsVisible = isChecked;
        }
    }

