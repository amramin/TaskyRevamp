

@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Pages.SystemConfiguration.TypeSetting
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.TaskViews
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject TypeSettingConsumer _typeSettingConsumer
@inject ILocalStorageService LocalStorageService

@inject PopupService PopupService


<div class="column-options-panel">

    @foreach (var column in Columns.OrderBy(c => c.Order))
    {
        <div class="column-row">

            <!-- Drag Handle -->
            <span class="drag-handle">☰</span>

            <!-- Column Name -->
            <span class="column-name">@column.DisplayName</span>

            <!-- Up Arrow -->
            <button class="icon-btn"
                    disabled="@IsFirst(column)"
                    @onclick="() => MoveUp(column)">
                ▲
            </button>

            <!-- Down Arrow -->
            <button class="icon-btn"
                    disabled="@IsLast(column)"
                    @onclick="() => MoveDown(column)">
                ▼
            </button>

            <!-- Show / Hide Toggle -->
            <input type="checkbox"
                   checked="@column.IsVisible"
                  
                   @onchange="e => ToggleVisibility(column, e)" />
        </div>
    }

</div>
<div class="actions">
    <button class="btn btn-primary" @onclick="Save">Save</button>
    <button class="btn btn-secondary" @onclick="Cancel">Cancel</button>
</div>


