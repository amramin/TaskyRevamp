    private void Cancel()
    {
        Columns = BackupColumns
        .Select(c => new SortableColumn
        {
            Field = c.Field,
            DisplayName = c.DisplayName,
            Order = c.Order,
            IsVisible = c.IsVisible,

        })
        .ToList();
        PopupService.Hide();
    }

    protected async override Task OnInitializedAsync()
    {

        //check if session has data
        var olddata = await GetColumns();
        if (olddata != null && olddata.Count > 0)
        {
            Columns = olddata.OrderBy(c => c.Order).ToList();
        }
        else
        {
            //if yes load from session else load default

            var all = await GetDefaultColumns();
            Columns = all.ToList();
        }
        BackupColumns = Columns
        .Select(c => new SortableColumn
        {
            Field = c.Field,
            DisplayName = c.DisplayName,
            Order = c.Order,
            IsVisible = c.IsVisible,

        })
        .ToList();



        var res = await _defaultColumnsSettingConsumer.GetDefaultColumnsSettings();
        if (res.Success)
        {
            var settings = res.Data;
            if (settings != null)
            {
                ColumnsList = settings;
            }

        }
        // ColumnsList = res.Data;

        // Filter and order by settings
        Columns = Columns
        .Where(c => ColumnsList.Any(s => s.IsActive &&
        string.Equals(s.NameEnglish, c.Field, StringComparison.OrdinalIgnoreCase)))
        .OrderBy(c => ColumnsList
        .First(s => string.Equals(s.NameEnglish, c.Field, StringComparison.OrdinalIgnoreCase))
        .Order ?? int.MaxValue)
        .ToList();
        StateHasChanged();
