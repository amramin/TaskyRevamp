    private void MoveUp(SortableColumn column)
    {
        var index = Columns.IndexOf(column);
        if (index <= 0) return;

        (Columns[index - 1], Columns[index]) =
        (Columns[index], Columns[index - 1]);

        UpdateOrder();
    }

    private void MoveDown(SortableColumn column)
    {
        var index = Columns.IndexOf(column);
        if (index >= Columns.Count - 1) return;

        (Columns[index + 1], Columns[index]) =
        (Columns[index], Columns[index + 1]);

        UpdateOrder();
    }

    private void UpdateOrder()
    {
        for (int i = 0; i < Columns.Count; i++)
            Columns[i].Order = i;
    }


}