        // departmentDtos = departs.Data;
        // var tsks = await _taskConsumer.GetTasksForDDL();

        // allTaskDtos = tsks.Data;
        // var ress = await _prioritySettingConsumer.GetPriorities();
        // if (ress.Success && ress.Data != null)
        // {
        //     Priorities = ress.Data;
        // }
        var addTaskSettingsTask = _addTaskSettingConsumer.GetAddTaskSettings();
        var taskTypesTask = _typeSettingConsumer.GetTaskTypesForDDL();
        var taskSourcesTask = _sourceSettingConsumer.GetTaskSourcesForDDL();
        var usersTask = _userConsumer.GetUsers();
        var departmentsTask = _departmentConsumer.GetDepartmentsForDDL();
        var tasksTask = _taskConsumer.GetTasksForDDL();
        var prioritiesTask = _prioritySettingConsumer.GetPriorities();

        // Run all in parallel
        await Task.WhenAll(
            addTaskSettingsTask,
            taskTypesTask,
            taskSourcesTask,
            usersTask,
            departmentsTask,
            tasksTask,
            prioritiesTask
        );

        // Read results safely
        var addTaskSettingsRes = await addTaskSettingsTask;
        if (addTaskSettingsRes.Success && addTaskSettingsRes.Data != null)
        {
            AddTaskSettings = addTaskSettingsRes.Data;
        }

        taskTypeDtos = (await taskTypesTask).Data;
        taskSourceDtos = (await taskSourcesTask).Data;
        userDtos = (await usersTask).Data;
        departmentDtos = (await departmentsTask).Data;
        allTaskDtos = (await tasksTask).Data;

        var prioritiesRes = await prioritiesTask;
        if (prioritiesRes.Success && prioritiesRes.Data != null)
        {
            Priorities = prioritiesRes.Data;
        }

        taskdto.StartDate = taskdto.StartDate == default ? DateTime.Now : taskdto.StartDate;
        taskdto.EndDate = taskdto.EndDate == default ? DateTime.Now : taskdto.EndDate;
        taskdto.ReminderDate = taskdto.ReminderDate == default ? DateTime.Now : taskdto.ReminderDate;
        x = true;
        await InvokeAsync(StateHasChanged);

    }

    private void ValidateDynamicFields(object sender, ValidationRequestedEventArgs e)
    {
        ValidateDynamicFields((EditContext)sender);
    }

    private void ValidateDynamicFields(EditContext context)
    {
        // Clear previous messages
        messageStore.Clear();

        foreach (var column in AddTaskSettings.Where(c => c.IsMandatory))
        {
            // Map column name to property name in CreateTaskDto
            // e.g., "Start Date" -> "StartDate"
            string propName = column.NameEnglish.Replace(" ", "").Trim();
            var prop = typeof(CreateTaskDto).GetProperty(propName);
            if (prop == null)
                continue;

            var value = prop.GetValue(taskdto);
            bool isEmpty = false;

            if (value == null)
            {
                isEmpty = true;
            }
            else
            {
                var type = prop.PropertyType;

                // String
                if (type == typeof(string))
                {
                    isEmpty = string.IsNullOrWhiteSpace(value as string);
                }
                // Guid / Nullable<Guid>
                else if (type == typeof(Guid) || type == typeof(Guid?))
                {
                    isEmpty = (Guid)value == Guid.Empty;
                }
                // DateTime / Nullable<DateTime>
                else if (type == typeof(DateTime) || type == typeof(DateTime?))
                {
                    isEmpty = value == null;
                }
                // Numeric types (optional: you can treat 0 as invalid if needed)
                else if (type == typeof(int) || type == typeof(int?) ||
                type == typeof(double) || type == typeof(double?) ||
                type == typeof(decimal) || type == typeof(decimal?))
                {
                    // Example: consider 0 as invalid
                    // isEmpty = Convert.ToDecimal(value) == 0;
                }
                // Collections (List<Guid>, List<string>, etc.)
                else if (typeof(System.Collections.IEnumerable).IsAssignableFrom(type)
                && type != typeof(string))
                {
                    var enumerable = (System.Collections.IEnumerable)value;
                    isEmpty = !enumerable.Cast<object>().Any();
                }
            }

            if (isEmpty)
            {
                var fieldId = new FieldIdentifier(taskdto, prop.Name);
                // Optional: use column.DisplayName for friendly message
                messageStore.Add(fieldId, $"{column.NameEnglish} is required.");
            }
        }

        // Notify EditContext to refresh validation messages
        context.NotifyValidationStateChanged();
    }


    private async Task HandleValidSubmit(EditContext context)
    {
        // proceed with saving
        await OnValidSubmit.InvokeAsync(context);
    }

    private void HandleInvalidSubmit(EditContext context)
    {
        ToastService.ShowToastAsync("Please fill all required fields before submitting", "error");

    }

