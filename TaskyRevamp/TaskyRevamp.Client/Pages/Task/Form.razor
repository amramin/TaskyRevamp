@implements IDisposable
@using System.Globalization
@using System.Linq.Expressions
@using Stingray.Components.MultiSelectComponent
@using System.Reflection
@using Syncfusion.Blazor
@using Syncfusion.Blazor.Calendars
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.ChecklistItem
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums;
@using TaskyRevamp.Dto.TaskAttachment
@using TaskyRevamp.Dto.TaskChecklist
@using TaskyRevamp.Dto.TaskDto
@using TaskyRevamp.Dto.TaskSourceDto
@using TaskyRevamp.Dto.TaskTypeDto
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject TaskConsumer _taskConsumer
@inject TypeSettingConsumer _typeSettingConsumer
@inject Microsoft.Extensions.Options.IOptions<MySettings> mySettings
@inject DepartmentConsumer _departmentConsumer
@inject AddTaskSettingConsumer _addTaskSettingConsumer
@inject PrioritySettingConsumer _prioritySettingConsumer
@inject SourceSettingConsumer _sourceSettingConsumer
@inject FileManagementService fileManagementService
@inject UserConsumer _userConsumer
@inject TaskAttachmentConsumer _taskAttachmentConsumer

@if (x)
{
    <EditForm EditContext="@editContext" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <div class="offcanvas-body ">
            @foreach (var column in AddTaskSettings.Where(c => c.IsActive).OrderBy(c => c.Order))
            {
                <div @key="column.Id">
                    @switch (column.NameEnglish)
                    {
                        case "File upload":
                            <div class="mb-3">
                                <label class="form-label">
                                    @Loc["uploadFile"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger"> *</span>
                                    }
                                </label>
                                <div id="dropZone" class="file-uploader">
                                    <InputFile id="fileInput" OnChange="LoadFile" multiple
                                               accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.csv,.jpg,.jpeg,.png" />
                                    <label for="fileInput">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.FileUpload"></SVGCrud>
                                        </span>
                                        <div>
                                            @Loc["Drag and Drop or"],
                                            <span class="primary"> @Loc["AddFileAttachment"]</span>
                                        </div>
                                    </label>
                                </div>
                                <ValidationMessage class="small text-danger" For="@(() => taskdto.BrowserFiles)"></ValidationMessage>
                                @if (uploadedFiles.Any())
                                {
                                    <div class="mt-3">
                                        <h6 class="mb-2">Uploaded Files (@uploadedFiles.Count)</h6>
                                        <div class="list-group">
                                            @foreach (var file in uploadedFiles)
                                            {
                                                <div class="list-group-item d-flex align-items-center justify-content-between">
                                                    <div class="d-flex align-items-center flex-grow-1 me-2">
                                                        <div class="flex-grow-1">
                                                            <div class="fw-medium">@file.Name</div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            break;
                        case "Title":
                            <div class="mb-3">
                                <label class="form-label">
                                    @Loc["Title"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger"> *</span>
                                    }
                                </label>
                                <InputText class="form-control" @bind-Value="taskdto.Title" placeholder="@Loc["TitleEnglish"]" />
                                <ValidationMessage class="small text-danger" For="@(() => taskdto.Title)"></ValidationMessage>
                            </div>
                            break;
                        case "Description":
                            <div class="mb-3">
                                <label class="form-label">
                                    @Loc["Description"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger"> *</span>
                                    }
                                </label>
                                <div class="col-lg-12">
                                    <div class="mb-2">
                                        <RichTextEditorComponent @key="column.Id" EditorId="RTE_English2"
                                                                 @ref="RichTextEditorComponentRefDescriptionEnglish" ContentChanged="OnDescriptionChanged"
                                                                 Content="@taskdto.Description" ButtonText="@Loc["AddDescription"]">
                                        </RichTextEditorComponent>
                                        <ValidationMessage class="small text-danger" For="@(() => taskdto.Description)" />
                                    </div>
                                </div>
                            </div>
                            break;
                        case "Type":
                            <div class="mb-3">
                                <label class="form-label">
                                    @Loc["Type"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger"> *</span>
                                    }
                                </label>
                                <SearchableSingleDropdownOffline TInput=TypeDto TOutput=Guid?
                                                                 TextSelector="(TypeDto x) => x.DisplayedName" OutputSelector="x => x.Id" Datasource="taskTypeDtos"
                                                                 MinCharacterCount="1" SelectedOption="@taskdto.TypeId" SelectedOptionChanged="OnTypeChanged"
                                                                 SearchInputPlaceHolder="@Loc["Search"]" PlaceHolder="@($"{Loc["Select"]}")"
                                                                 NoMatchPlaceHolder="@Loc["NoResultsFound"]" />
                                <ValidationMessage class="small text-danger" For="@(() => taskdto.TypeId)" />
                            </div>
                            break;
                        case "Source":
                            <label class="form-label">
                                @Loc["Source"]
                                @if (column.IsMandatory)
                                {
                                    <span class="text-danger"> *</span>
                                }
                            </label>
                            <div class="mb-3">
                                <SearchableSingleDropdownOffline TInput=SourceDto TOutput=Guid?
                                                                 TextSelector="(SourceDto x) => x.DisplayedName" OutputSelector="x => x.Id"
                                                                 Datasource="taskSourceDtos" MinCharacterCount="1" SelectedOption="@taskdto.SourceId"
                                                                 SelectedOptionChanged="OnSourceChanged" SearchInputPlaceHolder="@Loc["Search"]"
                                                                 PlaceHolder="@($"{Loc["Select"]}")" NoMatchPlaceHolder="@Loc["NoResultsFound"]" />
                                <ValidationMessage class="small text-danger" For="@(() => taskdto.SourceId)"></ValidationMessage>
                            </div>
                            break;
                        case "Start date":
                            <div class="mb-3">
                                <label class="form-label" for="fromDate">
                                    @Loc["FromDate"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger"> *</span>
                                    }
                                </label>

                                <div class="date-group w-100" dir="@dateGroupDir" style="cursor:pointer" @onclick="OpenStratDatePicker">
                                    <SfDatePicker @ref="startDatePicker" @key="column.Id" TValue="DateTime?"
                                                  @bind-Value="taskdto.StartDate" Locale="@datePickerLocale" EnableRtl="@enableRtl"
                                                  Format="dd-MM-yyyy" Placeholder="@placeholderDate" ShowClearButton="true">
                                    </SfDatePicker>
                                </div>
                                <ValidationMessage class="small text-danger mt-1" For="@(() => taskdto.StartDate)" />
                            </div>
                            break;
                        case "Reminder date":
                            <div class="mb-3">
                                <label class="form-label" for="fromDate">
                                    @Loc["ReminderDate"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger"> *</span>
                                    }
                                </label>

                                <div class="date-group" dir="@dateGroupDir" style="cursor:pointer" @onclick="OpenReminderDatePicker">
                                    <SfDatePicker @ref="ReminderDatePicker" @key="column.Id" TValue="DateTime?"
                                                  @bind-Value="taskdto.ReminderDate" Locale="@datePickerLocale" EnableRtl="@enableRtl"
                                                  Format="dd-MM-yyyy" Placeholder="@placeholderDate" ShowClearButton="true">
                                    </SfDatePicker>
                                </div>
                                <ValidationMessage class="small text-danger mt-1" For="@(() => taskdto.ReminderDate)" />
                            </div>
                            break;
                        case "End date":
                            <div class="mb-3">
                                <label class="form-label" for="toDate">
                                    @Loc["EndDate"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger"> *</span>
                                    }
                                </label>
                                <div class="date-group" dir="@dateGroupDir" style="cursor:pointer" @onclick="OpenEndDatePicker">
                                    <SfDatePicker @ref="EndDatePicker" @key="column.Id" TValue="DateTime?" @bind-Value="taskdto.EndDate"
                                                  Locale="@datePickerLocale" EnableRtl="@enableRtl" Format="dd-MM-yyyy"
                                                  Placeholder="@placeholderDate" ShowClearButton="true">
                                    </SfDatePicker>
                                </div>
                                <ValidationMessage class="small text-danger" For="@(() => taskdto.EndDate)" />
                            </div>
                            break;
                        case "Department":
                            <div class="mb-3">
                                <label class="form-label">
                                    @Loc["AssignedToDepartmentForm"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <SearchableMultiDropdownOffline TInput=DepartmentDto TOutput="Guid" Datasource=departmentDtos
                                                                TextSelector=@(x=>x.NameEnglish) OutputSelector="x=> x.Id"
                                                                SelectedOptions="@taskdto.AssignedDepartmentIds" SelectedOptionsChanged="OnDepartmentsChanged"
                                                                SearchInputPlaceHolder="@Loc["Search"]" PlaceHolder="@($"{Loc["Select"]}")"
                                                                NoMatchPlaceHolder="@Loc["NoResultsFound"]" SelectAllPlaceHolder="@Loc["SelectAll"]"
                                                                AllowSelectAll="departmentDtos.Any()" MinCharacterCount="1" />
                                <ValidationMessage class="small text-danger mt-1" For="@(() => taskdto.AssignedDepartmentIds)">
                                </ValidationMessage>
                            </div>
                            break;
                        case "Dependency":
                            <div class="mb-3">
                                <label class="form-label">
                                    @Loc["Dependency"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <SearchableMultiDropdownOffline TInput=CreateTaskDto TOutput="Guid" Datasource=allTaskDtos
                                                                TextSelector=@(x=>x.Title) OutputSelector="x=> x.Id" MinCharacterCount="1"
                                                                SelectedOptions="@taskdto.Dependencies" SelectedOptionsChanged="OnDependenciesChanged"
                                                                SearchInputPlaceHolder="@Loc["Search"]" PlaceHolder="@($"{Loc["Select"]}")"
                                                                NoMatchPlaceHolder="@Loc["NoResultsFound"]" SelectAllPlaceHolder="@Loc["SelectAll"]"
                                                                AllowSelectAll="allTaskDtos.Any()" />
                                <ValidationMessage class="small text-danger mt-1" For="@(() => taskdto.Dependencies)">
                                </ValidationMessage>
                            </div>
                            break;
                        case "Assigned to":
                            <div class="mb-3">
                                <label class="form-label">
                                    @Loc["AssigneduserNames"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger">*</span>
                                    }
                                </label>
                                <SearchableMultiDropdownOffline TInput=UserDto TOutput="Guid" Datasource=userDtos
                                                                TextSelector=@(x=>x.DisplayedName) OutputSelector="x=> x.Id" MinCharacterCount="1"
                                                                SelectedOptions="@taskdto.AssignedIds" SelectedOptionsChanged="OnAssigneesChanged"
                                                                SearchInputPlaceHolder="@Loc["Search"]" PlaceHolder="@($"{Loc["Select"]}")"
                                                                NoMatchPlaceHolder="@Loc["NoResultsFound"]" SelectAllPlaceHolder="@Loc["SelectAll"]"
                                                                AllowSelectAll="userDtos.Any()" />
                                <ValidationMessage class="small text-danger mt-1" For="@(() => taskdto.AssignedIds)" />
                            </div>
                            break;
                        case "Comments":
                            <div class="mb-3">
                                <div class="col-lg-12">
                                    <div class="mb-2">
                                        <label class="form-label">
                                            @Loc["Comments"]
                                            @if (column.IsMandatory)
                                            {
                                                <span class="text-danger"> *</span>
                                            }
                                        </label>
                                        <RichTextEditorComponent @key="column.Id" EditorId="RTE_English4"
                                                                 @ref="RichTextEditorComponentRefComment" ContentChanged="OnCommentsChanged"
                                                                 Content="@taskdto.Content" ButtonText="@Loc["AddComment"]"></RichTextEditorComponent>
                                        <div class="d-flex align-items-center justify-content-between">
                                            @if (column.IsMandatory)
                                            {
                                                <div class="d-flex gap-2">
                                                    <ValidationMessage class="small text-danger" For="@(() => taskdto.Content)" />
                                                </div>
                                            }
                                        </div>
                                    </div>

                                </div>
                            </div>
                            break;
                        case "Checklist":
                            <div class="mb-3">
                                <label class="form-label">@Loc["Checklist"]</label>
                                @if (column.IsMandatory)
                                {
                                    <span class="text-danger"> *</span>
                                }
                                @foreach (var checklist in taskdto.Checklists)
                                {
                                    <div class="border rounded p-2 mb-2">
                                        <InputText class="form-control mb-2" Value="@checklist.Title"
                                                   ValueChanged="@(v => OnChecklistTitleChanged(checklist, v))" ValueExpression="() => checklist.Title" />
                                        <ValidationMessage For="@(() => checklist.Title)" class="small text-danger mb-2" />
                                        @foreach (var item in checklist.Items)
                                        {
                                            <div class="d-flex mb-1">
                                                <InputText class="form-control me-2" Value="@item.Title"
                                                    ValueChanged="@(v => OnChecklistItemTitleChanged(item, v))" ValueExpression="() => item.Title" />
                                                <button type="button" class="btn btn-sm btn-danger" @onclick="() => RemoveChecklistItem(checklist, item)">✖</button>
                                            </div>
                                            <ValidationMessage For="@(() => item.Title)" class="small text-danger" />
                                        }
                                        <button type="button" class="btn btn-sm btn-light" @onclick="() => AddChecklistItem(checklist)">@Loc["AddItem"]</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => RemoveChecklist(checklist)">✖</button>
                                    </div>
                                }
                                <div class="me-2">
                                <button type="button" class="btn btn-sm btn-light me-2" @onclick="AddChecklist">@Loc["Add Checklist"]</button>
                                </div>
                                @if (column.IsMandatory)
                                {
                                    <div class="d-flex align-items-center justify-content-between">
                                        @if (column.IsMandatory)
                                        {
                                            <div class="d-flex gap-2">
                                                <ValidationMessage class="small text-danger" For="@(() => taskdto.Checklists)" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                            break;
                        case "Priority":
                            <div class="mb-3">
                                <label class="form-label">
                                    @Loc["Priority2"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger"> *</span>
                                    }
                                </label>
                                <SearchableSingleDropdownOffline TInput=PriorityDto TOutput=Guid
                                                                 TextSelector=" (PriorityDto x)=> x.Name" OutputSelector="x => x.Id" Datasource="Priorities"
                                                                 MinCharacterCount="1" SelectedOption="@taskdto.Priority" SelectedOptionChanged="OnPriorityChanged"
                                                                 SearchInputPlaceHolder="@Loc["Search"]" PlaceHolder="@($"{Loc["Select"]}")"
                                                                 NoMatchPlaceHolder="@Loc["NoResultsFound"]" />
                                <ValidationMessage class="small text-danger mt-1" For="@(() => taskdto.Priority)" />
                            </div>
                            break;
                        case "Weight":
                            <div class="mb-3">
                                <div class="mb-3">
                                    <label class="form-label" for="maxLength">
                                        @Loc["weight"]
                                        @if (column.IsMandatory)
                                        {
                                            <span class="text-danger"> *</span>
                                        }
                                    </label>
                                    <InputText class="form-control" @bind-Value="weightInput" @oninput="OnWeightInputChanged" />
                                    <ValidationMessage class="small text-danger mt-1" For="@(() => taskdto.weight)" />

                                </div>
                            </div>
                            break;
                        case "Actual progress":
                            <div class="mb-3">
                                <label class="form-label" for="maxLength">
                                    @Loc["ActualProgress"]
                                    @if (column.IsMandatory)
                                    {
                                        <span class="text-danger"> *</span>
                                    }
                                </label>
                                <div class="mb-3">
                                    <input type="range" class="form-range" min="0" max="100" value="@taskdto.ActualProcess"
                                           @oninput="OnActualProgressChanged"
                                           disabled="@(taskdto.ActualProcess >= 100 && !AlllowedToChangeProgress.Any(p => p == taskdto.TaskStatus))" />
                                    <span class="badge bg-primary"> @taskdto.ActualProcess% </span>
                                    <div class="progress mt-2" style="height: 20px;">
                                        <div class="progress-bar" role="progressbar" style="width:@taskdto.ActualProcess%;"
                                             aria-valuenow="@taskdto.ActualProcess" aria-valuemin="0" aria-valuemax="100">
                                        </div>
                                    </div>
                                    <ValidationMessage class="small text-danger" For="@(() => taskdto.ActualProcess)" />
                                </div>
                            </div>
                            break;
                    }
                </div>
            }
        </div>
        <div class="offcanvas-footer">
            <div class="row g-2">
                <div class="col-6">
                    <div class="d-grid">
                        <button type="button" class="btn btn-lg btn-light" @onclick="OnCancelClick">@Loc["Cancel"]</button>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-grid">
                        <button type="submit" class="btn btn-lg btn-primary">@SaveButton</button>
                    </div>
                </div>
            </div>

        </div>
    </EditForm>
}

@code {
    [Parameter] public CreateTaskDto taskdto { set; get; }
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string ButtonText { get; set; }
    [Parameter] public string SaveButton { get; set; }
    public List<AddTaskSettingDto> AddTaskSettings { get; set; } = new List<AddTaskSettingDto>();
    private EditContext editContext;
    SearchableSingleDropdownOffline<TypeDto, Guid> typeref { set; get; }
    SearchableSingleDropdownOffline<SourceDto, Guid> sourceref { set; get; }
    SearchableMultiDropdownOffline<DepartmentDto, Guid> departRef { set; get; }
    private ValidationMessageStore messageStore;
    private Dictionary<string, object?> formData = new();
    public List<PriorityDto> Priorities = new List<PriorityDto>();
    List<TypeDto> taskTypeDtos = new List<TypeDto>();
    List<SourceDto> taskSourceDtos = new List<SourceDto>();
    List<DepartmentDto> departmentDtos = new List<DepartmentDto>();
    List<CreateTaskDto> allTaskDtos = new List<CreateTaskDto>();
    string placeholderDate = CultureInfo.CurrentCulture.Name.StartsWith("ar") ? "yyyy-mm-dd" : "dd-mm-yyyy";
    private RichTextEditorComponent RichTextEditorComponentRefComment;
    private RichTextEditorComponent RichTextEditorComponentRefDescriptionEnglish;
    bool x;
    private RichTextEditorComponent RichTextEditorComponentRefDescriptionArabic;
    long maxFileSize;
    bool notvald;
    private bool isRtlCulture;
    private string datePickerLocale = "en";
    private bool enableRtl = false;
    private string dateGroupDir = "ltr";
    List<UserDto> userDtos = new List<UserDto>();
    string ErroMessage;
    string PhotoErroMessage;
    string fileErroMessage;
    private InputFile? inputFile;
    private List<IBrowserFile> uploadedFiles = new List<IBrowserFile>();
    private bool _dropZoneInitialized;
    private SfDatePicker<DateTime?> startDatePicker;
    private SfDatePicker<DateTime?> ReminderDatePicker;
    private SfDatePicker<DateTime?> EndDatePicker;
    private string weightInput;
    List<Guid> AlllowedToChangeProgress = new List<Guid>()
    {
        Guid.Parse("547022EA-EF8C-4FBC-2236-08DE3318A61C"),
        Guid.Parse("9843AF9D-1389-4740-B428-08DE3D8A77AB"),
        Guid.Parse("753404A6-8B18-43F7-2238-08DE3318A61C"),
        Guid.Parse("270A78EB-C5CA-475D-2239-08DE3318A61C")
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (x && !_dropZoneInitialized)
        {
            _dropZoneInitialized = true;
            await fileManagementService.InitDropZone("dropZone", "fileInput");
        }
    }
    private Task LoadFile(InputFileChangeEventArgs args)
    {
        var files = args.GetMultipleFiles(int.MaxValue).ToList();
        return UploadFiles(files);
    }
    private Task UploadFiles(List<IBrowserFile> files)
    {
        if (!files.Any()) return Task.CompletedTask;
        var validFiles = new List<IBrowserFile>();
        var field = new FieldIdentifier(taskdto, nameof(taskdto.BrowserFiles));
        messageStore.Clear(field);
        const long maxFileSize = 26214400;
        foreach (var file in files)
        {
            var validationRes = fileManagementService.ValidateUploadedFile(file, maxFileSize);
            if (validationRes.NotValid)
            {
                messageStore.Add(field, validationRes.ValidationMessage);
                editContext.NotifyValidationStateChanged();
                continue;
            }
            validFiles.Add(file);
            uploadedFiles.Add(file);
        }
        if (!validFiles.Any())
            return Task.CompletedTask;
        foreach (var file in validFiles)
            taskdto.BrowserFiles.Add(file);
        StateHasChanged();
        return Task.CompletedTask;
    }
    private async Task OpenStratDatePicker() => await startDatePicker.ShowPopupAsync();
    private async Task OpenReminderDatePicker() => await ReminderDatePicker.ShowPopupAsync();
    private async Task OpenEndDatePicker() => await EndDatePicker.ShowPopupAsync();
    private void OnContentChanged(string html)
    {
        taskdto.Content = html;
    }
    private void OnContentDescriptionArabicChanged(string html)
    {
        taskdto.Description = html;
    }
    private void OnDescriptionEnglishChanged(string html)
    {
        taskdto.Description = html;
    }
    private void OnCommentsChanged()
    {
        taskdto.Content = RichTextEditorComponentRefComment.GetContent();
        Notify(new FieldIdentifier(taskdto, nameof(taskdto.Content)));
    }
    private void OnDescriptionChanged()
    {
        taskdto.Description = RichTextEditorComponentRefDescriptionEnglish.GetContent();
        Notify(new FieldIdentifier(taskdto, nameof(taskdto.Description)));
    }
    private void OnPriorityChanged(Guid value)
    {
        taskdto.Priority = value;
        var filedId = new FieldIdentifier(taskdto, nameof(taskdto.Priority));
        Notify(filedId);
    }
    private void OnTypeChanged(Guid? value)
    {
        taskdto.TypeId = value;
        var filedId = new FieldIdentifier(taskdto, nameof(taskdto.TypeId));
        Notify(filedId);
    }
    private void OnSourceChanged(Guid? value)
    {
        taskdto.SourceId = value;
        var filedId = new FieldIdentifier(taskdto, nameof(taskdto.SourceId));
        Notify(filedId);
    }
    private void OnDepartmentsChanged(List<Guid> values)
    {
        taskdto.AssignedDepartmentIds = values != null ? new List<Guid>(values) : new List<Guid>();
        var field = new FieldIdentifier(taskdto, nameof(taskdto.AssignedDepartmentIds));
        Notify(field);
    }
    private void OnAssigneesChanged(List<Guid> values)
    {
        taskdto.AssignedIds = values != null ? new List<Guid>(values) : new List<Guid>();
        var field = new FieldIdentifier(taskdto, nameof(taskdto.AssignedIds));
        Notify(field);
    }
    private void OnDependenciesChanged(List<Guid> values)
    {
        taskdto.Dependencies = values;
        var field = new FieldIdentifier(taskdto, nameof(taskdto.Dependencies));
        Notify(field);
    }
    private void OnActualProgressChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var value))
        {
            taskdto.ActualProcess = value;
            var field = new FieldIdentifier(taskdto, nameof(taskdto.ActualProcess));
            Notify(field);
        }
    }
    private void OnWeightInputChanged(ChangeEventArgs e)
    {
        weightInput = e.Value?.ToString();
        var field = new FieldIdentifier(taskdto, nameof(taskdto.weight));
        messageStore.Clear(field);
        var weightColumn = AddTaskSettings.FirstOrDefault(c => c.NameEnglish == "Weight");
        bool isMandatory = weightColumn?.IsMandatory == true;
        if (string.IsNullOrWhiteSpace(weightInput))
        {
            taskdto.weight = null;
            if (isMandatory)
                messageStore.Add(field, Loc["Required"]);
            editContext.NotifyValidationStateChanged();
            return;
        }
        weightInput = weightInput.Replace(",", ".");
        if (!int.TryParse(weightInput, NumberStyles.Any, CultureInfo.InvariantCulture, out var value))
        {
            messageStore.Add(field, Loc["WeightMustBeBetween0And100"]);
            editContext.NotifyValidationStateChanged();
            return;
        }
        if (value % 1 != 0)
        {
            messageStore.Add(field, Loc["WeightMustBeBetween0And100"]);
            editContext.NotifyValidationStateChanged();
            return;
        }
        if (value < 0 || value > 100)
        {
            messageStore.Add(field, Loc["WeightMustBeBetween0And100"]);
            editContext.NotifyValidationStateChanged();
            return;
        }
        taskdto.weight = value;
        editContext.NotifyValidationStateChanged();
    }
    private void Notify(FieldIdentifier field)
    {
        messageStore.Clear(field);
        editContext.NotifyFieldChanged(field);
        editContext.Validate();
    }
    protected async override Task OnInitializedAsync()
    {
        isRtlCulture = CultureInfo.CurrentCulture.TwoLetterISOLanguageName.Equals("ar", StringComparison.OrdinalIgnoreCase);
        datePickerLocale = isRtlCulture ? "ar" : "en";
        enableRtl = isRtlCulture;
        dateGroupDir = isRtlCulture ? "rtl" : "ltr";

        editContext = new EditContext(taskdto);        
        messageStore = new ValidationMessageStore(editContext);
        editContext.OnValidationRequested += ValidateDynamicFields;
        editContext.OnFieldChanged += OnFieldChanged;
        maxFileSize = mySettings.Value.MaxFileSize;

        var addTaskSettingsTask = _addTaskSettingConsumer.GetAddTaskSettings();
        var taskTypesTask = _typeSettingConsumer.GetTaskTypesForDDL();
        var taskSourcesTask = _sourceSettingConsumer.GetTaskSourcesForDDL();
        var usersTask = _userConsumer.GetUsers();
        var departmentsTask = _departmentConsumer.GetDepartmentsForDDL();
        var tasksTask = _taskConsumer.GetTasksForDDL(taskdto.Id);
        var prioritiesTask = _prioritySettingConsumer.GetPriorities();

        // Run all in parallel
        await Task.WhenAll(
        addTaskSettingsTask,
        taskTypesTask,
        taskSourcesTask,
        usersTask,
        departmentsTask,
        tasksTask,
        prioritiesTask
        );
        var addTaskSettingsRes = await addTaskSettingsTask;
        if (addTaskSettingsRes.Success && addTaskSettingsRes.Data != null)
        {
            AddTaskSettings = addTaskSettingsRes.Data;
        }
        taskTypeDtos = (await taskTypesTask).Data!.Where(k => (k.IsDeleted != true && k.IsActive)).ToList();
        taskSourceDtos = (await taskSourcesTask).Data!.Where(k => (k.IsDeleted != true && k.IsActive)).ToList();
        userDtos = (await usersTask).Data!;
        departmentDtos = (await departmentsTask).Data!;
        allTaskDtos = (await tasksTask).Data!;

        var prioritiesRes = await prioritiesTask;
        if (prioritiesRes.Success && prioritiesRes.Data != null)
        {
            Priorities = prioritiesRes.Data.Where(k => k.IsDeleted != true).ToList().OrderBy(q => q.Order).ToList();
        }
        x = true;
        await InvokeAsync(StateHasChanged);
    }
    private void OnFieldChanged(object sender, FieldChangedEventArgs e)
    {
        var field = e.FieldIdentifier;
        switch (field.FieldName)
        {
            case nameof(taskdto.StartDate):
            case nameof(taskdto.EndDate):
                ValidateDateRange();
                break;
        }
        editContext.NotifyValidationStateChanged();
    }
    private void ValidateDateRange()
    {
        var startField = new FieldIdentifier(taskdto, nameof(taskdto.StartDate));
        messageStore.Clear(startField);
        if (taskdto.StartDate.HasValue && taskdto.EndDate.HasValue && taskdto.StartDate > taskdto.EndDate)
            messageStore.Add(startField, Loc["StartDateMustBeBeforeEndDate"]);
    }
    private void ValidateDynamicFields(object sender, ValidationRequestedEventArgs e)
    {
        messageStore.Clear();
        if (taskdto.AssignedDepartmentIds == null || !taskdto.AssignedDepartmentIds.Any())
            messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.AssignedDepartmentIds)), Loc["Required"]);
        if (taskdto.AssignedIds == null || !taskdto.AssignedIds.Any())
            messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.AssignedIds)), Loc["Required"]);
        foreach (var column in AddTaskSettings.Where(c => c.IsMandatory))
        {
            switch (column.NameEnglish)
            {
                case "File upload":
                    if (column.IsMandatory && (taskdto.BrowserFiles == null || !taskdto.BrowserFiles.Any()))
                        messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.BrowserFiles)), Loc["Required"]);
                    break;
                case "Description":
                    if (column.IsMandatory && string.IsNullOrWhiteSpace(taskdto.Description))
                        messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.Description)), Loc["Required"]);
                    break;
                case "Type":
                    if (column.IsMandatory && !taskdto.TypeId.HasValue)
                        messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.TypeId)), Loc["Required"]);
                    break;
                case "Source":
                    if (column.IsMandatory && !taskdto.SourceId.HasValue)
                        messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.SourceId)), Loc["Required"]);
                    break;
                case "Priority":
                    if (column.IsMandatory && taskdto.Priority == Guid.Empty)
                        messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.Priority)), Loc["Required"]);
                    break;
                case "Reminder date":
                    var field = new FieldIdentifier(taskdto, nameof(taskdto.ReminderDate));
                    if (column.IsMandatory && !taskdto.ReminderDate.HasValue)
                        messageStore.Add(field, Loc["Required"]);
                    else if (taskdto.ReminderDate.HasValue && taskdto.StartDate.HasValue && taskdto.EndDate.HasValue)
                    {
                        if (taskdto.ReminderDate < taskdto.StartDate || taskdto.ReminderDate > taskdto.EndDate)
                            messageStore.Add(field, Loc["ReminderDateBetweenStartAndEnd"]);
                    }
                    break;
                case "Dependency":
                    if (column.IsMandatory && (taskdto.Dependencies == null || !taskdto.Dependencies.Any()))
                        messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.Dependencies)), Loc["Required"]);
                    break;
                case "Weight":
                    if (column.IsMandatory && !taskdto.weight.HasValue)
                        messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.weight)), Loc["Required"]);
                    break;
                case "Comments":
                    if (column.IsMandatory && string.IsNullOrWhiteSpace(taskdto.Content))
                        messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.Content)), Loc["Required"]);
                    break;
                case "Actual progress":
                    var progressField = new FieldIdentifier(taskdto, nameof(taskdto.ActualProcess));
                    if (column.IsMandatory && (taskdto.ActualProcess < 0 || taskdto.ActualProcess > 100))
                        messageStore.Add(progressField, Loc["Required"]);
                    break;
                case "Checklist":
                    if (column.IsMandatory)
                    {
                        if (taskdto.Checklists == null || !taskdto.Checklists.Any())
                            messageStore.Add(new FieldIdentifier(taskdto, nameof(taskdto.Checklists)), Loc["Required"]);
                        foreach (var checklist in taskdto.Checklists!)
                        {
                            if (string.IsNullOrWhiteSpace(checklist.Title))
                                messageStore.Add(new FieldIdentifier(checklist, nameof(checklist.Title)), Loc["Required"]);
                            foreach (var item in checklist.Items)
                            {
                                if (string.IsNullOrWhiteSpace(item.Title))
                                    messageStore.Add(new FieldIdentifier(item, nameof(item.Title)), Loc["Required"]);
                            }
                        }
                    }
                    break;
            }
        }
        ValidateDateRange();
        editContext.NotifyValidationStateChanged();
    }
    private void AddChecklist()
    {
        taskdto.Checklists.Add(new TaskChecklistDto
        {
            Title = "",
            Items = new List<ChecklistItemDto>()
        });;
    }
    private void AddChecklistItem(TaskChecklistDto checklist)
    {
        checklist.Items.Add(new ChecklistItemDto
        {
            Title = "",
            IsDone = false
        });
    }
    private void RemoveChecklistItem(TaskChecklistDto checklist, ChecklistItemDto item)
    {
        checklist.Items.Remove(item);
        var field = new FieldIdentifier(checklist, nameof(checklist.Items));
        Notify(field);
    }
    private void RemoveChecklist(TaskChecklistDto checklist)
    {
        taskdto.Checklists.Remove(checklist);
        var field = new FieldIdentifier(taskdto, nameof(taskdto.Checklists));
        Notify(field);
    }
    private void OnChecklistTitleChanged(TaskChecklistDto checklist, string value)
    {
        checklist.Title = value;
        var field = new FieldIdentifier(checklist, nameof(checklist.Title));
        Notify(field);
    }
    private void OnChecklistItemTitleChanged(ChecklistItemDto item, string value)
    {
        item.Title = value;
        var field = new FieldIdentifier(item, nameof(item.Title));
        Notify(field);
    }
    private async Task HandleValidSubmit(EditContext context)
    {
        if (RichTextEditorComponentRefDescriptionEnglish != null)
            taskdto.Description = RichTextEditorComponentRefDescriptionEnglish.GetContent();
        if (RichTextEditorComponentRefComment != null)
            taskdto.Content = RichTextEditorComponentRefComment.GetContent();
        var isValid = editContext.Validate();
        if (!isValid){ StateHasChanged(); return; }
        await OnValidSubmit.InvokeAsync(context);
    }
    private async Task OnCancelClick() => await OnCancel.InvokeAsync();
    public void Dispose()
    {
        if (editContext != null)
        {
            editContext.OnValidationRequested -= ValidateDynamicFields!;
            editContext.OnFieldChanged -= OnFieldChanged!;
        }
    }
}