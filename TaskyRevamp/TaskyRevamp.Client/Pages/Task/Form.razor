@using System.Globalization
@using System.Linq.Expressions
@using Stingray.Components.MultiSelectComponent
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.SystemConfiguration

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums;
@using TaskyRevamp.Dto.SystemConfiguration;
@using TaskyRevamp.Dto.TaskDto
@using TaskyRevamp.Dto.TaskSourceDto
@using TaskyRevamp.Dto.TaskTypeDto
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject TaskConsumer _taskConsumer
@inject TypeSettingConsumer _typeSettingConsumer

@inject DepartmentConsumer _departmentConsumer
@inject AddTaskSettingConsumer _addTaskSettingConsumer
@inject PrioritySettingConsumer _prioritySettingConsumer
@inject SourceSettingConsumer _sourceSettingConsumer

@inject UserConsumer _userConsumer
<EditForm Model="@taskdto" EditContext="@editContext"
          OnValidSubmit="HandleValidSubmit"
          OnInvalidSubmit="HandleInvalidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="row">
        @foreach (var column in AddTaskSettings.Where(c => c.IsActive).OrderBy(c => c.Order))
        {
            switch (column.NameEnglish)
            {
                case "Title":

                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["TitleEnglish"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>
                        <InputText class="form-control" @bind-Value="taskdto.TitleEnglish" placeholder="@Loc["NameEnglish"]" />
                        <ValidationMessage class="small text-danger" For="@(() => taskdto.TitleEnglish)"></ValidationMessage>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["TitleArabic"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>
                        <InputText class="form-control" @bind-Value="taskdto.TitleArabic" placeholder="@Loc["NameEnglish"]" />
                        <ValidationMessage class="small text-danger" For="@(() => taskdto.TitleArabic)"></ValidationMessage>
                    </div>

                    break;


                case "Description":

                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["DescriptionEnglish"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>

                        <div class="col-lg-12">
                            <div class="mb-2">


                                <RichTextEditorComponent EditorId="RTE_English2" @ref="RichTextEditorComponentRefDescriptionEnglish"
                                                         Content="@taskdto.DescriptionEnglish"
                                                         ContentChanged="OnDescriptionEnglishChanged"></RichTextEditorComponent>

                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex gap-2">
                                        <ValidationMessage class="small text-danger" For="@(() => taskdto.DescriptionEnglish)" />
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["DescriptionArabic"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>

                        <div class="col-lg-12">
                            <div class="mb-2">


                                <RichTextEditorComponent EditorId="RTE_English3" @ref="RichTextEditorComponentRefDescriptionEnglish"
                                                         Content="@taskdto.DescriptionArabic"
                                                         ContentChanged="OnContentDescriptionArabicChanged"></RichTextEditorComponent>

                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex gap-2">
                                        <ValidationMessage class="small text-danger" For="@(() => taskdto.DescriptionArabic)" />
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>

                    break;
                case "Type":
                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["SelectType"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>
                        <SearchableSingleDropdownOffline TInput=TypeDto
                                                         TOutput=Guid
                                                         TextSelector="(TypeDto x)=> x.DisplayedName"
                                                         OutputSelector="x => x.Id"
                                                         Datasource="taskTypeDtos"
                                                         MinCharacterCount="1"
                                                         @bind-SelectedOption="@taskdto.TypeId"
                                                         PlaceHolder="@($"--{Loc["SelectType"]}--")" />

                    </div>
                    break;
                case "Source":
                    <label class="form-label">
                        @Loc["SelectSource"]
                        @if (column.IsMandatory)
                        {
                            <span class="text-danger"> *</span>
                        }
                    </label>
                    <div class="mb-3">
                        <SearchableSingleDropdownOffline TInput=SourceDto
                                                         TOutput=Guid
                                                         TextSelector="(SourceDto x)=> x.DisplayedName"
                                                         OutputSelector="x => x.Id"
                                                         Datasource="taskSourceDtos"
                                                         MinCharacterCount="1"
                                                         @bind-SelectedOption="@taskdto.SourceId"
                                                         PlaceHolder="@($"--{Loc["SelectSource"]}--")" />

                    </div>
                    break;

                case "Start Date":
                    <div class="mb-3">
                        <label class="form-label" for="fromDate">
                            @Loc["FromDate"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>

                        <div class="date-group">
                            <InputDate class="form-control" id="fromDate" @bind-Value="taskdto.StartDate" />
                        </div>
                        <ValidationMessage class="small text-danger" For="@(() => taskdto.StartDate)" />
                    </div>
                    break;


                case " Reminder Date":
                    <div class="mb-3">
                        <label class="form-label" for="fromDate">
                            @Loc["ReminderDate"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>

                        <div class="date-group">
                            <InputDate class="form-control" id="fromDate" @bind-Value="taskdto.ReminderDate" />
                        </div>
                        <ValidationMessage class="small text-danger" For="@(() => taskdto.ReminderDate)" />
                    </div>
                    break;
                case "End Date":
                    <div class="mb-3">
                        <label class="form-label" for="toDate">
                            @Loc["ToDate"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>
                        <div class="date-group">
                            <InputDate class="form-control" id="toDate" @bind-Value="taskdto.EndDate" />
                        </div>
                        <ValidationMessage class="small text-danger" For="@(() => taskdto.EndDate)" />

                    </div>
                    break;
                case "Department":
                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["AssignedToDepartment"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>
                        <SearchableMultiDropdownOffline TInput=DepartmentDto TOutput="Guid" Datasource=departmentDtos
                                                        TextSelector=@(x=>x.NameEnglish) OutputSelector="x=> x.Id" @bind-SelectedOptions=taskdto.AssignedDepartmentIds />
                    </div>
                    break;
                case "Dependency ":
                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["Dependency"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>
                        <SearchableMultiDropdownOffline TInput=CreateTaskDto TOutput="Guid" Datasource=allTaskDtos
                                                        TextSelector=@(x=>x.Title) OutputSelector="x=> x.Id" @bind-SelectedOptions=taskdto.Dependencies />
                    </div>
                    break;
                case "Assigned To":
                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["AssignedTo"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>
                        <SearchableMultiDropdownOffline TInput=UserDto TOutput="Guid" Datasource=userDtos
                                                        TextSelector=@(x=>x.UserName) OutputSelector="x=> x.Id" @bind-SelectedOptions=taskdto.AssignedIds />
                    </div>
                    break;

                case "Checklist":
                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["Checklist"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger">*</span>
                            }
                        </label>

                    </div>

                    break;
                case "Comments":

                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["Comments"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>

                        <div class="col-lg-12">
                            <div class="mb-2">
                                <label class="form-label">
                                    @Loc["Comment"]
                                    <span class="text-danger"> *</span>
                                </label>

                                <RichTextEditorComponent EditorId="RTE_English4" @ref="RichTextEditorComponentRefComment"
                                                         Content="@taskdto.Content"
                                                         ContentChanged="OnContentChanged"></RichTextEditorComponent>

                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex gap-2">
                                        <ValidationMessage class="small text-danger" For="@(() => taskdto.Content)" />
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                    break;
                case "Priority":
                    <div class="mb-3">
                        <label class="form-label">
                            @Loc["SelectPriority"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>
                        <SearchableSingleDropdownOffline TInput=PriorityDto
                                                         TOutput=Guid
                                                         TextSelector=" (PriorityDto x)=> x.Name"
                                                         OutputSelector="x => x.Id"
                                                         Datasource="Priorities"
                                                         MinCharacterCount="1"
                                                         @bind-SelectedOption="@taskdto.Priority"
                                                         PlaceHolder="@($"--{Loc["SelectPriority"]}--")" />
                    </div>
                    break;

                case "Weight":
                    <div class="mb-3">
                        <div class="mb-3">
                            <label class="form-label" for="maxLength">
                                @Loc["Weight"]
                            </label>
                            <InputNumber class="form-control" min="0" max="100" id="maxLength" @bind-Value="taskdto.weight" />
                            <ValidationMessage class="small text-danger" For="@(() => taskdto.weight)" />

                        </div>

                    </div>
                    break;



                case "Actual Progress":
                    <div class="mb-3">
                        <label class="form-label" for="maxLength">
                            @Loc["ActualProgress"]
                            @if (column.IsMandatory)
                            {
                                <span class="text-danger"> *</span>
                            }
                        </label>
                        <div class="mb-3">

                            <input type="range" class="form-range"
                                   min="0" max="100"
                                   @bind="taskdto.ActualProcess" />

                            <!-- Optional visual bar to match -->
                            <div class="progress" style="height: 20px;">
                                <div class="progress-bar" role="progressbar"
                                     style="width:@taskdto.ActualProcess%;"
                                     aria-valuenow="@taskdto.ActualProcess"
                                     aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>

                        </div>

                    </div>
                    break;

            }

        }
    </div>

    <button class="btn btn-primary mt-3" type="submit">Submit</button>
</EditForm>

@code {
    [Parameter] public CreateTaskDto taskdto { set; get; }

    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    [Parameter] public string ButtonText { get; set; }
    public List<AddTaskSettingDto> AddTaskSettings { get; set; } = new List<AddTaskSettingDto>();
    private EditContext editContext;
    private ValidationMessageStore messageStore;
    private Dictionary<string, object?> formData = new();
    public List<PriorityDto> Priorities = new List<PriorityDto>();

    List<TypeDto> taskTypeDtos = new List<TypeDto>();
    List<SourceDto> taskSourceDtos = new List<SourceDto>();
    List<DepartmentDto> departmentDtos = new List<DepartmentDto>();
    List<CreateTaskDto> allTaskDtos = new List<CreateTaskDto>();
    private RichTextEditorComponent RichTextEditorComponentRefComment;
    private RichTextEditorComponent RichTextEditorComponentRefDescriptionEnglish;

    private RichTextEditorComponent RichTextEditorComponentRefDescriptionArabic;

    List<UserDto> userDtos = new List<UserDto>();
    private void OnContentChanged(string html)
    {
        taskdto.Content = html;
    }
    private void OnContentDescriptionArabicChanged(string html)
    {
        taskdto.DescriptionArabic = html;
    }
    private void OnDescriptionEnglishChanged(string html)
    {
        taskdto.DescriptionEnglish = html;
    }
    protected async override Task OnInitializedAsync()
    {

        var res = await _addTaskSettingConsumer.GetAddTaskSettings();
        if (res.Success)
        {
            var settings = res.Data;
            if (settings != null)
            {
                AddTaskSettings = settings;
            }

        }
        var typs = await _typeSettingConsumer.GetTaskTypesForDDL();
        taskTypeDtos = typs.Data;
        var sorce = await _sourceSettingConsumer.GetTaskSourcesForDDL();
        taskSourceDtos = sorce.Data;
        var users = await _userConsumer.GetUsers();
        userDtos = users.Data;
        var departs = await _departmentConsumer.GetDepartmentsForDDL();
        departmentDtos = departs.Data.ToList();
        var tsks = await _taskConsumer.GetTasksForDDL();

        allTaskDtos = tsks.Data.ToList();
        var ress = await _prioritySettingConsumer.GetPriorities();
        if (ress.Success && ress.Data != null)
        {
            Priorities = ress.Data;
        }
        StateHasChanged();

    }

    private void ValidateDynamicFields(object sender, ValidationRequestedEventArgs e)
    {
        ValidateDynamicFields((EditContext)sender);
    }

    private void ValidateDynamicFields(EditContext context)
    {
        // Clear previous messages
        messageStore.Clear();

        foreach (var column in AddTaskSettings.Where(c => c.IsMandatory))
        {
            // Map column name to property name in CreateTaskDto
            // e.g., "Start Date" -> "StartDate"
            string propName = column.NameEnglish.Replace(" ", "").Trim();
            var prop = typeof(CreateTaskDto).GetProperty(propName);
            if (prop == null)
                continue;

            var value = prop.GetValue(taskdto);
            bool isEmpty = false;

            if (value == null)
            {
                isEmpty = true;
            }
            else
            {
                var type = prop.PropertyType;

                // String
                if (type == typeof(string))
                {
                    isEmpty = string.IsNullOrWhiteSpace(value as string);
                }
                // Guid / Nullable<Guid>
                else if (type == typeof(Guid) || type == typeof(Guid?))
                {
                    isEmpty = (Guid)value == Guid.Empty;
                }
                // DateTime / Nullable<DateTime>
                else if (type == typeof(DateTime) || type == typeof(DateTime?))
                {
                    isEmpty = value == null;
                }
                // Numeric types (optional: you can treat 0 as invalid if needed)
                else if (type == typeof(int) || type == typeof(int?) ||
                         type == typeof(double) || type == typeof(double?) ||
                         type == typeof(decimal) || type == typeof(decimal?))
                {
                    // Example: consider 0 as invalid
                    // isEmpty = Convert.ToDecimal(value) == 0;
                }
                // Collections (List<Guid>, List<string>, etc.)
                else if (typeof(System.Collections.IEnumerable).IsAssignableFrom(type)
                         && type != typeof(string))
                {
                    var enumerable = (System.Collections.IEnumerable)value;
                    isEmpty = !enumerable.Cast<object>().Any();
                }
            }

            if (isEmpty)
            {
                var fieldId = new FieldIdentifier(taskdto, prop.Name);
                // Optional: use column.DisplayName for friendly message
                messageStore.Add(fieldId, $"{column.NameEnglish} is required.");
            }
        }

        // Notify EditContext to refresh validation messages
        context.NotifyValidationStateChanged();
    }


    private async Task HandleValidSubmit(EditContext context)
    {
        // proceed with saving
        await OnValidSubmit.InvokeAsync(context);
    }

    private void HandleInvalidSubmit(EditContext context)
    {
        ToastService.ShowToastAsync("Please fill all required fields before submitting", "error");

    }

}







