    private async Task LoadFile(InputFileChangeEventArgs args)
    {

        string base64String = "";

        try
        {

            var file = args.GetMultipleFiles()[0];
            //   const long maxSize = 25 * 1024 * 1024; // 25MB
            var fileExtension = Path.GetExtension(file.Name).ToLower();

            var validRes =  taskyService.ValidateUploadedFile(file, fileExtension);
            notvald = validRes.NotValid;
            if (notvald)
            {
                fileErroMessage = validRes.ValidationMessage;
                ToastService.ShowToastAsync(fileErroMessage, "error");

                StateHasChanged();
                return;
            }
            taskdto.PhotoName = file.Name;
            await using MemoryStream fs = new MemoryStream();
            await file.OpenReadStream(maxFileSize).CopyToAsync(fs);
            byte[] somBytes = GetBytes(fs);
            base64String = Convert.ToBase64String(somBytes, 0, somBytes.Length);
            taskdto.PhotoBase64 = base64String;
            taskdto.Extention = fileExtension;
        }

        catch (Exception e)
        {
        }
        //  string newFileName=Path.ChangeExtension
    }

    public static byte[] GetBytes(Stream stream)
    {
        var bytes = new byte[stream.Length];
        stream.Seek(0, SeekOrigin.Begin);
        stream.ReadAsync(bytes, 0, bytes.Length);
        stream.Dispose();
        return bytes;
    }
