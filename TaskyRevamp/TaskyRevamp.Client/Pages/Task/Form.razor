    private async Task LoadFile(InputFileChangeEventArgs args)
    {
        var files = args.GetMultipleFiles().ToList();
        await UploadFiles(files);

    }
    private async Task UploadFiles(List<IBrowserFile> files)
    {
        if (!files.Any()) return;
        var validFiles = new List<IBrowserFile>();
        var hasErrors = false;
        foreach (var file in files)
        {
            var validationRes = fileManagementService.ValidateUploadedFile(file, maxFileSize);
            if (validationRes.NotValid)
            {


                await ToastService.ShowToastAsync(validationRes.ValidationMessage, "error");
                continue;
            }
            validFiles.Add(file);
            uploadedFiles.Add(file);
        }
        if (!validFiles.Any())
        {
            return;
        }
        StateHasChanged();

        var attachmentDtos = new List<UploadAttachmentDto>();
        foreach (var file in validFiles)
        {
            StateHasChanged();
            var (bytes, name, type) = await fileManagementService.ReadFileAsync(file);
            if (bytes != null && bytes.Length > 0)
            {
                attachmentDtos.Add(new UploadAttachmentDto
                {
                    FileName = name,
                    Bytes = bytes,
                    Size = bytes.LongLength
                });
            }
        }
        taskdto.uploadAttachmentDtos = attachmentDtos;
        StateHasChanged();
    }
