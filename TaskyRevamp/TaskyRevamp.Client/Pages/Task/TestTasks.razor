@page "/tasks"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.GeneralDto
@using TaskyRevamp.Localization.Resources
@inject HttpClient Http
@inject PopupService PopupService
@inject ToastService ToastService
@inject LoaderService LoaderService
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResources> Loc
@inject AccountConsumer AccountConsumer
<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">Create Task</h1>
    </div>
</div>
<div class="page-body">
    <input @bind="title" placeholder="Title" />
    <input @bind="description" placeholder="Description" />
    <button @onclick="CreateTask">Create</button>

    <h3>Update Status</h3>
    <input @bind="taskId" placeholder="Task ID" />
    <select @bind="status">
        <option value="Pending">Pending</option>
        <option value="InProgress">In Progress</option>
        <option value="Completed">Completed</option>
    </select>
    <button @onclick="UpdateStatus">Update</button>

    <br />
    <button @onclick="ShowConfirmationPopupDelete">Show Confirmation Popup Delete</button>
    <button @onclick="ShowConfirmationPopupTrash">Show Confirmation Popup Trash</button>
    <button @onclick="ShowInvalidPopup">Show Invalid Popup</button>
    <button @onclick="ShowNewPopup">Show New Popup</button>
    <button @onclick="ShowStandardPopup">Show Standard Popup</button>

    <br />
    <button class="btn btn-primary" @onclick="ShowToast">Show Toast Message</button>

    <br />
    <button @onclick="TestLoader">Test Loader</button>

    <br />
    <h3>Users</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Users)
            {
                <tr>
                    <td>@user.userNameEN</td>
                    <td>@user.Email</td>
                </tr>
            }
        </tbody>
    </table>

    <Pagination CurrentPage="@currentPage"
                TotalPages="@totalPages"
                TotalCount="@totalCount"
                PageSize="@pageSize"
                PageChanged="ChangePage"
                PageSizeChangedCallback="ChangePageSize" />

</div>


@code {
    string title = "";
    string description = "";
    string taskId = "";
    string status = "Pending";
    string message = "";

    async Task CreateTask()
    {
        var dto = new { Title = title, Description = description };
        var response = await Http.PostAsJsonAsync("api/tasks", dto);

        await HandleResponse(response);
    }

    async Task UpdateStatus()
    {
        var dto = new { TaskId = Guid.Parse(taskId), Status = status };
        var response = await Http.PutAsJsonAsync("api/tasks/status", dto);

        await HandleResponse(response);
    }

    async Task HandleResponse(HttpResponseMessage response)
    {
        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ApiResponse>();
            message = result?.Message ?? "";
        }
        else
        {
            var error = await response.Content.ReadFromJsonAsync<ValidationErrorResponse>();
            message = string.Join("\n", error?.Errors ?? []);
        }
    }

    public class ApiResponse
    {
        public string Message { get; set; }
    }

    public class ValidationErrorResponse
    {
        public List<string> Errors { get; set; }
    }

    private void ShowConfirmationPopupDelete()
    {
        PopupService.ShowConfirmation(
             "Are you sure you want to delete this task?",
            "Yes, Delete",
             async (confirmed) =>
             {
                 if (confirmed)
                     await CreateTask();
             },
             ConfirmationType.Danger
        );
    }
    private void ShowConfirmationPopupTrash()
    {
        PopupService.ShowConfirmation(
             "Are you sure you want to delete this task?",
             "Move to Trash",
             async (confirmed) =>
             {
                 if (confirmed)
                     await CreateTask();
             },
             ConfirmationType.Primary
        );
    }

    private void ShowInvalidPopup()
    {
        PopupService.ShowInvalid("This form contains errors.");
    }

    private void ShowNewPopup()
    {
        PopupService.ShowNew(@<div><h3>Hello from New Popup!</h3></div>);
    }
    private void ShowStandardPopup()
    {
        PopupService.ShowStandard(@<div><h3>Hello from New Popup!</h3></div>);
    }


    private async Task ShowToast()
    {
        // Perform your action here...
        await Task.Delay(500); // simulate work

        // Show toast
        await ToastService.ShowToastAsync(Loc[MessagesMap.DataSavedSuccessfully], "success");
    }

    private async Task TestLoader()
    {
        LoaderService.Show();
        await Task.Delay(2000);
        LoaderService.Hide();
    }


    // Pagination state
    private List<UserDto> Users = new();
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;

    // Called when user clicks on a page number / arrow
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadUsers();
    }

    // Called when user changes dropdown (items per page)
    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1; // reset to first page
        await LoadUsers();
    }

    // Always fetch users based on currentPage & pageSize
    private async Task LoadUsers()
    {
        var resp = await AccountConsumer.GetUsers(currentPage, pageSize);
        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        Users = data.Items.ToList();
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
    }



}
