@using TaskyRevamp.Dto.TaskDto
@inject IStringLocalizer<SharedResources> Loc

<div class="page-header">
    <div class="title-block">
        <button class="btn btn-action-24" @onclick="OnGoBack">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.BackArrow"></SVGCrud>
            </span>
        </button>
        <h1 class="page-headline">@Task?.Title</h1>
    </div>
    @if (ShowViewedBy && Task?.ViewdByNames != null && Task.ViewdByNames.Any())
    {
        <div class="d-flex align-items-center gap-1">
            <span class="headline-8">@Loc["ViewedBy"]</span>
            <ul class="initials-list">
                @{
                    var visibleViewers = Task.ViewdByNames.Take(2).ToList();
                    var remainingCount = Task.ViewdByNames.Count - 2;
                }
                @foreach (var viewer in visibleViewers)
                {
                    <li class="initial @(viewer.IsActive ? "" : "opacity-75")" style="z-index: @(visibleViewers.IndexOf(viewer));"
                        title="@viewer.FullName" data-bs-toggle="tooltip">
                        <span>@GetInitials(viewer.FullName)</span>
                    </li>
                }
                @if (remainingCount > 0)
                {
                    <li class="dropdown more-user">
                        <button class="btn btn-more" @onclick="ShowAllViewers" data-bs-toggle="tooltip">
                            <span class="fw-semibold">+@remainingCount</span>
                        </button>
                    </li>
                }
            </ul>
        </div>
    }
</div>

@if (showViewersPopup && Task?.ViewdByNames != null)
{
    <div class="modal fade show d-block" tabindex="-1" @onclick="CloseViewersPopup">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@Loc["ViewedBy"]</h5>
                    <button type="button" class="btn-close" @onclick="CloseViewersPopup"></button>
                </div>
                <div class="modal-body">
                    <div class="list-group list-group-flush">
                        @foreach (var viewer in Task.ViewdByNames.OrderByDescending(v => v.ViewdAt))
                        {
                            <div class="border rounded mb-2 p-2
                                        d-flex align-items-center gap-3 @(viewer.IsActive ? "" : "text-muted bg-light")">
                                <div class="d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-semibold flex-shrink-0 @(viewer.IsActive ? "" : "bg-secondary opacity-75")"
                                     style="width: 48px; height: 48px; font-size: 16px;">
                                    <span>@GetInitials(viewer.FullName)</span>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="fw-semibold mb-1">
                                        @viewer.FullName
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public CreateTaskDto? Task { get; set; }
    [Parameter] public EventCallback OnGoBack { get; set; }
    [Parameter] public bool ShowViewedBy { get; set; }
    private bool showViewersPopup = false;

    private string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "?";

        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0].Substring(0, Math.Min(2, parts[0].Length)).ToUpper();

        return (parts[0][0].ToString() + parts[^1][0].ToString()).ToUpper();
    }
    private void ShowAllViewers()
    {
        showViewersPopup = true;
    }

    private void CloseViewersPopup()
    {
        showViewersPopup = false;
    }
}