@using TaskyRevamp.Dto.TaskDto
@inject IStringLocalizer<SharedResources> Loc

<div class="card mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center"
         style="cursor: pointer;"
         @onclick="ToggleSection">
        <h5 class="mb-0">Details</h5>
        <span>@(ShowSection ? "▼" : "▲")</span>
    </div>
    @if (ShowSection)
    {
        <div class="card-body">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-calendar3 fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["StartDate"]</small>
                            <span class="fw-medium">@Task?.StartDate.ToString(Loc["LocalizeDate"])</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-calendar-check fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["CreateDate"]</small>
                            <span class="fw-medium">@Task?.CreateDate?.ToString(Loc["LocalizeDate"])</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-calendar-x fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["EndDate"]</small>
                            <span class="fw-medium">@Task?.EndDate.ToString(Loc["LocalizeDate"])</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-box fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["weight"]</small>
                            <span class="fw-medium">@Task?.weight</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-box fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["Source"]</small>
                            <span class="fw-medium">@Task?.SourceName</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-clock fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["Duration"]</small>
                            <span class="fw-medium">@Task?.Duration</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-diagram-3 fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["Type"]</small>
                            <span class="fw-medium">@Task?.TypeName</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-building fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["AssignedToDepartment"]</small>
                            <span class="fw-medium">@Task?.AssignedDepartmentName</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-building fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["AssignedTo"]</small>
                            <div class="d-flex gap-2 flex-wrap">
                                @foreach (var name in (Task?.AssigneduserNames ?? "").Split(",", StringSplitOptions.RemoveEmptyEntries).Select(n => n.Trim()))
                                {
                                    <div style="width:35px; height:35px; border-radius:50%;border:1px solid gray; display:flex; align-items:center; justify-content:center; font-weight:bold;"
                                         title="@name">
                                            @GetInitials(name)
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-bar-chart fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["PlannedProgress"]</small>
                            <span class="fw-medium">@Task?.PlannedProgress</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-link-45deg fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["Dependency"]</small>
                            <span class="fw-medium">@Task?.Dependencies</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-graph-up fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["ActualWeight"]</small>
                            <span class="fw-medium">@Task?.ActualWeight</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-graph-up fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["PlannedWeight"]</small>
                            <span class="fw-medium">@Task?.Plannedweight</span>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-building fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["CreatedBy"]</small>
                            <div style="width:35px; height:35px; border-radius:50%;border:1px solid gray; display:flex; align-items:center; justify-content:center; font-weight:bold;"
                                 title="@Task?.CreatedByName">
                                @GetInitials(Task?.CreatedByName)
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="d-flex gap-3">
                        <i class="bi bi-building fs-5"></i>
                        <div>
                            <small class="text-muted d-block">@Loc["CreatedByDepartment"]</small>
                            <span class="fw-medium">@Task?.CreatorDepartment</span>
                        </div>
                    </div>
                </div>
                @if (Task?.ActualProcess == 100 && (Task?.TaskStatusName == "Pending Review" || Task?.TaskStatusName == "Completed"))
                {
                    <div class="col-md-6">
                        <div class="d-flex gap-3">
                            <i class="bi bi-building fs-5"></i>
                            <div>
                                <small class="text-muted d-block">@Loc["DeliveryDate"]</small>
                                <span class="fw-medium">@Task?.DeliveryDate?.ToString(Loc["LocalizeDate"])</span>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public bool ShowSection { get; set; }

    [Parameter]
    public EventCallback<bool> ShowSectionChanged { get; set; }

    [Parameter]
    public CreateTaskDto? Task { get; set; }

    private async Task ToggleSection()
    {
        ShowSection = !ShowSection;
        await ShowSectionChanged.InvokeAsync(ShowSection);
    }
    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();
        var first = parts[0][0];
        var last = parts[^1][0];
        return $"{char.ToUpper(first)}{char.ToUpper(last)}";
    }
}