@code {
    [Parameter] public bool ShowSection { get; set; }
    [Parameter] public EventCallback<bool> ShowSectionChanged { get; set; }
    [Parameter] public CreateTaskDto? Task { get; set; }

    private async Task ToggleSection()
    {
        ShowSection = !ShowSection;
        await ShowSectionChanged.InvokeAsync(ShowSection);
    }
    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();
        var first = parts[0][0];
        var last = parts[^1][0];
        return $"{char.ToUpper(first)}{char.ToUpper(last)}";
    }
}