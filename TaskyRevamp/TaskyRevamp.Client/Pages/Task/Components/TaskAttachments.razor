@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.TaskAttachment
@inject FileManagementService _fileManagementService
@inject TaskAttachmentConsumer _taskAttachmentConsumer
@inject PopupService PopupService
@inject ToastService ToastService
@inject IStringLocalizer<SharedResources> Loc

<div class="card">
    <div class="card-body">
        <h5 class="card-title mb-4">@Loc["Attachments"]</h5>

        <div id="dropZone" class="border border-2 border-dashed rounded p-5 text-center mb-4" style="background-color: #f8f9fa;">
            <button class="btn btn-link text-secondary p-1">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.FileUpload"></SVGCrud>
                </span>
            </button>
            <p class="mb-2">
                @Loc["Drag and Drop or"],
                <label for="fileInput" class="text-primary" style="cursor: pointer; text-decoration: underline;">
                    @Loc["AddAttachment"]
                </label>
            </p>
            <InputFile id="fileInput"
                       OnChange="HandleFileSelected"
                       multiple
                       class="d-none"
                       accept=".pdf,.docx,.doc,.ppt,.pptx,.jpeg,.jpg,.png,.txt,.csv,.json,.xml" />
            <div class="mt-3">
                <small class="text-muted d-block mb-1">
                    <i class="bi bi-info-circle me-1"></i>
                    @Loc["MaxSize"]: <strong>50 MB</strong>
                </small>
                <small class="text-muted">
                    <i class="bi bi-file-earmark me-1"></i>
                    @Loc["SupportedTypes"]: PDF, DOCX, DOC, PPT, PPTX, JPEG, PNG, TXT, CSV, JSON, XML
                </small>
            </div>
        </div>

        @if (isUploading)
        {
            <div class="d-flex align-items-center mb-4" role="alert">
                <div class="spinner-border spinner-border-sm me-2" role="status">
                </div>
            </div>
            <div>
                 @Loc["Uploading"] @if (!string.IsNullOrEmpty(uploadingFileName)) { <strong>@uploadingFileName</strong> }
            </div>
        }
        @if (!attachmentsDto.Any())
        {
            <div class="text-center text-muted py-4">
                <p class="mb-0">@Loc["NoAttachmentsYet"]</p>
            </div>
        }
        else
        {
            <h6 class="mb-3">@Loc["Uploads"]</h6>
            <div class="list-group">
                @foreach (var attachment in attachmentsDto)
                {
                    <div class="list-group-item d-flex align-items-center gap-3 py-3">
                        <!-- File Icon -->
                        <div class="flex-shrink-0">
                            <i class="@GetFileIcon(attachment.AttachmentDto.FileName) fs-2"></i>
                        </div>

                        <!-- File Info -->
                        <div class="flex-grow-1">
                            <h6 class="mb-1">@attachment.AttachmentDto.FileName</h6>
                            <small class="text-muted">
                                @Loc["CreatedBy"]: @attachment.CreatedByName
                                <span class="mx-1">•</span>
                                @GetFileSize(attachment.AttachmentDto.Size)
                                <span class="mx-1">•</span>
                                @attachment.AttachmentDto.CreateDate.ToString(Loc["LocalizeDate"])
                            </small>

                        </div>

                        <!-- Actions -->
                        <div class="d-flex gap-2">
                            @if (_fileManagementService.CanPreview(attachment.AttachmentDto.FileName))
                            {
                                <button class="btn btn-link text-primary p-1"
                                        @onclick="() => PreviewFile(attachment.AttachmentDto)"
                                        title="@Loc["Preview"]">
                                    <span class="icon">
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.OpenEye"></SVGCrud>
                                    </span>
                                </button>
                            }
                            <button class="btn btn-link text-secondary p-1"
                                    @onclick="() => DownloadFile(attachment.AttachmentDto)"
                                    title="@Loc["Download"]">
                                <span class="icon">
                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowDown"></SVGCrud>
                                </span>
                            </button>
                            <button class="btn btn-link text-danger p-1"
                                    @onclick="() => DeleteFile(attachment)"
                                    title="@Loc["Delete"]">
                                <span class="icon">
                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Reject"></SVGCrud>
                                </span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public Guid TaskId { get; set; }
    [Parameter] public EventCallback OnAttachmentChanged { get; set; }
    private List<AttachmentWithNameDto> attachmentsDto = new List<AttachmentWithNameDto>();
    private bool isUploading = false;
    private const long MaxFileSize = 50 * 1024 * 1024; // 50MB
    private bool showConfirm;
    private string uploadingFileName = string.Empty;
    private AttachmentWithNameDto? selectedAttachment;
    private bool isDragging = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await _fileManagementService.InitDropZone("dropZone", "fileInput");
        }
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadAttachments();
    }
    private async Task LoadAttachments()
    {
        var res = await _taskAttachmentConsumer.GetTaskAttachments(TaskId);
        if (res.Success && res.Data != null)
        {
            attachmentsDto = res.Data;
            StateHasChanged();
        }
    }
    private async Task HandleFileSelected(InputFileChangeEventArgs args)
    {
        var files = args.GetMultipleFiles().ToList();
        await UploadFiles(files);
    }
    private async Task UploadFiles(IEnumerable<IBrowserFile> files)
    {
        if (!files.Any()) return;
        var validFiles = new List<IBrowserFile>();
        var hasErrors = false;
        foreach (var file in files)
        {
            var validationRes = _fileManagementService.ValidateAttachment(file, MaxFileSize);
            if (validationRes.NotValid)
            {
                await ToastService.ShowToastAsync($"{file.Name}: {validationRes.ValidationMessage}", "error");
                hasErrors = true;
                continue;
            }
            validFiles.Add(file);
        }
        if (!validFiles.Any())
        {
            return;
        }
        isUploading = true;
        StateHasChanged();

        var attachmentDtos = new List<UploadAttachmentDto>();
        foreach (var file in validFiles)
        {
            uploadingFileName = file.Name;
            StateHasChanged();
            var (bytes, name, type) = await _fileManagementService.ReadFileAsync(file);
            if (bytes != null && bytes.Length > 0)
            {
                attachmentDtos.Add(new UploadAttachmentDto
                    {
                        FileName = name,
                        Bytes = bytes,
                        Size = bytes.LongLength
                    });
            }
        }

        if (attachmentDtos.Any())
        {
            var res = await _taskAttachmentConsumer.AddTaskAttachment(attachmentDtos, TaskId);
            if (res.Success)
            {
                await LoadAttachments();
                if (OnAttachmentChanged.HasDelegate)
                    await OnAttachmentChanged.InvokeAsync(null);
                await ToastService.ShowToastAsync(Loc["Added successfully"], "success");
            }
        }
        isUploading = false;
        uploadingFileName = string.Empty;
        StateHasChanged();
    }
    private async Task DownloadFile(AttachmentDto attachment)
    {
        var res = await _taskAttachmentConsumer.GetAttachmentInfo(attachment.FileId);
        if (res.Success)
        {
            var content = res.Data;
            if (content != null)
                await _fileManagementService.DownloadFile(content, attachment.FileName);
        }

    }
    private async Task PreviewFile(AttachmentDto attachment)
    {
        if (!_fileManagementService.CanPreview(attachment.FileName)) return;
        var res = await _taskAttachmentConsumer.GetAttachmentInfo(attachment.FileId);
        if (res.Success && res.Data != null)
        {
            var contentType = _fileManagementService.GetMimeType(attachment.FileName);
            await _fileManagementService.PreviewFile(res.Data, attachment.FileName, contentType);
        }

    }
    private void DeleteFile(AttachmentWithNameDto attachment)
    {
        PopupService.ShowConfirmation(@Loc["Sure"], @Loc["Confirm"], OnDeleteConfirmed, type: ConfirmationType.Danger);
        selectedAttachment = attachment;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedAttachment != null)
        {
            var result = await _taskAttachmentConsumer.DeleteAttachment(selectedAttachment.AttachmentDto.Id, selectedAttachment.AttachmentDto.FileId);
            if (result.Success)
            {
                attachmentsDto.Remove(selectedAttachment);
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
        }
        selectedAttachment = null;
    }
    private string GetFileIcon(string fileName) => _fileManagementService.GetFileIcon(fileName);
    private string GetFileSize(long bytes) => _fileManagementService.GetFileSize(bytes);
}
