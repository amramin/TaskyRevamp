@code {
    [Parameter]
    public CreateTaskDto? Task { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }
    [Parameter] public EventCallback OnReopenTask { get; set; }
    [Parameter] public EventCallback OnRequestNewEndDate{ get; set; }

    private Guid CurrentUser { get; set; }
    private int RejectionPeriod { get; set; } = 0;
    int progressold { get; set; }
    List<Guid> AlllowedToChangeProgress = new List<Guid>()
{
Guid.Parse("547022EA-EF8C-4FBC-2236-08DE3318A61C"),
Guid.Parse("9843AF9D-1389-4740-B428-08DE3D8A77AB"),
Guid.Parse("753404A6-8B18-43F7-2238-08DE3318A61C"),
Guid.Parse("270A78EB-C5CA-475D-2239-08DE3318A61C")
};
    protected override void OnParametersSet()
    {
        progressold = Task.ActualProcess;
    }
    private async Task HandleProgressChanged(int value)
    {
        if (Task == null)
            return;


        if (Task.ActualProcess >= 100 &&
            !AlllowedToChangeProgress.Any(p => p == Task.TaskStatus))
            return;

        var newProgress = value;

        PopupService.ShowConfirmation(
            @Loc["SureChangeProgress"],
            @Loc["Confirm"],
            async (confirmed) =>
            {
                if (confirmed)
                {
                    await ChangeProgressConfirmed(newProgress);
                }
                else
                {

                    Task.ActualProcess = progressold;
                    StateHasChanged();
                }
            },
            ConfirmationType.Other
        );
    }
