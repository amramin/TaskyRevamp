<!-- Checklist Section -->
@if (showChecklist)
{
    <div class="card mb-3 border-primary">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0"><i class="bi bi-check-square me-2"></i>Checklist</h6>
                <button class="btn btn-sm btn-link text-danger" @onclick="() => showChecklist = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="text-center text-muted py-3">
                <i class="bi bi-list-check fs-3 d-block mb-2"></i>
                Checklist feature coming soon
            </div>
        </div>
    </div>
}

