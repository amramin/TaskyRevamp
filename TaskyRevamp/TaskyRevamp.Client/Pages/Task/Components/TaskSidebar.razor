    public async Task ReopenTask(Guid id)
    {
        PopupService.ShowNew(@<ReopenTask Id="id" OnSaved="ReloadAfterSave"></ReopenTask>,Loc["ReOpen"]);

        // StateHasChanged();

    }
    public async Task RejectTask(Guid id)
    {
        PopupService.ShowNew(@<RejectTask Id="id" OnSaved="ReloadAfterSave"></RejectTask>,Loc["Reject"]);

        // StateHasChanged();

    }
    public async Task RequestChangeDueDate(CreateTaskDto task)
    {

        PopupService.ShowNew(@<RequestChangeDueDate task="task" OnSaved="ReloadRequestAfterSave"></RequestChangeDueDate>,Loc["RequestDueDate"]);


        // StateHasChanged();

    }
    private void Edit(Guid id) => PopupService.ShowNew(@<EditTask Id="id" OnValidSubmit="ReloadAfterSave"></EditTask>,
    headerText: @Loc["EditTask"]);

private async Task ReloadAfterSave()
    {
        await OnReopenTask.InvokeAsync();
        //currentPage = page;
    }
    private async Task ReloadRequestAfterSave()
    {
        await OnRequestNewEndDate.InvokeAsync();
        //currentPage = page;
    }
    private async Task<int> GetRejectionPeriod()
    {
        var res = await _rejectionSettingConsumer.GetRejectionSetting();
        int RejectionPeriod = 0;
        if (res.Success)
        {
            var setting = res.Data;
            if (res.Data is not null)
            {
                if (res.Data.CustomDays != null)
                {
                    RejectionPeriod = (int)res.Data.CustomDays;
                }
                else
                {
                    RejectionPeriod = (int)res.Data.PeriodType;
                }
            }
        }
        return RejectionPeriod;
    }
    private bool DisplayRejectButton(CreateTaskDto taskDto)
    {
        if (RejectionPeriod == 0)
        {
            return false;
        }
        else
        {
            if ((DateOnly.FromDateTime(taskDto.AssigneesData.FirstOrDefault(p => p.UserId == CurrentUser)?.AssigneeDate??DateTime.Now).AddDays(RejectionPeriod) <
            DateOnly.FromDateTime(DateTime.Now)) || !(taskDto.AssigneesData is not null && taskDto.AssigneesData!.Any(u => u.UserId == CurrentUser))
            || taskDto?.TaskStatus == Guid.Parse("6EE4574D-C439-45B4-223A-08DE3318A61C") || taskDto?.TaskStatus ==
            Guid.Parse("C8D504C7-9402-4F91-223C-08DE3318A61C"))
            {
                return false;
            }
            else
            {
                return true;
            }
        }
    }
    private bool IsRequestNewEndDate(CreateTaskDto taskDto)
    {
        if (!(taskDto.AssigneesData is not null && taskDto.AssigneesData!.Any(u => u.UserId == CurrentUser))
        || taskDto?.TaskStatus == Guid.Parse("6EE4574D-C439-45B4-223A-08DE3318A61C") || taskDto?.TaskStatus ==
        Guid.Parse("C8D504C7-9402-4F91-223C-08DE3318A61C") ||
        (taskDto.ChangeEndDateRequestCount > 0))
        {
            return false;
        }
        else
        {
            return true;
        }
    }
    private void FullProgrssChange()
    {
        Task.ActualProcess = 100;
        var progress = Task.ActualProcess;
        PopupService.ShowConfirmation(@Loc["SureChangeProgress"], @Loc["Confirm"],
        async (confirmed) =>
        {
            if (confirmed)
            {
                await ChangeProgressConfirmed(progress);
            }
            else
            {
                Task.ActualProcess = progressold;
                StateHasChanged();
            }
        },
        ConfirmationType.Other
        );
    }

    private async Task ChangeProgressConfirmed(int progress)
    {
        if (Task == null)
            return;


        if (Task.ActualProcess >= 100 &&
            !AlllowedToChangeProgress.Any(p => p == Task.TaskStatus))
            return;

        var result = await _taskConsumer.ChangeTaskProgress(Task.Id, progress);

        if (result.Success && result.Data)
        {
            Task.ActualProcess = progress;
            progressold = progress;
            await ToastService.ShowToastAsync(Loc["progressChangedsuccessfully"], "success");
            await OnConfirmed.InvokeAsync();
        }
        else
        {
            Task.ActualProcess = progressold;
            await ToastService.ShowToastAsync(Loc["DependencyError"], "error");
            await OnConfirmed.InvokeAsync();
        }

        StateHasChanged();
    }
    private string GetRemainingDays(CreateTaskDto task)
    {
        var today = DateOnly.FromDateTime(DateTime.Now).DayNumber;
        var expiry = DateOnly.FromDateTime(task.CreateDate ?? DateTime.Now)
        .AddDays(RejectionPeriod).DayNumber;
        var res = expiry - today;
        if (res == 1)
        {
            return $"({res} {Loc["Day"]})";
        }
        else
        {
            return $"({res} {Loc["Days"]})";
        }
    }
}