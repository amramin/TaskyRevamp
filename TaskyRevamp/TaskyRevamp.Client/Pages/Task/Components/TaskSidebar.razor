@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.TaskDto
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService
@inject TaskConsumer _taskConsumer
@inject ILocalStorageService LocalStorageService
@inject RejectionSettingConsumer _rejectionSettingConsumer
<!-- Progress -->
<div class="card mb-3">
    <div class="card-body">
@*         <small class="text-muted fw-semibold d-block mb-3">@lo</small> *@

        <!-- Actual Progress -->
        <div class="mb-3">
            <div class="d-flex justify-content-between mb-2">
                <small class="text-muted">@Loc["ActualProgress"]</small>
                <span class="fw-semibold">@Task?.ActualProcess%</span>
            </div>
            <div class="progress" style="height: 10px;">
                <div class="progress-bar bg-primary"
                     role="progressbar"
                     style="width: @Task?.ActualProcess%"
                     aria-valuenow="@Task?.ActualProcess"
                     aria-valuemin="0"
                     aria-valuemax="100"></div>
            </div>
            <input type="range"
                   class="form-range"
                   min="0"
                   max="100"
                   @bind-value="Task.ActualProcess"
                   @bind-value:event="oninput"
                   @onchange="OnProgressChanged"
                   disabled="@(Task.ActualProcess >= 100 && !AlllowedToChangeProgress.Any(p=>p==Task.TaskStatus))" />
        </div>
   
       @*  <small class="text-muted fw-semibold d-block mb-3">Add to card</small>
        <button class="btn btn-light w-100 text-start mb-2" @* @onclick="OnEditTask" >
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Menu"></SVGCrud>
            </span> Checklist
        </button>
        <button class="btn btn-light w-100 text-start mb-2"  @onclick="OnCompleteTask ">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowsUp"></SVGCrud>
            </span> Done
        </button>
        <button class="btn btn-light w-100 text-start mb-2" @* @onclick="OnReOpenTask" >
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
            </span>Edit a task
        </button>
        <button class="btn btn-light w-100 text-start mb-2" @* @onclick="OnRejectTask" >
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Reject"></SVGCrud>
            </span> Reject task
        </button>
        <button class="btn btn-light w-100 text-start mb-2" @* @onclick="OnDeleteTask" >
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
            </span>Delete task
        </button> *@
        @if (Task.ActualProcess < 100)
        {
            <button class="btn btn-light w-100 text-start mb-2" @onclick="FullProgrssChange" title="@Loc["FullProgress"]">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CloseArrow"></SVGCrud>  @Loc["FullProgress"]
                </span>
            </button>
        }
        @if (Task?.TaskStatus == Guid.Parse("6EE4574D-C439-45B4-223A-08DE3318A61C"))
        {
            <button class="btn btn-light w-100 text-start mb-2" @onclick="@(() => CompleteTask(Task.Id))" title="@Loc["Complete"]">
                 <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CompletedList"></SVGCrud>  @Loc["Complete"]
                </span>
            </button>
            <button class="btn btn-light w-100 text-start mb-2" @onclick="@(() => ReopenTask(Task.Id))" title="@Loc["ReOpen"]">
                 <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Repeat"></SVGCrud>  @Loc["ReOpen"]
                </span>
            </button>
        }
        @if (DisplayRejectButton(Task))
        {
            <button class="btn btn-light w-100 text-start mb-2" @onclick="@(() => RejectTask(Task.Id))" title="@Loc["Reject"]">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Reject"></SVGCrud>  @Loc["Reject"] - @GetRemainingDays(Task)
                </span>
            </button>
        }
        <button class="btn btn-light w-100 text-start mb-2" @onclick="@(() => Edit(Task.Id))" title="@Loc["Edit"]">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>  @Loc["Edit"]
            </span>
        </button>
        <button class="btn btn-light w-100 text-start mb-2" title="@Loc["Delete"]">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>  @Loc["Delete"]
            </span>
        </button>
    </div>
</div>

