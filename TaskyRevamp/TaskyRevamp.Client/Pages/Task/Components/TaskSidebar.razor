<!-- Checklist Section -->
@if (showChecklist)
{
    <div class="card mb-3 border-primary">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0"><i class="bi bi-check-square me-2"></i>Checklist</h6>
                <button class="btn btn-sm btn-link text-danger" @onclick="() => showChecklist = false">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>

            <div class="text-center text-muted py-3">
                <i class="bi bi-list-check fs-3 d-block mb-2"></i>
                Checklist feature coming soon
            </div>
        </div>
    </div>
}

@code {
    [Parameter]
    public CreateTaskDto? Task { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }
    int progressold  { get; set; }
    List<Guid> AlllowedToChangeProgress = new List<Guid>()
    {
        Guid.Parse("547022EA-EF8C-4FBC-2236-08DE3318A61C"),
        Guid.Parse("9843AF9D-1389-4740-B428-08DE3D8A77AB"),
        Guid.Parse("753404A6-8B18-43F7-2238-08DE3318A61C"),
        Guid.Parse("270A78EB-C5CA-475D-2239-08DE3318A61C")
    };
    protected override void OnParametersSet()
    {
        progressold = Task.ActualProcess;
    }
    // [Parameter]
    // public EventCallback OnEditTask { get; set; }

    // [Parameter]
    // public EventCallback OnRejectTask { get; set; }

    // [Parameter]
    // public EventCallback OnDeleteTask { get; set; }

    // [Parameter]
    // public EventCallback OnCompleteTask { get; set; }

    // [Parameter]
    // public EventCallback OnReOpenTask { get; set; }

    private bool showChecklist = false;

    private void ToggleChecklist()
    {
        showChecklist = !showChecklist;
    }
    private async Task CompleteConfirmed(Guid id)
    {
        var result = await _taskConsumer.CompleteTask(id);
        if (result.Success && result.Data)
        {
            await ToastService.ShowToastAsync(Loc["Completedsuccessfully"], "success");
            await OnConfirmed.InvokeAsync();

        }
        else
        {
            await ToastService.ShowToastAsync(Loc["CompleteFailed"], "danger");
        }

        StateHasChanged();
    }
    private void CompleteTask(Guid id)
    {
        PopupService.ShowConfirmation(
                @Loc["SureCompleteTask"],
                "Yes, Complete",
                async (confirmed) =>
                {
                    if (confirmed)
                        await CompleteConfirmed(id);
                },
                ConfirmationType.Primary
            );
    }
    private async Task ReopenConfirmed(Guid id)
    {
        var result = await _taskConsumer.ReopenTask(id);
        if (result.Success && result.Data)
        {
            await ToastService.ShowToastAsync(Loc["Reopenedsuccessfully"], "success");
            await OnConfirmed.InvokeAsync();

        }
        else
        {
            await ToastService.ShowToastAsync(Loc["ReopenFailed"], "danger");
        }

        StateHasChanged();
    }
    private void ReopenTask(Guid id)
    {
        PopupService.ShowConfirmation(
                @Loc["SureReopenTask"],
                "Yes, Reopen",
                async (confirmed) =>
                {
                    if (confirmed)
                        await ReopenConfirmed(id);
                },
                ConfirmationType.Primary
            );
    }
    private void OnProgressChanged(ChangeEventArgs args)
    {
        var progress = Task.ActualProcess;
        PopupService.ShowConfirmation(
        @Loc["SureChangeProgress"],
        "Yes, Changeprgreess",
        async (confirmed) =>
        {
            if (confirmed)
            {
                await ChangeProgressConfirmed(progress);
            }
            else
            {
                Task.ActualProcess = progressold;
                StateHasChanged();
            }
        },
        ConfirmationType.Primary
    );
    }
    private async Task ChangeProgressConfirmed(int progress)
    {
        var result = await _taskConsumer.ChangeTaskProgress(Task.Id,progress);
        if (result.Success && result.Data)
        {
            await ToastService.ShowToastAsync(Loc["progressChangedsuccessfully"], "success");
            await OnConfirmed.InvokeAsync();

        }
        else
        {
            await ToastService.ShowToastAsync(Loc["progressChangedFailed"], "danger");
        }

        StateHasChanged();
    }
}