@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.TaskChecklist
@using TaskyRevamp.Dto.TaskDto
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject NavigationManager navigationManager
@inject PopupService PopupService
@inject TaskConsumer _taskConsumer
@inject TaskChecklistConsumer _taskChecklistConsumer
@inject ILocalStorageService LocalStorageService
@inject RejectionSettingConsumer _rejectionSettingConsumer


<div class="mb-3">
    <OverallBar ActualProgress="Task?.ActualProcess" Width="605" OnProgressChanged="ChangeProgressConfirmed">
    </OverallBar>
</div>

<div class="task-action-buttons">
    @if (Task != null && (Task.CreatedBy == CurrentUser ||
        (Task.AssignedIds != null && Task.AssignedIds.Contains(CurrentUser))))
    {
        <button class="btn btn-light w-100" @onclick="ShowChecklistInput" title="@Loc["Checklist"]">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CompletedList"></SVGCrud>
                <span class="ms-1">@Loc["Checklist"]</span>
            </span>
        </button>
    }
    @if (Task != null && Task.ActualProcess < 100)
    {
        <button class="btn btn-light w-100" @onclick="FullProgrssChange" title="@Loc["FullProgress"]">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CloseArrow"></SVGCrud>
                <span class="ms-1">
                    @Loc["FullProgress"]
                </span>
            </span>
        </button>
    }

    @if (Task?.TaskStatus == Guid.Parse("6EE4574D-C439-45B4-223A-08DE3318A61C"))
    {
        <button class="btn btn-light w-100" @onclick="@(() => CompleteTask(Task.Id))" title="@Loc["Complete"]">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CompletedList"></SVGCrud>
                <span class="ms-1">
                    @Loc["Complete"]
                </span>
            </span>

        </button>
        <button class="btn btn-light w-100" @onclick="@(() => ReopenTask(Task.Id))" title="@Loc["ReOpen"]">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Repeat"></SVGCrud>
                <span class="ms-1">
                    @Loc["ReOpen"]

                </span>
            </span>
        </button>
    }

    @if (Task != null && DisplayRejectButton(Task))
    {
        <button class="btn btn-light w-100 " @onclick="@(() => RejectTask(Task.Id))" title="@Loc["Reject"]">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Reject"></SVGCrud>
                <span class="ms-1">
                    @Loc["Reject"] - @GetRemainingDays(Task)
                </span>
            </span>

        </button>
    }

    @if (Task != null && IsRequestNewEndDate(Task))
    {
        <button class="btn btn-light w-100" @onclick="@(() => RequestChangeDueDate(Task))">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CalnderPluse"></SVGCrud>

            </span>
            @Loc["RequestDueDate"]
        </button>
    }

    <button class="btn btn-light w-100 text-start mb-2" @onclick="@(() => Edit(Task!.Id))" title="@Loc["Edit"]">
        <span class="icon">
            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud> <span class="ms-1"> @Loc["Edit"]</span>
        </span>
    </button>
    @if (Task != null && Task.IsDeleted)
    {
        <button class="btn btn-light w-100 text-start mb-2" @onclick="@(() => ShowRestorePopup(Task.Id))" title="@Loc["Restore"]">
            <span class="icon">
                 <span class="ms-1"> @Loc["Restore"]</span>
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Repeat"></SVGCrud>
            </span>
        </button>
    }

    @if (Task != null && !Task.IsDeleted)
    {
        <button class="btn btn-light w-100 text-start mb-2 text-danger" title="@Loc["Delete"]" @onclick="@(() => DeleteTask(Task.Id))">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>  <span class="ms-1">@Loc["Delete"]</span>
            </span>
        </button>
    }

</div>
<RestoreTaskPopup Show="@showRestorePopup" ShowChanged="@(v => showRestorePopup = v)" TaskId="@restoreTaskId" OnRestored="ReloadAfterSave" />
<Checklist Task="Task"  @bind-showNewChecklistInput="showNewChecklistInput"></Checklist>

@code {
    [Parameter] public CreateTaskDto Task { get; set; }
    [Parameter] public EventCallback OnConfirmed { get; set; }
    [Parameter] public EventCallback OnReopenTask { get; set; }
    [Parameter] public EventCallback OnRequestNewEndDate { get; set; }
    private Guid CurrentUser { get; set; }
    private int RejectionPeriod { get; set; } = 0;
    int progressold { get; set; }
    private bool showChecklist = false;
    bool showRestorePopup = false;
    Guid restoreTaskId;
    List<Guid> AlllowedToChangeProgress = new List<Guid>()
    {
        Guid.Parse("547022EA-EF8C-4FBC-2236-08DE3318A61C"),
        Guid.Parse("9843AF9D-1389-4740-B428-08DE3D8A77AB"),
        Guid.Parse("753404A6-8B18-43F7-2238-08DE3318A61C"),
        Guid.Parse("270A78EB-C5CA-475D-2239-08DE3318A61C")
    };
    List<TaskChecklistDto> Checklists = new();
    private string newChecklistTitle = "";
    private string newItemTitle = "";
    bool showNewChecklistInput = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Task != null)
        {
            progressold = Task.ActualProcess;
            // await LoadChecklists();
        }
    }
    private async Task HandleProgressChanged(int value)
    {
        if (Task == null)
            return;

        if (Task.ActualProcess >= 100 &&
            !AlllowedToChangeProgress.Any(p => p == Task.TaskStatus))
            return;
        var newProgress = value;
        PopupService.ShowConfirmation(
            @Loc["SureChangeProgress"],
            @Loc["Confirm"],
            async (confirmed) =>
            {
                if (confirmed)
                {
                    await ChangeProgressConfirmed(newProgress);
                }
                else
                {

                    Task.ActualProcess = progressold;
                    StateHasChanged();
                }
            },
            ConfirmationType.Other
        );
    }
    protected override async Task OnInitializedAsync()
    {
        var user = await LocalStorageService.GetItemAsStringAsync("Id");
        if (!string.IsNullOrEmpty(user) && Guid.TryParse(user, out var userId))
            CurrentUser = userId;
        else
            CurrentUser = Guid.Empty;
        RejectionPeriod = await GetRejectionPeriod();
    }
    private void ShowChecklistInput()
    {
        showNewChecklistInput = true;
    }
    private async Task CompleteConfirmed(Guid id)
    {
        var result = await _taskConsumer.CompleteTask(id);
        if (result.Success && result.Data)
        {
            await ToastService.ShowToastAsync(Loc["Completedsuccessfully"], "success");
            await OnConfirmed.InvokeAsync();
        }
        else
        {
            await ToastService.ShowToastAsync(Loc["CompleteFailed"], "danger");
        }
        StateHasChanged();
    }
    private void CompleteTask(Guid id)
    {
        PopupService.ShowConfirmation(@Loc["SureCompleteTask"], @Loc["Confirm"],
        async (confirmed) =>
        {
            if (confirmed)
                await CompleteConfirmed(id);
        },
        ConfirmationType.Other
        );
    }
    public void ReopenTask(Guid id) => PopupService.ShowNew(@<ReopenTask Id="id" OnSaved="ReloadAfterSave"></ReopenTask>,Loc["ReOpen"]);
    public async Task RejectTask(Guid id) => PopupService.ShowNew(@<RejectTask Id="id" OnSaved="ReloadAfterSave"></RejectTask>,Loc["Reject"]);
    private void Edit(Guid id) => PopupService.ShowNew(@<EditTask Id="id" OnValidSubmit="ReloadAfterSave"></EditTask>, headerText: @Loc["EditTask"]);
    public void RequestChangeDueDate(CreateTaskDto task) => PopupService.ShowNew(@<RequestChangeDueDate task="task" OnSaved="ReloadRequestAfterSave"></RequestChangeDueDate>,Loc["RequestDueDate"]);
    private void DeleteTask(Guid id)
    {
        PopupService.ShowConfirmation(@Loc["SureDeleteTask"], @Loc["Confirm"],
                async (confirmed) =>
                {
                    if (confirmed)
                        await DeleteConfirmed(id);
                }, ConfirmationType.Danger);
    }
    private async Task DeleteConfirmed(Guid Id)
    {
        var result = await _taskConsumer.SoftDeleteTask(Id, CurrentUser);
        if (result.Success && result.Data)
        {
            await ToastService.ShowToastAsync(Loc["taskDeleted"], "success"); ;
            navigationManager.NavigateTo("/MainTasks");
        }
        else
            await ToastService.ShowToastAsync(Loc["PreventTaskDeletion"], "error");
        StateHasChanged();
    }
    void ShowRestorePopup(Guid id)
    {
        restoreTaskId = id;
        showRestorePopup = true;
    }
    private async Task ReloadAfterSave()
    {
        await OnReopenTask.InvokeAsync();
    }
    private async Task ReloadRequestAfterSave()
    {
        await OnRequestNewEndDate.InvokeAsync();
        //currentPage = page;
    }
    private async Task<int> GetRejectionPeriod()
    {
        var res = await _rejectionSettingConsumer.GetRejectionSetting();
        int RejectionPeriod = 0;
        if (res.Success)
        {
            var setting = res.Data;
            if (res.Data is not null)
            {
                if (res.Data.CustomDays != null)
                    RejectionPeriod = (int)res.Data.CustomDays;
                else
                    RejectionPeriod = (int)res.Data.PeriodType;
            }
        }
        return RejectionPeriod;
    }
    private bool DisplayRejectButton(CreateTaskDto taskDto)
    {
        if (RejectionPeriod == 0 || taskDto?.AssigneesData == null)
            return false;
        var assignee = taskDto.AssigneesData.FirstOrDefault(p => p.UserId == CurrentUser);
        if(assignee == null)
            return false;

        if ((DateOnly.FromDateTime(assignee.AssigneeDate).AddDays(RejectionPeriod) < DateOnly.FromDateTime(DateTime.Now)) 
                || taskDto?.TaskStatus == Guid.Parse("6EE4574D-C439-45B4-223A-08DE3318A61C") 
                || taskDto?.TaskStatus == Guid.Parse("C8D504C7-9402-4F91-223C-08DE3318A61C"))
            return false;
        return true;
    }
    private bool IsRequestNewEndDate(CreateTaskDto taskDto)
    {
        if (!(taskDto.AssigneesData is not null && taskDto.AssigneesData!.Any(u => u.UserId == CurrentUser))
        || taskDto?.TaskStatus == Guid.Parse("6EE4574D-C439-45B4-223A-08DE3318A61C") || taskDto?.TaskStatus ==
        Guid.Parse("C8D504C7-9402-4F91-223C-08DE3318A61C") ||
        (taskDto.ChangeEndDateRequestCount > 0))
        {
            return false;
        }
        else
        {
            return true;
        }
    }
    private void FullProgrssChange()
    {
        Task!.ActualProcess = 100;
        var progress = Task.ActualProcess;
        PopupService.ShowConfirmation(@Loc["SureChangeProgress"], @Loc["Confirm"],
        async (confirmed) =>
        {
            if (confirmed)
            {
                await ChangeProgressConfirmed(progress);
            }
            else
            {
                Task.ActualProcess = progressold;
                StateHasChanged();
            }
        },
        ConfirmationType.Other
        );
    }
    private async Task ChangeProgressConfirmed(int progress)
    {
        if (Task == null)
            return;


        if (Task.ActualProcess >= 100 &&
            !AlllowedToChangeProgress.Any(p => p == Task.TaskStatus))
            return;

        var result = await _taskConsumer.ChangeTaskProgress(Task!.Id, progress);

        if (result.Success && result.Data)
        {
            Task.ActualProcess = progress;
            progressold = progress;
            await ToastService.ShowToastAsync(Loc["progressChangedsuccessfully"], "success");
            await OnConfirmed.InvokeAsync();
        }
        else
        {
            Task.ActualProcess = progressold;
            await ToastService.ShowToastAsync(Loc["DependencyError"], "error");
            await OnConfirmed.InvokeAsync();
        }
        StateHasChanged();
    }
    private string GetRemainingDays(CreateTaskDto task)
    {
        var today = DateOnly.FromDateTime(DateTime.Now).DayNumber;
        var expiry = DateOnly.FromDateTime(task.AssigneesData?.FirstOrDefault(d => d.UserId == CurrentUser)?.AssigneeDate ?? DateTime.Now).AddDays(RejectionPeriod).DayNumber;
        var res = expiry - today;
        if (res == 1)
        {
            return $"({res} {Loc["Day"]})";
        }
        else
        {
            return $"({res} {Loc["Days"]})";
        }
    }
    private int GetChecklistProgress(TaskChecklistDto checklist)
    {
        if (checklist.Items == null || !checklist.Items.Any())
            return 0;
        return (int)Math.Round(checklist.Items.Count(i => i.IsDone) / (double)checklist.Items.Count * 100);
    }
}