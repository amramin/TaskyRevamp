@using TaskyRevamp.Dto.TaskDto
@inject IStringLocalizer<SharedResources> Loc
@if (ShouldRenderBar)
{
    <div class="progress-overall-bar">
        <div class="content">
            <span class="title"> @Loc["Overall progress"] </span>
            <span class="value">@ProgressValue %</span>
        </div>


        <div class="progress position-relative" style="width:@($"{Width}px");
            cursor:@(IsEditable ? "pointer" : "default")" @onmousedown="OnMouseDown">
            <div class="progress-bar  @(IsComplete ? "completed" : "")" role="progressbar"
                 style="width:@($"{ProgressValue}%")" aria-valuemin="0" aria-valuemax="100">
            </div>
             <span class="progress-value" style="inset-inline-start:@($"{ProgressValue}%");">
                @($"{ProgressValue}%")
            </span> 
            @if (IsEditable)
            {
                <span class="circle" style="inset-inline-start:@($"{ProgressValue}%");"></span>
            }
        </div>
    </div>
}
@code {
    [Parameter] public List<CreateTaskDto>? Tasks { get; set; }
    [Parameter] public int? ActualProgress { get; set; }
    [Parameter] public EventCallback<int> OnProgressChanged { get; set; }
    [Parameter] public int Width { get; set; } = 400;
    private bool IsEditable = true;
    private bool ShouldRenderBar => ActualProgress.HasValue || (Tasks != null && Tasks.Any());
    private bool IsComplete => ProgressValue >= 100;
    private int ProgressValue
    {
        get
        {
            if (IsEditable || (Tasks == null || !Tasks.Any()))
                return Math.Clamp(ActualProgress!.Value, 0, 100);
            if (Tasks == null || !Tasks.Any()) return 0;
            return (int)Math.Round(Tasks.Sum(t => t.ActualProcess) / (double)Tasks.Count);
        }
    }

    protected override void OnParametersSet()
    {
        IsEditable = ActualProgress.HasValue && ActualProgress < 100;
    }
    // private string ProgressColor => ProgressValue < 40 ? "bg-danger" : ProgressValue < 70 ? "bg-warning" : "bg-success";
    private async Task OnMouseDown(MouseEventArgs e)
    {
        if (!IsEditable)
            return;
        var newValue = (int)Math.Round((e.OffsetX / Width) * 100.0);
        newValue = Math.Clamp(newValue, 0, 100);
        ActualProgress = newValue;
        await OnProgressChanged.InvokeAsync(newValue);
    }
}