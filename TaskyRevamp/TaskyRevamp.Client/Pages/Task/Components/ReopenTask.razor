@page "/Reopen-Task/{Id:guid}"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.TaskComment
@inject IStringLocalizer<SharedResources> Loc
@inject PopupService PopupService
@inject TaskConsumer _taskConsumer
@inject ToastService ToastService
@inject NavigationManager navigationManager

<EditForm Model="comments"
          OnValidSubmit="HandleValidSubmit"
          OnInvalidSubmit="HandleInvalidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />
        <div class="offcanvas-body">
        <label class="form-label">@Loc["Enterthereason"]</label>
    <InputTextArea class="form-control"
                       placeholder="@Loc["Enterthereason"]"
              @bind-value="comments.Content"
              rows="3"></InputTextArea>
              <ValidationMessage For="()=>comments.Content" class="text-danger"></ValidationMessage>
            </div>
        <div class="offcanvas-footer">
            <div class="row g-2">
                <div class="col-6">
                    <div class="d-grid">
                <button type="button" class="btn btn-lg btn-light" @onclick="Cancel">@Loc["Cancel"]</button>
                    </div>
                </div>
                <div class="col-6">
                    <div class="d-grid">
                <button type="submit" class="btn btn-lg btn-primary">@Loc["Save"]</button>
                    </div>
                </div>
            </div>

        </div>
</EditForm>

@code {
    [Parameter] public Guid Id { get; set; }
    public string Content{ get; set; }
    public TaskCommentDto comments { get; set; } = new TaskCommentDto();
    [Parameter] public EventCallback OnSaved { get; set; }
    private void Cancel()
    {
        PopupService.Hide();
    }
    private async Task HandleValidSubmit(EditContext args)
    {
        comments.TaskItemId = Id;
        var res=await _taskConsumer.ReopenTask(comments);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["DataSavedSuccessfully"], "success");
            await OnSaved.InvokeAsync();
            PopupService.Hide();
        }
        else
            {
            await ToastService.ShowToastAsync(Loc["Erroroccurred"], "error");

                return;
            }
        }
    private void HandleInvalidSubmit(EditContext args)
    {
        throw new NotImplementedException();
    }
}
