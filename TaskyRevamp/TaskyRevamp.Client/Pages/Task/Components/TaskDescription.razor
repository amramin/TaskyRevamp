@using TaskyRevamp.Dto.TaskDto
@inject IStringLocalizer<SharedResources> Loc

<div class="card collapse-card mb-3">
    <div class="card-header" @onclick="ToggleSection">
        <button type="button" class="btn colapse-btn ">
            <h6 class="headline-6 mb-0">@Loc["Description"]</h6>
            <span class="icon"> @if (ShowSection)
                {
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ChevronDown"></SVGCrud>
                }
    else
                {
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ChevronUp"></SVGCrud>
                }
            </span>
        </button>

    </div>
    @if (ShowSection)
    {
        <div class="card-body">
            <div>@((MarkupString)(Task?.Description ?? ""))</div>
        </div>
    }
</div>

@code {
    [Parameter]
    public bool ShowSection { get; set; } = true;

    [Parameter]
    public EventCallback<bool> ShowSectionChanged { get; set; }

    [Parameter]
    public CreateTaskDto? Task { get; set; }
   
    private async Task ToggleSection()
    {
        ShowSection = !ShowSection;
        await ShowSectionChanged.InvokeAsync(ShowSection);
    }
}