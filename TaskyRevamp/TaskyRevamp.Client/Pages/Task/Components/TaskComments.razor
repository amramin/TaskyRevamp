@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.TaskComment
@using TaskyRevamp.Dto.TaskDto
@inject TaskCommentConsumer _taskCommentConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject ILocalStorageService LocalStorageService

@inject PopupService PopupService
<div class="card comments-card collapse-card mb-3">
    <div class="card-header" @onclick="ToggleSection">


        <button type="button" class="btn colapse-btn ">
            <h6 class="headline-6 mb-0">@Loc["Comments"]</h6>
            <span class="icon"> @if (ShowSection)
                {
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ChevronDown"></SVGCrud>
                }
    else
                {
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ChevronUp"></SVGCrud>
                }
            </span>
        </button>
    </div>
    @if (ShowSection)
    {
        <div class="card-body">
            <div class="comment-container">
                <div class="avatar">
                    @GetInitials("You")
                </div>
                <div class="comment-input">
                    <RichTextEditorComponent @key="TaskId" EditorId="RTE_English2"
                                             @ref="RichTextEditorComponentRefDescriptionEnglish" ContentChanged="OnDescriptionChanged"
                                             Content="@newComment" ButtonText="@Loc["AddDescription"]"> </RichTextEditorComponent>
                </div>


            <div class="action-btn-list justify-content-end">
                <button class="btn btn-light" @onclick="CancelComment" disabled="@string.IsNullOrWhiteSpace(newComment)">
                    @Loc["Cancel"]
                </button>
                <button class="btn btn-primary end-icon" @onclick="AddComment"
                        disabled="@string.IsNullOrWhiteSpace(newComment)">
                    @Loc[buttonName]
                    <span class="icon">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.PaperPlane"></SVGCrud>
                    </span>
                </button>

            </div>

            @if (comments != null && comments.Any())
            {
                <div class="mt-4">
                    @foreach (var comment in comments)
                    {
                        <div class="comment-container">
                            <div class="avatar">
                                @GetInitials(comment.CreatedByName)
                            </div>
                            <div class="comment-input mb-3">
                                <div class="card">
                                    <div class="card-body">
                                        <div class="d-flex align-items-center gap-3 mb-2">
                                            <h5 class="headline-8 mb-0">@comment.CreatedByName</h5>
                                            <span class="x-small-medium-text">
                                                @if (comment.TaskComment.UpdateDate != comment.TaskComment.CreateDate)
                                                {
                                                    <span>@Loc["Edited"] : </span>
                                                    @comment.TaskComment.UpdateDate.Value.ToString(Loc["LocalizeDate"])
                                                }
                                            </span>
                                        </div>
                                        @if (comment.TaskComment.Type == Dto.Enums.CommentType.Reject)
                                        {
                                            <p class="mb-0">@Loc["RejectReason"]</p>
                                            <p class="mb-0"> @comment.TaskComment.Content</p>
                                        }
                                        else
                                        {
                                            <div>
                                                @((MarkupString)comment.TaskComment.Content)
                                            </div>
                                        }
                                    </div>
                                </div>
                                @if (currentId == comment.TaskComment.CreatedById || isCreator)
                                {
                                    <div class="mt-2 d-flex align-items-center gap-1">
                                        <button class="btn btn-link btn-text-500"
                                                @onclick="(() => EditTask(comment.TaskComment.Id))">@Loc["Edit"]</button>
                                        <span class="btn-text-500">.</span>
                                        <button class="btn btn-link btn-text-500"
                                                @onclick="(() => OnDeleteComment(comment.TaskComment.Id))">@Loc["Delete"]</button>
                                    </div>
                                }
                            </div>


                        </div>
                    }
                </div>
            }
            else
            {
                <div class="no-comments">
                    <span class="icon icon-32">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Comments"></SVGCrud>
                    </span>
                    <h5 class="headline-8 mb-1">@Loc["NoComments"]</h5>
                    <span class="x-small-medium-text">@Loc["Comments will appear after add first comment"]</span>

                </div>
            }

        </div>
    }
</div>

@code {
    [Parameter] public bool ShowSection { get; set; } = true;
    [Parameter] public EventCallback<bool> ShowSectionChanged { get; set; }
    [Parameter] public Guid TaskId { get; set; }
    [Parameter] public CreateTaskDto taskDto { get; set; }
    private string newComment = string.Empty;
    private List<TaskCommentWithNameDto>? comments;
    private TaskCommentWithNameDto Upatedcomment = new TaskCommentWithNameDto();
    string buttonName = $"AddComment";
    private RichTextEditorComponent RichTextEditorComponentRefDescriptionEnglish;
    private Guid? creatorId { set; get; }
    private bool isCreator => creatorId.HasValue && creatorId.Value == currentId;
    private async Task ToggleSection()
    {
        ShowSection = !ShowSection;
        await ShowSectionChanged.InvokeAsync(ShowSection);
    }
    Guid currentId { set; get; }
    protected override async Task OnInitializedAsync()
    {
        var current = await LocalStorageService.GetItemAsStringAsync("Id");
        currentId = Guid.Parse(current!);
        await LoadComments();
    }
    protected override void OnParametersSet()
    {
        if (taskDto != null)
            creatorId = taskDto.CreatedBy;
    }
    private void OnDeleteComment(Guid Id)
    {
        PopupService.ShowConfirmation(@Loc["Ares"], @Loc["Confirm"], async (confirmed) =>
        {
            if (confirmed)
                await DeleteConfirmed(Id);
        },
        ConfirmationType.Danger);
    }
    private async Task DeleteConfirmed(Guid Id)
    {
        var result = await _taskCommentConsumer.DeleteTaskComment(Id);
        if (result.Success)
        {
            var toRemove = comments.FirstOrDefault(d => d.TaskComment.Id == Id);
            if (toRemove != null)
            {
                await LoadComments();
            }

            await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
        }
        else
        {
            await ToastService.ShowToastAsync(Loc["DeleteFailed"], "danger");
        }

        StateHasChanged();
    }

    private async Task CancelConfirmed()
    {
        newComment = string.Empty;
        Upatedcomment = new TaskCommentWithNameDto();
        buttonName = "AddComment";
        await LoadComments();
        StateHasChanged();
    }

    private async Task CancelComment()
    {
        PopupService.ShowConfirmation(@Loc["Areyousureyouwan"], @Loc["Confirm"], async (confirmed) =>
        {
            if (confirmed)
                await CancelConfirmed();
        },
        ConfirmationType.Danger);
    }
    private async Task AddComment()
    {
        if (string.IsNullOrWhiteSpace(newComment))
            return;
        if (Upatedcomment != null && Upatedcomment.TaskComment != null && Upatedcomment.TaskComment.Id != Guid.Empty)
        {
            await _taskCommentConsumer.UpdateTaskComment(new TaskCommentDto
            {
                TaskItemId = TaskId,
                Content = newComment,
                Id = Upatedcomment.TaskComment.Id
            });
            newComment = string.Empty;
            Upatedcomment = new TaskCommentWithNameDto();
            await ToastService.ShowToastAsync(Loc["Editedsuccessfully"], "success");

        }
        else
        {
            await _taskCommentConsumer.AddTaskComment(new TaskCommentDto
            {
                TaskItemId = TaskId,
                Content = newComment
            });
            newComment = string.Empty;
        }
        newComment = string.Empty;
        Upatedcomment = new TaskCommentWithNameDto();
        buttonName = "AddComment";
        await LoadComments();
        StateHasChanged();
        await LoadComments();
    }
    public async Task LoadComments()
    {
        var res = await _taskCommentConsumer.GetTaskCommentsById(TaskId);
        if (res.Success && res.Data != null)
        {
            comments = res.Data;
        }
    }
    private string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();
        var first = parts[0][0];
        var last = parts[^1][0];
        return $"{char.ToUpper(first)}{char.ToUpper(last)}";
    }
    private void DeleteTask(MouseEventArgs args)
    {
        throw new NotImplementedException();
    }
    private async Task EditTask(Guid id)
    {
        Upatedcomment = comments?.FirstOrDefault(c => c.TaskComment.Id == id);
        newComment = Upatedcomment.TaskComment.Content;
        buttonName = "UpdateComment";
        StateHasChanged();

    }
    private void OnDescriptionChanged()
    {
        newComment = RichTextEditorComponentRefDescriptionEnglish.GetContent();
    }
}