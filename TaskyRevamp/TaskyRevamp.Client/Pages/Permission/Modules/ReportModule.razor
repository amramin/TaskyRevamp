@using System.ComponentModel.DataAnnotations
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.Permissions
@using TaskyRevamp.Dto.Permissions.ReportModule

@inject ReportModuleConsumer _reportModuleConsumer
@inject IStringLocalizer<SharedResources> Loc

<div >

    <div class="text-content">
        <h6 class="headline-6">@Loc["SelectReportOptions"]</h6>
        <p class="small-medium-text hint"> @Loc["ReportModuleHint"]</p>
    </div>
    @foreach (var module in ReportModules)
    {
        var permission = ReportPermissions.First(x => x.ReportModuleId == module.Id);
        <div class="form-check p-3 @(permission.IsActive ? "bg-light border-primary" : "")">
            <InputCheckbox @bind-Value="permission.IsActive" class="form-check-input" id="@module.Id" />
            <label class="form-check-label w-100" for="@module.Id">
                <div class="fw-semibold">@module.Name</div>
                <small class="text-muted">@module.Hint</small>
            </label>
        </div>
    }
</div>
@code {

    [Parameter] public PrivilegeDto PrivilegeDto { get; set; } = new PrivilegeDto();

    public List<ReportModuleDto> ReportModules { get; set; } = new List<ReportModuleDto>();
    public List<ReportModulePermissionDto> ReportPermissions { get; set; } = new List<ReportModulePermissionDto>();

    protected override async Task OnInitializedAsync()
    {
        var res = await _reportModuleConsumer.GetReportModules();
        if (res.Success && res != null && res.Data != null)
        {
            ReportModules = res.Data;
            ReportPermissions = PrivilegeDto.ReportModulePermissionDtos;
            foreach (var module in ReportModules)
            {
                if (!ReportPermissions.Any(x => x.ReportModuleId == module.Id))
                    ReportPermissions.Add(new ReportModulePermissionDto { ReportModuleId = module.Id });
            }

        }
    }
}