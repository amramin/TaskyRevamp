@page "/GeneralModulePrivileges"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.Permissions
@using TaskyRevamp.Dto.Permissions.GeneralModule
@using TaskyRevamp.Client.Pages.Permission.Components
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject GeneralModuleConsumer _generalModuleConsumer
@inject DepartmentConsumer _departmentConsumer
@inject UserConsumer _userConsumer


<div>
    <table class="table separated-table">
        <thead>
            <tr>
                <th>@Loc["Module"]</th>
                <th>@Loc["All"]</th>
                <th>@Loc["View"]</th>
                <th>@Loc["Add"]</th>
                <th>@Loc["Edit"]</th>
                <th>@Loc["Delete"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var module in generalModules)
            {
                var permission = PrivilegeDto.GeneralModulePermissions
                .FirstOrDefault(p => p.GeneralModuleId == module.Id);
                @if (permission != null)
                {
                    <tr>
                        <td>@module.Name</td>
                        <td>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" disabled="@IsViewMode"
                                    checked="@(permission.IsView && permission.IsEdit && permission.IsAdd && permission.IsDelete)"
                                    @onchange="e => SetAll(permission, e.Value!)" />
                            </div>
                        </td>

                        <td>
                            @if (module.HasView)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" disabled="@IsViewMode" @bind="permission.IsView" @bind:event="onchange" />
                                </div>

                            }
                        </td>

                        <td>
                            @if (module.HasAdd)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" disabled="@IsViewMode" checked="@permission.IsAdd"
                                           @onchange="e => OnAddChanged(permission, e)" />
                                </div>

                            }
                        </td>

                        <td>
                            @if (module.HasEdit)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" disabled="@IsViewMode" @bind="permission.IsEdit" @bind:event="onchange" />
                                </div>

                            }
                        </td>

                        <td>
                            @if (module.HasDelete)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" disabled="@IsViewMode" @bind="permission.IsDelete" @bind:event="onchange" />
                                </div>
                            }
                        </td>
                    </tr>
                }
            }

        </tbody>
    </table>

    @if (PrivilegeDto.GeneralModulePermissions
        .Any(p => generalModules.FirstOrDefault(m => m.Id == p.GeneralModuleId)?.NameEnglish == "Delegation" && p.IsAdd))
    {
        var delegationPermission = PrivilegeDto.GeneralModulePermissions
        .FirstOrDefault(p => generalModules.FirstOrDefault(m => m.Id == p.GeneralModuleId)?.NameEnglish == "Delegation");

        <div class="card ">
            <div class="card-body">
                <div class="row gy-4">
                    <!-- FROM USER TOGGLE GROUP -->
                    <div class="col-12">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["FromUser"]<span class="text-danger">*</span></label>
                            @foreach (var value in Enum.GetValues<DelegationFromUser>())
                            {
                                var id = $"fromUser_{value}";
                                <div class="form-check form-switch custom">
                                    <input type="checkbox" id="@id" disabled="@IsViewMode" class="form-check-input"
                                           checked="@delegationPermission!.DelegationFromUser!.Contains((int)value)"
                                           @onchange="e => OnDelegationFromUserChanged((int)value, e.Value!, delegationPermission)" />
                                    <label class="form-check-label ms-2" for="@id">
                                        <span class="toggler-icon"></span>
                                        @Loc[@value.ToString()]
                                    </label>
                                </div>
                            }
                            @if (IsSaveClicked && showDelegationFromUserError)
                            {
                                <div class="text-danger small mt-1">
                                    @Loc["SelectAtLeastOneValue"]
                                </div>
                            }
   
                            @if (delegationPermission?.DelegationFromUser != null &&
                                                    delegationPermission.DelegationFromUser.Contains((int)DelegationFromUser.DifferentDepartment))
                            {
                                <DelegationDepartmentSelector DepartmentList="departmentDtos" IsViewMode="@IsViewMode"
                                                              SelectedDepartments="@delegationPermission.DelegationFromUserDepartments"
                                                              SelectedDepartmentsChanged="@((List<Guid> ids) => delegationPermission.DelegationFromUserDepartments = ids)"
                                                              LoadUsersByDepartment="@LoadUsersForDepartment" />
                            }
   
                        </div>
                    </div>
                    <!-- TO USER SWITCH GROUP -->
                    <div class="col-12 mt-3">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">@Loc["ToUser"]<span class="text-danger">*</span></label>
                            @foreach (var value in Enum.GetValues<DelegationToUser>())
                            {
                                var id = $"toUser_{value}";
                                <div class="form-check form-switch custom">
                                    <input type="checkbox" id="@id" disabled="@IsViewMode" class="form-check-input" 
                                           checked="@delegationPermission!.DelegationToUser!.Contains((int)value)"
                                           @onchange="e => OnDelegationToUserChanged((int)value, e.Value!, delegationPermission)" />
                                    <label class="form-check-label ms-2" for="@id">
                                        <span class="toggler-icon"></span>
                                        @Loc[@value.ToString()]
                                    </label>
                                </div>
                            }
                            @if (IsSaveClicked && showDelegationToUserError)
                            {
                                <div class="text-danger small mt-1">
                                    @Loc["SelectAtLeastOneValue"]
                                </div>
                            }
                            @if (delegationPermission!.DelegationToUser != null  && 
                                            delegationPermission!.DelegationToUser.Contains((int)DelegationToUser.DifferentDepartment))
                            {
                                <DelegationDepartmentSelector DepartmentList="departmentDtos" IsViewMode="@IsViewMode"
                                                              SelectedDepartments="@delegationPermission.DelegationToUserDepartments"
                                                              SelectedDepartmentsChanged="@((List<Guid> ids) => delegationPermission.DelegationToUserDepartments = ids)"
                                                              LoadUsersByDepartment="@LoadUsersForDepartment" />

                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>


@code {
    [Parameter] public PrivilegeDto PrivilegeDto { get; set; } = new PrivilegeDto();
    [Parameter] public EventCallback<bool> OnValidationStateChanged { get; set; }
    [Parameter] public string Mode { get; set; }
    [Parameter] public bool IsViewMode { get; set; }
    [Parameter] public bool IsSaveClicked { get; set; }
    List<GeneralModuleDto> generalModules = new();
    List<DepartmentDto> departmentDtos = new();
    private bool showDelegationFromUserError = false;
    private bool showDelegationToUserError = false;

    protected override async Task OnInitializedAsync()
    {
        var res = await _generalModuleConsumer.GetGeneralModules();
        if (res.Success && res != null && res.Data != null)
        {
            generalModules = res.Data.ToList();
            // Only initialize if GeneralModulePermissions is null or empty
            if (PrivilegeDto.GeneralModulePermissions == null || !PrivilegeDto.GeneralModulePermissions.Any())
            {
                PrivilegeDto.GeneralModulePermissions = generalModules
                    .Select(m => new GeneralModulePermissionDto
                    {
                        GeneralModuleId = m.Id,
                        IsView = false,
                        IsEdit = false,
                        IsAdd = false,
                        IsDelete = false,
                        DelegationFromUser = new List<int>(),
                        DelegationToUser = new List<int>(),
                        DelegationFromUserDepartments = new List<Guid>(),
                        DelegationToUserDepartments = new List<Guid>()
                    })
                    .ToList();
            }
            else
            {
                // Ensure all modules have a permission entry (add missing ones)
                var existingModuleIds = PrivilegeDto.GeneralModulePermissions
                    .Select(p => p.GeneralModuleId)
                    .ToHashSet();

                var missingPermissions = generalModules
                    .Where(m => !existingModuleIds.Contains(m.Id))
                    .Select(m => new GeneralModulePermissionDto
                    {
                        GeneralModuleId = m.Id,
                        IsView = false,
                        IsEdit = false,
                        IsAdd = false,
                        IsDelete = false,
                        DelegationFromUser = new List<int>(),
                        DelegationToUser = new List<int>(),
                        DelegationFromUserDepartments = new List<Guid>(),
                        DelegationToUserDepartments = new List<Guid>()
                    });

                PrivilegeDto.GeneralModulePermissions.AddRange(missingPermissions);
            }
            var departmentsRes = await _departmentConsumer.GetDepartmentsNoPagnation();
            if (departmentsRes.Success && departmentsRes != null && departmentsRes.Data != null)
            {
                departmentDtos = departmentsRes.Data.ToList();
            }
        }
    }
    void SetAll(GeneralModulePermissionDto permission, object value)
    {
        bool isChecked = (bool)value;
        permission.IsView = isChecked;
        permission.IsEdit = isChecked;
        permission.IsAdd = isChecked;
        permission.IsDelete = isChecked;
    }
    void OnAddChanged(GeneralModulePermissionDto permission, ChangeEventArgs e)
    {
        permission.IsAdd = (bool)e.Value!;
        if (!permission.IsAdd)
        {
            // Reset DelegationFromUser
            permission.DelegationFromUser = new();
            permission.DelegationFromUserDepartments = new();
            // Reset DelegationToUser
            permission.DelegationToUser = new();
            permission.DelegationToUserDepartments = new();
            // Clear validation errors
            showDelegationFromUserError = false;
            showDelegationToUserError = false;

            OnValidationStateChanged.InvokeAsync(true);
        }
        else
        {
            bool isValid = ValidateDelegation(permission);
            OnValidationStateChanged.InvokeAsync(isValid);
        }
        StateHasChanged();
    }
    private async Task OnDelegationToUserChanged(int value, object checkedValue, GeneralModulePermissionDto permission)
    {
        bool isChecked = (bool)checkedValue;
        permission.DelegationToUser ??= new();
        if(isChecked)
        {
            if (!permission.DelegationToUser!.Contains(value))
                permission.DelegationToUser.Add(value);
        }
        else
        {
            permission.DelegationToUser!.Remove(value);
            // Clear departments if unchecking DifferentDepartment
            if (value == (int)DelegationToUser.DifferentDepartment)
            {
                permission.DelegationToUserDepartments = new List<Guid>();
            }
        }
        bool isValid = ValidateDelegation(permission);
        await OnValidationStateChanged.InvokeAsync(isValid);
        StateHasChanged();
    }
    private async Task OnDelegationFromUserChanged(int value, object checkedValue, GeneralModulePermissionDto permission)
    {
        bool isChecked = (bool)checkedValue;
        permission.DelegationFromUser ??= new();
        if (isChecked)
        {
            if (!permission.DelegationFromUser.Contains(value))
                permission.DelegationFromUser.Add(value);
        }
        else
        {
            permission.DelegationFromUser.Remove(value);
            // Clear departments if unchecking DifferentDepartment
            if (value == (int)DelegationFromUser.DifferentDepartment)
            {
                permission.DelegationFromUserDepartments = new List<Guid>();
            }
        }
        bool isValid = ValidateDelegation(permission);
        await OnValidationStateChanged.InvokeAsync(isValid);

        StateHasChanged();
    }
    private bool ValidateDelegation(GeneralModulePermissionDto permission)
    {
        showDelegationFromUserError = false;
        showDelegationToUserError = false;

        if (!permission.IsAdd)
            return true;

        if (permission.DelegationFromUser == null || !permission.DelegationFromUser.Any())
        {
            showDelegationFromUserError = true;
        }
        if (permission.DelegationToUser == null || !permission.DelegationToUser.Any())
        {
            showDelegationToUserError = true;
        }
        return !showDelegationFromUserError && !showDelegationToUserError;
    }
    private async Task<List<UserDto>> LoadUsersForDepartment(Guid deptId)
    {
        var res = await _userConsumer.GetUsersByDepartment(deptId);
        return res.Success ? res.Data?.AssignedUsers ?? new List<UserDto>() : new List<UserDto>();
    }

}