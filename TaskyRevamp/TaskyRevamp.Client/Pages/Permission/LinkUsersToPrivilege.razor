@page "/LinkPrivilegeUsers/{Id:guid}"

@using Stingray.Components.MultiSelectComponent
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.Department
@inject UserConsumer _userConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService

<div class="offcanvas-body">
    <div class="mb-3">
        <label class="form-label">
            @Loc["users"]
            <span class="text-danger">*</span>
        </label>
        <SearchableMultiDropdownOffline TInput=UserDto TOutput="Guid" Datasource=availableUsers
                                        TextSelector=@(x=>x.DisplayedName) OutputSelector="x=> x.Id" @bind-SelectedOptions=SelectedUsers
                                        SelectAllPlaceHolder="@Loc["SelectAll"]" SearchInputPlaceHolder="@Loc["Search"]" PlaceHolder="@($"{Loc["Select"]}")" NoMatchPlaceHolder="@Loc["NoResultsFound"]" MinCharacterCount="1" />
        @if (ShowValidationError)
        {
            <div class="text-danger mt-1">
                @Loc["Required"]
            </div>
        }
    </div>
</div>
<div class="offcanvas-footer">
    <div class="row g-2">
        <div class="col-6">
            <div class="d-grid">
                <button type="button" class="btn btn-lg btn-light" @onclick="OnCancelClick">@Loc["Cancel"]</button>
            </div>
        </div>
        <div class="col-6">
            <div class="d-grid">
                <button type="button" @onclick="SaveClick" class="btn btn-lg btn-primary">@Loc["Save"]</button>
            </div>
        </div>
    </div>

</div>

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }
    public List<UserDto> availableUsers { get; set; } = new();
    public List<Guid> _selectedUsers { get; set; } = new();
    public List<Guid> SelectedUsers
    {
        get => _selectedUsers;
        set
        {
            _selectedUsers = value;
            ShowValidationError = false;
        }
    }
    private bool ShowValidationError;
    protected async override Task OnInitializedAsync()
    {
        var res = await _userConsumer.GetUnAssignedUsersToPrivilege();
        if (res.Success && res.Data != null)
        {
            availableUsers = res.Data.ToList();
        }
    }
    private async Task SaveClick()
    {
        if (SelectedUsers == null || SelectedUsers.Count == 0)
        {
            ShowValidationError = true;
            return;
        }
        ShowValidationError = false;

        var selectedUserDtos = availableUsers.Where(u => SelectedUsers.Contains(u.Id)).ToList();
        var res = await _userConsumer.AssignUsersToPrivilege(selectedUserDtos, Id);
        if (res.Success)
        {
            var result = await _userConsumer.GetUnAssignedUsersToPrivilege();
            if(result.Success && result.Data != null)
            {
                availableUsers = result.Data.ToList();
                SelectedUsers = new();
            }
            await OnSaved.InvokeAsync();
            await ToastService.ShowToastAsync(Loc["Added successfully"], "success");
        }
       
    }

    private void OnCancelClick()
    {
        PopupService.Hide();
        SelectedUsers = new List<Guid>();
    }

}
