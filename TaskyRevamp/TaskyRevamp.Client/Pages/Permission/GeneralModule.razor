@page "/GeneralModulePrivileges"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.Permissions
@using TaskyRevamp.Dto.Permissions.GeneralModule
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject GeneralModuleConsumer _generalModuleConsumer
@inject DepartmentConsumer _departmentConsumer
@inject UserConsumer _userConsumer

<div class="card shadow-sm p-3">
    <div>
        <table class="table table-bordered align-middle">
            <thead class="table-light">
                <tr>
                    <th>@Loc["Module"]</th>
                    <th class="text-center">@Loc["All"]</th>
                    <th class="text-center">@Loc["View"]</th>
                    <th class="text-center">@Loc["Edit"]</th>
                    <th class="text-center">@Loc["Add"]</th>
                    <th class="text-center">@Loc["Delete"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var module in generalModules)
                {
                    var permission = PrivilegeDto.GeneralModulePermissions
                    .FirstOrDefault(p => p.GeneralModuleId == module.Id);
                    @if (permission != null)
                    {
                        <tr>
                            <td>@module.Name</td>

                            <td class="text-center">
                                <input type="checkbox" @onchange="e => SetAll(permission, e.Value!)" />
                            </td>

                            <td class="text-center">
                                @if (module.HasView)
                                {
                                    <input type="checkbox" @bind="permission.IsView" />
                                }
                            </td>

                            <td class="text-center">
                                @if (module.HasEdit)
                                {
                                    <input type="checkbox" @bind="permission.IsEdit" />
                                }
                            </td>

                            <td class="text-center">
                                @if (module.HasAdd)
                                {
                                    <input type="checkbox" checked="@permission.IsAdd" @onchange="e => OnAddChanged(permission, e)" />
                                }
                            </td>

                            <td class="text-center">
                                @if (module.HasDelete)
                                {
                                    <input type="checkbox" @bind="permission.IsDelete" />
                                }
                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
        @if (PrivilegeDto.GeneralModulePermissions
                .Any(p => generalModules.FirstOrDefault(m => m.Id == p.GeneralModuleId)?.NameEnglish == "Delegation" && p.IsAdd))
        {
            var delegationPermission = PrivilegeDto.GeneralModulePermissions
            .FirstOrDefault(p => generalModules.FirstOrDefault(m => m.Id == p.GeneralModuleId)?.NameEnglish == "Delegation");

            <div class="card mt-4 border-0 shadow-sm">
                <div class="card-body">
                    <div class="row gy-4">
                        <!-- FROM USER TOGGLE GROUP -->
                        <div class="col-12">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@Loc["FromUser"]</label>
                                @foreach (var value in Enum.GetValues<DelegationFromUser>())
                                {
                                    var id = $"fromUser_{value}";
                                    <div class="form-check form-switch d-block mb-2">
                                        <input type="checkbox"
                                               id="@id"
                                               class="form-check-input"
                                               checked="@delegationPermission!.DelegationFromUser!.Contains((int)value)"
                                               @onchange="e => OnDelegationFromUserChanged((int)value, e.Value!, delegationPermission)" />
                                        <label class="form-check-label ms-2" for="@id">@Loc[@value.ToString()]</label>
                                    </div>
                                }
                                @if (showDelegationFromUserError)
                                {
                                    <div class="text-danger small mt-1">
                                        @Loc["SelectAtLeastOneValue"]
                                    </div>
                                }
                                @if (delegationPermission?.DelegationFromUser != null &&
                                                            delegationPermission.DelegationFromUser.Contains((int)DelegationFromUser.DifferentDepartment))
                                {
                                    <DelegationDepartmentSelector DepartmentList="departmentDtos"
                                                                  SelectedDepartments="@delegationPermission.DelegationFromUserDepartments"
                                                                  SelectedDepartmentsChanged="@((List<Guid> ids) => delegationPermission.DelegationFromUserDepartments = ids)"
                                                                  LoadUsersByDepartment="@LoadUsersForDepartment" />
                                }
                            </div>
                        </div>
                        <!-- TO USER SWITCH GROUP -->
                        <div class="col-12 mt-3">
                            <div class="mb-3">
                                <label class="form-label fw-semibold">@Loc["ToUser"]</label>
                                @foreach (var value in Enum.GetValues<DelegationToUser>())
                                {
                                    var id = $"toUser_{value}";
                                    bool isChecked = delegationPermission!.DelegationToUser == value;

                                    <div class="form-check form-switch d-block mb-2">
                                        <input type="radio"
                                               id="@id"
                                               class="form-check-input"
                                               name="toUserRadio"
                                               checked="@isChecked"
                                               @onclick="@(() => OnDelegationToUserClicked(value, delegationPermission))" />
                                        <label class="form-check-label ms-2" for="@id">@Loc[@value.ToString()]</label>
                                    </div>
                                }
                                @if (delegationPermission!.DelegationToUser == DelegationToUser.DifferentDepartment)
                                {
                                    <DelegationDepartmentSelector DepartmentList="departmentDtos"
                                                                  SelectedDepartments="@delegationPermission.DelegationToUserDepartments"
                                                                  SelectedDepartmentsChanged="@((List<Guid> ids) => delegationPermission.DelegationToUserDepartments = ids)"
                                                                  LoadUsersByDepartment="@LoadUsersForDepartment" />

                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public PrivilegeDto PrivilegeDto { get; set; } = new PrivilegeDto();
    [Parameter] public EventCallback<bool> OnValidationStateChanged { get; set; }
    List<GeneralModuleDto> generalModules = new();
    List<DepartmentDto> departmentDtos = new();
    private bool showDelegationFromUserError = false;

    protected override async Task OnInitializedAsync()
    {
        var res = await _generalModuleConsumer.GetGeneralModules();
        if (res.Success && res != null && res.Data != null)
        {
            generalModules = res.Data.ToList();
            PrivilegeDto.GeneralModulePermissions = generalModules
            .Select(m => new GeneralModulePermissionDto
            {
                GeneralModuleId = m.Id,
                IsView = false,
                IsEdit = false,
                IsAdd = false,
                IsDelete = false,
                DelegationFromUser = new List<int>(),
                DelegationFromUserDepartments = new List<Guid>(),
                DelegationToUserDepartments = new List<Guid>()
            })
            .ToList();
            var departmentsRes = await _departmentConsumer.GetDepartmentsNoPagnation();
            if (departmentsRes.Success && departmentsRes != null && departmentsRes.Data != null)
            {
                departmentDtos = departmentsRes.Data.ToList();
            }
        }
    }

    void SetAll(GeneralModulePermissionDto permission, object value)
    {
        bool isChecked = (bool)value;
        permission.IsView = isChecked;
        permission.IsEdit = isChecked;
        permission.IsAdd = isChecked;
        permission.IsDelete = isChecked;
    }

    void OnAddChanged(GeneralModulePermissionDto permission, ChangeEventArgs e)
    {
        permission.IsAdd = (bool)e.Value!;
        StateHasChanged();
    }

    private void OnDelegationToUserClicked(DelegationToUser value, GeneralModulePermissionDto permission)
    {
        if (permission.DelegationToUser == value)
            permission.DelegationToUser = null;
        else
            permission.DelegationToUser = value;
    }
    private async Task OnDelegationFromUserChanged(int value, object checkedValue, GeneralModulePermissionDto permission)
    {
        bool isChecked = (bool)checkedValue;
        permission.DelegationFromUser ??= new List<int>();

        if (isChecked)
        {
            if (!permission.DelegationFromUser.Contains(value))
                permission.DelegationFromUser.Add(value);
        }
        else
        {
            permission.DelegationFromUser.Remove(value);
        }
        showDelegationFromUserError =
           permission.IsAdd && (permission.DelegationFromUser == null || !permission.DelegationFromUser.Any());
        await OnValidationStateChanged.InvokeAsync(!showDelegationFromUserError);
        StateHasChanged();
    }

    private async Task<List<UserDto>> LoadUsersForDepartment(Guid deptId)
    {
        var res = await _userConsumer.GetAllUsersByDepartment(deptId);
        return res.Success ? res.Data?.AssignedUsers ?? new List<UserDto>() : new List<UserDto>();
    }
}
