@page "/privilege"
@using TaskyRevamp.Client.Pages.Permission.Modules
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.Permissions
@using TaskyRevamp.Client.Consumer
@inject PrivilegeConsumer _privilegeConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject NavigationManager navigationManager

<div class="page-header">
    <div class="title-block">
        <button type="button" class="btn btn-action-24" @onclick="Return">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.BackArrow"></SVGCrud>
            </span>
        </button>
        <h1 class="page-headline"> @Loc[PageTitle]</h1>
    </div>

</div>
<div class="page-body">
    @if (editContext != null)
    {
        <!-- Tabs -->
        <div class="line-tabs-nav">
            @foreach (var tab in new[] { "General", "Task", "Report" })
            {
                <button class="btn-tab @(SelectedTab == tab ? "active" : "")" @onclick='() => SelectTab(tab)'>
                    <span class="icon">
                        @switch (tab)
                        {
                            case "General":
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.PrivilegePluse"></SVGCrud>
                                break;

                            case "Task":
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.File"></SVGCrud>
                                break;

                            case "Report":
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.User"></SVGCrud>
                                break;

                            default:
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                                break;
                        }
                    </span>
                    <span class="text"> @Loc[$"{tab}Module"]</span>
                </button>
            }
        </div>
        <div class="card setting-card">
            <!-- Form -->
            <EditForm class="d-flex flex-column flex-1" EditContext="editContext" OnValidSubmit="SaveSettings" OnInvalidSubmit="OnInvalidSubmit">
                <DataAnnotationsValidator />

                <div class="card-body">
                    <div class="row justify-content-center">
                        <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                            <div class="border-bottom mb-4 pb-3">
                                <div class="row ">

                                    <div class="col-md-6">
                                        <label class="form-label">
                                            @Loc["EnglishName"] <span class="text-danger">*</span>
                                        </label>
                                        <InputText class="form-control" @bind-Value="PrivilegeDto.NameEnglish"
                                            placeholder=@Loc["EnterPrivilegeEnglishName"] />
                                        <ValidationMessage For="@(() => PrivilegeDto.NameEnglish)"
                                            class="small text-danger" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">
                                            @Loc["ArabicName"] <span class="text-danger">*</span>
                                        </label>
                                        <InputText class="form-control" @bind-Value="PrivilegeDto.NameArabic"
                                            placeholder=@Loc["EnterPrivilegeArabicName"] />
                                        <ValidationMessage For="@(() => PrivilegeDto.NameArabic)"
                                            class="small text-danger" />
                                    </div>
                                </div>
                            </div>
                            <div style="display:@(SelectedTab == "General" ? "block" : "none")">

                                <!-- GeneralModule child component -->
                                <GeneralModule PrivilegeDto="PrivilegeDto" Mode="Mode" IsViewMode="IsViewMode"
                                    OnValidationStateChanged="@OnGeneralModuleValidationChanged" IsSaveClicked="@IsSaveClicked"/>
                            </div>
                            <div style="display:@(SelectedTab == "Task" ? "block" : "none")">
                                <TaskModule PrivilegeDto="PrivilegeDto" Mode="Mode" IsViewMode="IsViewMode" IsSaveClicked="IsSaveClicked"/>
                            </div>
                            <div style="display:@(SelectedTab == "Report" ? "block" : "none")">
                                <ReportModule PrivilegeDto="PrivilegeDto" Mode="Mode" IsViewMode="IsViewMode" />
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Shared Footer -->
                <div class="card-footer">
                    <div class="row justify-content-center">
                        <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                            <div class="action-buttons">
                                <button type="button" class="btn btn-lg btn-light" @onclick="CancelSettings">
                                    @Loc["Cancel"]
                                </button>
                                <button type="submit" disabled="@IsViewMode"
                                    class="btn btn-lg btn-primary">@Loc["Save"]</button>
                            </div>
                        </div>
                    </div>
                </div>
            </EditForm>
        </div>
    }
</div>
@code {
    [Parameter][SupplyParameterFromQuery] public string Mode { get; set; } = "add";
    [Parameter][SupplyParameterFromQuery] public Guid? Id { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    public PrivilegeDto PrivilegeDto { get; set; } = new PrivilegeDto();
    private string SelectedTab { get; set; } = "General";
    private EditContext? editContext;
    private ValidationMessageStore? messageStore;
    private bool isGeneralModuleValid = true;
    private bool IsSaveClicked = false;
    private string PageTitle =>
    Mode == "add" ? "AddNewPrivilege" :
    Mode == "edit" ? "EditPrivilege" : "ViewPermission";
    public bool IsViewMode => Mode == "view";

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(PrivilegeDto);
        messageStore = new ValidationMessageStore(editContext);
        if (Mode != "add" && Id.HasValue)
        {
            var res = await _privilegeConsumer.GetPrivilegeById(Id.Value);
            if (res.Success && res.Data != null)
            {
                PrivilegeDto = res.Data;
                editContext = new EditContext(PrivilegeDto);
                messageStore = new ValidationMessageStore(editContext);
            }
        }
        editContext.OnFieldChanged += (_, e) =>
        {
            messageStore.Clear(e.FieldIdentifier);
            editContext.NotifyValidationStateChanged();
        };
    }

    void SelectTab(string tab) => SelectedTab = tab;

    private void OnGeneralModuleValidationChanged(bool isValid)
    {
        isGeneralModuleValid = isValid;
    }
    private void CancelSettings()
    {
        // Navigate away or reset DTO
        PrivilegeDto = new PrivilegeDto();
        editContext = new EditContext(PrivilegeDto);
        SelectedTab = "General";
        navigationManager.NavigateTo("/Privileges");
    }

    private void ClearValidationMessages()
    {
        messageStore!.Clear();
        editContext!.NotifyValidationStateChanged();
    }
    private void AddErrorsToEditContext(IReadOnlyDictionary<string, List<string>> errors)
    {
        messageStore!.Clear();
        foreach (var error in errors)
        {
            var fieldIdentifier = new FieldIdentifier(PrivilegeDto, error.Key);
            foreach (var msg in error.Value)
            {
                messageStore.Add(fieldIdentifier, msg);
            }
        }
        editContext!.NotifyValidationStateChanged();
    }
    private bool HasInvalidUserDepartments()
    {
        if (PrivilegeDto.TaskModuleUserDepartmentDto == null)
            return false;

        foreach (var item in PrivilegeDto.TaskModuleUserDepartmentDto.Where(x => x.IsActive))
        {
            // Validate permissions
            bool shouldShowPermission =
            item.SelectedOption == UserDepartmentOptions.BelowUserDepartmentLevel ||
            item.SelectedOption == UserDepartmentOptions.AboveUserDepartmentLevel ||
            item.SelectedOption == UserDepartmentOptions.PeersLevel ||
            item.SelectedOption == UserDepartmentOptions.SameDepartment;

            if (shouldShowPermission && (item.PermissionId == null || !item.PermissionId.Any()))
                return true;

            // Validate direction level
            bool shouldShowDirection =
            item.SelectedOption == UserDepartmentOptions.BelowUserDepartmentLevel ||
            item.SelectedOption == UserDepartmentOptions.AboveUserDepartmentLevel;

            if (shouldShowDirection && (item.DirectionLevel == null || item.DirectionLevel < 1))
                return true;

            if (shouldShowPermission && (item.IsManagerTasks != true && item.IsEmployeeTasks != true))
                return true;

        }
        return false;
    }

    private bool HasInvalidExternalDepartments()
    {
        if (PrivilegeDto.TaskModuleExternalDepartmentDto == null ||
        !PrivilegeDto.TaskModuleExternalDepartmentDto.Any())
            return false;

        foreach (var dept in PrivilegeDto.TaskModuleExternalDepartmentDto)
        {
            // Direction Level
            if (dept.IsIncludeSubDepartment && (dept.DirectionLevel == null || dept.DirectionLevel < 1))
                return true;

            // Permissions
            if (dept.PermissionId == null || !dept.PermissionId.Any())
                return true;

            if (dept.IsEmployeeTasks != true && dept.IsManagerTasks != true)
                return true;
        }

        return false;
    }

    private async Task SaveSettings()
    {
        IsSaveClicked = true;

        if (IsViewMode)
        {
            return;
        }

        if (!isGeneralModuleValid)
        {
            SelectedTab = "General";
            StateHasChanged();
            return;
        }
        if (HasInvalidUserDepartments() || HasInvalidExternalDepartments())
        {
            SelectedTab = "Task";
            StateHasChanged();
            return;
        }
        // var json = System.Text.Json.JsonSerializer.Serialize(PrivilegeDto, new System.Text.Json.JsonSerializerOptions
        // {
        // WriteIndented = true
        // });
        // Console.WriteLine(json);
        ClearValidationMessages();
        if (Mode == "add")
        {
            var res = await _privilegeConsumer.CreatePrivilege(PrivilegeDto);
            if (res.Errors != null && res.Errors.Count > 0)
            {
                AddErrorsToEditContext(res.Errors);
                return;
            }
            await ToastService.ShowToastAsync(Loc["Added successfully"], "success");
        }
        else if (Mode == "edit")
        {
            var res = await _privilegeConsumer.UpdatePrivilege(PrivilegeDto);
            if (res.Errors != null && res.Errors.Count > 0)
            {
                AddErrorsToEditContext(res.Errors);
                return;
            }
            await ToastService.ShowToastAsync(Loc["Edited successfully"], "success");
        }
        navigationManager.NavigateTo("/Privileges");

    }
    private void OnInvalidSubmit(EditContext context)
    {
        // Do nothing → prevents auto focus
    }
    private void Return()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            navigationManager.NavigateTo(Uri.UnescapeDataString(ReturnUrl));
        else
            navigationManager.NavigateTo("/Privileges");
    }
}