@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.Permissions.TaskModule
@using Stingray.Components.MultiSelectComponent
@inject IStringLocalizer<SharedResources> Loc

<div class="card mb-3 border">
    <div class="card-header d-flex justify-content-between align-items-center bg-light">
        <strong>@DepartmentName</strong>
        <div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleExpand">
                @(IsExpanded ? "-" : "+")
            </button>
            <button class="btn btn-sm btn-outline-danger ms-2" @onclick="RemoveClicked">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                </span>
            </button>
        </div>
    </div>

    @if (IsExpanded)
    {
        <div class="card-body">
            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" @bind="Item.IsIncludeSubDepartment" />
                <label class="form-check-label">@Loc["IncludingSubDepartment"]</label>
            </div>

            <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" @bind="Item.IsManagerTasks" />
                <label class="form-check-label">@Loc["ManagersTasks"]</label>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" @bind="Item.IsEmployeeTasks" />
                <label class="form-check-label">@Loc["EmployeesTasks"]</label>
            </div>

            <div class="mb-3">
                <label class="form-label fw-bold">@Loc["Permissions"] <span class="text-danger">*</span></label>
                <SearchableMultiDropdownOffline TInput="Permission"
                                                TOutput="int"
                                                Datasource="PermissionList"
                                                TextSelector="(p => Loc[p.ToString()])"
                                                OutputSelector="(p => (int)p)"
                                                SelectedOptions="Item.PermissionId"
                                                SelectedOptionsChanged="OnPermissionsChanged" />
            </div>

            <div class="mb-3">
                <label class="form-label">@Loc["Status"]<span class="text-danger">*</span></label>
                <SearchableMultiDropdownOffline TInput="Permission"
                                                TOutput="int"
                                                Datasource="PermissionList"
                                                TextSelector="(p => Loc[p.ToString()])"
                                                OutputSelector="(p => (int)p)"
                                                SelectedOptions="Item.PermissionId"
                                                SelectedOptionsChanged="OnPermissionsChanged" />
            </div>

            <div class="mb-3">
                <label class="form-label">@Loc["Source"]<span class="text-danger">*</span></label>
                <SearchableMultiDropdownOffline TInput="Permission"
                                                TOutput="int"
                                                Datasource="PermissionList"
                                                TextSelector="(p => Loc[p.ToString()])"
                                                OutputSelector="(p => (int)p)"
                                                SelectedOptions="Item.PermissionId"
                                                SelectedOptionsChanged="OnPermissionsChanged" />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public TaskModuleExternalDepartmentDto Item { get; set; }
    [Parameter] public string DepartmentName { get; set; } = string.Empty;
    [Parameter] public EventCallback<TaskModuleExternalDepartmentDto> OnRemove { get; set; }

    private bool IsExpanded { get; set; } = true;
    private List<Permission> PermissionList = Enum.GetValues(typeof(Permission)).Cast<Permission>().ToList();
    // private List<StatusDto> StatusList { get; set; } = new();
    // private List<SourceDto> SourceList { get; set; } = new();
    private void OnPermissionsChanged(List<int> selectedPermissions)
    {
        Item.PermissionId = selectedPermissions;
    }
    private async Task RemoveClicked()
    {
        await OnRemove.InvokeAsync(Item);
    }
    private void ToggleExpand()
    {
        IsExpanded = !IsExpanded;
    }
}
