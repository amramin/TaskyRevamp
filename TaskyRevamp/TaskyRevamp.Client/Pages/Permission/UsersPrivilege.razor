@page "/UsersPrivilege/{Id:guid}"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.Enums.SearchFields
@using TaskyRevamp.Client.Pages.Department
@inject UserConsumer _userConsumer
@inject PrivilegeConsumer _privilegeConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService

<div class="page-header">
    <div class="title-block">
        <button class="btn btn-action-24" @onclick="ReturnBack">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.BackArrow"></SVGCrud>
            </span>
        </button>
        <h1 class="page-headline"> @Loc["Usersin"]@privilegeName </h1>
    </div>
    <div class="action-btn-list">
        <Search @ref="searchComponent" SearchSubmit="Search" CssClass="form-control"></Search>
        <button class="btn btn-primary" @onclick="Add">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
            </span>
            @Loc["LinkUser"]
        </button>
    </div>
</div>

@if (Users != null && Users.Any())
{
    <div class="page-body">
        <div class="table-responsive sticky-header-custom">
            @if (Users != null && Users.Any())
            {

                <SortableTable TItem="UserDtoWithName" Columns="@tableColumns" Items="@Users"
                               SortColumn="@currentSortColumn" SortAscending="@sortAscending" OnSortRequested="HandleSort">

                    <RowTemplate>
                        @foreach (var user in Users)
                        {
                            var checkboxId = $"source-active-{user.user.Id}";
                            <tr>
                                <td>@user.user.DisplayedName</td>
                                <td>@user.user.Email</td>
                                <td>@user.DepartmentName</td>
                                <td>@user.PrivilegeName</td>
                            </tr>
                        }
                    </RowTemplate>
                </SortableTable>
            }
        </div>
        <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                    PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
    </div>
}
else if (initialUsers != null && initialUsers.Any())
{
    <NoSearchResults OnResetClick="ClearSearch"></NoSearchResults>
}
else
{
    <NoDataAvailable MessageTitle="@Loc["NoUsersPrivilege"]"
                     ButtonText="@Loc["LinkUser"]"
                     OnButtonClick="Add" />
}

@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter, SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    public List<UserDtoWithName> Users = new List<UserDtoWithName>();
    public List<UserDtoWithName> initialUsers = new List<UserDtoWithName>();
    private bool isOrdered = false;
    string searchdata { set; get; }
    private Search? searchComponent;
    private string? lastSearchTerm = null;
    private bool isSearchMode = false;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "";
    private bool? sortAscending = true;
    private List<SortableColumn> tableColumns = new();
    private string privilegeName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        tableColumns = new()
        {
            new() { Field = "DisplayedName", DisplayName = Loc["username"] },
            new() { Field = "Email", DisplayName = Loc["Email_user"] },
            new() { Field = "Department", DisplayName = Loc["Department"] },
            new() { Field = "Privilege", DisplayName = Loc["UserPrivilege"] },
        };
        await LoadPrivilegeName();
        await LoadUsers();
        initialUsers = Users;
    }

    private async Task LoadUsers(bool isSearch = false, string searchTerm = null)
    {
        if (isSearchMode && !isSearch)
        {
            isSearch = true;
            searchTerm = lastSearchTerm;
        }
        var encodedTerm = searchTerm != null ? Uri.EscapeDataString(searchTerm) : null;
        var resp = await _userConsumer.GetUsersByPrivilegeIdWithPagination(Id, currentPage, pageSize, currentSortColumn, sortAscending.Value,
                         isSearch ? searchFields : null, isSearch ? encodedTerm : null);

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        Users = data.Items.ToList();
        totalPages = resp.Data.TotalPages;
        totalCount = resp.Data.TotalCount;
    }
    private async Task LoadPrivilegeName()
    {
        var res = await _privilegeConsumer.GetPrivilegeNameById(Id);
        if(res.Success && res.Data != null)
        {
            privilegeName = res.Data;
        }
    }
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadUsers();
    }

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadUsers();
    }
    private void Add() => PopupService.ShowNew(@<LinkUsersToPrivilege Id="Id" OnSaved="ReloadAfterSave"></LinkUsersToPrivilege>,Loc["LinkUser"]);
    private void ViewPrivilege(Guid? id)
    {
        var currentUrl = navigationManager.Uri;
        navigationManager.NavigateTo($"/privilege?mode=view&id={id}&ReturnUrl={Uri.EscapeDataString(currentUrl)}");
    }

    private async Task ReloadAfterSave()
    {
        currentPage = 1;
        PopupService.Hide();
        await LoadUsers();
        StateHasChanged();
    }
    private async Task SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }
        await LoadUsers();
    }

    public List<SearchFieldUserPrivilege> searchFields = new List<SearchFieldUserPrivilege>() {
            SearchFieldUserPrivilege.NameEnglish,
            SearchFieldUserPrivilege.NameArabic,
            SearchFieldUserPrivilege.Email,
            SearchFieldUserPrivilege.PrivilegeArabic,
            SearchFieldUserPrivilege.DepartmentArabic,
            SearchFieldUserPrivilege.PrivilegeEnglish,
            SearchFieldUserPrivilege.DepartmentEnglish
    };

    public async Task Search(string searchTerm)
    {
        lastSearchTerm = searchTerm;
        isSearchMode = true;
        currentPage = 1;
        await LoadUsers(true, searchTerm);
    }
    private async Task ClearSearch()
    {
        currentPage = 1;
        lastSearchTerm = null;
        isSearchMode = false;
        searchComponent?.ClearSearchText();
        await LoadUsers(isSearch: false);
    }
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;
        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = ""; // or whatever your default column is
            sortAscending = true;
        }
        await LoadUsers();
    }
    private void ReturnBack()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
            navigationManager.NavigateTo(Uri.UnescapeDataString(ReturnUrl));
        else
            navigationManager.NavigateTo("/Privileges");
    }

}