@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.Account
@using Stingray.Components.MultiSelectComponent
@inject IStringLocalizer<SharedResources> Loc

<div>
    <!-- Department Selector -->
    <SearchableMultiDropdownOffline TInput="DepartmentDto"
                                    TOutput="Guid"
                                    @key="AvailableDepartments"
                                    IsDisabled="IsViewMode"
                                    Datasource="AvailableDepartments"
                                    TextSelector="(d => d.Name)"
                                    OutputSelector="(d => d.Id)"
                                    SelectedOptions="@SelectedDepartments"
                                    SelectedOptionsChanged="@OnDepartmentsChanged" />

    @if (DepartmentsWithUsers.Any())
    {
        @foreach (var entry in DepartmentsWithUsers)
        {
            var dept = DepartmentList.First(d => d.Id == entry.Key);
            var users = entry.Value;
            var isExpanded = ExpandedDepartments.Contains(dept.Id);

            <div class="card mt-3 border-0 shadow-sm">
                <div class="card-header bg-light fw-semibold d-flex justify-content-between align-items-center"
                     style="cursor: default; padding:0.5rem 1rem;">

                    <!-- Name on the left -->
                    <span class="flex-grow-1">@dept.Name</span>

                    <!-- Right controls: Toggle arrow + Reject button -->
                    <div class="d-flex align-items-center">
                        @if (!IsViewMode)
                        {
                            <span class="text-muted small me-2" style="cursor:pointer;" @onclick="() => ToggleDepartment(dept.Id)">
                                @(isExpanded ? "▲" : "▼")
                            </span>

                            <button class="btn btn-action-24 p-0" type="button"
                                    aria-label="Remove"
                                    @onclick="() => RemoveDepartment(dept.Id)">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Reject"></SVGCrud>
                            </button>
                        }
                    </div>
                </div>

                @if (isExpanded)
                {
                    <div class="card-body p-2">
                        @if (users == null)
                        {
                            <div class="text-muted small px-2">Loading users...</div>
                        }
                        else if (!users.Any())
                        {
                            <div class="text-muted small px-2">@Loc["NoUsers"]</div>
                        }
                        else
                        {
                            <ul class="list-unstyled mb-0">
                                @foreach (var user in users)
                                {
                                    <li class="border-bottom py-1 px-2">
                                        @* <span class="fw-semibold">@user.DisplayedName</span> *@
                                        <span class="text-muted small ms-1">@user.DisplayedName</span>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public List<DepartmentDto> DepartmentList { get; set; } = new();
    [Parameter] public List<Guid> SelectedDepartments { get; set; } = new();
    [Parameter] public EventCallback<List<Guid>> SelectedDepartmentsChanged { get; set; }
    [Parameter] public Func<Guid, Task<List<UserDto>>> LoadUsersByDepartment { get; set; } = default!;
    [Parameter] public bool IsViewMode { get; set; }
    private Dictionary<Guid, List<UserDto>?> DepartmentsWithUsers { get; set; } = new();
    private HashSet<Guid> ExpandedDepartments { get; set; } = new();
    private List<DepartmentDto> AvailableDepartments => DepartmentList.Where(d => !SelectedDepartments.Contains(d.Id)).ToList();

    protected override async Task OnParametersSetAsync()
    {
        // Ensure departments with users are loaded in edit/view mode
        foreach (var id in SelectedDepartments)
        {
            if (!DepartmentsWithUsers.ContainsKey(id))
            {
                DepartmentsWithUsers[id] = null;
                ExpandedDepartments.Add(id);
                _ = LoadUsersAsync(id); // Load users asynchronously
            }
        }
    }
    private async Task OnDepartmentsChanged(List<Guid> selectedIds)
    {
        SelectedDepartments = selectedIds ?? new();
        await SelectedDepartmentsChanged.InvokeAsync(SelectedDepartments);

        // Remove unselected
        var removed = DepartmentsWithUsers.Keys.Where(id => !SelectedDepartments.Contains(id)).ToList();
        foreach (var r in removed)
        {
            DepartmentsWithUsers.Remove(r);
            ExpandedDepartments.Remove(r);
        }
        // Add new selected
        foreach (var id in SelectedDepartments)
        {
            if (!DepartmentsWithUsers.ContainsKey(id))
            {
                DepartmentsWithUsers[id] = null;
                ExpandedDepartments.Add(id);
                _ = LoadUsersAsync(id);
            }
        }

        StateHasChanged();
    }

    private async Task LoadUsersAsync(Guid departmentId)
    {
        var users = await LoadUsersByDepartment(departmentId);
        DepartmentsWithUsers[departmentId] = users ?? new List<UserDto>();
        StateHasChanged();
    }
    private async Task RemoveDepartment(Guid deptId)
    {
        if (SelectedDepartments.Contains(deptId))
        {
            SelectedDepartments.Remove(deptId);
            DepartmentsWithUsers.Remove(deptId);
            ExpandedDepartments.Remove(deptId);

            await SelectedDepartmentsChanged.InvokeAsync(SelectedDepartments);
            StateHasChanged();
        }
    }
    private void ToggleDepartment(Guid deptId)
    {
        if (ExpandedDepartments.Contains(deptId))
            ExpandedDepartments.Remove(deptId);
        else
            ExpandedDepartments.Add(deptId);
    }
}
