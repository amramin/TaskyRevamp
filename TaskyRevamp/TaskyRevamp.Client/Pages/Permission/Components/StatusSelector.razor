@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.Permissions.TaskModule
@using TaskyRevamp.Dto.SystemConfiguration
@using Stingray.Components.MultiSelectComponent
@inject IStringLocalizer<SharedResources> Loc
@inject StatusSettingConsumer _statusSettingConsumer

<div class="mb-3">
    <label class="form-label">@Loc["Status"]<span class="text-danger">*</span></label>
    <SearchableMultiDropdownOffline @key="AvailableStatuses"
                                    TInput="StatusSettingsDto" TOutput="Guid" Datasource="AvailableStatuses"
                                    TextSelector="(s => s.Name)" OutputSelector="(s => s.Id)"
                                    SelectedOptions="SelectedStatuses"
                                    SelectedOptionsChanged="OnSelectedChanged"
                                    IsDisabled="IsViewMode"
                                    MinCharacterCount="1"
                                    SearchInputPlaceHolder="@Loc["Search"]" PlaceHolder="@($"{Loc["Select"]}")" NoMatchPlaceHolder="@Loc["NoResultsFound"]"
                                    SelectAllPlaceHolder="@Loc["SelectAll"]" AllowSelectAll="AvailableStatuses.Any()"/>

    @if (IsSaveClicked && (SelectedStatuses == null || !SelectedStatuses.Any()))
    {
        <div class="text-danger small mt-1">@Loc["Required"]</div>
    }
    @if (SelectedStatuses != null && SelectedStatuses.Any())
    {
        <div class="my-2">
            <button class="btn btn-primary" @onclick="RemoveAll">@Loc["Deslectall"]</button>
        </div>

        <div class="mt-2 d-flex flex-wrap gap-1">
            @foreach (var statusId in SelectedStatuses)
            {
                var statusItem = StatusList.FirstOrDefault(s => s.Id == statusId);
                if (statusItem != null)
                {
                    <span class="badge bg-white text-black border border-dark d-flex align-items-center gap-1 py-1 px-2 small">
                        @statusItem.Name
                        @if (!IsViewMode)
                        {
                            <button type="button" class="btn-close btn-close-black btn-close-sm ms-1"
                                    aria-label="Remove" style="height:0.9rem; width:0.9rem;"
                                    @onclick="() => RemoveStatus(statusId)"></button>
                        }
                    </span>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public TaskModuleExternalDepartmentDto Item { get; set; }
    [Parameter] public bool IsViewMode { get; set; }
    [Parameter] public bool IsSaveClicked { get; set; }
    private List<StatusSettingsDto> StatusList { get; set; } = new();
    private List<Guid> SelectedStatuses
    {
        get => Item.Status ??= new List<Guid>();
        set => Item.Status = value;
    }
    private List<StatusSettingsDto> AvailableStatuses => 
                StatusList.Where(s => SelectedStatuses == null || !SelectedStatuses.Contains(s.Id)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var statusRes = await _statusSettingConsumer.GetStatusConfiguration();
        if (statusRes.Success && statusRes != null && statusRes.Data != null)
        {
            StatusList = statusRes.Data.Where(p => p.Id != Guid.Parse("D8E94CCE-586A-46D3-223D-08DE3318A61C")).ToList();
        }
    }
    private void OnSelectedChanged(List<Guid> selected)
    {
        SelectedStatuses = selected;
        StateHasChanged();
    }

    private void RemoveStatus(Guid id)
    {
        SelectedStatuses.Remove(id);
        StateHasChanged();
    }
    private void RemoveAll(MouseEventArgs args)
    {
        SelectedStatuses = new List<Guid>();
        StateHasChanged();
    }
    
}
