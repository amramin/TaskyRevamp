@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.Permissions.TaskModule
@using Stingray.Components.MultiSelectComponent
@inject IStringLocalizer<SharedResources> Loc

<div class="mb-3">

    <!-- Conditional Direction fields -->
    @if (ShowDirectionFields)
    {
        <div class="mb-3">
            <label class="form-label ">@Loc["DirectionLevel"] <span class="text-danger">*</span></label>
            <input type="number" class="form-control @(Item.DirectionLevel < 1 ? "border-danger" : "")" min="1"
                   @oninput="ValidateDirectionLevel" @bind="Item.DirectionLevel" disabled="@IsViewMode" />
            @if (IsSaveClicked && Item.IsActive && Item.DirectionLevel == null)
            {
                <div class="text-danger small mt-1">@Loc["Required"]</div>
            }
            else if (IsSaveClicked && Item.IsActive && Item.DirectionLevel < 1)
            {
                <div class="text-danger small mt-1">@Loc["ValueMustBeGreaterThanOrEqualTo1"]</div>
            }
        </div>
    }
    <!-- Permissions -->
    <div class="mb-3">
        @if (ShowPermissionFields)
        {
            <label class="form-label ">@Loc["Permissions"] <span class="text-danger">*</span></label>
            <SearchableMultiDropdownOffline TInput="Permission" TOutput="int" @key="AvailablePermissions" Datasource="AvailablePermissions"
                TextSelector="(p => Loc[p.ToString()])" OutputSelector="(p => (int)p)" SelectedOptions="Item.PermissionId"
                SelectedOptionsChanged="OnPermissionsChanged" IsDisabled="IsViewMode" />
            @if (IsSaveClicked && Item.IsActive && (Item.PermissionId == null || !Item.PermissionId.Any()))
            {
                <div class="text-danger small mt-1">@Loc["Required"]</div>

            }
            @if (Item.PermissionId != null && Item.PermissionId.Any())
            {
                <div class="mt-2">
                    <div class="d-flex flex-wrap gap-1">
                        @foreach (var permissionId in Item.PermissionId)
                        {
                            var permission = (Permission)permissionId;
                            <span class="badge bg-primary d-flex align-items-center gap-1 py-1 px-2 small">
                                @Loc[permission.ToString()]
                                @if (!IsViewMode)
                                {
                                    <button type="button" class="btn-close btn-close-white btn-close-sm ms-1" aria-label="Remove"
                                            style="height:1rem; width:1rem;" @onclick="() => RemovePermission(permissionId)"></button>
                                }
                            </span>
                        }
                    </div>
                </div>
            }
        }
    </div>
    @if(ShowToggleFields){
        <!-- Manager / Employee toggles -->
        <div class="d-flex flex-column gap-2 mb-3">
            <div class="form-check form-switch custom">
                <input class="form-check-input" type="checkbox" id="manager_@Item.SelectedOption"
                       @bind="Item.IsManagerTasks" disabled="@IsViewMode" />
                <label class="form-check-label" for="manager_@Item.SelectedOption">
                    <span class="toggler-icon"></span>
                    @Loc["ManagersTasks"]</label>
            </div>

            <div class="form-check form-switch custom">
                <input class="form-check-input" type="checkbox" id="employee_@Item.SelectedOption"
                       @bind="Item.IsEmployeeTasks" disabled="@IsViewMode" />
                <label class="form-check-label" for="employee_@Item.SelectedOption">
                    <span class="toggler-icon"></span>
                    @Loc["EmployeesTasks"]</label>
            </div>
            @if (IsSaveClicked && Item.IsActive && Item.IsEmployeeTasks != true &&  Item.IsManagerTasks != true)
            {
                <div class="text-danger small mt-1">@Loc["SelectAtLeastOneToggleToProceed"]</div>
            }
        </div>
    }
   
</div>

@code {
    [Parameter] public TaskModuleUserDepartmentPermissionDto Item { get; set; } = new();
    [Parameter] public bool ShowDirectionFields { get; set; } = true;
    [Parameter] public bool ShowPermissionFields { get; set; } = true;
    [Parameter] public bool ShowToggleFields { get; set; } = true;
    [Parameter] public bool IsViewMode { get; set; }
    [Parameter] public bool IsSaveClicked { get; set; }
    private List<Permission> PermissionList = Enum.GetValues(typeof(Permission)).Cast<Permission>().ToList();
    private List<Permission> AvailablePermissions => PermissionList.Where(p => Item.PermissionId == null || !Item.PermissionId.Contains((int)p)).ToList();
    private void OnPermissionsChanged(List<int> selectedPermissions)
    {
        Item.PermissionId = selectedPermissions;
        StateHasChanged();
    }
    private void ValidateDirectionLevel(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int value))
        {
            Item.DirectionLevel = value < 1 ? 1 : value;
        }
        else
        {
            Item.DirectionLevel = 1;
        }
        StateHasChanged();
    }
    private void RemovePermission(int permissionId)
    {
        Item.PermissionId?.Remove(permissionId);
        StateHasChanged();
    }
}