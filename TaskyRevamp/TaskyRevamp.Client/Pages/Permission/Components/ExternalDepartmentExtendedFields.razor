@using TaskyRevamp.Dto.Department
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.Permissions.TaskModule
@using TaskyRevamp.Client.Consumer
@using Stingray.Components.MultiSelectComponent
@inject IStringLocalizer<SharedResources> Loc

<div class="card collapse-card mb-3">
    <div class="card-header">
        <button type="button" class="btn colapse-btn @(IsExpanded ? "active" : "")" @onclick="ToggleExpand">
            <span>@DepartmentName</span>
            @if (IsExpanded)
            {
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Minus"></SVGCrud>
            }
            else
            {
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
            }
        </button>
        <button type="button" class="btn btn-delete btn-action-24" @onclick="RemoveClicked" disabled="@IsViewMode">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
            </span>
        </button>
    </div>

    @if (IsExpanded)
    {
        <div class="card-body">
            <div class="d-flex flex-column gap-2 mb-3">
                <div class="form-check form-switch custom">
                    <input class="form-check-input" type="checkbox" id="manager_@Item.Id"
                           @bind="Item.IsManagerTasks" disabled="@IsViewMode" />
                    <label class="form-check-label" for="manager_@Item.Id">
                        <span class="toggler-icon"></span>
                        @Loc["ManagersTasks"]
                    </label>
                </div>
                <div class="form-check form-switch custom">
                    <input class="form-check-input" type="checkbox" id="employee_@Item.Id"
                           @bind="Item.IsEmployeeTasks" disabled="@IsViewMode" />
                    <label class="form-check-label" for="employee_@Item.Id">
                        <span class="toggler-icon"></span>
                        @Loc["EmployeesTasks"]
                    </label>
                </div>
                @if (IsSaveClicked && Item.IsManagerTasks != true && Item.IsEmployeeTasks != true)
                {
                    <div class="text-danger small mt-1">@Loc["SelectAtLeastOneToggleToProceed"]</div>
                }
            </div>

            <div class="form-check form-switch custom">
                <input class="form-check-input" type="checkbox" @bind="Item.IsIncludeSubDepartment"
                       disabled="@IsViewMode" id="sub_@Item.Id" />
                <label class="form-check-label" for="sub_@Item.Id">
                    <span class="toggler-icon"></span>
                    @Loc["IncludingSubDepartment"]
                </label>
            </div>
            @if (IsSaveClicked && Item.IsIncludeSubDepartment)
            {
                <div class="mb-3">
                    <label class="form-label fw-bold">@Loc["DirectionLevel"] <span class="text-danger">*</span></label>
                    <input type="number" class="form-control @(Item.DirectionLevel < 1 ? "border-danger" : "")" min="1"
                           @oninput="ValidateDirectionLevel" @bind="Item.DirectionLevel" disabled="@IsViewMode" />
                    @if (IsSaveClicked && Item.DirectionLevel == null)
                    {
                        <div class="text-danger small mt-1">@Loc["Required"]</div>
                    }
                    else if (IsSaveClicked && Item.DirectionLevel < 1)
                    {
                        <div class="text-danger small mt-1">@Loc["ValueMustBeGreaterThanOrEqualTo1"]</div>
                    }
                </div>
            }
            else
            {
                <div class="text-danger small mt-1">@Loc["Required"]</div>
            }

            <div class="mb-3">
                <label class="form-label fw-bold">@Loc["Permissions"] <span class="text-danger">*</span></label>
                <SearchableMultiDropdownOffline TInput="Permission" TOutput="int" @key="AvailablePermissions"
                                                Datasource="AvailablePermissions"
                                                TextSelector="(p => Loc[p.ToString()])" OutputSelector="(p => (int)p)"
                                                SelectedOptions="Item.PermissionId" SelectedOptionsChanged="OnPermissionsChanged" IsDisabled="IsViewMode" />
                @if (IsSaveClicked && (Item.PermissionId == null || !Item.PermissionId.Any()))
                {
                    <div class="text-danger small mt-1">@Loc["Required"]</div>
                }
                @if (Item.PermissionId != null && Item.PermissionId.Any())
                {
                    <div class="mt-2">
                        <div class="d-flex flex-wrap gap-1">
                            @foreach (var permissionId in Item.PermissionId)
                            {
                                var permission = (Permission)permissionId;
                                <span class="badge bg-primary d-flex align-items-center gap-1 py-1 px-2 small">
                                    @Loc[permission.ToString()]
                                    @if (!IsViewMode)
                                    {
                                        <button type="button" class="btn-close btn-close-white btn-close-sm ms-1" aria-label="Remove"
                                                style="height:1rem; width:1rem;" @onclick="() => RemovePermission(permissionId)"></button>
                                    }
                                </span>
                            }
                        </div>
                    </div>
                }
            </div>

            <StatusSelector Item="Item" IsViewMode="IsViewMode" IsSaveClicked="IsSaveClicked" />
            <SourceSelector Item="Item" IsViewMode="IsViewMode" IsSaveClicked="IsSaveClicked" />
           
        </div>
    }
</div>

@code {
    [Parameter] public TaskModuleExternalDepartmentDto Item { get; set; }
    [Parameter] public string DepartmentName { get; set; } = string.Empty;
    [Parameter] public EventCallback<TaskModuleExternalDepartmentDto> OnRemove { get; set; }
    [Parameter] public bool IsViewMode { get; set; }
    [Parameter] public bool IsSaveClicked { get; set; }
    [Parameter] public bool IsExpanded { get; set; }
    private bool IsTouched = false;
    private List<Permission> PermissionList = Enum.GetValues(typeof(Permission)).Cast<Permission>().ToList();
    private List<Permission> AvailablePermissions => PermissionList.Where(p => Item.PermissionId == null || !Item.PermissionId.Contains((int)p)).ToList();

    protected override void OnParametersSet()
    {
        if ((IsViewMode || IsSaveClicked && IsInvalid()) && !IsExpanded)
        {
            IsExpanded = true;
        }
    }
    private void OnPermissionsChanged(List<int> selectedPermissions)
    {
        Item.PermissionId = selectedPermissions;
        StateHasChanged();
    }
    private async Task RemoveClicked()
    {
        await OnRemove.InvokeAsync(Item);
    }
    private void ToggleExpand()
    {
        IsExpanded = !IsExpanded;
    }
    private void ValidateDirectionLevel(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int value))
        {
            Item.DirectionLevel = value < 1 ? null : value;
        }
        else
        {
            Item.DirectionLevel = null;
        }
        StateHasChanged();
    }
    private bool IsInvalid()
    {
        if (Item.IsManagerTasks != true && Item.IsEmployeeTasks != true)
            return true;
        if (Item.PermissionId == null || !Item.PermissionId.Any())
            return true;
        if (Item.Status == null || !Item.Status.Any())
            return true;
        if (Item.Source == null || !Item.Source.Any())
            return true;
        if (Item.IsIncludeSubDepartment &&
            (Item.DirectionLevel == null || Item.DirectionLevel < 1))
            return true;

        return false;
    }
    private void MarkTouched()
    {
        if (!IsTouched)
            IsTouched = true;
    }
    private void RemovePermission(int permissionId)
    {
        Item.PermissionId?.Remove(permissionId);
        StateHasChanged();
    }
}