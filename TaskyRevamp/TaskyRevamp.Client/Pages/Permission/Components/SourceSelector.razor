@using Stingray.Components.MultiSelectComponent
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.Permissions.TaskModule
@using TaskyRevamp.Dto.SystemConfiguration
@inject IStringLocalizer<SharedResources> Loc
@inject SourceSettingConsumer _sourceSettingConsumer

<div class="mb-3">
    <label class="form-label">@Loc["Source"]<span class="text-danger">*</span></label>
    <SearchableMultiDropdownOffline @key="AvailableSources"
                                    TInput="SourceDto" TOutput="Guid" Datasource="SourceList"
                                    TextSelector="(s => s.DisplayedName)" OutputSelector="(s => s.Id)"
                                    SelectedOptions="SelectedSources"
                                    MinCharacterCount="1"
                                    IsDisabled="IsViewMode"
                                    SearchInputPlaceHolder="@Loc["Search"]" PlaceHolder="@($"{Loc["Select"]}")" NoMatchPlaceHolder="@Loc["NoResultsFound"]"
                                    SelectAllPlaceHolder="@Loc["SelectAll"]" AllowSelectAll="SourceList.Any()" />
</div>

@code {
    [Parameter] public TaskModuleExternalDepartmentDto Item { get; set; }
    [Parameter] public bool IsViewMode { get; set; }
    [Parameter] public bool IsSaveClicked { get; set; }
    [Parameter] public string Mode { get; set; }
    private List<SourceDto> SourceList { get; set; } = new();
    private List<Guid> SelectedSources
    {
        get => Item.Source ??= new List<Guid>();
        set => Item.Source = value;
    }
    private List<SourceDto> AvailableSources => SourceList.Where(s => !SelectedSources.Contains(s.Id)).ToList();

    protected override async Task OnInitializedAsync()
    {
        var sourceRes = await _sourceSettingConsumer.GetSourcesWithoutPagination();
        if (sourceRes.Success && sourceRes != null && sourceRes.Data != null)
        {
            var allSources = sourceRes.Data.ToList();
            if (Mode == "Edit")
                SourceList = allSources;
            else
                SourceList = allSources.Where(s => s.IsActive).ToList();

            var selectedSourceIds = SelectedSources ?? new List<Guid>();
            var missingSelected = allSources.Where(s => selectedSourceIds.Contains(s.Id) && !SourceList.Any(x => x.Id == s.Id)).ToList();
            SourceList.AddRange(missingSelected);
        }
    }
    private void OnSelectedChanged(List<Guid> selected)
    {
        SelectedSources = selected;
        StateHasChanged();
    }
    private void RemoveSource(Guid id)
    {
        SelectedSources.Remove(id);
        StateHasChanged();
    }
    private void RemoveAll(MouseEventArgs args)
    {
        SelectedSources = new List<Guid>();
        StateHasChanged();
    }
}
