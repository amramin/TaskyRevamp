@page "/ChangeDueDateRequests"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.ChangeEndDateRequest
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.Enums.SearchFields
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject RequestChangeDueDateConsumer _requestChangeDueDateConsumer
@inject PopupService PopupService



<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["ChangeEndDateRequests"]</h1>

    </div>
    <div class="action-btn-list">
        <Search @ref="searchComponent" SearchSubmit="Search" CssClass="form-control"></Search>
    </div>
</div>

@if (DueDasteRequests != null && DueDasteRequests.Any())
{
    <div class="page-body">
        <div class="table-responsive sticky-header-custom">
            @if (DueDasteRequests != null && DueDasteRequests.Any())
            {

                <SortableTable TItem="ChangeEndDateRequestDto" Columns="@tableColumns" Items="@DueDasteRequests"
                               SortColumn="@currentSortColumn" SortAscending="@sortAscending" OnSortRequested="HandleSort">

                    <RowTemplate>
                        @foreach (var item in DueDasteRequests)
                        {
                            <tr>
                                <td @onclick="@(() => ViewTaskDetails(item.TaskId))" style="cursor:pointer;">@item.TaskTitle</td>
                                <td>@item.oldEndDate.ToLocalTime().ToString(Loc["LocalizeDate"])</td>
                                <td>@item.NewEndDate.ToLocalTime().ToString(Loc["LocalizeDate"])</td>
                                <td>@item.RequesterName</td>
                                <td>@item.Reason</td>
                                <td>@item.Status.ToString()</td>
                                <td>

                                        <div class="dropdown actions d-flex">
                                        <button class="btn btn-action-24 btn-edit" @onclick="@(() => OnTaskUpdateStatus(item.Id, ChangeRequestStatus.Approved))">
                                            <span class="icon">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Approve"></SVGCrud>
                                            </span>
                                        </button>
                                        <button class="btn btn-action-24 btn-delete" @onclick="@(() => OnTaskUpdateStatus(item.Id, ChangeRequestStatus.Rejected))">
                                            <span class="icon">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.False"></SVGCrud>
                                            </span>
                                        </button>
                                        </div>
                                    

                                </td>
                            </tr>
                        }
                    </RowTemplate>
                </SortableTable>


            }
        </div>

        <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                    PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
    </div>

}
else if (initialDueDasteRequests != null && initialDueDasteRequests.Any())
{
    <NoSearchResults OnResetClick="ClearSearch"></NoSearchResults>
}
else
{
    <div class="card empty-page">
        <div class="card-body">
            <span class="vector">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EmptyPageVector"></SVGCrud>
            </span>
            <div class="content">
                <h5 class="headline-5">@Loc["NoEndDateRequests"]</h5>
            </div>
        </div>
    </div>
}

@code {
    List<ChangeEndDateRequestDto> DueDasteRequests = new();
    List<ChangeEndDateRequestDto> initialDueDasteRequests = new();
    private bool showConfirm;
    private SourceDtoWithName? selectedSource;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "";
    private bool? sortAscending = true;
    private List<SortableColumn> tableColumns = new();
    private Search? searchComponent;
    private string? lastSearchTerm = null;
    private bool isSearchMode = false;
    public List<SearchFieldChangeDueDate> searchFields = new List<SearchFieldChangeDueDate>();
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadSources();
    }

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadSources();
    }
    protected override async Task OnInitializedAsync()
    {
        tableColumns = new()
        {
            new() { Field = "TaskTitle", DisplayName = Loc["Tasktitle"] },
            //new() { Field = "Status", DisplayName = Loc["Status"] },
            new() { Field = "EndDate", DisplayName = Loc["EndDate"] },
            new() { Field = "RequestedEndDate", DisplayName = Loc["RequestedEndDate"] },
            new() { Field = "Requester", DisplayName = Loc["Requester"] },
            new() { Field = "RequestReason", DisplayName = Loc["RequestReason"] },
            new() { Field = "ActionStatus", DisplayName = Loc["RequestStatus"] },
            new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
        };
        searchFields = GetFileds();
        await LoadSources();
        initialDueDasteRequests = DueDasteRequests;
    }
    private async Task LoadSources(bool isSearch = false, string searchTerm = null)
    {
       
        if (isSearchMode && !isSearch)
        {
            isSearch = true;
            searchTerm = lastSearchTerm;
        }
        var encodedTerm = searchTerm != null ? Uri.EscapeDataString(searchTerm) : null;
        var resp = await _requestChangeDueDateConsumer.GetDueDateRequests(currentPage, pageSize, currentSortColumn, sortAscending.Value,
        isSearch ? searchFields : null, isSearch ? encodedTerm : null);

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        DueDasteRequests = data.Items.ToList();
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }
    private async Task SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }
        await LoadSources();
    }
    public List<SearchFieldChangeDueDate> GetFileds()
    {
        var fileds = new List<SearchFieldChangeDueDate>() {
            SearchFieldChangeDueDate.TaskTitle,
           // SearchFieldChangeDueDate.TaskStatus,
            SearchFieldChangeDueDate.EndDate,
            SearchFieldChangeDueDate.RequestEdendDate,
            SearchFieldChangeDueDate.Requester,
            SearchFieldChangeDueDate.RequestReason,
            //SearchFieldChangeDueDate.ActionStatus
        };
        // if (Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar")
        // {
        //     fileds.Add(SearchField.NameArabic);
        // }
        // else
        // {
        //     fileds.Add(SearchField.NameEnglish);
        // }
        return fileds;
    }
    public async Task Search(string searchTerm)
    {
        lastSearchTerm = searchTerm;
        isSearchMode = true;
        currentPage = 1;
        await LoadSources(true, searchTerm);
    }
    private async Task ClearSearch()
    {
        currentPage = 1;
        lastSearchTerm = null;
        isSearchMode = false;
        searchComponent?.ClearSearchText();
        await LoadSources(isSearch: false);
    }
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;


        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = ""; // or whatever your default column is
            sortAscending = true;
        }

        await LoadSources();
    }
    private async Task OnTaskUpdateStatus(Guid requestid, ChangeRequestStatus status)
    {
        string text = "";
        if (status == ChangeRequestStatus.Approved)
        {
            text = "Sureapprovestatus";
        }
        else if (status == ChangeRequestStatus.Rejected)
        {
            text = "Surerejectstatus";
        }
        PopupService.ShowConfirmation(@Loc[text], @Loc["Confirm"],
        async (confirmed) =>
        {
            if (confirmed)
            {
                await OnTaskUpdateStatusConfirmed(requestid, status);
            }
        },
        ConfirmationType.Other
        );
    }
    private async Task OnTaskUpdateStatusConfirmed(Guid requestid, ChangeRequestStatus status)
    {
        var result = await _requestChangeDueDateConsumer.UpdateRequestStatus(requestid, status);
        if (result.Success && result.Data)
        {
            if (status == ChangeRequestStatus.Approved)
            {
                await ToastService.ShowToastAsync(Loc["approvedsuccessfully"], "success");
            }
            else if (status == ChangeRequestStatus.Rejected)
            {
                await ToastService.ShowToastAsync(Loc["rejectedsuccessfully"], "success");
            }
        }
        else
        {
            await ToastService.ShowToastAsync(Loc["Erroroccurred"], "error");
        }
        await LoadSources();
        initialDueDasteRequests = DueDasteRequests;
        StateHasChanged();
    }
    private void ViewTaskDetails(Guid id) => navigationManager.NavigateTo($"/task/details/{id}/{"enddate"}?returnUrl=/ChangeDueDateRequests");

}