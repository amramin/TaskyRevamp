@page "/Update-Priority/{Id:guid}"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@using Newtonsoft.Json.Linq;
@using Newtonsoft.Json;

@inject PopupService PopupService
@inject IStringLocalizer<SharedResources> Loc
@inject PrioritySettingConsumer _prioritySettingConsumer
@inject ToastService ToastService
@inject NavigationManager navigationManager


<PriorityForm @ref="form"
              Priority="@Priority"
              OnValidSubmit="@Save"
              SubmitButtonText="Save"
              OnCancel="@Cancel" />


@code {
    [Parameter] public PriorityDto Priority { get; set; }
    [Parameter] public EventCallback<PriorityDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private PriorityDto _priority = new PriorityDto();
    private PriorityForm form;
    private PriorityDto? selectedPriority;
    private bool showConfirm;

    private async Task Save(EditContext editContext)
    {
        var alloldPriorty = await _prioritySettingConsumer.GetPriorities();
        var allOldActivePriorty = alloldPriorty.Data.Where(k => k.IsDeleted != true && k.Id != Priority.Id).ToList();
        var alloldDeletedPriority = alloldPriorty.Data.Where(k => k.IsDeleted == true).ToList();
        form.ClearValidationMessages();
        var isDuplicateAr = allOldActivePriorty.Any(m => m.NameArabic == Priority.NameArabic);
        var isDuplicateEn = allOldActivePriorty.Any(m => m.NameEnglish == Priority.NameEnglish);
        if (isDuplicateAr || isDuplicateEn)
        {
            if (isDuplicateAr && isDuplicateEn)
            {
                form.AddCustomError(nameof(Priority.NameArabic), Loc["PriorityDuplicateValidation"]);
                form.AddCustomError(nameof(Priority.NameEnglish), Loc["PriorityDuplicateValidation"]);
            }
            else if (isDuplicateAr)
                form.AddCustomError(nameof(Priority.NameArabic), Loc["PriorityDuplicateValidation"]);
            else if (isDuplicateEn)
                form.AddCustomError(nameof(Priority.NameEnglish), Loc["PriorityDuplicateValidation"]);
            return;
        }
        else if (alloldDeletedPriority.Any(m => m.NameEnglish == Priority.NameEnglish) || alloldDeletedPriority.Any(m => m.NameArabic == Priority.NameArabic))
        {
            var relatedwithcompleted = await _prioritySettingConsumer.CheckRelatedComplatedTaskitemPriority(Priority);
            if (relatedwithcompleted.Data)
            {
                PopupService.ShowConfirmation(@Loc["ThisPrioritynamewas"], @Loc["Confirm"], OnSavedConfirmed, type: ConfirmationType.Danger);
                selectedPriority = Priority;
                showConfirm = true;
            }
            else
            {
                var result = await _prioritySettingConsumer.UpdatePriority(Priority);
                await _prioritySettingConsumer.DeletePriority(Priority.Id);
                await ToastService.ShowToastAsync(Loc["Added successfully"], "success");
            }
        }
        else
        {
            var res = await _prioritySettingConsumer.UpdatePriority(Priority);
            if (res.Errors != null && res.Errors.Count > 0)
            {
                form.AddErrorsToEditContext(res.Errors);
            }
            else
            {
                if (res.Success)
                {
                    await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
                    PopupService.Hide();
                    if (OnValidSubmit.HasDelegate)
                        await OnValidSubmit.InvokeAsync(Priority);
                }
            }
        }

    }
    private async Task OnSavedConfirmed(bool confirmed)
    {
        if (confirmed && selectedPriority != null)
        {
            // retrve
            var result = await _prioritySettingConsumer.RetriveDeletePriority(selectedPriority);
            if (result.Data)
            {
                //  await _prioritySettingConsumer.DeletePriority(Priority.Id);

                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Retrived successfully"], "success");
            }
            else
            {

                return;
            }
        }
        selectedPriority = null;
        await OnValidSubmit.InvokeAsync();
    }

    private void Cancel()
    {
        PopupService.Hide();
    }
}
