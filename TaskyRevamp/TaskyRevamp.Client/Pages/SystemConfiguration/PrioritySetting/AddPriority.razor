@page "/Add-Priority"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject PopupService PopupService
@inject PrioritySettingConsumer _prioritySettingConsumer
@inject ToastService ToastService


<div class="container mt-4">
       <PriorityForm
           @ref="form"
           OnCancel="Cancel" 
           OnValidSubmit="@Save"
           Priority="_newPriority" 
           SubmitButtonText="Save" />
</div>

@code {

    private PriorityDto _newPriority = new PriorityDto();
    public List<PriorityDto> Priorities = new List<PriorityDto>();
    [Parameter] public EventCallback<PriorityDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private PriorityForm form;

    protected async override Task OnInitializedAsync()
    {
        var res = await _prioritySettingConsumer.GetPriorities();
        if (res.Success && res.Data != null)
        {
            Priorities = res.Data;
            if (Priorities.Any())
            {
                _newPriority.Order = Priorities.Count() + 1;
            }
            else
            {
                _newPriority.Order = 1;
            }
        }
    }

    private async Task Save(EditContext editContext)
    {
        var res = await _prioritySettingConsumer.AddPriority(_newPriority);
        if (res.Errors != null && res.Errors.Count > 0)
        {
            form.AddErrorsToEditContext(res.Errors);
        }
        else
        {
            if (res.Success)
            {
                await OnValidSubmit.InvokeAsync(_newPriority);
                await ToastService.ShowToastAsync(Loc["Added successfully"], "success");

                StateHasChanged();
                PopupService.Hide();
            }
        }
    }
    private void Cancel()
    {
        PopupService.Hide();
    }
}
