@using TaskyRevamp.Dto.SystemConfiguration
@inject IStringLocalizer<SharedResources> Loc

<EditForm EditContext="@editContext" OnSubmit="@OnSubmitHandler">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">
            @Loc["Name English"]
            <span class="text-danger" >*</span>
        </label>
        <InputText class="form-control" @bind-Value="Priority.NameEnglish" placeholder=@Loc["Enter Priority Name English"] />
        <ValidationMessage class="small text-danger" For="@(() => Priority.NameEnglish)"></ValidationMessage>
    </div>

    <div class="mb-3">
        <label class="form-label">
            @Loc["Name Arabic"]
            <span class="text-danger">*</span>
        </label>
        <InputText class="form-control" @bind-Value="Priority.NameArabic" placeholder=@Loc["Enter Priority Name Arabic"] />
        <ValidationMessage class="small text-danger" For="@(() => Priority.NameArabic)"></ValidationMessage>
    </div>

    <div class="mb-3">
        <label class="form-label">
            @Loc["Name Color Indicator"]
            <span class="text-danger">*</span>
        </label>
        <div class="input-group">
            <InputText class="form-control" @bind-Value="Priority.NameColor" />
            <span class="input-group-text">
                <input type="color" class="form-control form-control-color border-0 p-0"
                       style="width: 2rem;" @bind="Priority.NameColor" />
            </span>
        </div>
        <ValidationMessage class="small text-danger" For="@(() => Priority.NameColor)"></ValidationMessage>
    </div>

    <div class="mb-3">
        <label class="form-label">
            @Loc["Background Color Indicator"]
            <span class="text-danger">*</span>
        </label>
        <div class="input-group">
            <InputText class="form-control" @bind-Value="Priority.BackgroundColor" />
            <span class="input-group-text">
                <input type="color" class="form-control form-control-color border-0 p-0"
                       style="width: 2rem;" @bind="Priority.BackgroundColor" />
            </span>
        </div>
        <ValidationMessage class="small text-danger" For="@(() => Priority.BackgroundColor)"></ValidationMessage>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <button type="button" class="btn btn-light" @onclick="OnCancelClick">@Loc["Cancel"]</button>
        <button type="submit" class="btn btn-primary">@Loc[@SubmitButtonText]</button>
    </div>
</EditForm>


@code {

    [Parameter] public PriorityDto Priority { get; set; } = new PriorityDto();
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string SubmitButtonText { get; set; } = "Save";

    private EditContext editContext;
    private ValidationMessageStore messageStore;

    protected override void OnParametersSet()
    {
        if (editContext == null || editContext.Model != Priority)
        {
            editContext = new EditContext(Priority);
            messageStore = new ValidationMessageStore(editContext);
        }
    }



    private async Task OnSubmitHandler(EditContext context)
    {
        ClearValidationMessages();
        if (!editContext.Validate())
            return; // client-side validation failed → stop

        await OnValidSubmit.InvokeAsync(context);
    }

    private async Task OnCancelClick()
    {
        await OnCancel.InvokeAsync();
    }

    public void AddErrorsToEditContext(IReadOnlyDictionary<string, List<string>> errors)
    {
        messageStore.Clear();

        foreach (var error in errors)
        {
            var property = typeof(PriorityDto).GetProperty(error.Key);

            if (property != null)
            {
                var fieldIdentifier = new FieldIdentifier(Priority, property.Name);

                foreach (var errorMessage in error.Value)
                {
                    messageStore.Add(fieldIdentifier, errorMessage);
                }
            }
        }

        // Tell Blazor to re-render the validation messages
        editContext.NotifyValidationStateChanged();
    }

    public void ClearValidationMessages()
    {
        messageStore.Clear();
        editContext.NotifyValidationStateChanged();
    }
}
