@page "/PrioritySettings"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.SystemConfiguration
@inject PrioritySettingConsumer _prioritySettingConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService

<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["PriorityConfiguration"]</h1>
    </div>
    <div class="action-btn-list">
        <button class="btn btn-primary" type="button" @onclick="Add">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
            </span>
            @Loc["AddPriority"]
        </button>


    </div>
</div>
<div class="page-body">

    <div class="card setting-card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="text-content">
                        <h6 class="headline-6">@Loc["PriorityOptions"]</h6>
                        <p class="small-medium-text hint">@Loc["priorityHint"]</p>
                        <p class="small-medium-text hint">@Loc["priorityHint2"]</p>
                    </div>

                    <SortableList Id="defaultColsList" Items="Priorities.OrderBy(p => p.Order).ToList()"
                        KeySelector="@(item => item.Id)" OnUpdate="(i) => SortSettingsList(i)" Context="p">
                        <SortableItemTemplate>
                            <div class="card card-order-control">
                                <div class="card-body d-flex justify-content-between align-items-center">
                                    <span class="badge status-name"
                                        style="background-color:@p.BackgroundColor; color:@p.NameColor">
                                        <span >@p.Name</span> 
                                    </span>

                                    <div class="d-flex align-items-center gap-2">
                                        <span class="rounded-circle cl-preview"
                                            style="background-color:@p.BackgroundColor"></span>
                                        <span class="rounded-circle cl-preview"
                                            style="background-color:@p.NameColor"></span>
                                        <div class="actions">
                                            <button class="btn btn-action-24 btn-edit" @onclick=" () => Edit(p.Id)">
                                                <span class="icon">
                                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                                </span>
                                            </button>
                                            <button class="btn btn-action-24 btn-delete"
                                                @onclick=" () => ShowDeleteConfirm(p)">
                                                <span class="icon">
                                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                                                </span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <div class="btn-group-vertical">
                                    <button class="btn" @onclick=" () => MoveUp(p)">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowUp"></SVGCrud>
                                        </span>
                                    </button>

                                    <button class="btn " @onclick="() => MoveDown(p)">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowDown"></SVGCrud>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </SortableItemTemplate>
                    </SortableList>
                </div>
            </div>

        </div>

        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="action-buttons">

                        <button class="btn btn-lg  btn-primary" @onclick="Save">@Loc["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public List<PriorityDto> Priorities = new List<PriorityDto>();
    private Guid SelectedPriorityId { get; set; }
    private PriorityDto? selectedPriority;
    private bool showConfirm;
    private bool isOrdered = false;
    List<PriorityDto>? OriginalPriorities;
    private PriorityDto? draggedItem;

    protected async override Task OnInitializedAsync()
    {
        var res = await _prioritySettingConsumer.GetPriorities();
        if (res.Success && res.Data != null)
        {
            Priorities = res.Data.Where(k=>k.IsDeleted !=true).ToList();
            OriginalPriorities = CopyPriorites();
        }
    }
    private void Add()
    {
        PopupService.ShowNew(
        @<AddPriority OnValidSubmit="OnPriorityUpdated"></AddPriority> , headerText: @Loc["AddPriority"]
);
    }
    private void Edit(Guid id)
    {
        var priorityToEdit = Priorities.FirstOrDefault(p => p.Id == id);
        if (priorityToEdit != null)
        {
            // Create a copy to avoid direct binding issues
            var priorityCopy = new PriorityDto
                {
                    Id = priorityToEdit.Id,
                    NameEnglish = priorityToEdit.NameEnglish,
                    NameArabic = priorityToEdit.NameArabic,
                    NameColor = priorityToEdit.NameColor,
                    BackgroundColor = priorityToEdit.BackgroundColor,
                    Order = priorityToEdit.Order
                };
            PopupService.ShowNew(@<UpdatePriority Priority="@priorityCopy" OnValidSubmit="OnPriorityUpdated" />  , headerText: @Loc["EditPriority"]);
        }
    }
    private void OnPriorityUpdated(PriorityDto updatedPriority)
    {
        var existing = Priorities.FirstOrDefault(p => p.Id == updatedPriority.Id);
        if (existing != null)
        {
            existing.NameEnglish = updatedPriority.NameEnglish;
            existing.NameArabic = updatedPriority.NameArabic;
            existing.NameColor = updatedPriority.NameColor;
            existing.BackgroundColor = updatedPriority.BackgroundColor;
        }
        else
        {
            Priorities.Add(updatedPriority);
        }
        var isexistinoriginal = OriginalPriorities!.FirstOrDefault(p => p.Id == updatedPriority.Id);
        if (isexistinoriginal != null)
        {
            isexistinoriginal.NameEnglish = updatedPriority.NameEnglish;
            isexistinoriginal.NameArabic = updatedPriority.NameArabic;
            isexistinoriginal.NameColor = updatedPriority.NameColor;
            isexistinoriginal.BackgroundColor = updatedPriority.BackgroundColor;
        }
        else
        {
            OriginalPriorities!.Add(updatedPriority);
        }
        StateHasChanged();
    }
    private void ShowDeleteConfirm(PriorityDto p)
    {
        PopupService.ShowConfirmation(message: @Loc["Sure"], @Loc["Confirm"], OnDeleteConfirmed, type: ConfirmationType.Danger);
        selectedPriority = p;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedPriority != null)
        {
            var result = await _prioritySettingConsumer.DeletePriority(selectedPriority.Id);
            if (result.Data)
            {
                Priorities.Remove(selectedPriority);
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
            else
            {
                await ToastService.ShowToastAsync(Loc["Thisprioritycannotb"], "error");

                return;
            }
            
        }
        selectedPriority = null;
        StateHasChanged();
    }
    private void MoveUp(PriorityDto p)
    {
        if (p.Order > 1)
        {
            var abovePriority = Priorities.FirstOrDefault(pr => pr.Order == p.Order - 1);
            if (abovePriority != null)
            {
                abovePriority.Order++;
                p.Order--;
            }
        }
        isOrdered = true;
    }
    private void MoveDown(PriorityDto p)
    {
        if (p.Order < Priorities.Count())
        {
            var belowPriority = Priorities.FirstOrDefault(pr => pr.Order == p.Order + 1);
            if (belowPriority != null)
            {
                belowPriority.Order--;
                p.Order++;
            }
        }
        isOrdered = true;
    }
    private void SortSettingsList((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;

        var items = Priorities.OrderBy(q => q.Order).ToList();
        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);
        if (newIndex < items.Count)
            items.Insert(newIndex, itemToMove);
        else
            items.Add(itemToMove);
        // Reassign new order values
        for (int i = 0; i < items.Count; i++)
        {
            items[i].Order = i + 1;

        }
        isOrdered = true;
        StateHasChanged();
    }
    private async Task Save(MouseEventArgs args)
    {
        if (isOrdered)
        {
            var res = await _prioritySettingConsumer.UpdatePrioritiesOrder(Priorities);
            if (res.Success)
            {
                isOrdered = false;
                await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
                OriginalPriorities = CopyPriorites();
            }
        }
    }
    private void Cancel(MouseEventArgs args)
    {
        Priorities = OriginalPriorities!.Select(p => new PriorityDto
        {
            Id = p.Id,
            NameEnglish = p.NameEnglish,
            NameArabic = p.NameArabic,
            NameColor = p.NameColor,
            BackgroundColor = p.BackgroundColor,
            Order = p.Order
        }).ToList();
        isOrdered = false;
        StateHasChanged();
    }
    private List<PriorityDto> CopyPriorites()
    {
        return Priorities.Select(p => new PriorityDto
        {
            Id = p.Id,
            NameEnglish = p.NameEnglish,
            NameArabic = p.NameArabic,
            NameColor = p.NameColor,
            BackgroundColor = p.BackgroundColor,
            Order = p.Order
        }).ToList();
    }
}