@page "/PrioritySettings"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.SystemConfiguration
@inject PrioritySettingConsumer _prioritySettingConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService


<div class="card shadow-sm p-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">@Loc["PriorityConfiguration"]</h5>
        <button class="btn btn-primary" @onclick="Add">
            <i class="bi bi-plus"></i> @Loc["AddPriority"]
        </button>
    </div>

    <h6 class="mb-3">@Loc["PriorityOptions"]</h6>
    <p>@Loc["priorityHint"]</p>
    @foreach (var p in Priorities.OrderBy(p => p.Order))
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center">

                <span class="badge" style="background-color:@p.BackgroundColor; color:@p.NameColor">
                    @p.NameEnglish - @p.NameArabic
                </span>

                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle p-2" style="background-color:@p.BackgroundColor"></span>
                    <span class="rounded-circle p-2" style="background-color:@p.NameColor"></span>

                    <button class="btn btn-action-40 btn-outline-success" @onclick=" () => Edit(p.Id)">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                        </span>
                    </button>

                    <button class="btn btn-action-40 btn-outline-danger" @onclick=" () => ShowDeleteConfirm(p)">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.RecycleBin"></SVGCrud>
                        </span>
                    </button>

                    <div class="btn-group-vertical">
                        <button class="btn btn-action-40 btn-outline-secondary" @onclick=" () => MoveUp(p)">
                            <span class="icon">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                            </span>
                        </button>

                        <button class="btn btn-action-40 btn-outline-secondary" @onclick="() => MoveDown(p)">
                            <span class="icon">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                            </span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    
    @* <NewPopUpComponent @bind-Visible="IsShowCreateDialog" HeaderText=@Loc["AddPriority"]>
        <AddPriority 
            OnValidSubmit="ResetPage" 
            OnCancel="CloseAddPage"/>
    </NewPopUpComponent> *@

    @* <NewPopUpComponent @bind-Visible="IsShowEditDialog" HeaderText="@Loc["EditPriority"]">
        <UpdatePriority 
            Id="SelectedPriorityId" 
            OnValidSubmit="ResetPage" 
            OnCancel="CloseEditPage"/>
    </NewPopUpComponent> *@

    <ConfirmationPopup ButtonText="@Loc["Delete"]"
                       IsVisible="@showConfirm"
                       OnConfirm="OnDeleteConfirmed"
                       Message="@confirmMessage" />

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-light" @onclick="Cancel">@Loc["Cancel"]</button>
        <button class="btn btn-primary" @onclick="Save">@Loc["Save"]</button>
    </div>

</div>

@code {
    public List<PriorityDto> Priorities = new List<PriorityDto>();
    //private bool IsShowCreateDialog { get; set; } = false;
    //private bool IsShowEditDialog { get; set; } = false;
    private Guid SelectedPriorityId { get; set; }
    private string confirmMessage = "";
    private PriorityDto? selectedPriority;
    private bool showConfirm;
    private bool isOrdered = false;
    List<PriorityDto>? OriginalPriorities;

    protected async override Task OnInitializedAsync()
    {
        var res = await _prioritySettingConsumer.GetPriorities();
        if (res.Success  && res.Data != null)
        {
            Priorities = res.Data;
            OriginalPriorities = CopyPriorites();
        }
    }
    private void Add() => navigationManager.NavigateTo("/Add-Priority");
    private void Edit(Guid id)
    {
        //IsShowEditDialog = true;
        //SelectedPriorityId = id;
        navigationManager.NavigateTo($"/Update-Priority/{id}");
    }
    private void ShowDeleteConfirm(PriorityDto p)
    {
        confirmMessage = @Loc["Sure"];
        selectedPriority = p;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedPriority != null)
        {
            var result = await _prioritySettingConsumer.DeletePriority(selectedPriority.Id);
            if (result.Success)
            {
                Priorities.Remove(selectedPriority);
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
        } 
        selectedPriority = null;
        StateHasChanged();
    }
    private void MoveUp(PriorityDto p)
    {
        if (p.Order > 1)
        {
            var abovePriority = Priorities.FirstOrDefault(pr => pr.Order == p.Order - 1);
            if (abovePriority != null) 
            { 
                abovePriority.Order++;
                p.Order--;
            }
        }
        isOrdered = true;
    }
    private void MoveDown(PriorityDto p)
    {
        if (p.Order < Priorities.Count())
        {
            var belowPriority = Priorities.FirstOrDefault(pr => pr.Order == p.Order + 1);
            if (belowPriority != null)
            {
                belowPriority.Order--;
                p.Order++;
            }
        }
        isOrdered = true;
    }
    private async Task Save(MouseEventArgs args)
    {
        if (isOrdered)
        {
            var res = await _prioritySettingConsumer.UpdatePrioritiesOrder(Priorities);
            if (res.Success)
            {
                isOrdered = false;
                await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
                OriginalPriorities = CopyPriorites();
            }
        }
    }
    private void Cancel(MouseEventArgs args)
    {
        Priorities = OriginalPriorities!.Select(p => new PriorityDto
        {
            Id = p.Id,
            NameEnglish = p.NameEnglish,
            NameArabic = p.NameArabic,
            NameColor = p.NameColor,
            BackgroundColor = p.BackgroundColor,
            Order = p.Order
        }).ToList();
        isOrdered = false;
        StateHasChanged();
    }
    private List<PriorityDto> CopyPriorites()
    {
        return Priorities.Select(p => new PriorityDto
        {
            Id = p.Id,
            NameEnglish = p.NameEnglish,
            NameArabic = p.NameArabic,
            NameColor = p.NameColor,
            BackgroundColor = p.BackgroundColor,
            Order = p.Order
        }).ToList();
    }
