@page "/WeeklyReportSetting"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.SystemConfiguration
@using Stingray.Components.MultiSelectComponent
@inject WeeklyReportSettingConsumer _weeklyReportSettingConsumer
@inject WorkingDaysSettingConsumer _workingDaysSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService

<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["WeeklyReport"]</h1>
    </div>
</div>
<div class="page-body">
    <div class="card setting-card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="text-content">
                        <p class="small-medium-text hint">@Loc["weeklyReportHint"]</p>
                    </div>
                    <div class="mb-3">
                        <label for="daylabel" class="form-label">
                            @Loc["Day"]<span class="text-danger">*</span>
                        </label>
                        <SearchableSingleDropdownOffline TInput="WorkingDaysSettingsDto" TOutput="WeekDays"
                            TextSelector="(w => Loc[w.Day.ToString()])" OutputSelector="(w => w.Day)"
                            Datasource="workingDaysSettingsDtos!.Where(w => w.IsActive).ToList()"
                            SelectedOption="settingsDto.Day" SelectedOptionChanged="OnDayChanged"
                                                         PlaceHolder="@($"{Loc["Select"]}")" NoMatchPlaceHolder="@Loc["NoResultsFound"]" />
                        <div class="text-danger small mt-1">@DayError</div>
                    </div>
                    <div class="mb-4">
                        <label for="timelabel" class="form-label">
                            @Loc["Time"]<span class="text-danger">*</span>
                        </label>
                        <SearchableSingleDropdownOffline TInput="(TimeSpan Value, string Text)" TOutput="string"
                            TextSelector="t => t.Text" OutputSelector="t => t.Text" Datasource="TimeSlots"
                            SelectedOption="SelectedTimeText" SelectedOptionChanged="OnTimeTextChanged"
                                                         PlaceHolder="@($"{Loc["Select"]}")" NoMatchPlaceHolder="@Loc["NoResultsFound"]" />
                        <div class="text-danger small mt-1">@TimeError</div>
                    </div>
                    <div class="text-content mb-2">
                        <h6 class="headline-6">@Loc["ReportLanguage"]</h6>
                        <p class="small-medium-text hint">@Loc["languageHint"]</p>
                    </div>
                    <InputRadioGroup TValue="Language" Value="settingsDto.Language" ValueChanged="OnSettingChange"
                        ValueExpression="() => settingsDto.Language">
                        @foreach (var value in languages)
                        {
                            var radioId = $"Language_{value}";
                            <div class="form-check-card">
                                <InputRadio id="@radioId" Value="@value" />
                                <label for="@radioId"> @value.GetDescription()</label>
                            </div>
                        }
                    </InputRadioGroup>
                    <div class="text-danger small mt-1">@LanguageError</div>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="action-buttons">

                        <button class="btn btn-lg btn-primary" @onclick="Save">@Loc["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    public WeeklyReportSettingsDto settingsDto { get; set; } = new WeeklyReportSettingsDto { Language = Language.English };
    private List<WorkingDaysSettingsDto> workingDaysSettingsDtos = new List<WorkingDaysSettingsDto>();
    private List<(TimeSpan Value, string Text)>? TimeSlots { get; set; }
    public List<Language> languages = EnumExtensions.GetOrderedValues<Language>();
    private string DayError = "";
    private string TimeError = "";
    private string LanguageError = "";
    private string? SelectedTimeText;

    protected override async Task OnInitializedAsync()
    {

        var defaultRes = await _workingDaysSettingConsumer.GetWorkingDaysSetting();
        if (defaultRes.Success && defaultRes != null && defaultRes.Data != null)
        {
            workingDaysSettingsDtos = defaultRes.Data;
        }

        var res = await _weeklyReportSettingConsumer.GetWeeklyReportSetting();
        if (res.Success && res != null && res.Data != null)
        {
            settingsDto = res.Data;
            settingsDto.Time = new TimeSpan(settingsDto.Time.Hours, settingsDto.Time.Minutes, 0);
        }
        TimeSlots = GenerateTimeSlots();
        var match = TimeSlots.FirstOrDefault(t => t.Value == settingsDto.Time);
        SelectedTimeText = match != default ? match.Text : null;
    }
    private void OnTimeTextChanged(string newText)
    {
        SelectedTimeText = newText;
        TimeError = "";
        if (string.IsNullOrEmpty(SelectedTimeText))
        {
            TimeError = Loc["Required"];
        }
    }
    private void OnSettingChange(Language newValue)
    {
        settingsDto.Language = newValue;
        LanguageError = "";
    }
    private void OnDayChanged(WeekDays newDay)
    {
        settingsDto.Day = newDay;
        DayError = "";
        if (settingsDto.Day == 0)
        {
            DayError = Loc["Required"];
        }
     
    }

    private void Cancel(MouseEventArgs args)
    {
        throw new NotImplementedException();
    }

    private async Task Save()
    {
        bool isValid = true;
        if (settingsDto.Day == 0)
        {
            DayError = Loc["Required"];
            isValid = false;
        }

        if (string.IsNullOrEmpty(SelectedTimeText))
        {
            TimeError = Loc["Required"];
            isValid = false;
        }
        else
        {
            var selected = TimeSlots!.FirstOrDefault(t => t.Text == SelectedTimeText);
            settingsDto.Time = selected.Value;
        }
        if (!Enum.IsDefined(typeof(Language), settingsDto.Language))
        {
            LanguageError = Loc["Required"];
            isValid = false;
        }
        if (!isValid) return; // stop saving

        var res = await _weeklyReportSettingConsumer.UpdateWeeklyReportSetting(settingsDto);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }
    private List<(TimeSpan Value, string Text)> GenerateTimeSlots()
    {
        var times = new List<(TimeSpan Value, string Text)>();
        var start = new TimeSpan(0, 0, 0);
        var end = new TimeSpan(23, 45, 0);

        while (start <= end)
        {
            times.Add((start, DateTime.Today.Add(start).ToString("h:mm tt")));
            start = start.Add(new TimeSpan(0, 15, 0));
        }
        return times;
    }

}