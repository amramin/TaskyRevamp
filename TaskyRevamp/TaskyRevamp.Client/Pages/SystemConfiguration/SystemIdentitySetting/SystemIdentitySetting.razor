@page "/SystemIdentitySetting"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.SystemConfiguration
@inject SystemIdentityConsumer _systemIdentitySettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject NavigationManager NavigationManager
@inject TaskyService taskyService
<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["System Identity"]</h1>
    </div>
</div>
<div class="page-body">
    <div class="card setting-card">
        <EditForm Model="@_systemIdentity" OnValidSubmit="@SaveSystemIdentity">
            <DataAnnotationsValidator />


            <div class="card-body identity">
                <!-- Logo Section -->
                <div class="change-logo-Container mb-4 ">
                    <div class="logo">
                        @if (_systemIdentity.Logo != null)
                        {
                            <img src="@GetSystemLogo()" alt="Logo" />
                        }
                    </div>
                    <label for="logoUpload" class="upload-logo-btn">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ImagEdit"></SVGCrud>
                        </span>
                    </label>
                    <InputFile id="logoUpload" class="d-none" OnChange="HandleFileSelected"
                        accept=".png,.jpg,.jpeg,.svg" />
                </div>
                <!-- Form Fields -->
                <div class="row justify-content-center">
                    <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                        @* <div class="mb-3">
                            <label class="form-label fw-semibold">System Name</label>
                            <div class="input-group">
                                <input class="form-control" placeholder="Enter system name" @bind="_systemIdentity.NameEnglish" />
                                <span class="input-group-text bg-white"><i class="bi bi-pencil"></i></span>
                            </div>
                        </div> *@
                        <div class="row g-2">
                            <div class="col-lg-12">
                                <label class="form-label">System Name English</label>
                                <InputText class="form-control" placeholder="Enter system name English"
                                    @bind-Value="_systemIdentity.NameEnglish" />
                            </div>
                            <div class="col-lg-12">
                                <label class="form-label">System Name Arabic</label>
                                <InputText id="arabic-text" class="form-control" placeholder="Enter system name Arabic"
                                    @bind-Value="_systemIdentity.NameArabic" />
                            </div>
                            <div class="col-lg-12">
                                <label class="form-label">@Loc["Primary Color"]</label>
                                <div class="color-group">
                                    <InputText class="form-control" @bind-Value="_systemIdentity.PrimaryColor" />
                                    <span class="rounded-circle cl-preview"
                                        style="background-color:@_systemIdentity.PrimaryColor"></span>
                                    <span class="color-indicator">
                                        <input type="color" id="primary-color" @bind="_systemIdentity.PrimaryColor" />
                                        <label for="primary-color">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ColorPalette"></SVGCrud>
                                        </label>
                                    </span>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <label class="form-label">@Loc["Primary Active Color"]</label>
                                <div class="color-group">
                                    <InputText class="form-control" @bind-Value="_systemIdentity.PrimaryActiveColor" />
                                    <span class="rounded-circle cl-preview "
                                        style="background-color:@_systemIdentity.PrimaryActiveColor"></span>
                                    <span class="color-indicator">
                                        <input type="color" id="primary-active"
                                            @bind="_systemIdentity.PrimaryActiveColor" />
                                        <label for="primary-active">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ColorPalette"></SVGCrud>
                                        </label>
                                    </span>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <label class="form-label">@Loc["Main Title"]</label>
                                <div class="color-group">
                                    <InputText class="form-control" @bind-Value="_systemIdentity.MainTitle" />
                                    <span class="rounded-circle cl-preview"
                                        style="background-color:@_systemIdentity.MainTitle"></span>
                                    <span class="color-indicator">
                                        <input type="color" id="main-title" @bind="_systemIdentity.MainTitle" />
                                        <label for="main-title">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ColorPalette"></SVGCrud>
                                        </label>
                                    </span>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <label class="form-label">@Loc["Sub Title"]</label>
                                <div class="color-group">
                                    <InputText class="form-control" @bind-Value="_systemIdentity.SubTitle" />
                                    <span class="rounded-circle cl-preview"
                                        style=" background-color:@_systemIdentity.SubTitle"></span>
                                    <span class="color-indicator">
                                        <input type="color" id="sub-title" @bind="_systemIdentity.SubTitle" />
                                        <label for="sub-title">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ColorPalette"></SVGCrud>
                                        </label>
                                    </span>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <label class="form-label">@Loc["Navigation Background"]</label>
                                <div class="color-group">
                                    <InputText class="form-control"
                                        @bind-Value="_systemIdentity.NavigationBackground" />
                                    <span class="rounded-circle cl-preview"
                                        style="background-color:@_systemIdentity.NavigationBackground"></span>
                                    <span class="color-indicator">
                                        <input type="color" id="nav-bg" @bind="_systemIdentity.NavigationBackground" />
                                        <label for="nav-bg">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ColorPalette"></SVGCrud>
                                        </label>
                                    </span>
                                </div>
                            </div>

                            <div class="col-lg-12">
                                <label class="form-label">@Loc["Border Color"]</label>
                                <div class="color-group">
                                    <InputText class="form-control" @bind-Value="_systemIdentity.BorderColor" />
                                    <span class="rounded-circle cl-preview"
                                        style="background-color:@_systemIdentity.BorderColor"></span>
                                    <span class="color-indicator">
                                        <input type="color" id="border-color" @bind="_systemIdentity.BorderColor" />
                                        <label for="border-color">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ColorPalette"></SVGCrud>
                                        </label>
                                    </span>
                                </div>
                            </div>
                        </div>


                    </div>
                </div>
            </div>
            <div class="card-footer">
                <div class="row justify-content-center">
                    <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                        <div class="action-buttons">
                            <button type="button" class="btn btn-lg btn-light" @onclick="Cancel">
                                @Loc["Cancel"]
                            </button>
                            <button type="submit" class="btn btn-lg btn-primary">@Loc["Save"]</button>
                        </div>
                    </div>
                </div>
            </div>
        </EditForm>
    </div>
</div>
@code {
    SystemIdentityDto _systemIdentity = new SystemIdentityDto();

    protected override async Task OnInitializedAsync()
    {
        var res = await _systemIdentitySettingConsumer.GetSystemIdentitySetting();
        if (res.Success && res != null && res.Data != null)
        {
            _systemIdentity = res.Data;
        }
    }
    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            var allowed = new[] { "image/png", "image/jpeg", "image/jpg", "image/svg+xml" };
            if (!allowed.Contains(file.ContentType))
            {
                Console.WriteLine("Invalid file type.");
                return;
            }
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 5_000_000).CopyToAsync(ms);
            _systemIdentity.Logo = ms.ToArray();

            StateHasChanged();
        }
    }
    private async Task SaveSystemIdentity()
    {
        var res = await _systemIdentitySettingConsumer.UpdateSystemIdentitySetting(_systemIdentity);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
            await taskyService.ChangeTheme(_systemIdentity);
            taskyService.NotifySystemIdentityChanged(_systemIdentity);
        }
    }
    private void Cancel(MouseEventArgs args)
    {
        throw new NotImplementedException();
    }

    private string GetSystemLogo()
    {
        var mimeType = taskyService.GetMimeType(_systemIdentity.Logo);
        return $"data:{mimeType};base64,{_systemIdentity.LogoBase64}";
    }
}