@page "/RecycleBinConfiguration"

@using  TaskyRevamp.Client.Pages.Consumer;
@using TaskyRevamp.Dto.SystemConfiguration;
@using TaskyRevamp.Dto.Enums;
@inject  RecycleBinSettingConsumer _recycleBinSettingConsumer

<h6>Retention Period Options</h6>

<div class="container">
    <InputRadioGroup @bind-Value="RecycleBinSetting.PeriodType">
        @foreach (var value in PeriodTypes)
        {
            <div>
                <InputRadio Value="@value" /> @value.GetDescription()

                @if (RecycleBinSetting.PeriodType == PeriodType.Custom && value == PeriodType.Custom)
                {
                    <input type="text"
                           class="form-control mt-1"
                           placeholder="Enter custom period..."
                           @bind="RecycleBinSetting.CustomDays" />
                }
            </div>
            <br />
        }
    </InputRadioGroup>

    <div class="mt-3">
        <button class="btn btn-secondary" @onclick="CancelSettings">Cancel</button>
        <button class="btn btn-primary me-2" @onclick="SaveSettings">Save</button>
    </div>

</div>

@code {

    public List<PeriodType> PeriodTypes = Enum.GetValues(typeof(PeriodType)).Cast<PeriodType>().ToList();
    public RecycleBinSettingDto RecycleBinSetting { get; set; } = new RecycleBinSettingDto { PeriodType = PeriodType.Days30 };

    protected async override Task OnInitializedAsync()
    {

        var res = await _recycleBinSettingConsumer.GetRecycleBinSetting();
        if (res.Success)
        {
            var setting = res.Data;
            if(setting != null && setting.Id != Guid.Empty)
            {
                RecycleBinSetting = setting;
            }

        }
    }

    private void SaveSettings()
    {
        //Call update recycle bin setting request from consumer here
    }

    private void CancelSettings()
    {

    }
}
