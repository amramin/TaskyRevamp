@page "/RecycleBinConfiguration"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums;
@using TaskyRevamp.Dto.SystemConfiguration;
@inject RecycleBinSettingConsumer _recycleBinSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["RecycleBinConfiguration"]</h1>
    </div>
</div>
<div class="page-body">
    <div class="card setting-card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-xxl-6 col-xl-7 col-lg-8 col-md-10">
                    <div class="text-content">
                        <h6 class="headline-6">@Loc["RetentionPeriodOptions"]</h6>
                        <p class="small-medium-text hint">@Loc["recycleHint"]</p>
                    </div>
                    <InputRadioGroup TValue="PeriodType" Value="RecycleBinSetting.PeriodType"
                        ValueChanged="OnSettingChange" ValueExpression="() => RecycleBinSetting.PeriodType">
                        @foreach (var value in PeriodTypes)
                        {
                            var radioId = $"periodType_{value}";
                            <div class="form-check-card">

                                <InputRadio id="@radioId" Value="@value" />
                                <label for="@radioId">
                                    @value.GetDescription()

                                    @if (RecycleBinSetting.PeriodType == PeriodType.Custom && value == PeriodType.Custom)
                                    {
                                        <input placeholder="@Loc["EnterDaysNumber"]" type="number" min="1" class="form-control" @bind="RecycleBinSetting.CustomDays"
                                            @oninput="OnCustomDaysChange" />
                                    }
                                </label>
                            </div>

                        }
                    </InputRadioGroup>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-6 col-xl-7 col-lg-8 col-md-10">
                    <div class="action-buttons">
                        <button class="btn btn-lg btn-light" @onclick="CancelSettings">@Loc["Cancel"]</button>
                        <button class="btn btn-lg  btn-primary" @onclick="SaveSettings"
                                disabled="@(RecycleBinSetting.PeriodType == PeriodType.Custom && (RecycleBinSetting.CustomDays is null || RecycleBinSetting.CustomDays <= 0))">
                                @Loc["Save"]
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@code {

    public List<PeriodType> PeriodTypes = EnumExtensions.GetOrderedValues<PeriodType>();
    public RecycleBinSettingDto RecycleBinSetting { get; set; } = new RecycleBinSettingDto()
    {
        PeriodType = PeriodType.Days30
    };

    protected async override Task OnInitializedAsync()
    {

        var res = await _recycleBinSettingConsumer.GetRecycleBinSetting();

        if (res.Success && res.Data != null && res.Data.Id != Guid.Empty)
        {
            RecycleBinSetting = new RecycleBinSettingDto();
            RecycleBinSetting = res.Data;
        }

        StateHasChanged();
    }

    private async void SaveSettings()
    {
        var res = await _recycleBinSettingConsumer.UpdateRecycleBinSetting(RecycleBinSetting);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }

    private async Task CancelSettings()
    {
        //await OnInitializedAsync();
    }

    private void OnSettingChange(PeriodType newValue)
    {
        if (newValue != PeriodType.Custom)
            RecycleBinSetting.CustomDays = null;

        RecycleBinSetting.PeriodType = newValue;
    }

    private void OnCustomDaysChange(ChangeEventArgs e)
    {
        var input = e.Value?.ToString();

        if (string.IsNullOrEmpty(input) || !int.TryParse(input, out var number) || number <= 0)
        {
            RecycleBinSetting.CustomDays = null;
            return;
        }
        RecycleBinSetting.CustomDays = number;
    }
}