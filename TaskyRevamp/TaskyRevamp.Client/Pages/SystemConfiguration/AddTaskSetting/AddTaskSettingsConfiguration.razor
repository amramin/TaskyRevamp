@page "/AddTaskConfiguration"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums;
@using TaskyRevamp.Dto.SystemConfiguration;
@inject AddTaskSettingConsumer _addTaskSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService


<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["AddTaskFieldsConfiguration"]</h1>
    </div>
</div>
<div class="page-body">
    <div class="card setting-card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="text-content">
                        <p class="small-medium-text hint">@Loc["AddTaskHint"]</p>
                    </div>
                    <div class="card-order-header d-flex justify-content-between align-items-center">
                        <div class="title  small-medium-text"> @Loc["FieldNames"]</div>
                        <div class="toggle small-medium-text"> @Loc["active"]</div>
                        <div class="toggle small-medium-text"> @Loc["Mandatory"]</div>
                        <div class="order small-medium-text"></div>
                    </div>
                    <SortableList Id="defaultColsList" Items="AddTaskSettings.OrderBy(x => x.Order).ToList()"
                        KeySelector="@(item => item.Id)" OnUpdate="(i) => SortSettingsList(i)" Context="setting">
                        <SortableItemTemplate>
                            <div class="card card-order-control">
                                <div class="card-body d-flex justify-content-between align-items-center">

                                    <div class="flex-fill">
                                        <span >@setting.Name </span>
                                    </div>
                                    <div class="toggle">


                                        <div class="form-switch custom @(IsFixedField(setting) ? "opacity-50" : "")">

                                            <input checked="@setting.IsActive"
                                                   id="IsActive@(setting.Id)"
                                                   type="checkbox"
                                                   disabled="@IsFixedField(setting)"
                                                   @onchange="@(() =>
                                                   {
                                                       if (!IsFixedField(setting))
                                                           setting.IsActive = !setting.IsActive;
                                                   })" />
                                            <label for="IsActive@(setting.Id)">
                                                <span class="toggler-icon"></span>
                                            </label>
                                        </div>
                                    </div>
                                    <div class="toggle">
                                          <div class="form-switch custom @(IsFixedField(setting) ? "opacity-50" : "")">
                                              <input checked="@setting.IsMandatory"
                                                     id="IsMandatory@(setting.Id)"
                                                     type="checkbox"
                                                     disabled="@IsFixedField(setting)"
                                                     @onchange="@(() =>
                                                   {
                                                       if (!IsFixedField(setting))
                                                           setting.IsMandatory = !setting.IsMandatory;
                                                   })" />

                                                <label for="IsMandatory@(setting.Id)">
                                                <span class="toggler-icon"></span>
                                            </label>
                                        </div>
                                    </div>
                                </div>
                                <div class="btn-group-vertical">
                                    <button class="btn " @onclick=" () => MoveUp(setting)">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowUp"></SVGCrud>
                                        </span>
                                    </button>

                                    <button class="btn " @onclick="() => MoveDown(setting)">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowDown"></SVGCrud>
                                        </span>
                                    </button>
                                </div>
                            </div>
                        </SortableItemTemplate>
                    </SortableList>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="action-buttons">
           
                        <button class="btn btn-lg  btn-primary" @onclick="SaveSettings">@Loc["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
@code {

    public List<AddTaskSettingDto> AddTaskSettings { get; set; } = new List<AddTaskSettingDto>();
    private readonly HashSet<string> FixedFields = new(StringComparer.OrdinalIgnoreCase)
{
    "Title",
    "Priority",
    "Department",
    "Assigned to",
    "Start date",
    "End date",
    "Actual progress"
};

    private bool IsFixedField(AddTaskSettingDto setting)
    {
        return FixedFields.Contains(setting.Name);
    }
    protected async override Task OnInitializedAsync()
    {

        var res = await _addTaskSettingConsumer.GetAddTaskSettings();
        if (res.Success)
        {
            var settings = res.Data;
            if (settings != null)
            {
                AddTaskSettings = settings;


                foreach (var setting in AddTaskSettings)
                {
                    if (IsFixedField(setting))
                    {
                        setting.IsActive = true;
                        setting.IsMandatory = true;
                    }
                }
            }

        }
    }

    private void MoveUp(AddTaskSettingDto setting)
    {
        if (setting.Order >= 1)
        {
            var aboveSetting = AddTaskSettings.FirstOrDefault(x => x.Order == setting.Order - 1);
            if (aboveSetting != null)
            {
                aboveSetting.Order++;
                setting.Order--;

            }
        }
    }

    private void MoveDown(AddTaskSettingDto setting)
    {
        if (setting.Order <= AddTaskSettings.Count())
        {
            var belowSetting = AddTaskSettings.FirstOrDefault(x => x.Order == setting.Order + 1);
            if (belowSetting != null)
            {
                belowSetting.Order--;
                setting.Order++;
            }
        }
    }

    private async void SaveSettings()
    {
        var res = await _addTaskSettingConsumer.UpdateAddTaskSettings(AddTaskSettings);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }

    public async Task SortSettingsList((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;

        var items = AddTaskSettings.OrderBy(q => q.Order).ToList();

        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);

        if (newIndex < items.Count)
            items.Insert(newIndex, itemToMove);
        else
            items.Add(itemToMove);

        // Reassign new order values
        for (int i = 0; i < items.Count; i++)
        {
            items[i].Order = i + 1;

        }


        StateHasChanged();

    }
}