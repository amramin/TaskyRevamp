@page "/AddTaskConfiguration"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums;
@using TaskyRevamp.Dto.SystemConfiguration;
@inject AddTaskSettingConsumer _addTaskSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService


<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["AddTaskFieldsConfiguration"]</h1>
    </div>
</div>

<div class="card shadow-sm p-3">
    <div class="mb-2 fw-bold">
        <div class="d-flex align-items-center">

            <div class="col-md-6">
                Field Names
            </div>

            <div class="col-md-2">
                Active
            </div>

            <div class="col-md-2">
                Mandatory
            </div>
        </div>
    </div>

    <SortableList Id="defaultColsList"
                  Items="AddTaskSettings.OrderBy(x => x.Order).ToList()"
                  KeySelector="@(item => item.Id)"
                  OnUpdate="(i) => SortSettingsList(i)"
                  Context="setting">
        <SortableItemTemplate>
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div class="col-md-6">
                        @setting.NameEnglish - @setting.NameArabic
                    </div>

                    <div class="form-switch custom col-md-2">
                        <input checked="@setting.IsActive"
                               id="IsActive@(setting.Id)"
                               type="checkbox"
                               @onchange="@(() => setting.IsActive = !setting.IsActive)" />

                        <label for="IsActive@(setting.Id)">
                            <span class="toggler-icon"></span>
                        </label>
                    </div>

                    <div class="form-switch custom col-md-2">
                        <input checked="@setting.IsMandatory"
                               id="IsMandatory@(setting.Id)"
                               type="checkbox"
                               @onchange="@(() => setting.IsMandatory = !setting.IsMandatory)" />

                        <label for="IsMandatory@(setting.Id)">
                            <span class="toggler-icon"></span>
                        </label>
                    </div>


                    <div class="d-flex align-items-center gap-2">

                        <div class="btn-group-vertical">
                            <button class="btn btn-action-40 btn-outline-secondary" @onclick=" () => MoveUp(setting)">
                                <span class="icon">
                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ChevronUp"></SVGCrud>
                                </span>
                            </button>

                            <button class="btn btn-action-40 btn-outline-secondary" @onclick="() => MoveDown(setting)">
                                <span class="icon">
                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ChevronDown"></SVGCrud>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </SortableItemTemplate>
    </SortableList>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-light" @onclick="CancelSettings">@Loc["Cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveSettings">@Loc["Save"]</button>
    </div>

</div>

@code {

    public List<AddTaskSettingDto> AddTaskSettings { get; set; } = new List<AddTaskSettingDto>();

    protected async override Task OnInitializedAsync()
    {

        var res = await _addTaskSettingConsumer.GetAddTaskSettings();
        if (res.Success)
        {
            var settings = res.Data;
            if (settings != null)
            {
                AddTaskSettings = settings;
            }

        }
    }

    private void MoveUp(AddTaskSettingDto setting)
    {
        if (setting.Order >= 1)
        {
            var aboveSetting = AddTaskSettings.FirstOrDefault(x => x.Order == setting.Order - 1);
            if (aboveSetting != null)
            {
                aboveSetting.Order++;
                setting.Order--;

            }
        }
    }

    private void MoveDown(AddTaskSettingDto setting)
    {
        if (setting.Order <= AddTaskSettings.Count())
        {
            var belowSetting = AddTaskSettings.FirstOrDefault(x => x.Order == setting.Order + 1);
            if (belowSetting != null)
            {
                belowSetting.Order--;
                setting.Order++;
            }
        }
    }

    private async void SaveSettings()
    {
        var res = await _addTaskSettingConsumer.UpdateAddTaskSettings(AddTaskSettings);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }

    private void CancelSettings()
    {

    }

    public async Task SortSettingsList((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;

        var items = AddTaskSettings.OrderBy(q => q.Order).ToList();

        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);

        if (newIndex < items.Count)
            items.Insert(newIndex, itemToMove);
        else
            items.Add(itemToMove);

        // Reassign new order values
        for (int i = 0; i < items.Count; i++)
        {
            items[i].Order = i + 1;

        }


        StateHasChanged();

    }
}
