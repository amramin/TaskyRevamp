@page "/DefaultView"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.SystemConfiguration
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject DefaultViewSettingConsumer _defaultViewSettingConsumer
@inject ViewTaskSettingConsumer _viewTaskSettingConsumer
<style>
    .no-after::after {
        content: none !important;
        display: none !important;
    }
</style>
<div class="card setting-card">
    <div class="card-body">
        <div class="row justify-content-center">
            <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                <div class="text-content">
                    <h6 class="headline-6">@Loc["Default view"]</h6>
                    <p class="small-medium-text hint">@Loc["DefaultViewHint"]</p>
                </div>
                <InputRadioGroup TValue="ViewType" Value="ViewTaskSetting.ViewType" ValueChanged="OnSettingChange"
                    ValueExpression="() => ViewTaskSetting.ViewType">
                    @{
                        bool isListView = false;
                    }
                    @foreach (var value in ViewTypes)
                    {
                        var radioId = $"ViewType_{value}";
@*                          <div class="d-flex align-items-center gap-2 mb-2 ">

                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CiArrow"></SVGCrud>
                        <div class="form-check-card">
                            <InputRadio id="@radioId" Value="@value" />
                            <label for="@radioId">   @(value == ViewType.Kanban ? @Loc["KanbanView"] : value.GetDescription()) </label>
                        </div>
                        </div> *@
                        if ((int)value >= 11 && (int)value <= 15)
                        {
                            if (!isListView)
                            {
                                <div class="fw-bold text-dark mb-2">@Loc["List"]</div>
                                isListView = true;
                            }
                            <div class="d-flex align-items-center gap-2 mb-2 ">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CiArrow"></SVGCrud>
                                <div class="form-check-card switch flex-grow-1">
                                    <InputRadio id="@radioId" Value="@value" style="display:none;" />
                                    <label for="@radioId" class="no-after">
                                        @Loc[value.ToString()]
                                        <span class="toggler-icon"></span>
                                    </label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="form-check-card switch flex-grow-1">
                                <InputRadio id="@radioId" Value="@value" style="display:none;" />
                                <label for="@radioId" class="no-after">
                                    @Loc[value.ToString()]
                                    <span class="toggler-icon"></span>
                                </label>
                            </div>
                        }
                    }
                </InputRadioGroup>
            </div>
        </div>
    </div>




    <div class="card-footer">
        <div class="row justify-content-center">
            <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                <div class="action-buttons">
                 
                    <button class="btn btn-lg  btn-primary" @onclick="Save">@Loc["Save"]</button>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    public List<ViewType> ViewTypes = EnumExtensions.GetOrderedValues<ViewType>();
    public ViewTaskSettingsDto ViewTaskSetting { get; set; } = new ViewTaskSettingsDto
    {
        ViewType = ViewType.List_Timeline
    };
    public DefaultViewSettingsDto defaultViewSettingsDto = new DefaultViewSettingsDto();

    protected override async Task OnInitializedAsync()
    {
        var res = await _defaultViewSettingConsumer.GetDefaultViewSetting();
        if (res?.Success == true && res.Data != null)
        {
            defaultViewSettingsDto = res.Data;
            if (Enum.IsDefined(typeof(ViewType), defaultViewSettingsDto.DefaultSelected))
            {
                ViewTaskSetting.ViewType = (ViewType)defaultViewSettingsDto.DefaultSelected;
            }
        }
        else
        {
            defaultViewSettingsDto = new DefaultViewSettingsDto
            {
                DefaultSelected = (int)ViewType.List_Timeline
            };
            ViewTaskSetting.ViewType = ViewType.List_Timeline;
        }
    }
    private void OnSettingChange(ViewType viewType)
    {
        ViewTaskSetting.ViewType = viewType;
        defaultViewSettingsDto.DefaultSelected = (int)ViewTaskSetting.ViewType;
    }
    private void Cancel(MouseEventArgs args)
    {

    }
    private async Task Save(MouseEventArgs args)
    {

        var viewRes = await _viewTaskSettingConsumer.GetActiveViewTaskSetting();
        if (viewRes.Success && viewRes != null && viewRes.Data != null)
        {
            var viewQuery = viewRes.Data.FirstOrDefault(v => v.ViewType == ViewTaskSetting.ViewType);
            if (viewQuery != null)
            {
                var res = await _defaultViewSettingConsumer.UpdateDefaultViewSetting(defaultViewSettingsDto);
                if (res.Success)
                {
                    await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
                    StateHasChanged();
                }
            }
            else
            {
                await ToastService.ShowToastAsync(Loc["Default View Error"], "error");
            }
        }
    }
}