@page "/sub_task"

@using System.Globalization
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject DefaultViewSettingConsumer _defaultViewSettingConsumer
<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["Subtask_Levels"]</h1>
    </div>
</div>
<div class="page-body">
    <div class="card setting-card">
        <div class="card-body mt-3">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="text-content">
                        <h6 class="headline-6">@Loc["Subtask_Level"]</h6>
                        <p class="small-medium-text hint">@Loc["subtask_hint"]</p>
                    </div>
                    <div class="mb-3">
                        <label for="maxSubtaskLevel" class="form-label">
                            @Loc["Maximum_Subtask_Level"]
                            <span class="text-danger">*</span>
                        </label>
                        <input type="text" maxlength="10" class="form-control"
                               value="@SubTaskInput"
                               @oninput="OnCustomDaysChange" />
                        <span class="small text-danger">@Error</span>
                    </div>
                    @if (ViewSetting.SubTaskLevels > 3)
                    {
                        <div class="alert alert-sm alert-warning mb-3">
                            @Loc["sub_task_warning"]
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="action-buttons">
                        @*  <button class="btn btn-lg btn-light" @onclick="Cancel">@Loc["Cancel"]</button> *@
                        <button class="btn btn-lg  btn-primary" @onclick="Save" disabled="@(IsInvalid || ViewSetting.SubTaskLevels is null)">@Loc["Save"]</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
@code {
    private DefaultViewSettingsDto ViewSetting { get; set; } = new DefaultViewSettingsDto();
    string Error = "";
    long? OldLevel;
    private string SubTaskInput = "";
    private bool IsInvalid = false;

    protected override async Task OnInitializedAsync()
    {
        var res = await _defaultViewSettingConsumer.GetDefaultViewSetting();
        if (res.Success)
        {
            var resData = res.Data;
            if (resData != null)
            {
                ViewSetting = resData;
                OldLevel = ViewSetting.SubTaskLevels;
            }
        }
        SubTaskInput = ViewSetting.SubTaskLevels?.ToString() ?? "";
    }
    private async Task Save(MouseEventArgs args)
    {
        if (ViewSetting.SubTaskLevels < 0 || ViewSetting.SubTaskLevels == null)
        {
            return;
        }
        else
        {
            var res = await _defaultViewSettingConsumer.UpdateSubTaskLevelDefaultViewSetting(ViewSetting);
            if (res.Success)
            {
                await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
            }
        }
    }
    private void OnCustomDaysChange(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        SubTaskInput = input;
        if (string.IsNullOrWhiteSpace(input) || input == "-")
        {
            Error = "";
            IsInvalid = true;
            ViewSetting.SubTaskLevels = null;
            return;
        }
        if (int.TryParse(input, out var number))
        {
            if (number < 0)
            {
                Error = "";
                IsInvalid = true;
                ViewSetting.SubTaskLevels = null;
            }
            else
            {
                ViewSetting.SubTaskLevels = number;
                Error = "";
                IsInvalid = false;
            }
        }
        else
        {
            Error = "";
            IsInvalid = true;
            ViewSetting.SubTaskLevels = null;
        }
    }
    private void Cancel(MouseEventArgs args)
    {
        ViewSetting.SubTaskLevels = OldLevel;
        Error = "";
    }
}
