@page "/ViewTaskSetting"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.SystemConfiguration
@inject ViewTaskSettingConsumer _viewTaskSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService

<div class="card setting-card">

    <div class="card-body">
        <div class="row justify-content-center">
            <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                <div class="text-content">
                    <h6 class="headline-6">@Loc["ViewOptions"]</h6>
                    <p class="small-medium-text hint">@Loc["ViewTaskSettingHint"]</p>
                </div>
                @if (TaskViews != null)
                {
                    bool isListView = false;
                    int index = 0;
                    @foreach (var view in TaskViews)
                    {
                        var inputId = $"view_{view.ViewType}_{index}";
                        index++;

                        if ((int)view.ViewType >= 11 && (int)view.ViewType <= 14)
                        {
                            if (!isListView)
                            {
                                <div class="fw-bold text-dark mb-2">@Loc["List"]</div>
                                isListView = true;
                            }
                            <div class="d-flex align-items-center gap-2 mb-2 ">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CiArrow"></SVGCrud>
                                <div class="form-check-card switch flex-grow-1">
                                    <InputCheckbox id="@inputId" @bind-Value="view.IsActive" class="form-check-input" />
                                    <label for="@inputId">@Loc[view.ViewType.ToString()]
                                        <span class="toggler-icon"></span>
                                    </label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="form-check-card switch flex-grow-1">
                                <InputCheckbox id="@inputId" @bind-Value="view.IsActive" class="form-check-input" />
                                <label for="@inputId">@Loc[view.ViewType.ToString()]
                                    <span class="toggler-icon"></span>
                                </label>
                            </div>
                        }
                    }
                }

            </div>
        </div>
    </div>
    <div class="card-footer">
        <div class="row justify-content-center">
            <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                <div class="action-buttons">
             
                    <button class="btn btn-lg  btn-primary" @onclick="Save">@Loc["Save"]</button>
                </div>
            </div>
        </div>
    </div>

</div>
@code {
    private List<ViewTaskSettingsDto> TaskViews = new List<ViewTaskSettingsDto>();
    private List<ViewTaskSettingsDto> originalViews = new();
    private bool isChanged = false;

    protected override async Task OnInitializedAsync()
    {
        var res = await _viewTaskSettingConsumer.GetViewTaskSetting();
        if (res.Success && res.Data != null)
        {
            var orderedEnums = EnumExtensions.GetOrderedValues<ViewType>();
            TaskViews = orderedEnums
            .Select(enumVal => res.Data.FirstOrDefault(d => d.ViewType == enumVal))
            .Where(d => d != null)
            .ToList()!;
            originalViews = TaskViews.Select(t => new ViewTaskSettingsDto
            {
                ViewType = t.ViewType,
                IsActive = t.IsActive
            }).ToList();
        }
    }
    private void Cancel(MouseEventArgs args)
    {
        TaskViews = originalViews.Select(t => new ViewTaskSettingsDto
        {
            ViewType = t.ViewType,
            IsActive = t.IsActive
        }).ToList();
    }
    private async void Save(MouseEventArgs args)
    {
        var res = await _viewTaskSettingConsumer.UpdateTaskViewSetting(TaskViews);
        if (res.Success)
        {
            originalViews = TaskViews.Select(t => new ViewTaskSettingsDto
            {
                ViewType = t.ViewType,
                IsActive = t.IsActive
            }).ToList();

            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }


}