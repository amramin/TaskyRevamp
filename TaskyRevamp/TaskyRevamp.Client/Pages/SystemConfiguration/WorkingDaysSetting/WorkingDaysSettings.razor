@page "/WorkingDaysSetting"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums
@using TaskyRevamp.Dto.SystemConfiguration
@inject WorkingDaysSettingConsumer _workingDaysSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService

<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["WorkingDaysConfiguration"]</h1>
    </div>
</div>
<div class="page-body">
    <div class="card setting-card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="text-content">
                        <p class="small-medium-text hint">@Loc["workingDaysHint"]</p>
                    </div>
                    @if (workingDaysSettingsDtos != null)
        {
            foreach (var daySetting in workingDaysSettingsDtos)
            {
                 var inputId = $"day-{daySetting.Day}";
                            <div class="form-check-card switch">
                        <InputCheckbox id="@inputId" @bind-Value="daySetting.IsActive" 
                        class="form-check-input" />
                        <label for="@inputId">@Loc[daySetting.Day.ToString()]
                        <span class="toggler-icon"></span>
                        </label>
                    </div>
                
            }
        }
                </div>
            </div>
        </div>
<div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="action-buttons">
                        <button class="btn btn-lg btn-light"  @onclick="Cancel">@Loc["Cancel"]</button>
                        <button class="btn btn-lg  btn-primary"  @onclick="Save">@Loc["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
        
    </div>
</div>

@code {
    public List<WeekDays> weekDays = EnumExtensions.GetOrderedValues<WeekDays>();
    List<WorkingDaysSettingsDto> workingDaysSettingsDtos = new List<WorkingDaysSettingsDto>();
    List<WorkingDaysSettingsDto> orginalWorkingdays = new List<WorkingDaysSettingsDto>();

    protected override async Task OnInitializedAsync()
    {
        var res = await _workingDaysSettingConsumer.GetWorkingDaysSetting();
        if (res.Success && res != null && res.Data != null)
        {
            workingDaysSettingsDtos = res.Data.ToList();
            orginalWorkingdays = workingDaysSettingsDtos.Select(d => new WorkingDaysSettingsDto
            {
                Day = d.Day,
                IsActive = d.IsActive
            }).ToList();
        }
    }
    private void Cancel(MouseEventArgs args)
    {
        workingDaysSettingsDtos = orginalWorkingdays.Select(d => new WorkingDaysSettingsDto
        {
            Day = d.Day,
            IsActive = d.IsActive
        }).ToList();
    }
    private async Task Save(MouseEventArgs args)
    {
        if (!workingDaysSettingsDtos.Any(w => w.IsActive))
        {
            return;
        }
        var res = await _workingDaysSettingConsumer.UpdateTaskViewSetting(workingDaysSettingsDtos);
        if (res.Success)
        {
            orginalWorkingdays = workingDaysSettingsDtos.Select(d => new WorkingDaysSettingsDto
            {
                Day = d.Day,
                IsActive = d.IsActive
            }).ToList();
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }
}