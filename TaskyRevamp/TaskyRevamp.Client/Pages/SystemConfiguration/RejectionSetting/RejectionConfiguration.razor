@page "/RejectionConfiguration"

@using Microsoft.Extensions.Localization
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums;
@using TaskyRevamp.Dto.SystemConfiguration;
@using TaskyRevamp.Localization.Resources
@inject RejectionSettingConsumer _rejectionSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService

<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["RejectionConfiguration"]</h1>
    </div>
</div>
<div class="page-body">
    <div class="card setting-card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-xxl-6 col-xl-7 col-lg-8 col-md-10">
                  <div class="text-content">
                        <h6 class="headline-6">@Loc["RejectionPeriodOptions"]</h6>
                        <p class="small-medium-text">@Loc["rejectionHint"]</p>
                    </div>
                    <InputRadioGroup TValue="RejectionPeriodType" Value="RejectionSetting.PeriodType"
                                     ValueChanged="OnSettingChange" ValueExpression="() => RejectionSetting.PeriodType">
                        @foreach (var value in PeriodTypes)
                        {
                            var radioId = $"RejectionPeriodType_{value}";
                            <div class="form-check-card">
                                <InputRadio id="@radioId" Value="@value" /> 
                                <label for="@radioId">
                                    @value.GetDescription()
                                    @if (RejectionSetting.PeriodType == RejectionPeriodType.Custom && value ==
                                                                    RejectionPeriodType.Custom)
                                    {
                                        <input placeholder="@Loc["EnterDaysNumber"]" type="number" min="0" class="form-control" @bind="RejectionSetting.CustomDays"
                                               @oninput="OnCustomDaysChange" />
                                    }
                                </label>
                            </div>

                        }
                    </InputRadioGroup>
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-6 col-xl-7 col-lg-8 col-md-10">
                    <div class="action-buttons">
                        <button class="btn btn-lg btn-light" @onclick="CancelSettings">@Loc["Cancel"]</button>
                        <button class="btn btn-lg  btn-primary" @onclick="SaveSettings">@Loc["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    public List<RejectionPeriodType> PeriodTypes = EnumExtensions.GetOrderedValues<RejectionPeriodType>();
    public RejectionSettingsDto RejectionSetting { get; set; } = new RejectionSettingsDto
    {
        PeriodType = RejectionPeriodType.Days3
    };

    protected async override Task OnInitializedAsync()
    {
        var res = await _rejectionSettingConsumer.GetRejectionSetting();
        if (res.Success)
        {
            var setting = res.Data;
            if (setting != null && setting.Id != Guid.Empty)
            {
                RejectionSetting = setting;
            }

        }
    }

    private async void SaveSettings()
    {
        var res = await _rejectionSettingConsumer.UpdateRejectionSetting(RejectionSetting);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }

    private void CancelSettings()
    {

    }

    private void OnSettingChange(RejectionPeriodType newValue)
    {
        if (newValue != RejectionPeriodType.Custom)
            RejectionSetting.CustomDays = null;

        RejectionSetting.PeriodType = newValue;
    }

    private void OnCustomDaysChange(ChangeEventArgs e)
    {
        var input = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(input))
        {
            RejectionSetting.CustomDays = null;
            return;
        }

        if (int.TryParse(input, out var number))
        {
            RejectionSetting.CustomDays = number < 0 ? 0 : number;
        }
        else
        {
            RejectionSetting.CustomDays = 0;
        }
    }
}