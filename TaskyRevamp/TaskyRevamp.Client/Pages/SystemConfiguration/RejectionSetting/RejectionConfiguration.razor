@page "/RejectionConfiguration"

@using Microsoft.Extensions.Localization
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums;
@using TaskyRevamp.Dto.SystemConfiguration;
@using TaskyRevamp.Localization.Resources
@inject RejectionSettingConsumer _rejectionSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["RejectionPeriodOptions"]</h1>
    </div>
</div>


<div class="page-body">
    <InputRadioGroup TValue="RejectionPeriodType" Value="RejectionSetting.PeriodType" ValueChanged="OnSettingChange"
        ValueExpression="() => RejectionSetting.PeriodType">
        @foreach (var value in PeriodTypes)
        {
            <div>
                <InputRadio Value="@value" /> @value.GetDescription()

                @if (RejectionSetting.PeriodType == RejectionPeriodType.Custom && value == RejectionPeriodType.Custom)
                {
                    <input type="number" min="0" class="form-control mt-1" @bind="RejectionSetting.CustomDays"
                        @oninput="OnCustomDaysChange" />
                }
            </div>
            <br />
        }
    </InputRadioGroup>

    <div class="mt-3">
        <button class="btn btn-secondary" @onclick="CancelSettings">@Loc["Cancel"]</button>
        <button class="btn btn-primary me-2" @onclick="SaveSettings">@Loc["Save"]</button>
    </div>

</div>

@code {

    public List<RejectionPeriodType> PeriodTypes = EnumExtensions.GetOrderedValues<RejectionPeriodType>();
    public RejectionSettingsDto RejectionSetting { get; set; } = new RejectionSettingsDto
    {
        PeriodType =
    RejectionPeriodType.Days3
    };

    protected async override Task OnInitializedAsync()
    {

        var res = await _rejectionSettingConsumer.GetRejectionSetting();
        if (res.Success)
        {
            var setting = res.Data;
            if (setting != null && setting.Id != Guid.Empty)
            {
                RejectionSetting = setting;
            }

        }
    }

    private async void SaveSettings()
    {
        var res = await _rejectionSettingConsumer.UpdateRejectionSetting(RejectionSetting);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }

    private void CancelSettings()
    {

    }

    private void OnSettingChange(RejectionPeriodType newValue)
    {
        if (newValue != RejectionPeriodType.Custom)
            RejectionSetting.CustomDays = null;

        RejectionSetting.PeriodType = newValue;
    }

    private void OnCustomDaysChange(ChangeEventArgs e)
    {
        var input = e.Value?.ToString();

        if (string.IsNullOrWhiteSpace(input))
        {
            RejectionSetting.CustomDays = null;
            return;
        }

        if (int.TryParse(input, out var number))
        {
            RejectionSetting.CustomDays = number < 0 ? 0 : number;
        }
        else
        {
            RejectionSetting.CustomDays = 0;
        }
    }
}
