@page "/DefaultColumnsConfiguration"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums;
@using TaskyRevamp.Dto.SystemConfiguration;
@inject DefaultColumnsSettingConsumer _defaultColumnsSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService

<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["DefaultColumnsConfiguration"]</h1>
    </div>
</div>
<div class="page-body">
    <div class="card setting-card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="text-content">
                        <p class="small-medium-text hint">@Loc["DefaultColumnsHint"]</p>
                    </div>

                    <div class="card-order-header d-flex justify-content-between align-items-center">
                        <div class="title  small-medium-text"> @Loc["FieldNames"]</div>
                        <div class="toggle small-medium-text"> @Loc["active"]</div>
                        <div class="order small-medium-text"></div>
                    </div>


                    <SortableList Id="defaultColsList" Items="DefaultColumnsSettings.OrderBy(x => x.Order).ToList()"
                        KeySelector="@(item => item.Id)" OnUpdate="(i) => SortSettingsList(i)" Context="setting">
                        <SortableItemTemplate>

                            <div class="card card-order-control">
                                <div class="card-body d-flex justify-content-between align-items-center">

                                    <div class="flex-fill">
                                        @setting.NameEnglish -
                                        <span class="ar-text">@setting.NameArabic</span>
                                    </div>
                                    <div class="toggle">
                                        <div class="form-switch custom ">
                                            <input type="checkbox" id="IsActive@(setting.Id)" class="form-check-input"
                                                @bind="setting.IsActive" />

                                            <label for="IsActive@(setting.Id)">
                                                <span class="toggler-icon"></span>
                                            </label>
                                        </div>
                                    </div>


                                </div>
                                <div class="btn-group-vertical">
                                    <button class="btn" @onclick=" () => MoveUp(setting)">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowUp"></SVGCrud>
                                        </span>
                                    </button>

                                    <button class="btn" @onclick="() => MoveDown(setting)">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowDown"></SVGCrud>
                                        </span>
                                    </button>
                                </div>
                            </div>

                        </SortableItemTemplate>
                    </SortableList>


                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="action-buttons">
                        <button class="btn btn-lg btn-light" @onclick="CancelSettings">@Loc["Cancel"]</button>
                        <button class="btn btn-lg  btn-primary" @onclick="SaveSettings">@Loc["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
@code {

    public List<DefaultColumnsSettingDto> DefaultColumnsSettings { get; set; } = new List<DefaultColumnsSettingDto>();

    protected async override Task OnInitializedAsync()
    {

        var res = await _defaultColumnsSettingConsumer.GetDefaultColumnsSettings();
        if (res.Success)
        {
            var settings = res.Data;
            if (settings != null)
            {
                DefaultColumnsSettings = settings;
            }

        }
    }

    private void MoveUp(DefaultColumnsSettingDto setting)
    {
        if (setting.Order >= 1)
        {
            var aboveSetting = DefaultColumnsSettings.FirstOrDefault(x => x.Order == setting.Order - 1);
            if (aboveSetting != null)
            {
                aboveSetting.Order++;
                setting.Order--;

            }
        }
    }

    private void MoveDown(DefaultColumnsSettingDto setting)
    {
        if (setting.Order <= DefaultColumnsSettings.Count())
        {
            var belowSetting = DefaultColumnsSettings.FirstOrDefault(x => x.Order == setting.Order + 1);
            if (belowSetting != null)
            {
                belowSetting.Order--;
                setting.Order++;
            }
        }
    }

    private async Task SaveSettings()
    {
        var res = await _defaultColumnsSettingConsumer.UpdateDefaultColumnsSettings(DefaultColumnsSettings);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }

    private void CancelSettings()
    {

    }

    public async Task SortSettingsList((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;

        var items = DefaultColumnsSettings.OrderBy(q => q.Order).ToList();

        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);

        if (newIndex < items.Count)
            items.Insert(newIndex, itemToMove);
        else
            items.Add(itemToMove);

        // Reassign new order values
        for (int i = 0; i < items.Count; i++)
        {
            items[i].Order = i + 1;

        }


        StateHasChanged();

    }

}