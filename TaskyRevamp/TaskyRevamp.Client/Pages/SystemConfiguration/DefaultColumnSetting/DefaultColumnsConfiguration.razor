@page "/DefaultColumnsConfiguration"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.Enums;
@using TaskyRevamp.Dto.SystemConfiguration;
@inject DefaultColumnsSettingConsumer _defaultColumnsSettingConsumer
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService

<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["DefaultColumnsConfiguration"]</h1>
    </div>
</div>

<div class="card shadow-sm p-3">
    <div class="mb-2 fw-bold">
        <div class="d-flex align-items-center">

            <div class="col-md-8">
                Field Names
            </div>

            <div class="col-md-2">
                Active
            </div>
        </div>
    </div>

    <SortableList Id="defaultColsList"
                  Items="DefaultColumnsSettings.OrderBy(x => x.Order).ToList()"
                  KeySelector="@(item => item.Id)"
                  OnUpdate="(i) => SortSettingsList(i)"
                  Context="setting">
        <SortableItemTemplate>
            <div class="card mb-2">
                <div class="card-body d-flex justify-content-between align-items-center">

                    <div class="col-md-8">
                        @setting.NameEnglish - @setting.NameArabic
                    </div>

                    <div class="form-switch custom col-md-2">
                        <input type="checkbox"
                               id="IsActive@(setting.Id)"
                               class="form-check-input"
                               @bind="setting.IsActive" />

                        <label for="IsActive@(setting.Id)">
                            <span class="toggler-icon"></span>
                        </label>
                    </div>


                    <div class="d-flex align-items-center gap-2">

                        <div class="btn-group-vertical">
                            <button class="btn btn-action-40 btn-outline-secondary" @onclick=" () => MoveUp(setting)">
                                <span class="icon">
                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ChevronUp"></SVGCrud>
                                </span>
                            </button>

                            <button class="btn btn-action-40 btn-outline-secondary" @onclick="() => MoveDown(setting)">
                                <span class="icon">
                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ChevronDown"></SVGCrud>
                                </span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </SortableItemTemplate>
    </SortableList>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-light" @onclick="CancelSettings">@Loc["Cancel"]</button>
        <button class="btn btn-primary" @onclick="SaveSettings">@Loc["Save"]</button>
    </div>

</div>

@code {

    public List<DefaultColumnsSettingDto> DefaultColumnsSettings { get; set; } = new List<DefaultColumnsSettingDto>();

    protected async override Task OnInitializedAsync()
    {

        var res = await _defaultColumnsSettingConsumer.GetDefaultColumnsSettings();
        if (res.Success)
        {
            var settings = res.Data;
            if (settings != null)
            {
                DefaultColumnsSettings = settings;
            }

        }
    }

    private void MoveUp(DefaultColumnsSettingDto setting)
    {
        if (setting.Order >= 1)
        {
            var aboveSetting = DefaultColumnsSettings.FirstOrDefault(x => x.Order == setting.Order - 1);
            if (aboveSetting != null)
            {
                aboveSetting.Order++;
                setting.Order--;

            }
        }
    }

    private void MoveDown(DefaultColumnsSettingDto setting)
    {
        if (setting.Order <= DefaultColumnsSettings.Count())
        {
            var belowSetting = DefaultColumnsSettings.FirstOrDefault(x => x.Order == setting.Order + 1);
            if (belowSetting != null)
            {
                belowSetting.Order--;
                setting.Order++;
            }
        }
    }

    private async Task SaveSettings()
    {
        var res = await _defaultColumnsSettingConsumer.UpdateDefaultColumnsSettings(DefaultColumnsSettings);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
        }
    }

    private void CancelSettings()
    {

    }

    public async Task SortSettingsList((int oldIndex, int newIndex) indices)
    {
        var (oldIndex, newIndex) = indices;

        var items = DefaultColumnsSettings.OrderBy(q => q.Order).ToList();

        var itemToMove = items[oldIndex];
        items.RemoveAt(oldIndex);

        if (newIndex < items.Count)
            items.Insert(newIndex, itemToMove);
        else
            items.Add(itemToMove);

        // Reassign new order values
        for (int i = 0; i < items.Count; i++)
        {
            items[i].Order = i + 1;

        }


        StateHasChanged();

    }

}
