@page "/TypeConfiguration"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.Enums.SearchFields
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject TypeSettingConsumer _typeSettingConsumer
@inject PopupService PopupService



<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["TaskTypeConfiguration"]</h1>
    </div>
    <div class="action-btn-list">
        <Search @ref="searchComponent" SearchSubmit="Search" CssClass="form-control ">
        </Search>
        <button class="btn btn-sm btn-primary" @onclick="AddType">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
            </span>
            @Loc["AddTaskType"]
        </button>
    </div>
</div>

@if (types != null && types.Any())
{
    <div class="page-body">
        <div class="table-responsive sticky-header-custom">
            @if (types != null && types.Any())
            {
                <SortableTable TItem="TypeDtoWithName" Columns="@tableColumns" Items="@types"
                               SortColumn="@currentSortColumn" SortAscending="@sortAscending" OnSortRequested="@HandleSort">
                    <RowTemplate>

                        @foreach (var item in types)
                        {
                            var checkboxId = $"type-active-{item.Type.Id}";
                            <tr>
                                <td>@item.Type.DisplayedName</td>
                                <td>@item.Type.CreateDate.ToLocalTime().ToString(Loc["LocalizeDate"])</td>
                                    <td>@item.CreatedByName</td>
                                    <td>
                                    @(item.Type.UpdateDate.HasValue? item.Type.UpdateDate.Value.ToLocalTime().ToString(Loc["LocalizeDate"]) : "")
                                    </td>
                                <td>@item.UpdatedByName</td>
                                <td>
                                    <div class="form-check form-switch custom">
                                        <InputCheckbox id="@checkboxId" @bind-Value="item.Type.IsActive" class="form-check-input" disabled />
                                        <label for="@checkboxId" class="form-check-label">
                                            <span class="toggler-icon"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-btn-list">
                                        <button class="btn btn-action-24 btn-edit" @onclick="@(() => EditType(item.Type.Id))">
                                            <span class="icon">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                            </span>
                                        </button>
                                        <button class="btn btn-action-24 btn-delete" @onclick="@(() => DeleteType(item))">
                                            <span class="icon">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                                            </span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </RowTemplate>
                </SortableTable>
            }
        </div>
        <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                    PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
    </div>
}
else if (initialTypes != null && initialTypes.Any() && (types == null || !types.Any()))
{
    <NoSearchResults OnResetClick="ClearSearch"></NoSearchResults>
}
else
{
    <NoDataAvailable MessageTitle="@Loc["NoTaskTypeAvailable"]"
                     MessageSubtitle="@Loc["AddANewTaskTypeToGetStarted"]"
                     ButtonText="@Loc["AddTaskType"]"
                     OnButtonClick="AddType" />
}

@code {
    List<TypeDtoWithName> types = new();
    private List<TypeDtoWithName> initialTypes = new();
    private bool showConfirm;
    private TypeDtoWithName? selectedType;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "";
    private bool? sortAscending = true;
    private List<SortableColumn> tableColumns = new();
    private Search? searchComponent;
    private string? lastSearchTerm = null;
    private bool isSearchMode = false;
    public List<SearchField> searchFields = new List<SearchField>();
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadTypes();
    }

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadTypes();
    }
    protected override async Task OnInitializedAsync()
    {
        tableColumns = new()
        {
        new() { Field = "DisplayedName", DisplayName = Loc["name"] },
        new() { Field = "CreateDate", DisplayName = Loc["CreationDate"] },
        new() { Field = "CreatedBy", DisplayName = Loc["CreatedBy"] },
        new() { Field = "UpdateDate", DisplayName = Loc["UpdateDate"] },
        new() { Field = "UpdatedBy", DisplayName = Loc["UpdatedBy"] },
        new() { Field = "IsActive", DisplayName = Loc["active"] },
        new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
        };
        searchFields = GetFileds();
        await LoadTypes();
        initialTypes = types;
    }
    private async Task LoadTypes(bool isSearch = false, string searchTerm = null)
    {
        
        if (isSearchMode && !isSearch)
        {
            isSearch = true;
            searchTerm = lastSearchTerm;
        }
        var encodedTerm = searchTerm != null ? Uri.EscapeDataString(searchTerm) : null;
        var resp = await _typeSettingConsumer.GetTypes(currentPage, pageSize, currentSortColumn, sortAscending.Value,
            isSearch ? searchFields : null, isSearch ? encodedTerm : null);

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        types = data.Items.ToList();
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }
    private void AddType()
    {
        PopupService.ShowNew(@<AddType OnValidSubmit="OnInitializedAsync"></AddType>, headerText: @Loc["AddTaskType"]);
    }
    private void EditType(Guid id)
    {
        PopupService.ShowNew(@<UpdateType Id="id" OnValidSubmit="OnInitializedAsync"></UpdateType>, headerText:
        @Loc["EditTaskType"]);
    }
    private void DeleteType(TypeDtoWithName type)
    {
        PopupService.ShowConfirmation(@Loc["Sure"], @Loc["Confirm"], OnDeleteConfirmed, ConfirmationType.Danger);
        selectedType = type;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedType != null)
        {
            var result = await _typeSettingConsumer.DeleteType(selectedType.Type.Id);
            if (result.Data)
            {
                types.Remove(selectedType);
                if (types.Count()<=0)
                {
                    currentPage = currentPage == 1 ? 1 : currentPage - 1;
                }
                await LoadTypes();

                initialTypes = initialTypes.Where(t => t.Type.Id != selectedType.Type.Id).ToList();
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
            else
            {
                await ToastService.ShowToastAsync(Loc["CannotdeleteType"], "error");

                return;
            }
        }
        selectedType = null;
    }
    private async Task SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }
        await LoadTypes();
    }

    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;


        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = ""; // or whatever your default column is
            sortAscending = true;
        }

        await LoadTypes();
    }


    public List<SearchField> GetFileds()
    {
        var fileds = new List<SearchField>() {
        SearchField.Name,
        SearchField.CreatedBy,
        SearchField.UpdatedBy,
        SearchField.CreateDate,
        SearchField.UpdateDate,
        SearchField.ActiveStatus
        };
        return fileds;
    }
    public async Task Search(string searchTerm)
    {
        lastSearchTerm = searchTerm;
        isSearchMode = true;
        currentPage = 1;
        await LoadTypes(true, searchTerm);
    }
    private async Task ClearSearch()
    {
        currentPage = 1;
        lastSearchTerm = null;
        isSearchMode = false;
        searchComponent?.ClearSearchText();
        await LoadTypes(isSearch: false);
    }

}