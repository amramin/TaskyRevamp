@page "/TypeConfiguration"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.Enums.SearchFields
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject TypeSettingConsumer _typeSettingConsumer
@inject PopupService PopupService


@if (initialTypes != null && initialTypes.Any())
{
    <div class="page-header">
        <div class="title-block">
            <h1 class="page-headline">@Loc["TaskTypeConfiguration"]</h1>
        </div>
        <div class="action-btn-list">
            <Search SearchSubmit="Search" CssClass="form-control ">
            </Search>
            <button class="btn btn-sm btn-primary" @onclick="AddType"> <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                </span>
                @Loc["AddTaskType"]</button>
        </div>
    </div>
    <div class="page-body">
       
            @if (types != null && types.Any())
            {
                <div class="table-responsive ">
                    <table class="table table-sm table-hover align-middle m-2">
                        <thead class="table-light small">
                            <tr>
                                <th @onclick='() => SortBy("DisplayedName")' style="cursor:pointer">
                                    @Loc["name"]
                                    <span class="ms-1">
                                        @(currentSortColumn == "DisplayedName" ? (sortAscending ? "↑" : "↓") : "↕")
                                    </span>
                                </th>
                                <th @onclick='() => SortBy("CreateDate")' style="cursor:pointer">
                                    @Loc["CreationDate"]
                                    <span class="ms-1">
                                        @(currentSortColumn == "CreateDate" ? (sortAscending ? "↑" : "↓") : "↕")
                                    </span>
                                </th>
                                <th @onclick='() => SortBy("CreatedBy")' style="cursor:pointer">
                                    @Loc["CreatedBy"]
                                    <span class="ms-1">
                                        @(currentSortColumn == "CreatedBy" ? (sortAscending ? "↑" : "↓") : "↕")
                                    </span>
                                </th>
                                <th @onclick='() => SortBy("UpdateDate")' style="cursor:pointer">
                                    @Loc["UpdateDate"]
                                    <span class="ms-1">
                                        @(currentSortColumn == "UpdateDate" ? (sortAscending ? "↑" : "↓") : "↕")
                                    </span>
                                </th>
                                <th @onclick='() => SortBy("UpdatedBy")' style="cursor:pointer">
                                    @Loc["UpdatedBy"]
                                    <span class="ms-1">
                                        @(currentSortColumn == "UpdatedBy" ? (sortAscending ? "↑" : "↓") : "↕")
                                    </span>
                                </th>
                                <th class="text-center">@Loc["active"]</th>
                                <th class="text-center">@Loc["Action"]</th>
                            </tr>
                        </thead>
                        <tbody class="small">
                            @foreach (var item in types)
                            {
                                <tr>
                                    <td>@item.Type.DisplayedName</td>
                                    <td>@item.Type.CreateDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                    <td>@item.CreatedByName</td>
                                    <td>@(item.Type.UpdateDate.HasValue?
                                                                item.Type.UpdateDate.Value.ToLocalTime().ToString("dd/MM/yyyy"): "")</td>
                                    <td>@item.UpdatedByName</td>
                                    <td class="text-center">
                                        <div class="form-check form-switch d-flex justify-content-center">
                                            <InputCheckbox @bind-Value="item.Type.IsActive" class="form-check-input" disabled />
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <button class="btn btn-sm btn-success me-2" @onclick="@(() => EditType(item.Type.Id))">
                                            <span class="icon">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                            </span>
                                        </button>
                                        <button class="btn btn-sm btn-danger" @onclick="@(() => DeleteType(item))">
                                            <span class="icon">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.RecycleBin"></SVGCrud>
                                            </span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

           
                <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount"
                    PageSize="@pageSize" PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
           
        
    </div>
}
else
{
    <div class="page-header">
        <div class="title-block">
            <h1 class="page-headline">@Loc["TaskTypeConfiguration"]</h1>
        </div>
    </div>
    <div class="page-body">
        <div class="card empty-page">
            <div class="card-body">
                <span class="vector">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EmptyPageVector"></SVGCrud>
                </span>
                <div class="content">
                    <h5 class="headline-5">@Loc["NoTaskTypeAvailable"]</h5>
                    <p class="small-medium-text">@Loc["Add a new task type to get started."]</p>
                </div>
                <div class="action-btn-list">
                    <button class="btn btn-lg btn-primary" @onclick="AddType">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                        </span>
                        @Loc["AddTaskType"]
                    </button>
                </div>
            </div>
        </div>
    </div>

}

@code {
    List<TypeDtoWithName> types = new();
    private List<TypeDtoWithName> initialTypes = new();
    private bool showConfirm;
    private TypeDtoWithName? selectedType;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "CreateDate";
    private bool sortAscending = true;

    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadTypes();
    }

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadTypes();
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadTypes();

        initialTypes = types;
    }
    private async Task LoadTypes(bool isSearch = false, string searchTerm = null)
    {
        var resp = await _typeSettingConsumer.GetTypes(currentPage, pageSize, currentSortColumn, sortAscending, isSearch ?
        searchFields : null, isSearch ? searchTerm : null);
        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        types = data.Items.ToList();
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }
    private void AddType()
    {
        PopupService.ShowNew(@<AddType OnValidSubmit="OnInitializedAsync"></AddType>, headerText: @Loc["AddTaskType"]);
    }
    private void EditType(Guid id)
    {
        PopupService.ShowNew(@<UpdateType Id="id" OnValidSubmit="OnInitializedAsync"></UpdateType>, headerText:
        @Loc["EditTaskType"]);
    }
    private void DeleteType(TypeDtoWithName t)
    {
        PopupService.ShowConfirmation(@Loc["TypeSure"], @Loc["Confirm"], OnDeleteConfirmed, ConfirmationType.Danger);
        selectedType = t;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedType != null)
        {
            var result = await _typeSettingConsumer.DeleteType(selectedType.Type.Id);
            if (result.Success)
            {
                types.Remove(selectedType);
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
        }
        selectedType = null;
    }
    private async Task SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }
        await LoadTypes();
    }

    public List<SearchField> searchFields = new List<SearchField>() {
SearchField.NameEnglish,
SearchField.NameArabic,
SearchField.CreatedBy,
SearchField.UpdatedBy,
SearchField.CreateDate,
SearchField.UpdateDate,
SearchField.ActiveStatus
};

    public async Task Search(string searchTerm)
    {
        await LoadTypes(true, searchTerm);
    }
}