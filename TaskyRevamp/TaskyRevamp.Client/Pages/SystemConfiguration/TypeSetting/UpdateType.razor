@page "/EditType/{Id:guid}"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject TypeSettingConsumer _typeSettingConsumer
@inject PopupService PopupService


    <TypeForm @ref="form"
                OnCancel="Cancel"
                OnValidSubmit="@Save"
                type="@type"
                SubmitButtonText="Save" />


@code {
    [Parameter] public Guid Id { get; set; }
    private TypeDto type = new TypeDto();
    [Parameter] public EventCallback<TypeDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private TypeForm form;

    protected override async Task OnInitializedAsync()
    {
        var res = await _typeSettingConsumer.GetTypeById(Id);
        if (res.Success && res != null && res.Data != null)
        {
            type = res.Data;
        }
    }

    private async Task Save(EditContext editContext)
    {

        var res = await _typeSettingConsumer.UpdateType(type);
        if (res.Success)
        {
            await OnValidSubmit.InvokeAsync(type);
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
            PopupService.Hide();
        }
    }
    private void Cancel()
    {
        PopupService.Hide();
    }
}
