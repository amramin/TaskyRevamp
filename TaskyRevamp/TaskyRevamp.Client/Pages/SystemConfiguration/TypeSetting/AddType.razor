@page "/AddType"

@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject TypeSettingConsumer _typeSettingConsumer
@inject ILocalStorageService LocalStorageService

@inject PopupService PopupService


       <TypeForm @ref="form"
                   OnCancel="Cancel" 
                   OnValidSubmit="@Save"
                   type="_newType"
                   SubmitButtonText="Save" />


@code {
    private TypeDto _newType = new TypeDto { IsActive = true};
    [Parameter] public EventCallback<TypeDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private TypeForm form;
    private TypeDto? selectedType;
    private bool showConfirm;
    protected override Task OnInitializedAsync()
    {
        return base.OnInitializedAsync();
    }

    private async Task Save(EditContext editContext)
    {


        var alloldTypes = await _typeSettingConsumer.GetTaskTypesForDDL();
        var allOldActiveType = alloldTypes.Data
            .Where(k => k.IsActive == true && k.IsDeleted != true)
            .ToList();

        var alloldDeletedType = alloldTypes.Data
            .Where(k => k.IsDeleted == true)
            .ToList();
        if (allOldActiveType.Any(m => m.NameEnglish == _newType.NameEnglish) || allOldActiveType.Any(m => m.NameArabic == _newType.NameArabic))
        {
            await ToastService.ShowToastAsync(Loc["AnactiveTypewith"], "error");

            return;
        }
        else if (alloldDeletedType.Any(m => m.NameEnglish == _newType.NameEnglish) || alloldDeletedType.Any(m => m.NameArabic == _newType.NameArabic))
        {

            var relatedwithcompleted = await _typeSettingConsumer.CheckRelatedComplatedTaskitemType(_newType);
            if (relatedwithcompleted.Data)
            {
                PopupService.ShowConfirmation(@Loc["ThisTypenamewas"], @Loc["Confirm"], OnSavedConfirmed, type: ConfirmationType.Danger);
                selectedType = _newType;
                showConfirm = true;
            }
            else
            {
                var result = await _typeSettingConsumer.RetriveType(_newType);
                await ToastService.ShowToastAsync(Loc["Added successfully"], "success");

            }
        }
        else
        {


            var res = await _typeSettingConsumer.CreateType(_newType);
            if (res.Success)
            {
                await OnValidSubmit.InvokeAsync(_newType);
                await ToastService.ShowToastAsync(Loc["Added successfully"], "success");

                PopupService.Hide();
            }
        }
    }
    private async Task OnSavedConfirmed(bool confirmed)
    {
        if (confirmed && selectedType != null)
        {
            // retrve
            var result = await _typeSettingConsumer.RetriveType(selectedType);
            if (result.Data)
            {

                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Retrived successfully"], "success");
            }
            else
            {

                return;
            }
        }
        selectedType = null;

    }

    private void Cancel()
    {
        PopupService.Hide();
    }
}
