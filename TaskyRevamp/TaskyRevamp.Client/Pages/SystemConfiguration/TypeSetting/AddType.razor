@page "/AddType"

@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject TypeSettingConsumer _typeSettingConsumer
@inject ILocalStorageService LocalStorageService

@inject PopupService PopupService


       <TypeForm @ref="form"
                   OnCancel="Cancel" 
                   OnValidSubmit="@Save"
                   type="_newType"
                   SubmitButtonText="Save" />


@code {
    private TypeDto _newType = new TypeDto { IsActive = true};
    [Parameter] public EventCallback<TypeDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private TypeForm form;

    protected override Task OnInitializedAsync()
    {
        return base.OnInitializedAsync();
    }

    private async Task Save(EditContext editContext)
    {


        var current = await LocalStorageService.GetItemAsStringAsync("Id");
        _newType.CreatedById = Guid.Parse(current);


        var res = await _typeSettingConsumer.CreateType(_newType);
        if (res.Success)
        {
            await OnValidSubmit.InvokeAsync(_newType);
            await ToastService.ShowToastAsync(Loc["Added successfully"], "success");

            PopupService.Hide();
        }
    }
    private void Cancel()
    {
        PopupService.Hide();
    }
}
