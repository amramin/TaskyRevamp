@page "/EditSource/{Id:guid}"

@using Blazored.LocalStorage
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService
@inject SourceSettingConsumer _sourceSettingConsumer
@inject ILocalStorageService LocalStorageService


    <SourceForm @ref="form"
                OnCancel="Cancel"
                OnValidSubmit="@Save"
                source="@source"
                SubmitButtonText="Save" />


@code {
    [Parameter] public Guid Id { get; set; }
    private SourceDto source = new SourceDto();
    [Parameter] public EventCallback<SourceDto> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    private SourceForm form;
    private bool showConfirm;
    private SourceDto? selectedSource;
    protected override async Task OnInitializedAsync()
    {
        var res = await _sourceSettingConsumer.GetSourceById(Id);
        if (res.Success && res != null && res.Data != null)
        {
            source = res.Data;
        }
    }

    private async Task Save(EditContext editContext)
    {
        //  var current = await LocalStorageService.GetItemAsStringAsync("Id");
        //source.UpdatedById = Guid.Parse(current);
        var alloldSources = await _sourceSettingConsumer.GetTaskSourcesForDDL();
        var allOldSources = alloldSources.Data.Where(k =>  k.IsDeleted != true && k.Id != source.Id).ToList();
        var alloldDeletedSource = alloldSources.Data.Where(k => k.IsDeleted == true).ToList();
        if (allOldSources.Any(m => m.NameEnglish == source.NameEnglish) || allOldSources.Any(m => m.NameArabic == source.NameArabic))
        {
            await ToastService.ShowToastAsync(Loc["Anactivesourcewith"], "error");

            return;
        }
        else if (alloldDeletedSource.Any(m => m.NameEnglish == source.NameEnglish) || alloldDeletedSource.Any(m => m.NameArabic == source.NameArabic))
        {

            var relatedwithcompleted = await _sourceSettingConsumer.CheckRelatedComplatedTaskitemSource(source);
            if (relatedwithcompleted.Data)
            {
                PopupService.ShowConfirmation(@Loc["Thissourcenamewas"], @Loc["Confirm"], OnSavedConfirmed, type: ConfirmationType.Danger);
                selectedSource = source;
                showConfirm = true;
            }
            else
            {
                var result = await _sourceSettingConsumer.UpdateSource(source);
               // await _sourceSettingConsumer.DeleteSource(Id);

                await ToastService.ShowToastAsync(Loc["Added successfully"], "success");

            }
        }
        else
        {
            var res = await _sourceSettingConsumer.UpdateSource(source);
            if (res.Success)
            {
                await OnValidSubmit.InvokeAsync(source);
                await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");

                PopupService.Hide();
            }
        }
    }
    private async Task OnSavedConfirmed(bool confirmed)
    {
        if (confirmed && selectedSource != null)
        {
            // retrve
            var result = await _sourceSettingConsumer.RetriveDeleteSource(selectedSource);
            if (result.Data)
            {
               // await _sourceSettingConsumer.DeleteSource(Id);
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Retrived successfully"], "success");
            }
            else
            {

                return;
            }
        }
        selectedSource = null;
        await OnValidSubmit.InvokeAsync();
    }

    private async Task Cancel()
    {
        PopupService.Hide();
    }
}
