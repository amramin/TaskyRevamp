@page "/SourceSettings"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject SourceSettingConsumer _sourceSettingConsumer
@inject PopupService PopupService

<div class="card p-4 m-2">
    @if(sources != null && sources.Any())
    {
        <div class="card shadow-sm border-1 ms-2">
            <div class="card-header d-flex justify-content-between align-items-center bg-white">
                <h5 class="mb-0 fw-bold">@Loc["SourceConfiguration"]</h5>
                <div class="d-flex">
                    <input type="text" class="form-control form-control-sm me-2" placeholder="Search..." oninput ="SearchOption" style="max-width: 400px;" />
                    <button class="btn btn-sm btn-primary" style="width:300px" @onclick="AddSource"> + @Loc["AddTaskSource"]</button>
                </div>
            </div>
            <div class="table-responsive flex-grow-1">
                <table class="table table-sm table-hover align-middle m-2">
                    <thead class="table-light small">
                        <tr>
                            <th @onclick='() => SortBy("DisplayedName")' style="cursor:pointer">
                                @Loc["name"]
                                <span class="ms-1">
                                    @(currentSortColumn == "DisplayedName" ? (sortAscending ? "↑" : "↓"): "↕")
                                </span>
                            </th>
                            <th @onclick='() => SortBy("CreateDate")' style="cursor:pointer">
                                @Loc["CreationDate"]
                                <span class="ms-1">
                                    @(currentSortColumn == "CreateDate" ? (sortAscending ? "↑" : "↓") : "↕")
                                </span>
                            </th>
                            <th @onclick='() => SortBy("CreatedBy")' style="cursor:pointer">
                                @Loc["CreatedBy"]
                                <span class="ms-1">
                                    @(currentSortColumn == "CreatedBy" ? (sortAscending ? "↑" : "↓") : "↕")
                                </span>
                            </th>
                            <th @onclick='() => SortBy("UpdateDate")' style="cursor:pointer">
                                @Loc["UpdateDate"]
                                <span class="ms-1">
                                    @(currentSortColumn == "UpdateDate" ? (sortAscending ? "↑" : "↓") : "↕")
                                </span>
                            </th>
                            <th @onclick='() => SortBy("UpdatedBy")' style="cursor:pointer">
                                @Loc["UpdatedBy"]
                                <span class="ms-1">
                                    @(currentSortColumn == "UpdatedBy" ? (sortAscending ? "↑" : "↓") : "↕")
                                </span>
                            </th>
                            <th class="text-center">@Loc["active"]</th>
                            <th class="text-center">@Loc["Action"]</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var item in sources)
                        {
                            <tr>
                                <td>@item.Source.DisplayedName</td>
                                <td>@item.Source.CreateDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td>@item.CreatedByName</td>
                                <td>@(item.Source.UpdateDate.HasValue? item.Source.UpdateDate.Value.ToLocalTime().ToString("dd/MM/yyyy"): "")</td>
                                <td>@item.UpdatedByName</td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <InputCheckbox @bind-Value="item.Source.IsActive" class="form-check-input" disabled />
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-success me-2" @onclick="@(() => EditSource(item.Source.Id))">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                        </span>
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="@(() => DeleteSource(item))">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.RecycleBin"></SVGCrud>
                                        </span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-white">
                <Pagination CurrentPage="@currentPage"
                            TotalPages="@totalPages"
                            TotalCount="@totalCount"
                            PageSize="@pageSize"
                            PageChanged="ChangePage"
                            PageSizeChangedCallback="ChangePageSize" />
            </div>
       </div>
    }
    else
    {
    
            <div class="d-flex flex-column align-sources-center justify-content-center p-5">
                <h6 class="mt-4 fw-semibold text-muted">@Loc["No Task Sources Available"]</h6>
                <p class="text-muted">@Loc["Add a new task source to get started."]</p>
                <button class="btn btn-primary mt-3" @onclick="AddSource"> + @Loc["AddTaskSource"] </button>
            </div>
    
    }
</div>
@code {
    List<SourceDtoWithName> sources = new();
    private bool showConfirm;
    private SourceDtoWithName? selectedSource;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "CreateDate";
    private bool sortAscending = true;

    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadSources();
    }

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadSources();
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadSources();
    }
    private async Task LoadSources()
    {
        var resp = await _sourceSettingConsumer.GetSources(currentPage, pageSize, currentSortColumn, sortAscending);
        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        sources = data.Items.ToList();
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }
    private void AddSource()
    {
        PopupService.ShowNew(@<AddSource OnValidSubmit="OnInitializedAsync"></AddSource>, headerText: @Loc["AddTaskSource"]);
    }
    private void EditSource(Guid id)
    {
        PopupService.ShowNew(@<UpdateSource Id="id" OnValidSubmit="OnInitializedAsync"></UpdateSource>, headerText: @Loc["EditTaskSource"]);
    }
    private void DeleteSource(SourceDtoWithName s)
    {
        PopupService.ShowConfirmation(@Loc["SourceSure"], @Loc["Confirm"], OnDeleteConfirmed, type: ConfirmationType.Danger);
        selectedSource = s;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedSource != null)
        {
            var result = await _sourceSettingConsumer.DeleteSource(selectedSource.Source.Id);
            if (result.Success)
            {
                sources.Remove(selectedSource);
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
        }
        selectedSource = null;
    }
    private async Task SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }
        await LoadSources();
    }
    private void OnSearchChanged(ChangeEventArgs args)
    {
        throw new NotImplementedException();
    }
}
