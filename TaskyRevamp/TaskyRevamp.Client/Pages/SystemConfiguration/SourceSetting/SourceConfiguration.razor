@page "/SourceSettings"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.Enums.SearchFields
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject SourceSettingConsumer _sourceSettingConsumer
@inject PopupService PopupService



<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["SourceConfiguration"]</h1>

    </div>
    <div class="action-btn-list">
        <Search @ref="searchComponent" SearchSubmit="Search" CssClass="form-control"></Search>
        <button class="btn  btn-primary" @onclick="AddSource">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
            </span>
            @Loc["AddTaskSource"]
        </button>
    </div>
</div>

@if (sources != null && sources.Any())
{
    <div class="page-body">
        <div class="table-responsive">
            @if (sources != null && sources.Any())
            {

                <SortableTable TItem="SourceDtoWithName" Columns="@tableColumns" Items="@sources"
                               SortColumn="@currentSortColumn" SortAscending="@sortAscending" OnSortRequested="HandleSort">

                    <RowTemplate>
                        @foreach (var item in sources)
                        {
                            var checkboxId = $"source-active-{item.Source.Id}";
                            <tr>
                                <td>@item.Source.DisplayedName</td>
                                <td>@item.Source.CreateDate.ToLocalTime().ToString("dd-MM-yyyy")</td>
                                <td>@item.CreatedByName</td>
                                <td>@(item.Source.UpdateDate?.ToLocalTime().ToString("dd-MM-yyyy"))</td>
                                <td>@item.UpdatedByName</td>
                                <td>
                                    <div class="form-check form-switch custom">
                                        <InputCheckbox id="@checkboxId" @bind-Value="item.Source.IsActive" class="form-check-input"
                                                       disabled />
                                        <label for="@checkboxId" class="form-check-label">
                                            <span class="toggler-icon"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="action-btn-list">
                                        <button class="btn btn-action-24 btn-edit" @onclick="@(() => EditSource(item.Source.Id))">
                                            <span class="icon">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                            </span>
                                        </button>
                                        <button class="btn btn-action-24 btn-delete" @onclick="@(() => DeleteSource(item))">
                                            <span class="icon">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                                            </span>
                                        </button>
                                    </div>

                                </td>
                            </tr>
                        }
                    </RowTemplate>
                </SortableTable>


            }
        </div>

        <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                    PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
    </div>

}
else if (initialSources != null && initialSources.Any())
{
    <NoSearchResults OnResetClick="ClearSearch"></NoSearchResults>
}
else
{
    <NoDataAvailable MessageTitle="@Loc["NoTaskSourcesAvailable"]"
                     MessageSubtitle="@Loc["AddANewTaskSourceToGetStarted"]"
                     ButtonText="@Loc["AddTaskSource"]"
                     OnButtonClick="AddSource" />
}

@code {
    List<SourceDtoWithName> sources = new();
    List<SourceDtoWithName> initialSources = new();
    private bool showConfirm;
    private SourceDtoWithName? selectedSource;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "CreateDate";
    private bool? sortAscending = true;
    private List<SortableColumn> tableColumns = new();
    private Search? searchComponent;
    private string? lastSearchTerm = null;
    private bool isSearchMode = false;
    public List<SearchField> searchFields = new List<SearchField>();
    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadSources();
    }

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadSources();
    }
    protected override async Task OnInitializedAsync()
    {
        tableColumns = new()
        {
            new() { Field = "DisplayedName", DisplayName = Loc["name"] },
            new() { Field = "CreateDate", DisplayName = Loc["CreationDate"] },
            new() { Field = "CreatedBy", DisplayName = Loc["CreatedBy"] },
            new() { Field = "UpdateDate", DisplayName = Loc["UpdateDate"] },
            new() { Field = "UpdatedBy", DisplayName = Loc["UpdatedBy"] },
            new() { Field = "IsActive", DisplayName = Loc["active"] },
            new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
        };
        searchFields = GetFileds();
        await LoadSources();
        initialSources = sources;
    }
    private async Task LoadSources(bool isSearch = false, string searchTerm = null)
    {
       
        if (isSearchMode && !isSearch)
        {
            isSearch = true;
            searchTerm = lastSearchTerm;
        }
        var encodedTerm = searchTerm != null ? Uri.EscapeDataString(searchTerm) : null;
        var resp = await _sourceSettingConsumer.GetSources(currentPage, pageSize, currentSortColumn, sortAscending.Value,
        isSearch ? searchFields : null, isSearch ? encodedTerm : null);

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        sources = data.Items.ToList();
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }
    private void AddSource()
    {
        PopupService.ShowNew(@<AddSource OnValidSubmit="OnInitializedAsync"></AddSource>, headerText: @Loc["AddTaskSource"]);
    }
    private void EditSource(Guid id)
    {
        PopupService.ShowNew(@<UpdateSource Id="id" OnValidSubmit="OnInitializedAsync"></UpdateSource>, headerText:
        @Loc["EditTaskSource"]);
    }
    private void DeleteSource(SourceDtoWithName source)
    {
        PopupService.ShowConfirmation(@Loc["Sure"], @Loc["Confirm"], OnDeleteConfirmed, type: ConfirmationType.Danger);
        selectedSource = source;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedSource != null)
        {
            var result = await _sourceSettingConsumer.DeleteSource(selectedSource.Source.Id);
            if (result.Success)
            {
                sources.Remove(selectedSource);
                if (sources.Count() <= 0)
                {
                    currentPage -= 1;
                }
                await LoadSources();
                initialSources = initialSources.Where(s => s.Source.Id != selectedSource.Source.Id).ToList(); // update initialsources
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
        }
        selectedSource = null;

    }
    private async Task SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }
        await LoadSources();
    }
    public List<SearchField> GetFileds()
    {
        var fileds = new List<SearchField>() {
        SearchField.CreatedBy,
        SearchField.UpdatedBy,
        SearchField.CreateDate,
        SearchField.UpdateDate,
        SearchField.ActiveStatus
    };
        if (Thread.CurrentThread.CurrentCulture.TwoLetterISOLanguageName == "ar")
        {
            fileds.Add(SearchField.NameArabic);
        }
        else
        {
            fileds.Add(SearchField.NameEnglish);
        }
        return fileds;
    }
    public async Task Search(string searchTerm)
    {
        lastSearchTerm = searchTerm;
        isSearchMode = true;
        currentPage = 1;
        await LoadSources(true, searchTerm);
    }
    private async Task ClearSearch()
    {
        currentPage = 1;
        lastSearchTerm = null;
        isSearchMode = false;
        searchComponent?.ClearSearchText();
        await LoadSources(isSearch: false);
    }
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;


        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = "DisplayedName"; // or whatever your default column is
            sortAscending = true;
        }

        await LoadSources();
    }
}