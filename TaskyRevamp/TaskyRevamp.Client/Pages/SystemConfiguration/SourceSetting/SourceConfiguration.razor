@page "/SourceSettings"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.Enums.SearchFields
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject SourceSettingConsumer _sourceSettingConsumer



@if (initialSources != null && initialSources.Any())
{
    <div class="page-header">
        <div class="title-block">
            <h1 class="page-headline">@Loc["SourceConfiguration"]</h1>
            
        </div>
        <div class="action-btn-list">
                <Search SearchSubmit="Search" CssClass="form-control"></Search>
                <button class="btn  btn-primary" @onclick="AddSource">
                    <span class="icon">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                    </span>
                    @Loc["AddTaskSource"]
                </button>
            </div>
    </div>
    <div class="page-body">
    
    
  
        
        @if (sources != null && sources.Any())
        {
            <div class="table-responsive flex-grow-1">
                <table class="table table-sm table-hover align-middle m-2">
                    <thead class="table-light small">
                        <tr>
                            <th @onclick='() => SortBy("DisplayedName")' style="cursor:pointer">
                                @Loc["name"]
                                <span class="ms-1">
                                    @(currentSortColumn == "DisplayedName" ? (sortAscending ? "↑" : "↓") : "↕")
                                </span>
                            </th>
                            <th @onclick='() => SortBy("CreateDate")' style="cursor:pointer">
                                @Loc["CreationDate"]
                                <span class="ms-1">
                                    @(currentSortColumn == "CreateDate" ? (sortAscending ? "↑" : "↓") : "↕")
                                </span>
                            </th>
                            <th @onclick='() => SortBy("CreatedBy")' style="cursor:pointer">
                                @Loc["CreatedBy"]
                                <span class="ms-1">
                                    @(currentSortColumn == "CreatedBy" ? (sortAscending ? "↑" : "↓") : "↕")
                                </span>
                            </th>
                            <th @onclick='() => SortBy("UpdateDate")' style="cursor:pointer">
                                @Loc["UpdateDate"]
                                <span class="ms-1">
                                    @(currentSortColumn == "UpdateDate" ? (sortAscending ? "↑" : "↓") : "↕")
                                </span>
                            </th>
                            <th @onclick='() => SortBy("UpdatedBy")' style="cursor:pointer">
                                @Loc["UpdatedBy"]
                                <span class="ms-1">
                                    @(currentSortColumn == "UpdatedBy" ? (sortAscending ? "↑" : "↓") : "↕")
                                </span>
                            </th>
                            <th class="text-center">@Loc["active"]</th>
                            <th class="text-center">@Loc["Action"]</th>
                        </tr>
                    </thead>
                    <tbody class="small">
                        @foreach (var item in sources)
                        {
                            <tr>
                                <td>@item.Source.DisplayedName</td>
                                <td>@item.Source.CreateDate.ToLocalTime().ToString("dd/MM/yyyy")</td>
                                <td>@item.CreatedByName</td>
                                <td>
                                    @(item.Source.UpdateDate.HasValue ?
                                                            item.Source.UpdateDate.Value.ToLocalTime().ToString("dd/MM/yyyy") : "")
                                </td>
                                <td>@item.UpdatedByName</td>
                                <td class="text-center">
                                    <div class="form-check form-switch d-flex justify-content-center">
                                        <InputCheckbox @bind-Value="item.Source.IsActive" class="form-check-input" disabled />
                                    </div>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-success me-2" @onclick="@(() => EditSource(item.Source.Id))">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                        </span>
                                    </button>
                                    <button class="btn btn-sm btn-danger" @onclick="@(() => DeleteSource(item))">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.RecycleBin"></SVGCrud>
                                        </span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

       
            <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
       </div>
   
}
else
{

    <div class="page-header">
        <div class="title-block">
            <h1 class="page-headline">@Loc["SourceConfiguration"]</h1>
        </div>
    </div>
    <div class="page-body">
        <div class="card empty-page">
            <div class="card-body">
                <span class="vector">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EmptyPageVector"></SVGCrud>
                </span>
                <div class="content">
                    <h5 class="headline-5">@Loc["No Task Sources Available"]</h5>
                    <p class="small-medium-text">@Loc["Add a new task source to get started."]</p>
                </div>
                <div class="action-btn-list">
                    <button class="btn btn-lg btn-primary" @onclick="AddSource">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                        </span>
                        @Loc["AddTaskSource"]
                    </button>
                </div>
            </div>
        </div>
    </div>
}
<ConfirmationPopup ButtonText="Confirm" IsVisible="@showConfirm" OnConfirm="OnDeleteConfirmed"
    Message="@confirmMessage" />

@code {
    List<SourceDtoWithName> sources = new();
    List<SourceDtoWithName> initialSources = new();
    private bool showConfirm;
    private string confirmMessage = "";
    private SourceDtoWithName? selectedSource;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "CreateDate";
    private bool sortAscending = true;

    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadSources();
    }

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadSources();
    }
    protected override async Task OnInitializedAsync()
    {
        await LoadSources();
        initialSources = sources;
    }
    private async Task LoadSources(bool isSearch = false, string searchTerm = null)
    {
        var resp = await _sourceSettingConsumer.GetSources(currentPage, pageSize, currentSortColumn, sortAscending, isSearch ?
        searchFields : null, isSearch ? searchTerm : null);

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        sources = data.Items.ToList();
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }
    private void AddSource() => navigationManager.NavigateTo("/AddSource");
    private void EditSource(Guid id) => navigationManager.NavigateTo($"EditSource/{id}");
    private void DeleteSource(SourceDtoWithName s)
    {
        confirmMessage = @Loc["SourceSure"];
        selectedSource = s;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedSource != null)
        {
            var result = await _sourceSettingConsumer.DeleteSource(selectedSource.Source.Id);
            if (result.Success)
            {
                sources.Remove(selectedSource);
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
        }
        selectedSource = null;
    }
    private async Task SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }
        await LoadSources();
    }

    public List<SearchField> searchFields = new List<SearchField>() {
SearchField.NameEnglish,
SearchField.NameArabic,
SearchField.CreatedBy,
SearchField.UpdatedBy,
SearchField.CreateDate,
SearchField.UpdateDate,
SearchField.ActiveStatus
};

    public async Task Search(string searchTerm)
    {
        await LoadSources(true, searchTerm);
    }
}