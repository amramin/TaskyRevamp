@page "/StatusSetting"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject StatusSettingConsumer _statusSettingConsumer

<h6 class="mb-3">@Loc["StatusOptions"]</h6>

<div class="card shadow-sm p-3">
    @foreach (var status in Status)
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center">

                <span class="badge" style="background-color:@status.BackgroundColor; color:@status.NameColor">
                    @status.NameEnglish - @status.NameArabic
                </span>

                <div class="d-flex align-items-center gap-2">
                    <span class="rounded-circle p-2" style="background-color:@status.BackgroundColor"></span>
                    <span class="rounded-circle p-2" style="background-color:@status.NameColor"></span>

                    <button class="btn btn-sm btn-outline-success" @onclick=" () => Edit(status.Id)">
                        <i class="bi bi-pencil"></i>
                    </button>
                
                </div>
            </div>
        </div>
    }

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-light" @onclick="Cancel">@Loc["Cancel"]</button>
        <button class="btn btn-primary" @onclick="Save">@Loc["Save"]</button>
    </div>

</div>

@code {
    private List<StatusSettingsDto> Status = new();

    protected override async Task OnInitializedAsync()
    {
        var res = await _statusSettingConsumer.GetStatusConfiguration();
        if(res.Success && res != null && res.Data != null)
        {
            Status = res.Data;
        }
    }

    private void Edit(Guid Id)
    {
        navigationManager.NavigateTo($"/Update-Status/{Id}");
    }
    private void Cancel(MouseEventArgs args)
    {
        
    }
    private void Save(MouseEventArgs args)
    {
        
    }
}
