@page "/StatusSetting"

@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject StatusSettingConsumer _statusSettingConsumer
@inject PopupService PopupService
@inject IJSRuntime JS

<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["StatusConfig"]</h1>
    </div>
    <div class="action-btn-list">

    </div>
</div>
<div class="page-body">
    <div class="card setting-card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="text-content">
                        <h6 class="headline-6">@Loc["StatusOptions"]</h6>
                    </div>
                    @foreach (var status in Status)
                    {
                        <div class="card card-order-control">
                            <div class="card-body d-flex justify-content-between align-items-center">

                                <span class="badge status-name"
                                    style="background-color:@status.BackgroundColor; color:@status.NameColor">
                                    <span>@status.Name</span> 
                                </span>

                                <div class="d-flex align-items-center gap-2">
                                    <span class="rounded-circle cl-preview"
                                        style="background-color:@status.BackgroundColor"></span>
                                    <span class="rounded-circle cl-preview"
                                        style="background-color:@status.NameColor"></span>

                                    <div class="actions">
                                        <button class="btn btn-action-24 btn-edit" type="button"
                                            @onclick=" () => Edit(status.Id)">
                                            <span class="icon">
                                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                            </span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="action-buttons">
                      
                        <button class="btn btn-lg btn-primary" @onclick="Save">@Loc["Save"]</button>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
@code {
    private List<StatusSettingsDto> Status = new();



    protected override async Task OnInitializedAsync()
    {
        var res = await _statusSettingConsumer.GetStatusConfiguration();
        if (res.Success && res != null && res.Data != null)
        {
            Status = res.Data;
        }
    }

    private void Edit(Guid id)
    {
        PopupService.ShowNew(@<UpdateStatus Id="id" OnValidSubmit="OnInitializedAsync" />, headerText: @Loc["EditStatus"]);
    }


    private async Task Save(MouseEventArgs args)
    {

    }
    
  
}