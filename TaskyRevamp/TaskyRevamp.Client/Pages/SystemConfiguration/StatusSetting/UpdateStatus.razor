@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject StatusSettingConsumer _statusSettingConsumer
@inject ToastService ToastService
@inject PopupService PopupService


<EditForm Model="_statusDto" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <div class="offcanvas-body">
        <div class="mb-3">
            <label class="form-label">
                @Loc["Name English"]
                <span class="text-danger">*</span>
            </label>
            <InputText class="form-control" @bind-Value="_statusDto.NameEnglish" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                @Loc["Name Arabic"]
                <span class="text-danger">*</span>
            </label>
            <InputText class="form-control" @bind-Value="_statusDto.NameArabic" />
        </div>

        <div class="mb-3">
            <label class="form-label">
                @Loc["Name Color Indicator"]
                <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <InputText class="form-control" @bind-Value="_statusDto.NameColor" />
                <span class="input-group-text">
                    <input type="color" class="form-control form-control-color border-0 p-0" style="width: 2rem;"
                        @bind="_statusDto.NameColor" />
                </span>
            </div>
        </div>

        <div class="mb-3">
            <label class="form-label">
                @Loc["Background Color Indicator"]
                <span class="text-danger">*</span>
            </label>
            <div class="input-group">
                <InputText class="form-control" @bind-Value="_statusDto.BackgroundColor" />
                <span class="input-group-text">
                    <input type="color" class="form-control form-control-color border-0 p-0" style="width: 2rem;"
                        @bind="_statusDto.BackgroundColor" />
                </span>
            </div>
        </div>
    </div>

    <div class="offcanvas-footer">
        <button type="button" class="btn btn-light" @onclick="Cancel">@Loc["Cancel"]</button>
        <button type="submit" class="btn btn-primary">@Loc["Save"]</button>
    </div>
</EditForm>


@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public EventCallback<StatusSettingsDto> OnValidSubmit { get; set; }
    private StatusSettingsDto _statusDto = new();

    protected override async Task OnParametersSetAsync()
    {
        var res = await _statusSettingConsumer.GetStatusById(Id);
        if (res.Success && res.Data != null)
        {
            _statusDto = res.Data;
        }
    }

    private async Task Save()
    {
        var res = await _statusSettingConsumer.UpdateStatusConfiguration(_statusDto);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
            PopupService.Hide();

            if (OnValidSubmit.HasDelegate)
                await OnValidSubmit.InvokeAsync(_statusDto);
        }
    }

    private void Cancel()
    {
        PopupService.Hide();
    }
}