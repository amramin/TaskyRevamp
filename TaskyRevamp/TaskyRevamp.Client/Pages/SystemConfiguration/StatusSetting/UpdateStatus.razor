@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Dto.SystemConfiguration
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject StatusSettingConsumer _statusSettingConsumer
@inject ToastService ToastService
@inject PopupService PopupService


<EditForm EditContext="editContext" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <div class="offcanvas-body">
        <div class="mb-3">
            <label class="form-label">
                @Loc["Name English"]
                <span class="text-danger">*</span> 
            </label>
            <InputText class="form-control" @bind-Value="_statusDto.NameEnglish" />
            <ValidationMessage class="small text-danger" For="@(() => _statusDto.NameEnglish)"></ValidationMessage>
        </div>

        <div class="mb-3">
            <label class="form-label">
                @Loc["Name Arabic"]
                <span class="text-danger">*</span>
            </label>
            <InputText class="form-control" @bind-Value="_statusDto.NameArabic" />
            <ValidationMessage class="small text-danger" For="@(() => _statusDto.NameArabic)"></ValidationMessage>
        </div>

        <div class="mb-3">
            <label class="form-label">
                @Loc["Name Color Indicator"]
                <span class="text-danger">*</span>
            </label>

            <div class="color-group">
                <InputText class="form-control" @bind-Value="_statusDto.NameColor" />
                <span class="rounded-circle cl-preview" style="background-color:@_statusDto.NameColor"></span>
                <span class="color-indicator">
                    <input type="color" id="color-name" value="@_statusDto.NameColor" @onchange="OnNameColorChanged" />
                    <label for="color-name">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ColorPalette"></SVGCrud>
                    </label>
                </span>
            </div>
            <ValidationMessage class="small text-danger" For="@(() => _statusDto.NameColor)"></ValidationMessage>
        </div>

        <div class="mb-3">
            <label class="form-label">
                @Loc["Background Color Indicator"]
                <span class="text-danger">*</span>
            </label>
            <div class="color-group">
                <InputText class="form-control" @bind-Value="_statusDto.BackgroundColor" />
                <span class="rounded-circle cl-preview" style="background-color:@_statusDto.BackgroundColor"></span>
                <span class="color-indicator">
                    <input type="color" id="bg-name" value="@_statusDto.BackgroundColor" @onchange="OnBackgroundColorChanged" />
                    <label for="bg-name">
                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ColorPalette"></SVGCrud>
                    </label>
                </span>
            </div>
            <ValidationMessage class="small text-danger" For="@(() => _statusDto.BackgroundColor)"></ValidationMessage>
        </div>
    </div>

    <div class="offcanvas-footer">
        <div class="row g-2">
            <div class="col-6">
                <div class="d-grid">
                    <button type="button" class="btn btn-lg btn-light" @onclick="Cancel">@Loc["Cancel"]</button>
                </div>
            </div>
            <div class="col-6">
                <div class="d-grid">
                    <button type="submit" class="btn btn-lg btn-primary">@Loc["Save"]</button>
                </div>
            </div>
        </div>

    </div>

</EditForm>


@code {
    [Parameter] public Guid Id { get; set; }
    [Parameter] public EventCallback<StatusSettingsDto> OnValidSubmit { get; set; }
    private StatusSettingsDto _statusDto = new();
    private EditContext editContext;

    protected override async Task OnParametersSetAsync()
    {
        var res = await _statusSettingConsumer.GetStatusById(Id);
        if (res.Success && res.Data != null)
        {
            _statusDto = res.Data;
            editContext = new EditContext(_statusDto);
        }
    }

    private async Task Save()
    {
        var res = await _statusSettingConsumer.UpdateStatusConfiguration(_statusDto);
        if (res.Success)
        {
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");
            PopupService.Hide();

            if (OnValidSubmit.HasDelegate)
                await OnValidSubmit.InvokeAsync(_statusDto);
        }
    }
    private void OnNameColorChanged(ChangeEventArgs e)
    {
        _statusDto.NameColor = e.Value?.ToString();

        editContext.NotifyFieldChanged(
            new FieldIdentifier(_statusDto, nameof(_statusDto.NameColor))
        );
    }
    private void OnBackgroundColorChanged(ChangeEventArgs e)
    {
        _statusDto.BackgroundColor = e.Value?.ToString();

        editContext.NotifyFieldChanged(
            new FieldIdentifier(_statusDto, nameof(_statusDto.BackgroundColor))
        );
    }
    private void Cancel()
    {
        PopupService.Hide();
    }
}