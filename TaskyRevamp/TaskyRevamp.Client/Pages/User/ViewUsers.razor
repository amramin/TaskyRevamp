@page "/Users"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.Enums.SearchFields
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject UserConsumer _userConsumer
@inject TaskConsumer _taskConsumer
@inject PopupService PopupService

<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["users"]</h1>

    </div>
    <div class="action-btn-list">
        <Search @ref="searchComponent" SearchSubmit="Search" CssClass="form-control"></Search>
    </div>
</div>

@if (users != null && users.Any())
{
    <div class="page-body">
        <div class="table-responsive">
            @if (users != null && users.Any())
            {

                <SortableTable TItem="UserDtoWithName" Columns="@tableColumns" Items="@users" SortColumn="@currentSortColumn"
                               SortAscending="@sortAscending" OnSortRequested="HandleSort">
                    <RowTemplate>
                        @foreach (var item in users)
                        {
                            var checkboxId = $"source-active-{item.user.Id}";
                            <tr>
                                <td>@item.user.DisplayedName</td>
                                <td>@item.user.Email</td>
                                <td>@item.PrivilegeName</td>
                                <td>@item.DepartmentName</td>
                                <td>
                                    <div class="form-check form-switch custom">
                                        <InputCheckbox id="@checkboxId" @bind-Value="item.user.IsManager" class="form-check-input"
                                                       disabled />
                                        <label for="@checkboxId" class="form-check-label">
                                            <span class="toggler-icon"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="form-check form-switch custom">
                                        <InputCheckbox id="@checkboxId" @bind-Value="item.user.IsActive" class="form-check-input"
                                                       disabled />
                                        <label for="@checkboxId" class="form-check-label">
                                            <span class="toggler-icon"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>@(item.user.UpdateDate?.ToLocalTime().ToString("dd-MM-yyyy"))</td>
                                <td>@item.user.UserName</td>
                                <td>
                                    <div class="dropdown actions">
                                        <button class="btn btn-action-24" type="button" data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EllipseVertical"></SVGCrud>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <button class="dropdown-item" @onclick="@(() => ViewPrivilege(item.user.PrivilegeId))">
                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.PrivilegeConfig"></SVGCrud>
                                                    </span>
                                                    @Loc["ViewPrivilege"]
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item" @onclick="@(() => LinkUser(item.user.Id))">
                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Users"></SVGCrud>
                                                    </span>
                                                    @Loc["LinkUser"]
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item text-danger" @onclick="@(() => DeleteUser(item))">
                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                                                    </span>
                                                    <span>@Loc["Delete"]</span>
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </RowTemplate>
                </SortableTable>
            }
        </div>
        <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                    PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
    </div>

}
else if (initialUsers != null && initialUsers.Any())
{
    <NoSearchResults OnResetClick="ClearSearch"></NoSearchResults>
}
else
{
    <NoDataAvailable MessageTitle="@Loc["NoUsersAvailable"]"/>
}


@code {
    List<UserDtoWithName> users = new();
    List<UserDtoWithName> initialUsers = new();
    private bool showConfirm;
    private UserDtoWithName? selectedUser;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "CreateDate";
    private bool? sortAscending = true;
    private List<SortableColumn> tableColumns = new();
    private Search? searchComponent;

    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadUsers();
    }

    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadUsers();
    }
    protected override async Task OnInitializedAsync()
    {
        tableColumns = new()
        {
            new() { Field = "Name", DisplayName = Loc["name"] },
            new() { Field = "Email", DisplayName = Loc["email"] },
            new() { Field = "Privileges", DisplayName = Loc["Privileges"] },
            new() { Field = "Department", DisplayName = Loc["Department"] },
            new() { Field = "Set as Manager", DisplayName = Loc["setAsManager"] },
            new() { Field = "IsActive", DisplayName = Loc["active"] },
            new() { Field = "UpdateDate", DisplayName = Loc["UpdateDate"] },
            new() { Field = "UpdatedBy", DisplayName = Loc["UpdatedBy"] },
            new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
        };
        await LoadUsers();
        initialUsers = users;
    }
    private async Task LoadUsers(bool isSearch = false, string searchTerm = null)
    {
        var resp = await _userConsumer.GetUsersWithPagination(currentPage, pageSize, currentSortColumn, sortAscending.Value,
        isSearch ? searchFields : null, isSearch ? searchTerm : null);

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        users = data.Items.ToList();
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }
    private void DeleteUser(UserDtoWithName user)
    {
        PopupService.ShowConfirmation(@Loc["Sure"], @Loc["Confirm"], OnDeleteConfirmed, type: ConfirmationType.Danger);
        selectedUser = user;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedUser != null)
        {
            if (selectedUser.user.IsActive)
            {
                await ToastService.ShowToastAsync(Loc["user_is_active"], "error");
                return;
            }
            else
            {
                var hasTasks = await _taskConsumer.CheckOpenedTaskForUser(selectedUser.user.Id);
                if (hasTasks.Data)
                {
                    await ToastService.ShowToastAsync(Loc["userHasTasksValidation"], "error");
                    return;
                }
            }
            var result = await _userConsumer.DeleteUser(selectedUser.user.Id);
            if (result.Success)
            {
                users.Remove(selectedUser);
                initialUsers = initialUsers.Where(s => s.user.Id != selectedUser.user.Id).ToList();
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
        }
        selectedUser = null;

    }
    private void LinkUser(Guid Id)
    {
        PopupService.ShowNew(@<LinkUser Id="Id" OnSaved="ReloadAfterSave"></LinkUser>, headerText: @Loc["LinkUser"]);
    }
    private async Task ReloadAfterSave()
    {
        currentPage = 1;
        PopupService.Hide();
        await LoadUsers();
        StateHasChanged();
    }
    private void ViewPrivilege(Guid? Id) => navigationManager.NavigateTo($"/privilege?mode=view&id={Id}");

    private async Task SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }
        await LoadUsers();
    }

    public List<SearchFieldUser> searchFields = new List<SearchFieldUser>() {
            SearchFieldUser.NameEnglish,
            SearchFieldUser.NameArabic,
            SearchFieldUser.Email,
            SearchFieldUser.IsManager,
            SearchFieldUser.Privilege,
            SearchFieldUser.Department,
            // SearchFieldUser.CreatedBy,
            SearchFieldUser.UpdatedBy,
            // SearchFieldUser.CreateDate,
            SearchFieldUser.UpdateDate,
            SearchFieldUser.ActiveStatus
    };

    public async Task Search(string searchTerm)
    {
        await LoadUsers(true, searchTerm);
    }
    private async Task ClearSearch()
    {
        currentPage = 1;
        searchComponent?.ClearSearchText();
        await LoadUsers(isSearch: false);
    }
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;
        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = "Name"; // or whatever your default column is
            sortAscending = true;
        }
        await LoadUsers();
    }
}