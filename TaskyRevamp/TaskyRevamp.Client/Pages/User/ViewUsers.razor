@page "/Users"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.SystemConfiguration
@using TaskyRevamp.Dto.Enums.SearchFields
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject UserConsumer _userConsumer
@inject TaskConsumer _taskConsumer
@inject PrivilegeConsumer _privilegeConsumer
@inject DepartmentConsumer _deparmentConsumer
@inject PopupService PopupService
@inject FileManagementService _fileManagementService

<div class="page-header">
    <div class="title-block">
        <h1 class="page-headline">@Loc["users"]</h1>

    </div>
    <div class="action-btn-list">
        <Search @ref="searchComponent" SearchSubmit="Search" CssClass="form-control"></Search>
    </div>
   
</div>
<div class="d-flex align-items-center justify-content-between p-3 m-3 border rounded bg-light">
    <div class="d-flex align-items-center">
        <label class="btn btn-action-24 me-3">
                <span class="icon">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowUp"></SVGCrud>
                </span>
            <InputFile OnChange="OnFileSelected" style="display:none" />
        </label>
        <div>
            <div class="fw-bold">@Loc["Upload"]</div>
            <div class="text-muted small">@Loc["Link"]</div>
            <div class="text-danger small">@Loc["EmailMandatory"]</div>
            <div class="text-danger small">@Loc["PrivilegeMandatory"]</div>
            <div class="text-danger small">@Loc["DepartmentMandatory"]</div>
        </div>
    </div>
    <div>
        <button class="btn btn-outline-primary" @onclick="DownloadExcel">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.ArrowDown"></SVGCrud> @Loc["Download"]
            </span>
            
        </button>
    </div>
</div>


@if (users != null && users.Any())
{
    <div class="page-body">
        <div class="table-responsive sticky-header-custom">
            @if (users != null && users.Any())
            {

                <SortableTable TItem="UserDtoWithName" Columns="@tableColumns" Items="@users" SortColumn="@currentSortColumn"
                               SortAscending="@sortAscending" OnSortRequested="HandleSort">
                    <RowTemplate>
                        @foreach (var item in users)
                        {
                            var checkboxId = $"source-active-{item.user.Id}";
                            <tr>
                                <td>@item.user.DisplayedName</td>
                                <td>@item.user.Email</td>
                                <td>@item.PrivilegeName</td>
                                <td>@item.DepartmentName</td>

                                @* <td>
                                    <div class="form-check form-switch custom">
                                        <InputCheckbox id="@checkboxId" @bind-Value="item.user.IsActive" class="form-check-input"
                                                       disabled />
                                        <label for="@checkboxId" class="form-check-label">
                                            <span class="toggler-icon"></span>
                                        </label>
                                    </div>

                                </td>*@
                                <td>@(item.user.UpdateDate?.ToLocalTime().ToString(Loc["LocalizeDate"]))</td>
                                <td>@item.UpdatedByName</td>
                                <td>
                                    <div class="form-check form-switch custom">
                                        <InputCheckbox id="@checkboxId" @bind-Value="item.user.IsManager" class="form-check-input"
                                                       disabled />
                                        <label for="@checkboxId" class="form-check-label">
                                            <span class="toggler-icon"></span>
                                        </label>
                                    </div>
                                </td>
                                <td>
                                    <div class="dropdown actions">
                                        <button class="btn btn-action-24" type="button" data-bs-toggle="dropdown"
                                                aria-expanded="false">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EllipseVertical"></SVGCrud>
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>

                                                <button class="dropdown-item text-danger" @onclick="@(() => DeleteUser(item))">

                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delete"></SVGCrud>
                                                    </span>
                                                    <span>@Loc["Delete"]</span>
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item" @onclick="@(() => ViewPrivilege(item.user.PrivilegeId))">
                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.PrivilegeConfig"></SVGCrud>
                                                    </span>
                                                    @Loc["ViewPrivilege"]
                                                </button>
                                            </li>
                                            <li>
                                                <button class="dropdown-item" @onclick="@(() => LinkUser(item.user.Id))">
                                                    <span class="icon">
                                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Users"></SVGCrud>
                                                    </span>
                                                    @Loc["userLink"]
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </td>
                            </tr>
                        }
                    </RowTemplate>
                </SortableTable>
            }
        </div>
        <Pagination CurrentPage="@currentPage" TotalPages="@totalPages" TotalCount="@totalCount" PageSize="@pageSize"
                    PageChanged="ChangePage" PageSizeChangedCallback="ChangePageSize" />
    </div>

}
else if (initialUsers != null && initialUsers.Any())
{
    <NoSearchResults OnResetClick="ClearSearch"></NoSearchResults>
}
else
{
    <div class="page-body">
        <div class="card empty-page">
            <div class="card-body">
                <span class="vector">
                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EmptyPageVector"></SVGCrud>
                </span>
                <div class="content">
                    <h5 class="headline-5">@Loc["NoUsersAvailable"]</h5>
                </div>
            </div>
        </div>
    </div>
}


@code {
    List<UserDtoWithName> users = new();
    List<UserDtoWithName> initialUsers = new();
    private bool showConfirm;
    private UserDtoWithName? selectedUser;
    private int currentPage = 1;
    private int totalPages = 1;
    private int totalCount = 0;
    private int pageSize = 10;
    private string currentSortColumn = "";
    private bool? sortAscending = true;
    private List<SortableColumn> tableColumns = new();
    private Search? searchComponent;
    private IBrowserFile? fileInput;
    private HashSet<string> systemDepartments = new();
    private HashSet<string> systemPrivileges = new();
    private HashSet<string> systemEmails = new();
    private List<UserLinkDto> userLinkDtos = new();

    private async Task ChangePage(int page)
    {
        currentPage = page;
        await LoadUsers();
    }
    private async Task ChangePageSize(int newSize)
    {
        pageSize = newSize;
        currentPage = 1;
        await LoadUsers();
    }
    protected override async Task OnInitializedAsync()
    {
        tableColumns = new()
        {
            new() { Field = "Name", DisplayName = Loc["name"] },
            new() { Field = "Email", DisplayName = Loc["email"] },
            new() { Field = "Privileges", DisplayName = Loc["UserPrivilege"] },
            new() { Field = "Department", DisplayName = Loc["Department"] },
            new() { Field = "UpdateDate", DisplayName = Loc["UpdateDate"] },
            new() { Field = "UpdatedBy", DisplayName = Loc["UpdatedBy"] },
            new() { Field = "Set as Manager", DisplayName = Loc["setAsManager"] },
            new() { Field = "Action", DisplayName = Loc["Action"] ,IsSortable = false},
        };
        await LoadUsers();
        initialUsers = users;
    }
    private async Task LoadUsers(bool isSearch = false, string searchTerm = null)
    {
        var resp = await _userConsumer.GetUsersWithPagination(currentPage, pageSize, currentSortColumn, sortAscending.Value,
        isSearch ? searchFields : null, isSearch ? searchTerm : null);

        if (!(resp?.Success ?? false) || resp.Data is null)
            return;

        var data = resp.Data;
        users = data.Items.ToList();
        totalPages = data.TotalPages;
        totalCount = data.TotalCount;
    }
    private void DeleteUser(UserDtoWithName user)
    {
        PopupService.ShowConfirmation(@Loc["Sure"], @Loc["Confirm"], OnDeleteConfirmed, type: ConfirmationType.Danger);
        selectedUser = user;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedUser != null)
        {
            if (selectedUser.user.IsActive)
            {
                await ToastService.ShowToastAsync(Loc["user_is_active"], "error");
                return;
            }
            else
            {
                var hasTasks = await _taskConsumer.CheckOpenedTaskForUser(selectedUser.user.Id);
                if (hasTasks.Data)
                {
                    await ToastService.ShowToastAsync(Loc["userHasTasksValidation"], "error");
                    return;
                }
            }
            var result = await _userConsumer.DeleteUser(selectedUser.user.Id);
            if (result.Success)
            {
                users.Remove(selectedUser);
                initialUsers = initialUsers.Where(s => s.user.Id != selectedUser.user.Id).ToList();
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
        }
        selectedUser = null;

    }
    private void LinkUser(Guid Id)
    {
        PopupService.ShowNew(@<LinkUser Id="Id" OnSaved="ReloadAfterSave"></LinkUser>, headerText: @Loc["LinkUser"]);
    }
    private async Task ReloadAfterSave()
    {
        currentPage = 1;
        PopupService.Hide();
        await LoadUsers();
        StateHasChanged();
    }
    private void ViewPrivilege(Guid? Id) 
    {
        var currentUrl = navigationManager.Uri;
        navigationManager.NavigateTo($"/privilege?mode=view&id={Id}&ReturnUrl={Uri.EscapeDataString(currentUrl)}");
    }
    private async Task SortBy(string columnName)
    {
        if (currentSortColumn == columnName)
        {
            sortAscending = !sortAscending;
        }
        else
        {
            currentSortColumn = columnName;
            sortAscending = true;
        }
        await LoadUsers();
    }
    public List<SearchFieldUser> searchFields = new List<SearchFieldUser>() {
            SearchFieldUser.Name,
            SearchFieldUser.Email,
            SearchFieldUser.IsManager,
            SearchFieldUser.Privilege,
            SearchFieldUser.Department,
            SearchFieldUser.UpdatedBy,
            SearchFieldUser.UpdateDate,
            SearchFieldUser.ActiveStatus
    };
    public async Task Search(string searchTerm)
    {
        await LoadUsers(true, searchTerm);
    }
    private async Task ClearSearch()
    {
        currentPage = 1;
        searchComponent?.ClearSearchText();
        await LoadUsers(isSearch: false);
    }
    private async Task HandleSort((string Column, bool? Ascending) sortInfo)
    {
        currentSortColumn = sortInfo.Column;
        sortAscending = sortInfo.Ascending;
        if (sortAscending == null)
        {
            // third click → reset to default sorting
            currentSortColumn = ""; // or whatever your default column is
            sortAscending = true;
        }
        await LoadUsers();
    }
    private async Task DownloadExcel(MouseEventArgs args)
    {
        await _fileManagementService.DownloadUsersTemplateAsync();
    }
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        fileInput = e.File;
        if (fileInput != null)
        {
            var (bytes, name, type) = await _fileManagementService.ReadFileAsync(fileInput);
            if(bytes == null)
            {
                return;
            }
            var rows = _fileManagementService.ReadExcelRows(bytes);
            Console.WriteLine($"Total Rows: {rows.Count}");
            if (rows.Count <= 1)
            {
                await ToastService.ShowToastAsync(Loc["ValidationError"], "error");
                return;
            }
            var res = await _userConsumer.GetUsers();
            if (res.Success && res.Data != null)
            {
                systemEmails = res.Data.Select(u => u.Email.Trim().ToLower()).ToHashSet();
                Console.WriteLine($"System Emails: {string.Join(", ", systemEmails)}");
            }
            var allDepartmnets = await _deparmentConsumer.GetDepartmentNames();
            if(allDepartmnets.Success && allDepartmnets.Data != null){
                var Departmnets = allDepartmnets.Data;
                systemDepartments = Departmnets.Select(d => d.Trim().ToLower()).ToHashSet();
                Console.WriteLine($"All Departments: {string.Join(", ", systemDepartments)}");
            }
            var allPrivileges = await _privilegeConsumer.GetPrivilegeNames();
            if (allPrivileges.Success && allPrivileges.Data != null) {
                var Privileges = allPrivileges.Data;
                systemPrivileges = Privileges.Select(p => p.Trim().ToLower()).ToHashSet();
                Console.WriteLine($"All Privileges: {string.Join(", ", systemPrivileges)}");
            }
            var uploadedEmails = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            userLinkDtos.Clear();
            for (int i = 1; i < rows.Count; i++)
            {
                Console.WriteLine($"Processing Row {i + 1}");
                var isValid = Validate(rows[i], uploadedEmails);
                if (!isValid)
                {
                    await ToastService.ShowToastAsync(Loc["ValidationError"], "error");
                    return;
                }
                userLinkDtos.Add(new UserLinkDto
                {
                    email = rows[i][0].Trim(),
                    departmentName = rows[i][1].Trim(),
                    privilegeName = rows[i][2].Trim()
                });
            }

            var resp = await _userConsumer.LinkUserWithDepartmentAndPrivilege(userLinkDtos);
            if (resp.Success)
            {
                await ToastService.ShowToastAsync(Loc["filesSuccess"], "success");
                await LoadUsers();
            }
            
        }
    }

    private bool Validate(string[] row, HashSet<string> uploadedEmails)
    {
        if (row.Length != 3)
            return false;

        var email = row[0].Trim().ToLower();
        var departmentName = row[1].Trim().ToLower();
        var privilegeName = row[2].Trim().ToLower();
        Console.WriteLine($"Email: {email}, Department: {departmentName}, Privilege: {privilegeName}");
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(departmentName) || string.IsNullOrWhiteSpace(privilegeName))
        {
            Console.WriteLine("case1");
            return false;
        }
        if (!systemEmails.Contains(email))
        {
            Console.WriteLine("case2");
            return false;
        }
        if (!systemDepartments.Contains(departmentName))
        {
            Console.WriteLine("case3");
            return false;
        }
        if (!systemPrivileges.Contains(privilegeName))
        {
            Console.WriteLine("case4");
            return false;
        }
        if (!uploadedEmails.Add(email))
        {
            Console.WriteLine("case5");
            return false;
        }

        return true;
    }
}