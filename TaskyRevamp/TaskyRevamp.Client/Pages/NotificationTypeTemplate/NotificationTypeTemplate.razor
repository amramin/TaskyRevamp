@page "/NotificationTypeTemplates/{ModuleType:int}"

@using System.Globalization
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Dto.Notification
@using TaskyRevamp.Dto.SystemConfiguration
@inject NotificationTypeTemplateConsumer _NotificationTypeTemplateConsumer
@inject NavigationManager navigationManager
@inject IStringLocalizer<SharedResources> Loc
@inject ToastService ToastService
@inject PopupService PopupService

<div class="page-header">
    <div class="title-block">
        @if (ModuleType == (int)Dto.Enums.ModuleType.Email)
     {
            <h1 class="page-headline">@Loc["EmailNotification"]</h1>
     }
        @if (ModuleType == (int)Dto.Enums.ModuleType.SystemNotification)
        {
            <h1 class="page-headline">@Loc["SystemNotification"]</h1>
        }
        @if (ModuleType == (int)Dto.Enums.ModuleType.History)
        {
            <h1 class="page-headline">@Loc["SystemHistory"]</h1>
        }
    </div>

</div>
<div class="page-body">

    <div class="card setting-card">
        <div class="card-body">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="text-content">
                        <div class="text-content">
                            <h6 class="headline-6">@Loc["Types of system notification Messages"]</h6>
                            @if (ModuleType == (int)Dto.Enums.ModuleType.Email)
                            {
                                <p class="small-medium-text hint"> @Loc["Usethisoptionemail"]</p>
                            }
                            else if (ModuleType == (int)Dto.Enums.ModuleType.SystemNotification)
                            {
                                <p class="small-medium-text hint"> @Loc["Usethisoption"]</p>
                            }
                            else if (ModuleType == (int)Dto.Enums.ModuleType.History)
                            {
                                <p class="small-medium-text hint"> @Loc["historyHint"]</p>
                            }
                        </div>
                    </div>

                    <SortableList Id="defaultColsList" Items="NotificationTypeTemplates.ToList()"
                        KeySelector="@(item => item.Id)" Context="p">
                        <SortableItemTemplate>
                          
                                <div class="form-check-card switch ">

                                   
                                      
                                            <input type="checkbox" id="IsActive@(p.Id)" class="form-check-input"
                                                @bind="p.IsEnable" />

                                            <label for="IsActive@(p.Id)">
                                            <span class="d-flex justify-content-between gap-2 align-items-center flex-grow-1">
                                        @(CultureInfo.CurrentCulture.Name == "ar-EG" ? p.NameArabic : p.NameEnglish)
                                                <span class="toggler-icon"></span>
                                                </span>
                                                <div class="actions">

                                                    <button class="btn btn-action-24 btn-edit"
                                                        @onclick=" () => Edit(p)">
                                                        <span class="icon">
                                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Edit"></SVGCrud>
                                                        </span>
                                                    </button>
                                                </div>
                                            </label>
                                       
                                   
                                </div>

                           
                            @* <div class="form-check-card switch flex-grow-1">
                                <InputCheckbox id="@inputId" @bind-Value="view.IsActive" class="form-check-input" />
                                <label for="@inputId">@Loc[view.ViewType.ToString()]
                                    <span class="toggler-icon"></span>
                                </label>
                            </div> *@
                        </SortableItemTemplate>
                    </SortableList>


                </div>
            </div>

        </div>

        <div class="card-footer">
            <div class="row justify-content-center">
                <div class="col-xxl-7 col-xl-8 col-lg-9 col-md-11">
                    <div class="action-buttons">
                        <button class="btn btn-lg  btn-primary" @onclick="Save">@Loc["Save"]</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int ModuleType { get; set; }
    public List<NotificationTypeTemplateDto> NotificationTypeTemplates = new List<NotificationTypeTemplateDto>();
    private Guid SelectedNotificationTypeTemplateId { get; set; }
    private NotificationTypeTemplateDto? selectedNotificationTypeTemplate;
    private bool showConfirm;
    private bool isOrdered = false;
    private NotificationTypeTemplateDto? draggedItem;

    protected async override Task OnInitializedAsync()
    {
        var res = await _NotificationTypeTemplateConsumer.GetNotificationTypeTemplates();
        if (res.Success && res.Data != null)
        {
            NotificationTypeTemplates = res.Data.Where(k => k.moduleType == (Dto.Enums.ModuleType)ModuleType)
                .ToList();
        }
    }
    protected async override Task OnParametersSetAsync()
    {
        var res = await _NotificationTypeTemplateConsumer.GetNotificationTypeTemplates();
        if (res.Success && res.Data != null)
        {
            NotificationTypeTemplates = res.Data.Where(k => k.moduleType == (Dto.Enums.ModuleType)ModuleType)
                .ToList();
        }
    }


    private void Edit(NotificationTypeTemplateDto notificationTypeTemplateDto)
    {
        navigationManager.NavigateTo($"EditTemplate/{notificationTypeTemplateDto.Id}");
    }
    private void ShowDeleteConfirm(NotificationTypeTemplateDto p)
    {
        PopupService.ShowConfirmation(message: @Loc["Sure"], @Loc["Delete"], OnDeleteConfirmed, type: ConfirmationType.Danger);
        selectedNotificationTypeTemplate = p;
        showConfirm = true;
    }
    private async Task OnDeleteConfirmed(bool confirmed)
    {
        if (confirmed && selectedNotificationTypeTemplate != null)
        {
            var result = await
            _NotificationTypeTemplateConsumer.DeleteNotificationTypeTemplate(selectedNotificationTypeTemplate.Id);
            if (result.Success)
            {
                NotificationTypeTemplates.Remove(selectedNotificationTypeTemplate);
                showConfirm = false;
                StateHasChanged();
                await ToastService.ShowToastAsync(Loc["Deleted successfully"], "success");
            }
        }
        selectedNotificationTypeTemplate = null;
        StateHasChanged();
    }


    private async Task Save(MouseEventArgs args)
    {

        var res = await _NotificationTypeTemplateConsumer.UpdateNotificationTypeTemplates(NotificationTypeTemplates);
        if (res.Success)
        {
            isOrdered = false;
            await ToastService.ShowToastAsync(Loc["EditSuccess"], "success");

        }

    }
    private List<NotificationTypeTemplateDto> CopyPriorites()
    {
        return NotificationTypeTemplates.Select(p => new NotificationTypeTemplateDto
        {
            Id = p.Id,
            NameEnglish = p.NameEnglish,
            NameArabic = p.NameArabic,
            SubjectArabic = p.SubjectArabic,
            SubjectEnglish = p.SubjectEnglish,
            IsEnable = p.IsEnable,
            moduleType = p.moduleType
        }).ToList();
    }
}