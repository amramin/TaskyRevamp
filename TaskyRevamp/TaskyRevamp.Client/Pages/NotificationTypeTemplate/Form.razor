@page "/EditTemplate/{Id:guid}"
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.Notification
@using TaskyRevamp.Dto.SystemConfiguration
@inject IStringLocalizer<SharedResources> Loc
@inject NotificationTypeTemplateConsumer _NotificationTypeTemplateConsumer

<div class="page-header">
    <div class="title-block">
        <button class="btn btn-action-24">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.BackArrow"></SVGCrud>
            </span>
        </button>
        <h1 class="page-headline">Configure system notification content</h1>
    </div>

</div>
<div class="page-body">
<EditForm EditContext="@editContext" OnSubmit="@OnSubmitHandler">
    <DataAnnotationsValidator />
    <div class="body">
        <div class="row g-2">
            <div class="col-lg-6">
                <div class="mb-6">
                    <label class="form-label">
                        @Loc["SubjectEnglish"]
                        <span class="text-danger">*</span>
                    </label>
                    <InputText class="form-control" @bind-Value="NotificationTypeTamplate.SubjectEnglish" />
                    <ValidationMessage class="small text-danger" For="@(() => NotificationTypeTamplate.SubjectEnglish)">
                    </ValidationMessage>
                </div>
            </div>
            <div class="col-lg-6">

                <label class="form-label">
                    @Loc["SubjectArabic"]
                    <span class="text-danger">*</span>
                </label>

                <div class="color-group">
                    <InputText class="form-control" @bind-Value="NotificationTypeTamplate.SubjectArabic" />



                </div>
                <ValidationMessage class="small text-danger" For="@(() => NotificationTypeTamplate.SubjectEnglish)">
                </ValidationMessage>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <div class="col-lg-6">
            <div class="mb-6">


                <RichTextEditorComponent EditorId="RTE_EnglishTemplateEnglish"
                    @ref="RichTextEditorComponentRefTemplateEnglish" Content="@NotificationTypeTamplate.TemplateEnglish"
                    ContentChanged="OnDescriptionEnglishChanged">
                </RichTextEditorComponent>

                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex gap-2">
                        <ValidationMessage class="small text-danger"
                            For="@(() => NotificationTypeTamplate.TemplateEnglish)" />
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="mb-6">


                <RichTextEditorComponent EditorId="RTE_EnglishTemplateArabic"
                    @ref="RichTextEditorComponentRefTemplateArabic" Content="@NotificationTypeTamplate.TemplateArabic"
                    ContentChanged="OnDescriptionArabicChanged">
                </RichTextEditorComponent>

                <div class="d-flex align-items-center justify-content-between">
                    <div class="d-flex gap-2">
                        <ValidationMessage class="small text-danger"
                            For="@(() => NotificationTypeTamplate.TemplateArabic)" />
                    </div>
                </div>
            </div>

        </div>
    </div>

    <div class="offcanvas-footer">
        <div class="row g-2">
            <div class="col-3">
                <div class="d-grid"> <button type="button" class="btn btn-lg btn-light"
                        @onclick="OnCancelClick">@Loc["Cancel"]</button></div>
            </div>
            <div class="col-3">
                <div class="d-grid"> <button type="submit"
                        class="btn btn-lg btn-primary">@Loc[@SubmitButtonText]</button></div>
            </div>
        </div>
    </div>
</EditForm>
</div>

@code {

    [Parameter] public Guid Id { set; get; }


    NotificationTypeTemplateDto NotificationTypeTamplate { get; set; } = new NotificationTypeTemplateDto();
    [Parameter] public EventCallback<EditContext> OnValidSubmit { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string SubmitButtonText { get; set; } = "Save";
    private RichTextEditorComponent RichTextEditorComponentRefTemplateEnglish;

    private RichTextEditorComponent RichTextEditorComponentRefTemplateArabic;

    private EditContext editContext;
    private ValidationMessageStore messageStore;
    protected override async Task OnParametersSetAsync()

    {
        if (editContext == null || editContext.Model != NotificationTypeTamplate)
        {
            editContext = new EditContext(NotificationTypeTamplate);
            messageStore = new ValidationMessageStore(editContext);
        }
    }
    protected async override Task OnInitializedAsync()
    {
        var temp = await _NotificationTypeTemplateConsumer.GetNotificationTypeTemplateById(Id);
        NotificationTypeTamplate = temp.Data;
        StateHasChanged();
    }
    private void OnDescriptionEnglishChanged(string html)
    {
        NotificationTypeTamplate.TemplateEnglish = html;
    }

    private void OnDescriptionArabicChanged(string html)
    {
        NotificationTypeTamplate.TemplateArabic = html;
    }
    private async Task OnSubmitHandler(EditContext context)
    {
        ClearValidationMessages();
        if (!editContext.Validate())
            return; // client-side validation failed → stop

        await _NotificationTypeTemplateConsumer.AddNotificationTypeTemplate(NotificationTypeTamplate);
        await OnValidSubmit.InvokeAsync(context);
    }

    private async Task OnCancelClick()
    {
        await OnCancel.InvokeAsync();
    }


    public void ClearValidationMessages()
    {
        messageStore.Clear();
        editContext.NotifyValidationStateChanged();
    }
}