@inject IStringLocalizer<SharedResources> Loc
@inject NavigationManager NavigationManager

<aside
    class="side-nav side-nav @(IsSettingOpen ? "setting-nav-open" : "")  @(isMobileNavOpen ? "side-nav-open-mobile" : "")">
    <div class="side-nav-header">
        <div class="side-nav-logo">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.TaskyIcon"></SVGCrud>
            </span>
            <span class="text">Tasky</span>
        </div>
        <button class="btn btn-action-40 btn-outline-light d-flex d-lg-none btn-toggle-sidenav"
            @onclick="ToggleMobileNav">
            <span class="icon">
                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Menu"></SVGCrud>
            </span>
        </button>
        <button class="btn overlay btn-toggle-sidenav d-flex d-lg-none" @onclick="ToggleMobileNav">
        </button>
    </div>

    <div class="sid-nav-body">
        <ul class="nav menu flex-column">
            <li class="nav-item">
                <NavLink href="/tasks" class="nav-link" Match="NavLinkMatch.All"
                    @onclick="() => { CloseSettingsNav(); ToggleMobileNav(); }">
                    <div class="icon-text">
                        <span class="nav-icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Dashboard"></SVGCrud>
                        </span>
                        <span class="text"> Dashboard </span>
                    </div>
                </NavLink>
            </li>

            <li class="nav-item">
                <NavLink href="/MainTasks" class="nav-link" Match="NavLinkMatch.All"
                    @onclick="() => { CloseSettingsNav(); ToggleMobileNav(); }">
                    <div class="icon-text">
                        <span class="nav-icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.List"></SVGCrud>
                        </span>
                        <span class="text"> Task list </span>
                    </div>
                </NavLink>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="#" data-id="completed-list"
                    @onclick="() => { CloseSettingsNav(); ToggleMobileNav(); }">
                    <div class="icon-text">
                        <span class="nav-icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.CompletedList"></SVGCrud>
                        </span>
                        <span class="text"> Completed task list </span>
                    </div>
                </a>
            </li>

            <li class="nav-item">
                <a class="nav-link" href="/UserDelegations" @onclick="() => { CloseSettingsNav(); ToggleMobileNav(); }">
                    <div class="icon-text">
                        <span class="nav-icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Delegation"></SVGCrud>
                        </span>
                        <span class="text">Delegation </span>
                    </div>
                </a>
            </li>
        </ul>

        <ul class="nav menu flex-column">
            <li class="nav-item ">
                <a class="nav-link toggle-btn" @onclick="SettingNav" role="button">
                    <div class="icon-text">
                        <span class="nav-icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Config"></SVGCrud>
                        </span>
                        <span class="text"> Settings </span>
                    </div>
                </a>

                <ul class="nav setting-menu">
                    @foreach (var item in MenuItems)
                    {
                        <li class="nav-item dropdown @(item.IsOpen ? "open" : "") @(item.IsActive ? "active" : "")">
                            <button class="nav-link dropdown-toggler" @onclick="() => ToggleMenu(item)">
                                <span class="nav-icon">
                                    @if (item.IsOpen)
                                    {
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Minus"></SVGCrud>
                                    }
                                    else
                                    {
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Pluse"></SVGCrud>
                                    }
                                </span>
                                <span class="text"> @Loc[item.Title]</span>
                            </button>

                            <ul class="dropdown-menu @(item.IsOpen ? "show" : "")">
                                @foreach (var child in item.Children)
                                {
                                    <li class="nav-item">
                                        <a class="nav-link @(child.IsActive ? "active" : "")" data-id="@child.DataId"
                                            href="@child.Url"
                                            @onclick="() => { SetActiveItem(item, child); ToggleMobileNav(); }">
                                            <div class="icon-text">
                                                <span class="nav-icon">
                                                    <SVGCrud SVGType="@child.Icon"></SVGCrud>
                                                </span>
                                                <span class="text">@Loc[child.Text]</span>
                                            </div>
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                </ul>
            </li>
        </ul>
    </div>
</aside>

@code {
    private bool IsSettingOpen { get; set; } = false;

    private async Task SettingNav()
    {
        if (IsSettingOpen)
        {
            IsSettingOpen = false;
            return;
        }

        // Step 1: Open settings panel
        IsSettingOpen = true;
        StateHasChanged(); // Force UI update immediately

        // Step 2: Allow UI to render before expanding/clicking menu
        await Task.Yield(); // let render cycle complete

        // Step 3: Open first menu section and navigate
        var firstMenu = MenuItems.FirstOrDefault();
        if (firstMenu != null)
        {
            foreach (var item in MenuItems)
                item.IsOpen = false;

            firstMenu.IsOpen = true;

            var firstChild = firstMenu.Children.FirstOrDefault();
            if (firstChild != null)
            {
                SetActiveItem(firstMenu, firstChild);
                NavigationManager.NavigateTo(firstChild.Url);
            }
        }

        StateHasChanged(); // Final UI update
    }

    private void CloseSettingsNav()
    {
        IsSettingOpen = false;
    }

    class MenuItem
    {
        public string Title { get; set; }
        public bool IsOpen { get; set; }
        public bool IsActive { get; set; } // added for active state
        public List<ChildItem> Children { get; set; } = new();
    }

    class ChildItem
    {
        public string Text { get; set; }
        public string Url { get; set; }
        public SVGCrud.SVGTypeEnum Icon { get; set; }
        public string DataId { get; set; }
        public bool IsActive { get; set; } // added for active state
    }

    List<MenuItem> MenuItems = new();

    private void SetMenu()
    {
        MenuItems = new List<MenuItem> {
new MenuItem {
Title = "General",
IsOpen = false,
Children = new List<ChildItem> {
new ChildItem { Text = "RecycleBinConfiguration", Url = "/RecycleBinConfiguration", Icon =
SVGCrud.SVGTypeEnum.RecycleBinConfig , DataId = "recycle-config" },
new ChildItem { Text = "RejectionConfiguration", Url = "/RejectionConfiguration", Icon = SVGCrud.SVGTypeEnum.Reject,
DataId = "rejection-config" },
new ChildItem { Text = @Loc["Priority"], Url = "/PrioritySettings", Icon = SVGCrud.SVGTypeEnum.ArrowsUp, DataId =
"priorty-config" },
new ChildItem { Text = "StatusConfig", Url = "/StatusSetting", Icon = SVGCrud.SVGTypeEnum.Repeat, DataId =
"status-config" },
new ChildItem { Text = "DefaultColumnsConfiguration", Url = "/DefaultColumnsConfiguration", Icon =
SVGCrud.SVGTypeEnum.Columns, DataId = "defaultColumns-config" },
new ChildItem { Text = "FilterFields", Url = "/FilterFieldsConfiguration", Icon = SVGCrud.SVGTypeEnum.Filter, DataId =
"filterFields-config" },
new ChildItem { Text = "AddTaskFieldsConfiguration", Url = "/AddTaskConfiguration", Icon =
SVGCrud.SVGTypeEnum.PluseCircle, DataId = "addTask-config" },
new ChildItem { Text = "WorkingDaysConfiguration", Url = "/WorkingDaysSetting", Icon = SVGCrud.SVGTypeEnum.CalnderPluse,
DataId = "calnderPluse-config" },
new ChildItem { Text = "SourceConfiguration", Url = "/SourceSettings", Icon = SVGCrud.SVGTypeEnum.DataFlow, DataId =
"taskSource-config" },
new ChildItem { Text = "TaskTypeConfiguration", Url = "/TypeConfiguration", Icon = SVGCrud.SVGTypeEnum.TaskType, DataId
= "taskType-config" },
new ChildItem { Text = "Tasksviews", Url = "/Views", Icon = SVGCrud.SVGTypeEnum.List, DataId = "taskViews-config" },
new ChildItem {Text= "Subtask_Levels", Url="/sub_task", Icon = SVGCrud.SVGTypeEnum.SubTasks, DataId =
"taskViews-config"},
new ChildItem { Text = "WeeklyReport", Url = "/WeeklyReportSetting", Icon = SVGCrud.SVGTypeEnum.BarChartSquarPluse,
DataId = "weeklyReport-config" }
}
},
new MenuItem {
Title = "Appearance", IsOpen = false,
Children = new List<ChildItem> {
new ChildItem { Text = @Loc["System Identity Configuration"], Url = "/SystemIdentitySetting", Icon =
SVGCrud.SVGTypeEnum.RollerBrush, DataId =
"systemIdentity-config" }
}
},
new MenuItem {
Title = "Management", IsOpen = false,
Children = new List<ChildItem> {
new ChildItem { Text = "users", Url = "/Users", Icon = SVGCrud.SVGTypeEnum.UsersEdit, DataId = "users-config" },
new ChildItem { Text = "Departments", Url = "/Departments", Icon = SVGCrud.SVGTypeEnum.DataFlow, DataId =
"departments-config" },
new ChildItem { Text = @Loc["PrivilegeTilte"], Url = "/Privileges", Icon = SVGCrud.SVGTypeEnum.PrivilegeConfig, DataId =
"Privilege-config" }
}
},
new MenuItem {
Title = "Notifications", IsOpen = false,
Children = new List<ChildItem> {
new ChildItem { Text = "EmailNotification", Url =
$"/NotificationTypeTemplates/{(int)TaskyRevamp.Dto.Enums.ModuleType.Email}", Icon =
SVGCrud.SVGTypeEnum.NotificationMessage,
DataId = "notification-message-config" },
new ChildItem { Text = "SystemNotifications", Url =
$"/NotificationTypeTemplates/{(int)TaskyRevamp.Dto.Enums.ModuleType.SystemNotification}", Icon =
SVGCrud.SVGTypeEnum.BellPluse, DataId =

"systemNotifcation-config" },
new ChildItem { Text = "TaskHistory", Url = "/TaskHistory", Icon = SVGCrud.SVGTypeEnum.ClockRewind, DataId =
"taskHistory-config" }
}
},
};
    }

    protected override void OnInitialized()
    {
        SetMenu();

        var firstMenu = MenuItems.FirstOrDefault();
        if (firstMenu != null)
        {
            firstMenu.IsOpen = true;
            var firstChild = firstMenu.Children.FirstOrDefault();
            if (firstChild != null)
            {
                SetActiveItem(firstMenu, firstChild);
                NavigationManager.NavigateTo(firstChild.Url);
            }
        }
    }

    void ToggleMenu(MenuItem clicked)
    {
        foreach (var item in MenuItems)
            item.IsOpen = false;

        clicked.IsOpen = true;
        StateHasChanged(); // ensure re-render
    }

    private void SetActiveItem(MenuItem parent, ChildItem child)
    {
        // Reset all active states
        foreach (var item in MenuItems)
        {
            item.IsActive = false;
            foreach (var c in item.Children)
                c.IsActive = false;
        }

        // Activate selected parent and child
        parent.IsActive = true;
        child.IsActive = true;

        StateHasChanged(); // refresh immediately
    }
    // toggle side menu mobile
    private bool isMobileNavOpen = false;

    private void ToggleMobileNav()
    {
        isMobileNavOpen = !isMobileNavOpen;
    }
}