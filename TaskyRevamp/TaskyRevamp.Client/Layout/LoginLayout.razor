@using Blazored.LocalStorage
@using TaskyRevamp.Client.Services
@inherits LayoutComponentBase
@inject LoaderService LoaderService
@inject TaskyService taskyService
@inject IJSRuntime JS
@using TaskyRevamp.Client.Consumer
@inject SystemIdentityConsumer _systemIdentityConsumer
@inject ILocalStorageService localStorageService
@inject NavigationManager NavigationManager
@Body

<Loader IsVisible="@isLoaderVisible" />

@code {
    private bool isLoaderVisible;
    private string systemLogoAsImgSrc = "";
    private DotNetObjectReference<LoginLayout>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("authListener.register", _dotNetRef);
        }
    }
    protected override async Task OnInitializedAsync()
    {
        LoaderService.OnShow += () =>
        {
            isLoaderVisible = true;
            InvokeAsync(StateHasChanged); // force UI refresh
        };
        LoaderService.OnHide += () =>
        {
            isLoaderVisible = false;
            InvokeAsync(StateHasChanged); // force UI refresh
        };

        var identity = await taskyService.GetSystemIdentity();
        systemLogoAsImgSrc = taskyService.GetSystemLogoAsImgSrc(identity.Logo);

        await taskyService.ChangeTheme(identity);

        taskyService.OnSystemIdentityChanged += async (updatedIdentity) =>
        {
            systemLogoAsImgSrc = taskyService.GetSystemLogoAsImgSrc(updatedIdentity.Logo);
            await taskyService.ChangeTheme(updatedIdentity);
            await InvokeAsync(StateHasChanged);
        };
    }
    [JSInvokable]
    public async Task OnLoginDetected()
    {
        await Task.Delay(50);
        // if (NavigationManager.Uri.Contains("/login", StringComparison.OrdinalIgnoreCase))
        //     return;
        var tokenExists = await localStorageService.ContainKeyAsync("bearerToken");
        if (!tokenExists)
            return;
        var returnUrl = await JS.InvokeAsync<string>("navigationTracker.getReturnUrl");
        NavigationManager.NavigateTo(string.IsNullOrEmpty(returnUrl) ? "/" : returnUrl, forceLoad: true);
    }
}