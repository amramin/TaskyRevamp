<Toast />
<PopupHost />
<Loader IsVisible="@isLoaderVisible" />

@code {
    private bool IsAuthChecked = false;
    private bool langInitialized = false;
    private bool isLoaderVisible;

    string HeaderName;
    RenderFragment Content { get; set; }
    bool IsShowDialog = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await CheckAuth(firstRender);
        await base.OnAfterRenderAsync(firstRender);
    }

    protected override void OnInitialized()
    {
        LoaderService.OnShow += () =>
        {
            isLoaderVisible = true;
            InvokeAsync(StateHasChanged); // force UI refresh
        };
        LoaderService.OnHide += () =>
        {
            isLoaderVisible = false;
            InvokeAsync(StateHasChanged); // force UI refresh
        };
    }

    void SetRenderFragment(RenderFragment content, string headerName)
    {
        HeaderName = headerName;
        Content = content;
        StateHasChanged();
    }
    public void Logout()
    {
        taskyService.NavigateToLogin();
    }

    void ToggleDialog(bool isShow)
    {
        IsShowDialog = isShow;
        StateHasChanged();
    }


    private async Task CheckAuth(bool firstRender)
    {
        if (firstRender || IsAuthChecked)
            return;

        var isHomePage = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).AbsolutePath == "/";

        IsAuthChecked = true;
        var isTokenExist = await localStorageService.ContainKeyAsync("bearerToken");
        if (!isTokenExist)
        {
            taskyService.NavigateToLogin();
            return;
        }

        var token = await localStorageService.GetItemAsStringAsync("bearerToken");
        if (taskyService.IsTokenExpired(token))
        {
            taskyService.NavigateToLogin();
        }
    }
}