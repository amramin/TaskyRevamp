@using System.Globalization
@using Blazored.LocalStorage
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.SystemConfiguration
@inherits LayoutComponentBase
@inject SystemIdentityConsumer _systemIdentityConsumer
@inject ILocalStorageService localStorageService
@inject NavigationManager NavigationManager
@inject TaskyService taskyService
@inject IJSRuntime JS
@inject LoaderService LoaderService
@inject IStringLocalizer<SharedResources> Loc

<main class="@SideMenuWrapperClass">
    <NavMenu />
    <section class="main-content">
        <header class="main-header sticky-top">
            <div class="main-header-body">
                <div class="start">
                    <button class="btn btn-action-40 btn-outline-light d-none d-lg-flex" @onclick="ToggleSideMenu">
                        <span class="icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Menu"></SVGCrud>
                        </span>
                    </button>
                    <div class="group-input">
                        <span class="start-icon">
                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Search"></SVGCrud>
                        </span>
                        <input class="form-control form-control-lg"
                               placeholder="User name"
                               id="id-number"
                               required />
                    </div>
                </div>
                <div class="end">
                    <CultureSelector @rendermode="StaticClasses.InteractiveAutoRenderModeFalse" />
                    @*                     <button class="btn-change-lang btn" onclick="@ChangeLanguage">
                            <span class="ar">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.AR"></SVGCrud>
                            </span>
                            <span class="en">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EN"></SVGCrud>
                            </span>
                        </button> *@
                    <div class="dropdown notifcation-dropdown">
                        <button class="btn btn-action"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <span class="icon">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Bell"></SVGCrud>
                            </span>
                            <span class="badge"></span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                            <li><a class="dropdown-item" href="#">Action</a></li>
                            <li><a class="dropdown-item" href="#">Another action</a></li>
                            <li>
                                <a class="dropdown-item" href="#">Something else here</a>
                            </li>
                        </ul>
                    </div>
                    <img class="logo"
                         src="@(string.IsNullOrEmpty(systemLogoAsImgSrc)? "" : systemLogoAsImgSrc)"
                         alt="system-logo" />
                    <div class="dropdown dropdown-user">
                        <button class="btn btn-user"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <span class="first-user-letter">AM</span>
                        </button>
                        <ul class="dropdown-menu" aria-labelledby="topDropdown">
                            <li class="header">
                                <span class="first-user-letter">AM</span>
                                <div class="user-info">
                                    <span class="user-name"> Ahmed Mostafa </span>
                                    <span class="user-email">System Admin </span>
                                </div>
                            </li>

                            <li class="dropdown-item">
                                <a class="drop-link">
                                    <span class="icon">
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Lock"></SVGCrud>
                                    </span>
                                    Change Password
                                </a>
                            </li>

                            <li class="dropdown-item">
                                <a class="drop-link" @onclick="Logout">
                                    <span class="icon">
                                        <SVGCrud SVGType="SVGCrud.SVGTypeEnum.LogOut"></SVGCrud>
                                    </span>
                                    @Loc["Logout"]
                                </a>
                            </li>
                           
                        </ul>
                    </div>
                </div>
            </div>
        </header>
        <section class="main-page">
            <CascadingValue Value="ToggleDialog">
                <CascadingValue Value="SetRenderFragment">
                    <CascadingValue Value="Loc">
                        @Body
                    </CascadingValue>
                    <PopupHost />
                </CascadingValue>
            </CascadingValue>

            <footer class="page-footer">
                @* <span class="start-text">
                        Copyright &copy;
                        <a class="primary-link-btn" href="#"> Stingray Tasky</a>
                        <span class="year">2024</span> . All rights reserved.
                    </span>
                    <span class="end-text">
                        Power by
                        <a href="#" class="primary-link-btn text-decoration-none">Stingray</a>
                    </span> *@
                <span class="text-center  flex-grow-1">All rights are safe - Kingdom of Saudi Arabia</span>
            </footer>
        </section>
    </section>
</main>
<Toast />
<Loader IsVisible="@isLoaderVisible" />

@code {
    private bool IsAuthChecked = false;
    private bool langInitialized = false;
    private bool isLoaderVisible;

    string HeaderName;
    RenderFragment Content { get; set; }
    bool IsShowDialog = false;
 private bool IsSideMenuCollapsed = false;
    private string SideMenuWrapperClass =>
    IsSideMenuCollapsed ? "main-wrapper mainlayout-collapsed" : "main-wrapper";

    private string systemLogoAsImgSrc = "";

    private void ToggleSideMenu()
    {
        IsSideMenuCollapsed = !IsSideMenuCollapsed;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await CheckAuth(firstRender);
        await base.OnAfterRenderAsync(firstRender);
      
    }

    protected async override Task OnInitializedAsync()
    {
        LoaderService.OnShow += () =>
        {
            isLoaderVisible = true;
            InvokeAsync(StateHasChanged); // force UI refresh
        };
        LoaderService.OnHide += () =>
        {
            isLoaderVisible = false;
            InvokeAsync(StateHasChanged); // force UI refresh
        };

        var identity = await taskyService.GetSystemIdentity();
        systemLogoAsImgSrc = taskyService.GetSystemLogoAsImgSrc(identity.Logo);

        await taskyService.ChangeTheme(identity);
        // Listen for logo
        taskyService.OnSystemIdentityChanged += (updatedIdentity) =>
        {
            systemLogoAsImgSrc = taskyService.GetSystemLogoAsImgSrc(updatedIdentity.Logo);
            InvokeAsync(StateHasChanged);
        };
    }

    void SetRenderFragment(RenderFragment content, string headerName)
    {
        HeaderName = headerName;
        Content = content;
        StateHasChanged();
    }
    public void Logout()
    {
        taskyService.NavigateToLogin();
    }

    void ToggleDialog(bool isShow)
    {
        IsShowDialog = isShow;
        StateHasChanged();
    }
    

    private async Task CheckAuth(bool firstRender)
    {
        if (firstRender || IsAuthChecked)
            return;

        var isHomePage = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).AbsolutePath == "/";

        IsAuthChecked = true;
        var isTokenExist = await localStorageService.ContainKeyAsync("bearerToken");
        if (!isTokenExist)
        {
            taskyService.NavigateToLogin();
            return;
        }

        var token = await localStorageService.GetItemAsStringAsync("bearerToken");
        if (taskyService.IsTokenExpired(token))
        {
            taskyService.NavigateToLogin();
        }
    }

   
}