@code {
    private string currentLang = "en";
    private string currentLangDisplay => currentLang == "en" ? "العربية" : "English";
    private bool IsAuthChecked = false;
    private bool langInitialized = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // ✅ Safe: JSInterop after first render
            currentLang = await LanguageService.GetLanguageAsync();
            LanguageService.OnLanguageChanged += StateHasChanged;
            langInitialized = true;
            StateHasChanged();
        }

        // ✅ Auth check after first render
        await CheckAuth(firstRender);
    }

    private async Task ToggleLanguage()
    {
        currentLang = currentLang == "en" ? "ar" : "en";
        await LanguageService.SetLanguageAsync(currentLang);
        await JS.InvokeVoidAsync("location.reload");
    }

    private async Task CheckAuth(bool firstRender)
    {
        if (firstRender || IsAuthChecked)
            return;

        var isHomePage = NavigationManager.ToAbsoluteUri(NavigationManager.Uri).AbsolutePath == "/";

        IsAuthChecked = true;
        var isTokenExist = await localStorageService.ContainKeyAsync("bearerToken");
        if (!isTokenExist)
        {
            taskyService.NavigateToLogin();
            return;
        }

        var token = await localStorageService.GetItemAsStringAsync("bearerToken");
        if (taskyService.IsTokenExpired(token))
        {
            taskyService.NavigateToLogin();
        }
    }
}