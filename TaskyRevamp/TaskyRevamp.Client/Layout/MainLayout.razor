@using System.Globalization
@using Blazored.LocalStorage
@using TaskyRevamp.Client.Services
@using TaskyRevamp.Client.Shared.Popups
@using TaskyRevamp.Client.Consumer
@using TaskyRevamp.Dto.Account
@using TaskyRevamp.Dto.SystemConfiguration
@inherits LayoutComponentBase
@inject SystemIdentityConsumer _systemIdentityConsumer
@inject ILocalStorageService localStorageService
@inject NavigationManager NavigationManager
@inject TaskyService taskyService
@inject IJSRuntime JS
@inject LoaderService LoaderService
@inject IStringLocalizer<SharedResources> Loc
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject UserConsumer userConsumer

@if(!IsAuthChecked)
{
    <Loader IsVisible="true" />
}
else
{
    <main class="@SideMenuWrapperClass">
        <NavMenu />
        <section class="main-content">
            <header class="main-header sticky-top">
                <div class="main-header-body">
                    <div class="start">
                        <button class="btn btn-action-40 btn-outline-light d-none d-lg-flex" @onclick="ToggleSideMenu">
                            <span class="icon arrow">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Menu"></SVGCrud>
                            </span>
                        </button>
                        <div class="group-input">
                            <span class="start-icon">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Search"></SVGCrud>
                            </span>
                            <input class="form-control form-control-lg" placeholder="User name" id="id-number" required />
                        </div>
                    </div>
                    <div class="end">
                        <CultureSelector @rendermode="StaticClasses.InteractiveAutoRenderModeFalse" />
                        @*                     <button class="btn-change-lang btn" onclick="@ChangeLanguage">
                            <span class="ar">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.AR"></SVGCrud>
                            </span>
                            <span class="en">
                                <SVGCrud SVGType="SVGCrud.SVGTypeEnum.EN"></SVGCrud>
                            </span>
                        </button> *@
                        <div class="dropdown notifcation-dropdown">
                            <button class="btn btn-action" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="icon">
                                    <SVGCrud SVGType="SVGCrud.SVGTypeEnum.Bell"></SVGCrud>
                                </span>
                                <span class="badge"></span>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="dropdownMenuLink">
                                <li><a class="dropdown-item" href="#">Action</a></li>
                                <li><a class="dropdown-item" href="#">Another action</a></li>
                                <li>
                                    <a class="dropdown-item" href="#">Something else here</a>
                                </li>
                            </ul>
                        </div>
                        <img class="logo" src="@(string.IsNullOrEmpty(systemLogoAsImgSrc) ? "" : systemLogoAsImgSrc)"
                             alt="system-logo" />

                        <div class="dropdown dropdown-user">
                            <button class="btn btn-user" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="first-user-letter">@OfficalName</span>
                            </button>
                            <ul class="dropdown-menu" aria-labelledby="topDropdown">
                                <li class="header">
                                    <span class="first-user-letter"> @OfficalName</span>
                                    <div class="user-info">
                                        <span class="user-name">
                                            <span>@Loc["Welcome"],</span>
                                            <span>@displayName </span>
                                        </span>
                                    </div>
                                </li>

                                <li class="dropdown-item">
                                    <a class="drop-link" @onclick="Logout">
                                        <span class="icon">
                                            <SVGCrud SVGType="SVGCrud.SVGTypeEnum.LogOut"></SVGCrud>
                                        </span>
                                        @Loc["Logout"]
                                    </a>
                                </li>
                            </ul>
                        </div>

                    </div>
                </div>
            </header>
            <section class="main-page">
                <CascadingValue Value="ToggleDialog">
                    <CascadingValue Value="SetRenderFragment">
                        <CascadingValue Value="Loc">
                            @Body
                        </CascadingValue>
                        <PopupHost />
                    </CascadingValue>
                </CascadingValue>

                <footer class="page-footer">
                    @* <span class="start-text">
                        Copyright &copy;
                        <a class="primary-link-btn" href="#"> Stingray Tasky</a>
                        <span class="year">2024</span> . All rights reserved.
                    </span>
                    <span class="end-text">
                        Power by
                        <a href="#" class="primary-link-btn text-decoration-none">Stingray</a>
                    </span> *@
                    <span class="text-center  flex-grow-1">
                        @Loc["AllrightsKSA"]
                    </span>
                </footer>
            </section>
        </section>
    </main>
}
<Toast />
<Loader IsVisible="@isLoaderVisible" />

@code {
    private bool IsAuthChecked = false;
    private bool langInitialized = false;
    private bool isLoaderVisible;
    string OfficalName = "";
    private string? displayName;
    string HeaderName;
    RenderFragment Content { get; set; }
    bool IsShowDialog = false;
    private bool IsSideMenuCollapsed = false;
    private string SideMenuWrapperClass =>
    IsSideMenuCollapsed ? "main-wrapper mainlayout-collapsed" : "main-wrapper";
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private string systemLogoAsImgSrc = "";

    private void ToggleSideMenu()
    {
        IsSideMenuCollapsed = !IsSideMenuCollapsed;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await CheckAuth(true);
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("authListener.register", _dotNetRef);
        }
    }
    [JSInvokable]
    public void ForceLogout()
    {
        taskyService.NavigateToLogin();
    }
    protected async override Task OnInitializedAsync()
    {
        NavigationManager.LocationChanged += async (_, __) =>
        {   
            if (!NavigationManager.Uri.Contains("/Login", StringComparison.OrdinalIgnoreCase))
                await JS.InvokeVoidAsync("navigationTracker.saveCurrentUrl");
        };
        var id = await localStorageService.GetItemAsStringAsync("Id");
        var currentUser = await GetUser(Guid.Parse(id!));
        displayName = currentUser.DisplayedName;
        LoaderService.OnShow += () =>
        {
            isLoaderVisible = true;
            InvokeAsync(StateHasChanged); // force UI refresh
        };
        LoaderService.OnHide += () =>
        {
            isLoaderVisible = false;
            InvokeAsync(StateHasChanged); // force UI refresh
        };
        var identity = await taskyService.GetSystemIdentity();
        systemLogoAsImgSrc = taskyService.GetSystemLogoAsImgSrc(identity.Logo);
        await taskyService.ChangeTheme(identity);
        // Listen for logo
        taskyService.OnSystemIdentityChanged += (updatedIdentity) =>
        {
            systemLogoAsImgSrc = taskyService.GetSystemLogoAsImgSrc(updatedIdentity.Logo);
            InvokeAsync(StateHasChanged);
        };
        OfficalName = GetInitials(displayName!);
    }
    private async Task<UserDto> GetUser(Guid id)
    {
        var res = await userConsumer.GetUserById(id);
        if(res.Success && res.Data != null)
        {
            return res.Data;
        }
        return null!;
    }
    private static string GetInitials(string fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 1)
            return parts[0][0].ToString().ToUpper();
        return $"{char.ToUpper(parts[0][0])}{char.ToUpper(parts[^1][0])}";
    }
    private static bool IsArabic(string text)
    {
        return text.Any(c =>
            (c >= '\u0600' && c <= '\u06FF') ||
            (c >= '\u0750' && c <= '\u077F') ||
            (c >= '\u08A0' && c <= '\u08FF'));
    }
    void SetRenderFragment(RenderFragment content, string headerName)
    {
        HeaderName = headerName;
        Content = content;
        StateHasChanged();
    }
    public async Task Logout()
    {
        await localStorageService.SetItemAsync("IsManualLogout", true);
        taskyService.NavigateToLoginManual();
    }

    void ToggleDialog(bool isShow)
    {
        IsShowDialog = isShow;
        StateHasChanged();
    }


    private async Task CheckAuth(bool firstRender)
    {
        var isTokenExist = await localStorageService.ContainKeyAsync("bearerToken");
        if (!isTokenExist)
        {
            taskyService.NavigateToLogin();
            return;
        }
        var token = await localStorageService.GetItemAsStringAsync("bearerToken");
        if (string.IsNullOrEmpty(token) || taskyService.IsTokenExpired(token))
        {
            taskyService.NavigateToLogin();
            return;
        }
        if (taskyService.IsTokenExpired(token))
        {
            taskyService.NavigateToLogin();
            return;
        }
        IsAuthChecked = true;
        StateHasChanged();
    }


}