@using System.Globalization
@using Microsoft.AspNetCore.Localization

<!DOCTYPE html>
<html dir="@(@CultureInfo.CurrentCulture.Name == "ar-EG" ? "rtl" : "ltr")">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TaskyRevamp.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.ico" />
    <HeadOutlet />
@*     <link href="./css/bootstrap.min.css" rel="stylesheet" /> *@
    <!-- Main CSS-->
   
    <link href="favico.ico" rel="icon" />

    @if (CultureInfo.CurrentCulture.Name == "ar-EG")
    {
        <link rel="stylesheet" href="./css/bootstrap.rtl.min.css" />
    }
    else
    {
        <link rel="stylesheet" href="./css/bootstrap.min.css" />
      
    }
    <link href="./css/main.css" rel="stylesheet" />
    <title>Task list</title>
</head>

<body>
    <TaskyRevamp.Client.Routes @rendermode="StaticClasses.InteractiveWebAssemblyRenderModeFalse" />
 
    <script src="js/bootstrap.bundle.min.js"></script>
    <script src="js/main.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script src="js/jquery-1.11.2.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
    <script>
        window.blazorCulture = {
            get: () => window.localStorage['BlazorCulture'],
            set: (value) => window.localStorage['BlazorCulture'] = value
        };

        window.BlazorDownloadFile = (fileName, base64Content) => {
            const link = document.createElement('a');
            link.download = fileName;
            link.href = `data:application/octet-stream;base64,${base64Content}`;
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        };
    </script>
</body>

</html>

@code {
    [CascadingParameter]
    public HttpContext? HttpContext { get; set; }


    protected override void OnInitialized()
    {
        // Set the default language to Arabic ('ar-EG') if no culture is set
        var defaultCulture = "ar-EG"; // Default to Arabic (Egypt)

        // Check if the culture cookie is not already set
        if (HttpContext?.Request.Cookies[CookieRequestCultureProvider.DefaultCookieName] == null)
        {
            HttpContext?.Response.Cookies.Append(
            CookieRequestCultureProvider.DefaultCookieName,
            CookieRequestCultureProvider.MakeCookieValue(
            new RequestCulture(defaultCulture, defaultCulture)),
            new CookieOptions { Expires = DateTimeOffset.UtcNow.AddYears(1) }
            );

            CultureInfo.CurrentCulture = new CultureInfo(defaultCulture);
            CultureInfo.CurrentUICulture = new CultureInfo(defaultCulture);
        }
        else
        {
            // Use the existing culture if it's already set
            var currentCulture = HttpContext.Request.Cookies[CookieRequestCultureProvider.DefaultCookieName];
            var cultureInfo = CookieRequestCultureProvider.ParseCookieValue(currentCulture);
            var culture = cultureInfo?.Cultures?.FirstOrDefault().Value ?? defaultCulture;  // Ensure correct fallback to default culture

            HttpContext?.Response.Cookies.Append(
            CookieRequestCultureProvider.DefaultCookieName,
            CookieRequestCultureProvider.MakeCookieValue(new RequestCulture(culture, culture)),
            new CookieOptions { Expires = DateTimeOffset.UtcNow.AddYears(1) }
            );
        }
    }
}